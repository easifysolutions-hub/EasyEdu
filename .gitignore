## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# User-specific files
*.suo
*.user
*.userosscache
*.sln.docstates
*.userprefs

# User-specific files (MonoDevelop/Xamarin Studio)
*.userprefs

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# Visual Studio cache/options directory
.vs/
.vscode/

# MSTest test Results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*

# NuGet Packages
*.nupkg
**/packages/*
!**/packages/build/
*.nuget.props
*.nuget.targets

# NuGet v3's project.json files produces more ignorable files
*.nuget.props
*.nuget.targets

# Files built by Visual Studio
*_i.c
*_p.c
*_h.h
*.ilk
*.meta
*.obj
*.iobj
*.pch
*.pdb
*.ipdb
*.pgc
*.pgd
*.rsp
*.sbr
*.tlb
*.tli
*.tlh
*.tmp
*.tmp_proj
*_wpftmp.csproj
*.log
*.vspscc
*.vssscc
.builds
*.pidb
*.svclog
*.scc

# Visual Studio profiler
*.psess
*.vsp
*.vspx
*.sap

# ReSharper
_ReSharper*/
*.[Rr]e[Ss]harper
*.DotSettings.user

# .NET Core
project.lock.json
project.fragment.lock.json
artifacts/

# ASP.NET Scaffolding
ScaffoldingReadMe.txt

# StyleCop
StyleCopReport.xml

# Files built by project
[Bb]in/
[Oo]bj/

# Database files
*.mdf
*.ldf
*.ndf

# SQL Server files
*.mdf
*.ldf

# Entity Framework Migrations (optional - comment out if you want to track)
# Migrations/

# Upload files
wwwroot/uploads/
wwwroot/files/
Uploads/
Files/

# User uploaded images
wwwroot/images/uploads/
wwwroot/images/students/
wwwroot/images/teachers/
wwwroot/images/staff/

# Logs
logs/
*.log
log.txt

# Node.js dependencies (if using npm)
node_modules/
npm-debug.log
yarn-error.log

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# IDE - Visual Studio
.vs/
*.suo
*.user

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# Backup files
*.bak
*.backup
*~

# Temporary files
*.tmp
*.temp
*.swp
*.swo

# Connection Strings (IMPORTANT - Keep this!)
appsettings.Development.json
appsettings.Production.json
# Uncomment below if you want to ignore all appsettings
# appsettings.*.json

# Secrets
secrets.json
*.pfx
*.p12

# Certificate files
*.cer
*.crt
*.key

# Windows image file caches
Thumbs.db
ehthumbs.db

# Folder config file
Desktop.ini

# Recycle Bin used on file shares
$RECYCLE.BIN/

# Mac
.DS_Store

# JetBrains Rider
.idea/
*.sln.iml

# CodeRush
.cr/

# Python (if using)
__pycache__/
*.py[cod]
*$py.class

# Compiled files
*.exe
*.dll
*.so
*.dylib

# Package files
*.zip
*.tar.gz
*.rar

# Cache files
*.cache
.sass-cache/

# Application specific
wwwroot/lib/
wwwroot/css/*.min.css
wwwroot/js/*.min.js

# Keep these important files
!.gitignore
!README.md
!LICENSE

# Temp / Workspace Logs & Dumps
migration_*.txt
update_*.txt
*sidebar.html
window_dump.xml
test_out.txt
error.html
build_output.txt
run_logs.txt
run_logs_utf8.txt

# Mobile App test and dump files
EasyEduMobile/bundle_test.js
EasyEduMobile/logcat_fresh2.txt
EasyEduMobile/screen_test.png
EasyEduMobile/window_dump.xml
EasyEduMobile/window_dump_pretty.xml

# Mobile App builds and binaries
*.apk
*.ipa
node_modules/


