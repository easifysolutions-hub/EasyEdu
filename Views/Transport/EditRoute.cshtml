@model EasyEdu.Models.Route
@{
    ViewData["Title"] = "Optimize Mobility Corridor";
    Layout = "_Layout";
}

<div class="page-header d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="page-title animate-slide-in">Corridor Optimization</h1>
        <p class="text-muted fw-600">Refining transit parameters for the institutional mobility network</p>
    </div>
    <div>
        <a asp-action="Index" class="btn btn-premium-primary bg-white text-primary border border-primary px-4 shadow-sm">
            <i class="fas fa-arrow-left me-2"></i> Mobility Hub
        </a>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-xl-9 col-lg-11">
        <div class="premium-card bg-white shadow-lg border-0 overflow-hidden animate-fade-in">
            <div class="p-4 border-bottom bg-light d-flex justify-content-between align-items-center">
                <h5 class="fw-900 text-dark mb-0"><i class="fas fa-edit text-primary me-2"></i> Strategy Parameter Update</h5>
                <span class="badge bg-primary text-white fw-800">ID: RT-@Model.Id.ToString("D3")</span>
            </div>
            <div class="p-5">
                <form asp-action="EditRoute" asp-route-id="@Model.Id" method="post">
                    <input type="hidden" asp-for="Id" />
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-4 p-3 bg-danger-soft rounded-12"></div>
                    
                    <div class="row g-5">
                        <div class="col-md-7">
                            <div class="mb-4">
                                <label asp-for="Name" class="form-label fw-800 text-muted small uppercase mb-2">Corridor Designation</label>
                                <input asp-for="Name" class="form-control form-control-lg border-2 fw-700" required />
                                <span asp-validation-for="Name" class="text-danger small"></span>
                            </div>

                            <div class="mb-4">
                                <label asp-for="Description" class="form-label fw-800 text-muted small uppercase mb-2">Logistics Summary</label>
                                <textarea asp-for="Description" class="form-control border-2" rows="4"></textarea>
                                <span asp-validation-for="Description" class="text-danger small"></span>
                            </div>

                            <div class="p-4 bg-primary-soft rounded-24">
                                <div class="d-flex align-items-center mb-3">
                                    <i class="fas fa-map-location-dot text-primary me-2 h5 mb-0"></i>
                                    <span class="fw-900 text-primary uppercase">GPS Milestones</span>
                                </div>
                                <textarea asp-for="RouteStops" class="form-control border-0 bg-white font-monospace" rows="4"></textarea>
                            </div>
                        </div>

                        <div class="col-md-5">
                            <div class="premium-card p-4 border bg-gray-50 mb-4">
                                <label asp-for="RouteFee" class="form-label fw-800 text-muted small uppercase mb-2">Subscription Fee</label>
                                <div class="input-group input-group-lg">
                                    <span class="input-group-text bg-white border-2 text-success fw-900">$</span>
                                    <input asp-for="RouteFee" type="number" step="0.01" class="form-control border-2 fw-900 text-success" />
                                </div>
                                <span asp-validation-for="RouteFee" class="text-danger small"></span>
                            </div>

                            <div class="form-check form-switch custom-switch-lg p-0 mb-5">
                                <div class="d-flex align-items-center justify-content-between p-4 bg-white border-2 border-dashed rounded-24">
                                    <div>
                                        <h6 class="fw-900 text-dark mb-0">Corridor Status</h6>
                                        <p class="small text-muted mb-0 fw-600">Active / Operational</p>
                                    </div>
                                    <input asp-for="IsActive" class="form-check-input ms-0" type="checkbox" />
                                </div>
                            </div>

                            <div class="d-grid gap-3 pt-4">
                                <button type="submit" class="btn-premium btn-premium-primary py-3 shadow-lg fs-5">
                                    <i class="fas fa-sync me-2"></i> Update Parameters
                                </button>
                                <a asp-action="Index" class="btn btn-light py-2 rounded-12 fw-700 opacity-50 text-center text-decoration-none">
                                    Cancel
                                </a>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
