@model EasyEdu.Models.Vehicle
@{
    ViewData["Title"] = "Configure Fleet Unit";
    Layout = "_Layout";
}

<div class="page-header d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="page-title animate-slide-in">Asset Calibration</h1>
        <p class="text-muted fw-600">Managing specifications and operational status for institutional vehicular units</p>
    </div>
    <div>
        <a asp-action="Vehicles" class="btn btn-premium-primary bg-white text-primary border border-primary px-4 shadow-sm">
            <i class="fas fa-bus me-2"></i> Active Fleet
        </a>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-xl-9 col-lg-11">
        <div class="premium-card bg-white shadow-lg border-0 overflow-hidden animate-fade-in">
            <div class="p-4 border-bottom bg-light d-flex justify-content-between align-items-center">
                <h5 class="fw-900 text-dark mb-0"><i class="fas fa-shuttle-van text-primary me-2"></i> Unit Specification Control</h5>
                <span class="badge bg-dark fw-800">VIN: @Model.VehicleNumber</span>
            </div>
            <div class="p-5">
                <form asp-action="EditVehicle" asp-route-id="@Model.Id" method="post">
                    <input type="hidden" asp-for="Id" />
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-4 p-3 bg-danger-soft rounded-12"></div>
                    
                    <div class="row g-4">
                        <div class="col-md-4">
                            <label asp-for="VehicleNumber" class="form-label fw-800 text-muted small uppercase">Plate Number</label>
                            <input asp-for="VehicleNumber" class="form-control form-control-lg border-2 fw-900" required />
                            <span asp-validation-for="VehicleNumber" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="VehicleType" class="form-label fw-800 text-muted small uppercase">Asset Class</label>
                            <select asp-for="VehicleType" class="form-select border-2 fw-700">
                                <option value="Bus">Institutional Bus</option>
                                <option value="Van">Logistics Van</option>
                                <option value="Minibus">Minibus</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Model" class="form-label fw-800 text-muted small uppercase">Model Info</label>
                            <input asp-for="Model" class="form-control border-2" />
                        </div>

                        <div class="col-md-4">
                            <label asp-for="Capacity" class="form-label fw-800 text-muted small uppercase">Capacity (Seats)</label>
                            <input asp-for="Capacity" type="number" class="form-control border-2 fw-800" />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="RouteId" class="form-label fw-800 text-muted small uppercase">Active Corridor</label>
                            <select asp-for="RouteId" class="form-select border-2 fw-700" asp-items="@(new SelectList(ViewBag.Routes, "Id", "Name"))">
                                <option value="">-- No Route --</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="DriverId" class="form-label fw-800 text-muted small uppercase">Assigned Navigator</label>
                            <select asp-for="DriverId" class="form-select border-2 fw-700" asp-items="@(new SelectList(ViewBag.Drivers, "Id", "Name"))">
                                <option value="">-- No Driver --</option>
                            </select>
                        </div>

                        <div class="col-12 mt-5">
                            <div class="p-4 bg-gray-50 rounded-24 border">
                                <div class="d-flex justify-content-between align-items-center mb-4">
                                    <h6 class="fw-900 text-dark mb-0">Compliance Metadata</h6>
                                    <div class="form-check form-switch custom-switch">
                                        <input asp-for="IsActive" class="form-check-input" type="checkbox" />
                                        <label class="form-check-label fw-700 small ms-2">Operational Readiness</label>
                                    </div>
                                </div>
                                <div class="row g-4">
                                    <div class="col-md-4">
                                        <label asp-for="RegistrationNumber" class="form-label fw-700 text-muted small uppercase">Gov. Reg No</label>
                                        <input asp-for="RegistrationNumber" class="form-control border-2" />
                                    </div>
                                    <div class="col-md-4">
                                        <label asp-for="InsuranceExpiry" class="form-label fw-700 text-muted small uppercase">Insurance Due</label>
                                        <input asp-for="InsuranceExpiry" type="date" class="form-control border-2 fw-700" />
                                    </div>
                                    <div class="col-md-4">
                                        <label asp-for="FitnessExpiry" class="form-label fw-700 text-muted small uppercase">Fitness Due</label>
                                        <input asp-for="FitnessExpiry" type="date" class="form-control border-2 fw-700" />
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-12 mt-5 d-flex justify-content-end gap-3">
                            <form asp-action="DeleteVehicle" asp-route-id="@Model.Id" method="post" onsubmit="return confirm('Decommission asset?')">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-outline-danger px-4 py-3 rounded-12 fw-800 border-2">Decommission Unit</button>
                            </form>
                            <button type="submit" class="btn-premium btn-premium-primary px-5 py-3 shadow-lg fs-5">
                                <i class="fas fa-save me-2"></i> Update Specifications
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
