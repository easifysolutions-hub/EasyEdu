@model EasyEdu.Models.Driver
@{
    ViewData["Title"] = "Update Navigator Profile";
    Layout = "_Layout";
}

<div class="page-header d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="page-title animate-slide-in">Navigator Profile</h1>
        <p class="text-muted fw-600">Managing credentials and assignments for mobility personnel</p>
    </div>
    <div>
        <a asp-action="Drivers" class="btn btn-premium-primary bg-white text-primary border border-primary px-4 shadow-sm">
            <i class="fas fa-arrow-left me-2"></i> Navigator Registry
        </a>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-xl-9 col-lg-11">
        <div class="premium-card bg-white shadow-lg border-0 overflow-hidden animate-fade-in">
            <div class="p-4 border-bottom bg-light">
                <h5 class="fw-900 text-dark mb-0"><i class="fas fa-user-edit text-primary me-2"></i> Identity & Credential Management</h5>
            </div>
            <div class="p-5">
                <form asp-action="EditDriver" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data">
                    <input type="hidden" asp-for="Id" />
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-4 p-3 bg-danger-soft rounded-12"></div>
                    
                    <div class="row g-4">
                        <div class="col-md-7">
                            <div class="mb-4">
                                <label asp-for="Name" class="form-label fw-800 text-muted small uppercase">Full Legal Name</label>
                                <input asp-for="Name" class="form-control form-control-lg border-2 fw-900" required />
                                <span asp-validation-for="Name" class="text-danger small"></span>
                            </div>
                            
                            <div class="row g-3 mb-4">
                                <div class="col-md-6">
                                    <label asp-for="Phone" class="form-label fw-800 text-muted small uppercase">Direct Contact</label>
                                    <input asp-for="Phone" class="form-control border-2 fw-700" />
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="Experience" class="form-label fw-800 text-muted small uppercase">Experience Summary</label>
                                    <input asp-for="Experience" class="form-control border-2" placeholder="e.g. 10 Years Bus Exp" />
                                </div>
                            </div>

                            <div class="mb-4">
                                <label asp-for="Address" class="form-label fw-800 text-muted small uppercase">Residential Address</label>
                                <textarea asp-for="Address" class="form-control border-2" rows="3"></textarea>
                            </div>
                        </div>

                        <div class="col-md-5">
                            <div class="premium-card p-4 border bg-gray-50 mb-4 text-center">
                                <div class="avatar-xl rounded-circle overflow-hidden border-4 border-white shadow-md mx-auto mb-3" style="width: 120px; height: 120px;">
                                    @if (!string.IsNullOrEmpty(Model.Photo))
                                    {
                                        <img src="@Model.Photo" class="w-100 h-100 object-fit-cover" alt="Driver" />
                                    }
                                    else
                                    {
                                        <div class="bg-primary text-white h-100 d-flex align-items-center justify-content-center fw-900 fs-1">@Model.Name.Substring(0, 1)</div>
                                    }
                                </div>
                                <label class="btn btn-sm btn-white border shadow-sm fw-800 text-primary">
                                    Update Identity Photo
                                    <input type="file" name="PhotoFile" class="d-none" />
                                </label>
                            </div>

                            <div class="p-4 bg-white border-2 border-dashed rounded-24">
                                <h6 class="fw-900 text-dark mb-3">Licensing Protocol</h6>
                                <div class="mb-3">
                                    <label asp-for="LicenseNumber" class="form-label fw-700 text-muted small uppercase">License #</label>
                                    <input asp-for="LicenseNumber" class="form-control border-2 fw-800" required />
                                </div>
                                <div class="mb-0">
                                    <label asp-for="LicenseExpiry" class="form-label fw-700 text-muted small uppercase">Expiry Date</label>
                                    <input asp-for="LicenseExpiry" type="date" class="form-control border-2 fw-800 text-danger" required />
                                </div>
                            </div>
                        </div>

                        <div class="col-12 mt-5 d-flex justify-content-between align-items-center border-top pt-4">
                            <div class="form-check form-switch custom-switch">
                                <input asp-for="IsActive" class="form-check-input" type="checkbox" />
                                <label class="form-check-label fw-800 text-dark ms-2">Active Operational Status</label>
                            </div>
                            <div class="d-flex gap-3">
                                <button type="reset" class="btn btn-light px-4 py-2 rounded-12 fw-800">Reset Profile</button>
                                <button type="submit" class="btn-premium btn-premium-primary px-5 py-3 shadow-lg fs-5">
                                    <i class="fas fa-save me-2"></i> Update Navigator Profile
                                </button>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
