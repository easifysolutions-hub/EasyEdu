@model IEnumerable<EasyEdu.Models.Student>
@{
    ViewData["Title"] = "Institutional Passenger Allocation";
    Layout = "_Layout";
    var routes = ViewBag.Routes as List<EasyEdu.Models.Route>;
    var classes = ViewBag.Classes as List<EasyEdu.Models.Class>;
}

<div class="page-header d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="page-title animate-slide-in">Passenger Allocation Hub</h1>
        <p class="text-muted fw-600">Dynamic association of student passengers to institutional mobility corridors</p>
    </div>
    <div>
        <a asp-action="Index" class="btn btn-premium-primary bg-white text-primary border border-primary px-4 shadow-sm">
            <i class="fas fa-route me-2"></i> Mobility Hub
        </a>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-12">
        <div class="premium-card bg-white shadow-sm p-4 border-0">
            <form method="get" class="row g-3 align-items-end">
                <div class="col-md-3">
                    <label class="form-label fw-800 text-muted small uppercase">Academic Classification</label>
                    <select name="classId" class="form-select border-2 fw-700" onchange="this.form.submit()">
                        <option value="">-- All Students --</option>
                        @foreach (var c in classes ?? new List<EasyEdu.Models.Class>())
                        {
                            <option value="@c.Id" selected="@(ViewBag.SelectedClassId == c.Id)">@c.Name</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-800 text-muted small uppercase">Bulk Corridor (Target)</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-2 text-primary"><i class="fas fa-magic"></i></span>
                        <select id="bulkRouteId" class="form-select border-2 fw-700">
                            <option value="0">-- Detach All --</option>
                            @foreach (var r in routes ?? new List<EasyEdu.Models.Route>())
                            {
                                <option value="@r.Id">@r.Name</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="col-md-3">
                    <button type="button" class="btn btn-premium-primary w-100 py-2 border-0 shadow-sm" style="background: var(--dark);" onclick="bulkAssign()">
                        <i class="fas fa-bolt me-2"></i> Execute Bulk Sync
                    </button>
                </div>
                <div class="col-md-3 text-end">
                    <div class="small fw-700 text-muted">Filtered: <span class="text-primary fw-900">@Model.Count()</span> Students</div>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="premium-card bg-white shadow-lg border-0 overflow-hidden animate-fade-in">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="bg-light">
                <tr>
                    <th class="ps-4 py-3 fw-900 text-muted small uppercase">Student Identity</th>
                    <th class="py-3 fw-900 text-muted small uppercase text-center">Academic Track</th>
                    <th class="py-3 fw-900 text-muted small uppercase">Current Corridor Status</th>
                    <th class="pe-4 py-3 fw-900 text-muted small uppercase text-end">Logistics Control</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in Model)
                {
                    <tr class="student-row" data-student-id="@s.Id">
                        <td class="ps-4">
                            <div class="d-flex align-items-center">
                                <div class="avatar-sm bg-primary-soft text-primary rounded-circle me-3 d-flex align-items-center justify-content-center fw-900" style="width: 40px; height: 40px;">
                                    @s.FirstName.Substring(0, 1)
                                </div>
                                <div>
                                    <div class="fw-800 text-dark">@s.FirstName @s.LastName</div>
                                    <div class="small text-muted fw-700">ID: @s.AdmissionNumber</div>
                                </div>
                            </div>
                        </td>
                        <td class="text-center">
                            <span class="badge bg-light text-dark border fw-800 px-3 py-2 rounded-8">@s.Class.Name</span>
                        </td>
                        <td>
                            <div id="badge-@s.Id">
                                @if (s.Route != null)
                                {
                                    <span class="badge bg-success-soft text-success border-success-light fw-800 px-3 py-2 rounded-12">
                                        <i class="fas fa-route me-1"></i> @s.Route.Name
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-light text-muted border fw-800 px-3 py-2 rounded-12 opacity-50">UNASSIGNED</span>
                                }
                            </div>
                        </td>
                        <td class="pe-4 text-end">
                            <select class="form-select form-select-sm border-2 fw-800 student-route-select w-auto ms-auto" 
                                    data-student-id="@s.Id" 
                                    onchange="updateAllocation(@s.Id, this.value)">
                                <option value="0">-- Detach --</option>
                                @foreach (var r in routes ?? new List<EasyEdu.Models.Route>())
                                {
                                    <option value="@r.Id" selected="@(s.RouteId == r.Id)">@r.Name</option>
                                }
                            </select>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        function updateAllocation(studentId, routeId) {
            const select = document.querySelector(`select[data-student-id="${studentId}"]`);
            const badge = document.getElementById(`badge-${studentId}`);
            
            select.disabled = true;
            select.classList.add('opacity-50');

            $.post('/Transport/UpdateStudentAllocation', { studentId, routeId }, function (res) {
                select.disabled = false;
                select.classList.remove('opacity-50');
                
                if (res.success) {
                    const routeName = select.options[select.selectedIndex].text;
                    if (routeId == "0") {
                        badge.innerHTML = '<span class="badge bg-light text-muted border fw-800 px-3 py-2 rounded-12 opacity-50">UNASSIGNED</span>';
                    } else {
                        badge.innerHTML = `<span class="badge bg-success-soft text-success border-success-light fw-800 px-3 py-2 rounded-12"><i class="fas fa-route me-1"></i> ${routeName}</span>`;
                    }
                } else {
                    alert('Logistics sync failed.');
                }
            });
        }

        function bulkAssign() {
            const targetRouteId = document.getElementById('bulkRouteId').value;
            const confirms = confirm(`Trigger bulk sync for @Model.Count() students to this corridor?`);
            if (!confirms) return;

            const selects = document.querySelectorAll('.student-route-select');
            selects.forEach(select => {
                select.value = targetRouteId;
                updateAllocation(select.dataset.studentId, targetRouteId);
            });
        }
    </script>
}
