@model IEnumerable<EasyEdu.Models.Student>
@{
    ViewData["Title"] = "Institutional Logistics Report";
    Layout = "_Layout";
}

<div class="page-header d-flex justify-content-between align-items-center mb-4 px-4">
    <div>
        <h1 class="page-title animate-slide-in"><i class="fas fa-bus-alt me-2 text-primary"></i> Transport Intelligence</h1>
        <p class="text-muted fw-600">Logistical overview of institutional transit routes and student mobility</p>
    </div>
    <div class="d-flex gap-2">
        <button onclick="window.print()" class="btn btn-premium-light rounded-12 px-4 shadow-sm fw-800 border">
            <i class="fas fa-print me-2"></i> LOGISTICS SUMMARY
        </button>
    </div>
</div>

<div class="container-fluid px-4 pb-5">
    <div class="premium-card bg-white shadow-xl border-0 rounded-24 overflow-hidden mb-4 p-4 animate-fade-in">
        <form method="get" class="row g-3 align-items-end">
            <div class="col-md-6">
                <label class="form-label small fw-800 text-muted uppercase">Target Transport Route</label>
                <select name="routeId" class="form-select rounded-12 border-0 bg-light fw-700" asp-items="ViewBag.Routes">
                    <option value="">All Active Routes</option>
                </select>
            </div>
            <div class="col-md-3">
                <button type="submit" class="btn btn-premium-primary w-100 rounded-12 fw-800">
                    <i class="fas fa-search me-2"></i> FILTER MANIFEST
                </button>
            </div>
            <div class="col-md-3">
                <div class="search-box position-relative">
                    <i class="fas fa-search position-absolute top-50 start-0 translate-middle-y ms-3 text-muted"></i>
                    <input type="text" class="form-control rounded-pill ps-5 border-0 bg-light" id="transportSearch" placeholder="Quick search students...">
                </div>
            </div>
        </form>
    </div>

    <div class="premium-card bg-white shadow-xl border-0 rounded-24 overflow-hidden animate-fade-in">
        <div class="p-4 border-bottom bg-light">
            <h6 class="fw-800 text-dark mb-0 uppercase">Transit Passenger Manifest</h6>
        </div>

        <div class="table-responsive">
            <table class="table premium-table mb-0">
                <thead>
                    <tr>
                        <th class="ps-4">STUDENT IDENTITY</th>
                        <th>CLASS / SECTION</th>
                        <th>ASSIGNED TRANSIT ROUTE</th>
                        <th>ROUTE VALUATION</th>
                        <th class="text-end pe-4">TRANSIT STATUS</th>
                    </tr>
                </thead>
                <tbody id="transportTable">
                    @foreach (var student in Model)
                    {
                        <tr class="align-middle">
                            <td class="ps-4">
                                <div class="fw-800 text-dark">@student.FirstName @student.LastName</div>
                                <div class="small text-muted fw-600">SID: @student.AdmissionNumber</div>
                            </td>
                            <td>
                                <div class="small fw-800 text-muted">CLASS @student.Class?.Name</div>
                            </td>
                            <td>
                                <div class="d-flex align-items-center">
                                    <div class="icon-box-xs bg-primary-soft text-primary rounded-circle me-2 d-flex align-items-center justify-content-center" style="width: 28px; height: 28px;">
                                        <i class="fas fa-route" style="font-size: 10px;"></i>
                                    </div>
                                    <span class="fw-800 text-dark">@student.Route?.Name</span>
                                </div>
                            </td>
                            <td>
                                <div class="fw-900 text-primary">@student.Route?.RouteFee?.ToString("C")</div>
                            </td>
                            <td class="text-end pe-4">
                                <span class="badge bg-success-soft text-success fw-800 px-3 py-2 rounded-pill">
                                    <i class="fas fa-shield-check me-1"></i> LOGISTICALLY SECURE
                                </span>
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="5" class="text-center py-5">
                                <i class="fas fa-shuttle-van fa-3x text-muted opacity-25 mb-4 d-block"></i>
                                <h5 class="fw-800 text-muted">No students identified in the institutional transit manifest.</h5>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<style>
    .bg-primary-soft { background: rgba(99,102,241,0.1); }
    .bg-success-soft { background: rgba(16, 185, 129, 0.1); }
</style>

@section Scripts {
    <script>
        $(document).ready(function() {
            $("#transportSearch").on("keyup", function() {
                var v = $(this).val().toLowerCase();
                $("#transportTable tr").filter(function() { $(this).toggle($(this).text().toLowerCase().indexOf(v) > -1) });
            });
        });
    </script>
}
