@model IEnumerable<EasyEdu.Models.TimeTable>
@{
    ViewData["Title"] = "Institutional Course Routine";
    Layout = "_Layout";
    var days = new[] { "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday" };
}

<div class="page-header d-flex justify-content-between align-items-center mb-4 px-4">
    <div>
        <h1 class="page-title animate-slide-in"><i class="fas fa-calendar-alt me-2 text-primary"></i> Academic Routine</h1>
        <p class="text-muted fw-600">Chronological distribution of institutional course engagements and resource allocation</p>
    </div>
    <div class="d-flex gap-2">
        <button onclick="window.print()" class="btn btn-premium-light rounded-12 px-4 shadow-sm fw-800 border">
            <i class="fas fa-print me-2"></i> PRINT ROUTINE
        </button>
    </div>
</div>

<div class="container-fluid px-4 pb-5">
    <div class="premium-card bg-white shadow-xl border-0 rounded-24 overflow-hidden mb-4 p-4 animate-fade-in">
        <form method="get" class="row g-3 align-items-end">
            <div class="col-md-4">
                <label class="form-label small fw-800 text-muted">TARGET CLASS</label>
                <select name="classId" class="form-select rounded-12 border-0 bg-light fw-700" asp-items="ViewBag.Classes">
                    <option value="">Select Academic Level</option>
                </select>
            </div>
            <div class="col-md-4">
                <label class="form-label small fw-800 text-muted">SECTION</label>
                <select name="sectionId" class="form-select rounded-12 border-0 bg-light fw-700">
                    <option value="">Select Section</option>
                </select>
            </div>
            <div class="col-md-4">
                <button type="submit" class="btn btn-premium-primary w-100 rounded-12 fw-800">
                    <i class="fas fa-sync-alt me-2"></i> REFRESH ROUTINE
                </button>
            </div>
        </form>
    </div>

    @foreach (var day in days)
    {
        var scheduleForDay = Model.Where(m => m.DayOfWeek.Equals(day, StringComparison.OrdinalIgnoreCase)).OrderBy(m => m.StartTime).ToList();
        
        <div class="day-block mb-5 animate-fade-in">
            <h5 class="fw-900 text-primary mb-4 spacing-1 text-uppercase d-flex align-items-center">
                <i class="fas fa-clock me-2 opacity-50"></i> @day
                <span class="ms-3 flex-grow-1 border-bottom opacity-25"></span>
            </h5>
            
            <div class="row g-4">
                @foreach (var routine in scheduleForDay)
                {
                    <div class="col-md-6 col-xl-3">
                        <div class="premium-card bg-white border shadow-sm p-4 rounded-20 hover-lift transition-all">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <div class="time-stamp badge bg-primary-soft text-primary fw-900 rounded-pill px-3 py-2">
                                    @DateTime.Today.Add(routine.StartTime).ToString("hh:mm tt") - @DateTime.Today.Add(routine.EndTime).ToString("hh:mm tt")
                                </div>
                            </div>
                            <h6 class="fw-900 text-dark mb-2">@routine.Subject?.Name</h6>
                            <div class="d-flex align-items-center mb-3">
                                <div class="avatar-xs bg-light rounded-circle d-flex align-items-center justify-content-center border me-2" style="width: 24px; height: 24px;">
                                    <i class="fas fa-user-tie text-muted" style="font-size: 10px;"></i>
                                </div>
                                <span class="small fw-700 text-muted">@routine.Teacher?.FullName</span>
                            </div>
                            <div class="bg-light p-3 rounded-12 d-flex justify-content-between align-items-center">
                                <span class="small fw-800 text-primary uppercase">ROOM @routine.ClassRoom?.RoomNo</span>
                                <i class="fas fa-door-open text-muted opacity-50"></i>
                            </div>
                        </div>
                    </div>
                }
                @if (!scheduleForDay.Any())
                {
                    <div class="col-12">
                        <div class="p-4 bg-light border-dashed rounded-20 text-center">
                            <span class="text-muted small fw-800 italic">No academic engagements scheduled for @day</span>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>

<style>
    .bg-primary-soft { background: rgba(99,102,241,0.1); }
    .rounded-20 { border-radius: 20px; }
    .spacing-1 { letter-spacing: 1px; }
    .border-dashed { border: 2px dashed #e2e8f0; }
    .hover-lift:hover { transform: translateY(-5px); box-shadow: 0 10px 15px -3px rgba(0,0,0,0.1) !important; border-color: #6366f1 !important; }
</style>
