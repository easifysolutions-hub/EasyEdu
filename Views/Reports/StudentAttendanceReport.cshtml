@model IEnumerable<EasyEdu.Models.Attendance>
@{
    ViewData["Title"] = "Student Attendance Report";
    Layout = "_Layout";
}

<div class="page-header d-flex justify-content-between align-items-center mb-4 px-4">
    <div>
        <h1 class="page-title animate-slide-in"><i class="fas fa-user-check me-2 text-primary"></i> Attendance Analytics</h1>
        <p class="text-muted fw-600">Comprehensive overview of student presence and institutional engagement</p>
    </div>
    <div class="d-flex gap-2">
        <button onclick="window.print()" class="btn btn-premium-light rounded-12 px-4 shadow-sm fw-800 border">
            <i class="fas fa-file-export me-2"></i> EXPORT REPORT
        </button>
    </div>
</div>

<div class="container-fluid px-4">
    <div class="premium-card bg-white shadow-xl border-0 rounded-24 overflow-hidden mb-4 p-4 animate-fade-in">
        <form method="get" class="row g-3 align-items-end">
            <div class="col-md-3">
                <label class="form-label small fw-800 text-muted">ACADEMIC CLASS</label>
                <select name="classId" class="form-select rounded-12 border-0 bg-light fw-700" asp-items="ViewBag.Classes">
                    <option value="">All Classes</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-800 text-muted">SECTION</label>
                <select name="sectionId" class="form-select rounded-12 border-0 bg-light fw-700" asp-items="ViewBag.Sections">
                    <option value="">All Sections</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-800 text-muted">SPECIFIC DATE</label>
                <input type="date" name="date" class="form-control rounded-12 border-0 bg-light fw-700">
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-premium-primary w-100 rounded-12 fw-800">
                    <i class="fas fa-search me-2"></i> DATA
                </button>
            </div>
            <div class="col-md-3">
                <div class="search-box position-relative">
                    <i class="fas fa-search position-absolute top-50 start-0 translate-middle-y ms-3 text-muted"></i>
                    <input type="text" class="form-control rounded-pill ps-5 border-0 bg-light" id="studentSearch" placeholder="Quick search students...">
                </div>
            </div>
        </form>
    </div>

    <script>
        document.getElementById('studentSearch')?.addEventListener('keyup', function() {
            const v = this.value.toLowerCase();
            const rows = document.querySelectorAll('tbody tr');
            rows.forEach(row => {
                row.style.display = row.innerText.toLowerCase().includes(v) ? '' : 'none';
            });
        });
    </script>

    <div class="premium-card bg-white shadow-xl border-0 rounded-24 overflow-hidden animate-fade-in">
        <div class="table-responsive">
            <table class="table premium-table mb-0">
                <thead>
                    <tr>
                        <th class="ps-4">STUDENT IDENTITY</th>
                        <th>CLASS / SECTION</th>
                        <th>SESSION DATE</th>
                        <th>ENGAGEMENT STATUS</th>
                        <th class="text-end pe-4">METHOD</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr class="align-middle">
                            <td class="ps-4">
                                <div class="fw-800 text-dark">@item.Student.FirstName @item.Student.LastName</div>
                                <div class="small text-muted fw-600">ID: @item.Student.AdmissionNumber</div>
                            </td>
                            <td>
                                <div class="badge bg-light text-dark fw-700 rounded-pill px-3 py-2 border">
                                    @item.Student.Class?.Name - @item.Student.Section?.Name
                                </div>
                            </td>
                            <td>
                                <div class="fw-700 text-dark">@item.Date.ToString("dd MMM yyyy")</div>
                            </td>
                            <td>
                                @if (item.Status == "Present")
                                {
                                    <span class="badge bg-success-soft text-success fw-800 px-3 py-2 rounded-pill">
                                        <i class="fas fa-check-circle me-1"></i> PRESENT
                                    </span>
                                }
                                else if (item.Status == "Absent")
                                {
                                    <span class="badge bg-danger-soft text-danger fw-800 px-3 py-2 rounded-pill">
                                        <i class="fas fa-times-circle me-1"></i> ABSENT
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-warning-soft text-warning fw-800 px-3 py-2 rounded-pill">
                                        <i class="fas fa-clock me-1"></i> @item.Status.ToUpper()
                                    </span>
                                }
                            </td>
                            <td class="text-end pe-4">
                                <code class="small fw-800 text-primary">@item.AttendanceMethod?.ToUpper()</code>
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="5" class="text-center py-5">
                                <i class="fas fa-calendar-times fa-3x text-muted opacity-25 mb-4 d-block"></i>
                                <h5 class="fw-800 text-muted">No attendance logs found for the selected criteria.</h5>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<style>
    .bg-success-soft { background: rgba(16, 185, 129, 0.1); }
    .bg-danger-soft { background: rgba(239, 68, 68, 0.1); }
    .bg-warning-soft { background: rgba(245, 158, 11, 0.1); }
</style>
