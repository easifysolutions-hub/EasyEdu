@model IEnumerable<EasyEdu.Models.Student>
@{
    ViewData["Title"] = "Background Heritage Report";
    Layout = "_Layout";
}

<div class="page-header d-flex justify-content-between align-items-center mb-4 px-4">
    <div>
        <h1 class="page-title animate-slide-in"><i class="fas fa-history me-2 text-primary"></i> Previous Records</h1>
        <p class="text-muted fw-600">Verification trail of student academic backgrounds and heritage institutions</p>
    </div>
    <div class="d-flex gap-2">
        <button onclick="window.print()" class="btn btn-premium-light rounded-12 px-4 shadow-sm fw-800 border">
            <i class="fas fa-file-contract me-2"></i> VERIFICATION REPORT
        </button>
    </div>
</div>

<div class="container-fluid px-4 pb-5">
    <div class="premium-card bg-white shadow-xl border-0 rounded-24 overflow-hidden mb-4 p-4 animate-fade-in">
        <form method="get" class="row g-3 align-items-end">
            <div class="col-md-6">
                <label class="form-label small fw-800 text-muted uppercase">Academic Level Filter</label>
                <select name="classId" class="form-select rounded-12 border-0 bg-light fw-700" asp-items="ViewBag.Classes">
                    <option value="">All Academic Levels</option>
                </select>
            </div>
            <div class="col-md-3">
                <button type="submit" class="btn btn-premium-primary w-100 rounded-12 fw-800">
                    <i class="fas fa-search me-2"></i> FILTER REGISTRY
                </button>
            </div>
            <div class="col-md-3">
                <div class="search-box position-relative">
                    <i class="fas fa-search position-absolute top-50 start-0 translate-middle-y ms-3 text-muted"></i>
                    <input type="text" class="form-control rounded-pill ps-5 border-0 bg-light" id="recordSearch" placeholder="Search by name or school...">
                </div>
            </div>
        </form>
    </div>

    <div class="premium-card bg-white shadow-xl border-0 rounded-24 overflow-hidden animate-fade-in">
        <div class="p-4 border-bottom bg-light">
            <h6 class="fw-800 text-dark mb-0 uppercase">Student Heritage Registry</h6>
        </div>

        <div class="table-responsive">
            <table class="table premium-table mb-0">
                <thead>
                    <tr>
                        <th class="ps-4">STUDENT IDENTITY</th>
                        <th>CURRENT CLASS</th>
                        <th>LEGACY INSTITUTION DETAILS</th>
                        <th class="text-end pe-4">ADMISSION STATUS</th>
                    </tr>
                </thead>
                <tbody id="recordTable">
                    @foreach (var student in Model)
                    {
                        <tr class="align-middle">
                            <td class="ps-4">
                                <div class="d-flex align-items-center">
                                    <div class="avatar-sm bg-primary-soft text-primary rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 36px; height: 36px; font-weight: 800;">
                                        @(student.FirstName?[0] ?? '?')
                                    </div>
                                    <div>
                                        <div class="fw-800 text-dark">@student.FirstName @student.LastName</div>
                                        <div class="small text-muted fw-600">SID: @student.AdmissionNumber</div>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <div class="badge bg-light text-dark fw-700 rounded-pill px-3 py-2 border">
                                    CLASS @student.Class?.Name
                                </div>
                            </td>
                            <td style="max-width: 400px;">
                                <div class="p-3 bg-light rounded-16">
                                    <p class="small fw-700 text-dark mb-0 italic">"@student.PreviousSchoolDetails"</p>
                                </div>
                            </td>
                            <td class="text-end pe-4">
                                <span class="badge bg-primary-soft text-primary fw-800 px-3 py-2 rounded-pill">
                                    VERIFIED BACKGROUND
                                </span>
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="4" class="text-center py-5">
                                <i class="fas fa-scroll fa-3x text-muted opacity-25 mb-4 d-block"></i>
                                <h5 class="fw-800 text-muted">No external academic records found in the institutional registry.</h5>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<style>
    .bg-primary-soft { background: rgba(99,102,241,0.1); }
    .rounded-16 { border-radius: 16px; }
</style>

@section Scripts {
    <script>
        $(document).ready(function() {
            $("#recordSearch").on("keyup", function() {
                var v = $(this).val().toLowerCase();
                $("#recordTable tr").filter(function() { $(this).toggle($(this).text().toLowerCase().indexOf(v) > -1) });
            });
        });
    </script>
}
