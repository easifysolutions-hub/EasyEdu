@model IEnumerable<EasyEdu.Models.Teacher>
@{
    ViewData["Title"] = "Institutional Personnel Registry";
    Layout = "_Layout";
}

<div class="content-wrapper p-4 animate-fade-in">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="page-title mb-1">Institutional Staff Report</h3>
            <p class="text-muted small fw-600">Comprehensive summary of faculty and organizational personnel</p>
        </div>
        <div class="no-print">
            <button class="btn btn-premium-dark btn-sm rounded-8" onclick="window.print()">
                <i class="fas fa-file-pdf me-2"></i>GENERATE PDF
            </button>
        </div>
    </div>

    <div class="premium-card p-4 mb-4 no-print">
        <form method="get" class="row g-3 align-items-end">
            <div class="col-md-5">
                <label class="form-label small fw-800 text-uppercase opacity-50">Department</label>
                <select name="departmentId" class="form-select form-control-premium" asp-items="ViewBag.Departments">
                    <option value="">All Departments</option>
                </select>
            </div>
            <div class="col-md-5">
                <label class="form-label small fw-800 text-uppercase opacity-50">Designation</label>
                <select name="designationId" class="form-select form-control-premium" asp-items="ViewBag.Designations">
                    <option value="">All Designations</option>
                </select>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-premium-primary w-100">FILTER</button>
            </div>
        </form>
    </div>

    <div class="premium-card border-0 shadow-lg" style="border-radius: 20px; overflow: hidden;">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table premium-table mb-0 align-middle">
                    <thead class="bg-dark text-white">
                        <tr>
                            <th class="px-4 py-3">STAFF MEMBER</th>
                            <th>DESIGNATION</th>
                            <th>DEPARTMENT</th>
                            <th>EMAIL</th>
                            <th class="text-center">JOINING DATE</th>
                            <th class="text-end px-4">STATUS</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var s in Model)
                        {
                            <tr>
                                <td class="px-4">
                                    <div class="d-flex align-items-center">
                                        <img src="@(string.IsNullOrEmpty(s.ProfilePicture) ? "https://ui-avatars.com/api/?name=" + s.FirstName + "+" + s.LastName : s.ProfilePicture)" 
                                             class="rounded-circle me-3" style="width: 45px; height: 45px; object-fit: cover; border: 2px solid #f1f5f9;">
                                        <div>
                                            <div class="fw-900 text-dark">@s.FullName</div>
                                            <div class="small text-muted fw-700">@s.Phone</div>
                                        </div>
                                    </div>
                                </td>
                                <td><span class="badge border border-primary text-primary px-3 rounded-pill">@s.Designation?.Title</span></td>
                                <td class="fw-800 text-muted">@s.Department?.Name</td>
                                <td class="small fw-700">@s.Email</td>
                                <td class="text-center fw-600">@s.JoiningDate.ToString("MMM dd, yyyy")</td>
                                <td class="text-end px-4">
                                    <span class="badge @(s.IsActive ? "bg-success" : "bg-danger") rounded-pill px-3">
                                        @(s.IsActive ? "ACTIVE" : "INACTIVE")
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<style>
    .premium-table thead th { border: none !important; font-size: 0.75rem; letter-spacing: 0.05em; text-transform: uppercase; }
    .premium-table tbody tr:hover { background-color: #f8fafc; transition: 0.3s; }
    @@media print { .no-print { display: none !important; } }
</style>
