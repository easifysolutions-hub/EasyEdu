@model IEnumerable<EasyEdu.Models.WalletTransaction>
@{
    ViewData["Title"] = "Student Wallet Intelligence";
    Layout = "_Layout";
}

<div class="content-wrapper p-4 animate-fade-in text-dark">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="page-title mb-1 fw-900">Wallet Transaction Report</h3>
            <p class="text-muted small fw-600">Archival of all internal credit deposits, expenditures, and refunds</p>
        </div>
        <div class="no-print">
            <button class="btn btn-premium-purple btn-sm rounded-8" onclick="window.print()">
                <i class="fas fa-wallet me-2"></i>PRINT STATEMENT
            </button>
        </div>
    </div>

    <div class="premium-card p-4 mb-4 no-print text-dark">
        <form method="get" class="row g-3 align-items-end">
            <div class="col-md-5">
                <label class="form-label small fw-800 text-uppercase opacity-50">Filter by Student</label>
                <select name="studentId" class="form-select form-control-premium fw-700 text-dark" asp-items="ViewBag.Students">
                    <option value="">All Individual Wallets</option>
                </select>
            </div>
            <div class="col-md-5">
                <label class="form-label small fw-800 text-uppercase opacity-50">Transaction Nature</label>
                <select name="type" class="form-select form-control-premium fw-700 text-dark">
                    <option value="">All Transactions</option>
                    <option value="Deposit">Credit Deposits</option>
                    <option value="Expense">Wallet Expenditures</option>
                    <option value="Refund">Account Refunds</option>
                </select>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-premium-purple w-100">AUDIT</button>
            </div>
        </form>
    </div>

    <div class="row mb-4">
        <div class="col-md-4">
            <div class="premium-card p-4 bg-gradient-blue text-white border-0 shadow-lg" style="border-radius: 20px;">
                <div class="small fw-800 text-uppercase mb-2 opacity-75">Total Net Volume</div>
                <h2 class="fw-900 mb-0">@Model.Sum(t => t.TransactionType == "Deposit" ? t.Amount : -t.Amount).ToString("C")</h2>
                <div class="mt-2 small fw-600 opacity-50 italic">Aggregated liquidity in system</div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="premium-card p-4 bg-white shadow-sm border-0 h-100" style="border-radius: 20px;">
                <div class="small fw-800 text-uppercase mb-1 text-muted">Total Deposits</div>
                <h3 class="fw-900 mb-0 text-success">@Model.Where(t => t.TransactionType == "Deposit").Sum(t => t.Amount).ToString("C")</h3>
                <div class="small fw-700 text-muted opacity-25">Institutional Inflow</div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="premium-card p-4 bg-white shadow-sm border-0 h-100" style="border-radius: 20px;">
                <div class="small fw-800 text-uppercase mb-1 text-muted">Total Refunding</div>
                <h3 class="fw-900 mb-0 text-danger">@Model.Where(t => t.TransactionType == "Refund").Sum(t => t.Amount).ToString("C")</h3>
                <div class="small fw-700 text-muted opacity-25">Institutional Outflow</div>
            </div>
        </div>
    </div>

    <div class="premium-card border-0 shadow-sm overflow-hidden" style="border-radius: 20px;">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table premium-table mb-0 align-middle">
                    <thead class="bg-premium-dark text-white">
                        <tr>
                            <th class="px-4 py-3">TRANS DATE</th>
                            <th>STUDENT OWNER</th>
                            <th>TYPE</th>
                            <th>METHOD</th>
                            <th class="text-center">STATUS</th>
                            <th class="text-end px-4">TRANSACTION AMOUNT</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var t in Model)
                        {
                            <tr>
                                <td class="px-4 fw-800">
                                    <div class="text-dark">@t.Date.ToString("dd MMM yyyy")</div>
                                    <div class="small text-muted opacity-50">@t.Date.ToString("hh:mm tt")</div>
                                </td>
                                <td>
                                    <div class="fw-900 text-dark">@t.Student?.FullName</div>
                                    <div class="small text-muted fw-700">Ref: @t.ReferenceNumber</div>
                                </td>
                                <td>
                                    @{
                                        var typeClass = t.TransactionType == "Deposit" ? "bg-success-soft text-success" : 
                                                        t.TransactionType == "Refund" ? "bg-danger-soft text-danger" : "bg-warning-soft text-warning";
                                    }
                                    <span class="badge @typeClass px-3 rounded-pill fw-800 uppercase">@t.TransactionType</span>
                                </td>
                                <td class="fw-700 text-muted">@t.PaymentMethod</td>
                                <td class="text-center">
                                    <span class="badge @(t.Status == "Approved" ? "bg-success" : "bg-warning") rounded-pill px-2">@t.Status.ToUpper()</span>
                                </td>
                                <td class="text-end px-4">
                                    <div class="fw-900 h6 mb-0 @(t.TransactionType == "Deposit" ? "text-success" : "text-danger")">
                                        @(t.TransactionType == "Deposit" ? "+" : "-") @t.Amount.ToString("C")
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<style>
    .bg-premium-dark { background: #1e293b; }
    .bg-success-soft { background: rgba(16, 185, 129, 0.1); }
    .bg-danger-soft { background: rgba(239, 68, 68, 0.1); }
    .bg-warning-soft { background: rgba(245, 158, 11, 0.1); }
    .bg-gradient-blue { background: linear-gradient(135deg, #3b82f6 0%, #1d4ed8 100%); }
    @@media print { .no-print { display: none !important; } }
</style>
