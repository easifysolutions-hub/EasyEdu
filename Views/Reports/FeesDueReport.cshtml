@model IEnumerable<EasyEdu.Models.FeesInvoice>
@{
    ViewData["Title"] = "Fees Due Report";
    Layout = "_Layout";
}

<div class="content-wrapper p-4 animate-fade-in">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="page-title mb-1 fw-900">Fees Due Report</h3>
            <p class="text-muted small fw-600">Archival of all pending invoices and outstanding student balances</p>
        </div>
        <div class="no-print">
            <button class="btn btn-premium-danger btn-sm rounded-8" onclick="printReport()">
                <i class="fas fa-print me-2"></i>PRINT REPORT
            </button>
        </div>
    </div>

    <div class="premium-card p-4 mb-4 no-print">
        <form method="get" class="row g-3 align-items-end">
            <div class="col-md-5">
                <label class="form-label small fw-800 text-uppercase opacity-50">Class</label>
                <select name="classId" class="form-select form-control-premium" asp-items="ViewBag.Classes">
                    <option value="">All Classes</option>
                </select>
            </div>
            <div class="col-md-5">
                <label class="form-label small fw-800 text-uppercase opacity-50">Due Date (Before)</label>
                <input type="date" name="dueDate" class="form-control form-control-premium">
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-premium-purple w-100">FETCH RECORDS</button>
            </div>
        </form>
    </div>

    <div class="row mb-4">
        <div class="col-md-4">
            <div class="premium-card p-4 bg-gradient-danger text-white border-0 shadow-lg" style="border-radius: 20px;">
                <div class="small fw-800 text-uppercase mb-2 opacity-75">Total Outstanding</div>
                <h2 class="fw-900 mb-0">@Model.Sum(i => i.TotalAmount - i.PaidAmount - i.TotalWaiver).ToString("C")</h2>
                <div class="mt-2 small fw-600 opacity-50 italic">Aggregated across @Model.Count() pending invoices</div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="premium-card p-4 bg-gradient-dark text-white border-0 shadow-lg" style="border-radius: 20px;">
                <div class="small fw-800 text-uppercase mb-2 opacity-75">Overdue Count</div>
                <h2 class="fw-900 mb-0">@Model.Count(i => i.DueDate < DateTime.Now)</h2>
                <div class="mt-2 small fw-600 opacity-50 italic">Invoices past their due date period</div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="premium-card p-4 bg-white text-dark shadow-sm border-0" style="border-radius: 20px;">
                <div class="small fw-800 text-uppercase mb-2 text-muted">Awaiting Payment</div>
                <h2 class="fw-900 mb-0 text-premium-purple">@Model.Count(i => i.Status == "Unpaid")</h2>
                <div class="mt-2 small fw-600 text-muted opacity-50">Fully unpaid fresh invoices</div>
            </div>
        </div>
    </div>

    <div class="premium-card border-0 shadow-sm overflow-hidden" style="border-radius: 20px;">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table premium-table mb-0 align-middle">
                    <thead class="bg-dark text-white">
                        <tr>
                            <th class="px-4 py-3">INVOICE #</th>
                            <th>STUDENT</th>
                            <th>CLASS</th>
                            <th class="text-center">DUE DATE</th>
                            <th class="text-center">TOTAL</th>
                            <th class="text-center">PAID</th>
                            <th class="text-end px-4">BALANCE</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var i in Model)
                        {
                            var balance = i.TotalAmount - i.PaidAmount - i.TotalWaiver;
                            <tr class="@(i.DueDate < DateTime.Now ? "bg-danger-soft-tr" : "")">
                                <td class="px-4">
                                    <div class="fw-900 text-dark">@i.InvoiceNumber</div>
                                    <div class="small text-muted fw-700">@i.Date.ToString("dd MMM yyyy")</div>
                                </td>
                                <td>
                                    <div class="fw-800 text-dark">@i.Student?.FullName</div>
                                    <div class="small text-muted fw-600">ID: @i.StudentId</div>
                                </td>
                                <td class="fw-700">@i.Student?.Class?.Name</td>
                                <td class="text-center">
                                    <span class="badge @(i.DueDate < DateTime.Now ? "bg-danger" : "bg-warning") rounded-pill px-3">
                                        @i.DueDate.ToString("dd MMM yyyy")
                                    </span>
                                </td>
                                <td class="text-center fw-600 text-muted">@i.TotalAmount.ToString("C")</td>
                                <td class="text-center fw-600 text-success">@i.PaidAmount.ToString("C")</td>
                                <td class="text-end px-4 fw-900 text-danger h6 mb-0">@balance.ToString("C")</td>
                            </tr>
                        }
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="7" class="text-center py-5">
                                    <div class="opacity-20 mb-3"><i class="fas fa-check-circle fa-4x text-success"></i></div>
                                    <h5 class="fw-800 text-muted italic">Great! No pending dues found.</h5>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<style>
    .bg-danger-soft-tr { background-color: rgba(239, 68, 68, 0.05); }
    .bg-gradient-danger { background: linear-gradient(135deg, #ef4444 0%, #b91c1c 100%); }
    .bg-gradient-dark { background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%); }
    @@media print { .no-print { display: none !important; } }
</style>
<script>
    function printReport() { window.print(); }
</script>
