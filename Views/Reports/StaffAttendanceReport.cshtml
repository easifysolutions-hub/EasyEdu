@model IEnumerable<EasyEdu.Models.TeacherAttendance>
@{
    ViewData["Title"] = "Staff Attendance Archive";
    Layout = "_Layout";
}

<div class="content-wrapper p-4 animate-fade-in">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="page-title mb-1">Staff Attendance Report</h3>
            <p class="text-muted small fw-600">Daily archival of faculty and personnel attendance status</p>
        </div>
        <div class="no-print">
            <button class="btn btn-premium-primary btn-sm rounded-8" onclick="window.print()">
                <i class="fas fa-print me-2"></i>PRINT REPORT
            </button>
        </div>
    </div>

    <div class="premium-card p-4 mb-4 no-print">
        <form method="get" class="row g-3 align-items-end">
            <div class="col-md-4">
                <label class="form-label small fw-800 text-uppercase opacity-50">Attendance Date</label>
                <input type="date" name="date" class="form-control form-control-premium" value="@(((DateTime)ViewBag.Date).ToString("yyyy-MM-dd"))" required>
            </div>
            <div class="col-md-4">
                <label class="form-label small fw-800 text-uppercase opacity-50">Department</label>
                <select name="departmentId" class="form-select form-control-premium" asp-items="ViewBag.Departments">
                    <option value="">All Departments</option>
                </select>
            </div>
            <div class="col-md-4">
                <button type="submit" class="btn btn-premium-purple w-100">FETCH RECORDS</button>
            </div>
        </form>
    </div>

    <div class="premium-card border-0 shadow-sm overflow-hidden">
        <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
            <h5 class="mb-0 fw-800 text-dark">DATE: @(((DateTime)ViewBag.Date).ToString("MMMM dd, yyyy"))</h5>
            <div class="attendance-summary d-flex gap-3">
                <span class="badge bg-success-soft text-success px-3 rounded-pill">P: @Model.Count(a => a.Status == "Present")</span>
                <span class="badge bg-danger-soft text-danger px-3 rounded-pill">A: @Model.Count(a => a.Status == "Absent")</span>
                <span class="badge bg-warning-soft text-warning px-3 rounded-pill">L: @Model.Count(a => a.Status == "Late")</span>
            </div>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table premium-table mb-0">
                    <thead>
                        <tr>
                            <th class="px-4">STAFF NAME</th>
                            <th>DEPARTMENT</th>
                            <th class="text-center">STATUS</th>
                            <th class="px-4 text-end">REMARKS</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var a in Model)
                        {
                            <tr>
                                <td class="px-4">
                                    <div class="d-flex align-items-center">
                                        <div class="avatar-sm me-3 bg-light rounded-circle d-flex align-items-center justify-content-center text-primary fw-900">
                                            @a.Teacher.FullName.Substring(0,1)
                                        </div>
                                        <div>
                                            <div class="fw-800 text-dark">@a.Teacher.FullName</div>
                                            <div class="small text-muted fw-600">ID: @a.Teacher.Id</div>
                                        </div>
                                    </div>
                                </td>
                                <td class="fw-700 text-muted">@a.Teacher.Department?.Name</td>
                                <td class="text-center">
                                    @{
                                        var badgeClass = a.Status switch {
                                            "Present" => "bg-success-soft text-success",
                                            "Absent" => "bg-danger-soft text-danger",
                                            "Late" => "bg-warning-soft text-warning",
                                            _ => "bg-secondary-soft text-secondary"
                                        };
                                    }
                                    <span class="badge @badgeClass px-3 rounded-pill fw-800">@a.Status.ToUpper()</span>
                                </td>
                                <td class="px-4 text-end small italic text-muted">@a.Remarks</td>
                            </tr>
                        }
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="4" class="text-center py-5">
                                    <i class="fas fa-clipboard-question fa-3x text-muted opacity-20 mb-3"></i>
                                    <h5 class="fw-800 text-muted">No attendance records found for this date.</h5>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<style>
    .bg-success-soft { background: rgba(34, 197, 94, 0.1); }
    .bg-danger-soft { background: rgba(239, 68, 68, 0.1); }
    .bg-warning-soft { background: rgba(234, 179, 8, 0.1); }
    .bg-secondary-soft { background: rgba(100, 116, 139, 0.1); }
    .avatar-sm { width: 40px; height: 40px; }
    @@media print { .no-print { display: none !important; } }
</style>
