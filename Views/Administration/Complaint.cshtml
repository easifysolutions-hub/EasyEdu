@model IEnumerable<EasyEdu.Models.Complaint>
@{
    ViewData["Title"] = "Customer Experience";
    Layout = "_Layout";
}

<div class="page-header d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="page-title animate-slide-in">Grievance & Resolution Hub</h1>
        <p class="text-muted fw-600">Documenting feedback and ensuring rapid institutional accountability</p>
    </div>
    <div class="d-flex gap-3">
        <button class="btn-premium btn-premium-primary animate-fade-in shadow-lg" onclick="toggleForm()">
            <i class="fas fa-bullhorn"></i> Lodge New Grievance
        </button>
    </div>
</div>

<div class="row g-4 mb-5">
    <div class="col-xl-3 col-md-6">
        <div class="premium-card bg-white p-4 shadow-sm border-start border-4 border-info">
            <div class="small fw-800 text-muted uppercase mb-1">Active Cases</div>
            <div class="h3 fw-900 text-dark mb-0">@Model.Count(c => string.IsNullOrEmpty(c.ActionTaken))</div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6">
        <div class="premium-card bg-white p-4 shadow-sm border-start border-4 border-success">
            <div class="small fw-800 text-muted uppercase mb-1">Resolved</div>
            <div class="h3 fw-900 text-success mb-0">@Model.Count(c => !string.IsNullOrEmpty(c.ActionTaken))</div>
        </div>
    </div>
</div>

<div class="row g-4">
    <!-- Action Form -->
    <div class="col-xl-4 d-none" id="formColumn">
        <div class="premium-card bg-white shadow-lg animate-fade-in">
            <div class="p-4 border-bottom d-flex justify-content-between align-items-center bg-light">
                <h5 class="fw-800 text-dark mb-0">File Formal Complaint</h5>
                <button class="btn btn-sm btn-light rounded-circle" onclick="toggleForm()"><i class="fas fa-times"></i></button>
            </div>
            <div class="p-4">
                <form asp-action="CreateComplaint" method="post">
                    <div class="mb-3">
                        <label class="form-label fw-700 text-muted small uppercase">Complainant Identity</label>
                        <input type="text" name="ComplaintBy" class="form-control border-2 fw-700" placeholder="e.g. Parent Name" required />
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-6">
                            <label class="form-label fw-700 text-muted small uppercase">Contact Phone</label>
                            <input type="tel" name="Phone" class="form-control border-2" placeholder="+1..." required />
                        </div>
                        <div class="col-6">
                            <label class="form-label fw-700 text-muted small uppercase">Classification</label>
                            <select name="ComplaintType" class="form-select border-2 fw-700" asp-items="@(new SelectList(ViewBag.ComplaintTypes, "Name", "Name"))">
                                <option value="">-- Select Type --</option>
                            </select>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-700 text-muted small uppercase">Core Complaint / Grievance</label>
                        <textarea name="Description" class="form-control border-2" rows="3" placeholder="Full details of the issue..." required></textarea>
                    </div>
                    <div class="mb-4">
                        <label class="form-label fw-700 text-muted small uppercase">Assigned Resolution Officer</label>
                        <input type="text" name="AssignedTo" class="form-control border-2" placeholder="Facility Manager / Academic Head" />
                    </div>
                    <button type="submit" class="btn-premium btn-premium-primary w-100 py-3 shadow-md">
                        <i class="fas fa-gavel me-2"></i> Register Case
                    </button>
                </form>
            </div>
        </div>
    </div>

    <!-- Grievance Ledger -->
    <div class="col-xl-12" id="listColumn">
        <div class="premium-card bg-white shadow-sm border-0 overflow-hidden animate-fade-in">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light">
                        <tr>
                            <th class="ps-4 py-3 fw-800 text-muted small uppercase">Case Identity</th>
                            <th class="py-3 fw-800 text-muted small uppercase">Grievance Detail</th>
                            <th class="py-3 fw-800 text-muted small uppercase">Assigned Strategy</th>
                            <th class="py-3 fw-800 text-muted small uppercase">Status</th>
                            <th class="pe-4 py-3 fw-800 text-muted small uppercase text-end">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var c in Model)
                        {
                            <tr>
                                <td class="ps-4">
                                    <div class="fw-800 text-dark">@c.ComplaintBy</div>
                                    <div class="small text-muted fw-700 opacity-75">@c.Phone</div>
                                    <div class="small text-muted fw-600 mt-1">Ref: #TC-@c.Id.ToString("D4")</div>
                                </td>
                                <td>
                                    <div class="fw-700 text-dark line-clamp-1" style="max-width: 300px;">@c.Description</div>
                                    <div class="small text-primary fw-700 uppercase" style="font-size: 0.65rem;">CAT: @(c.ComplaintType ?? "General")</div>
                                </td>
                                <td>
                                    <div class="fw-800 text-dark">@(c.AssignedTo ?? "UNASSIGNED")</div>
                                    <div class="small text-muted fw-600">Action: @(string.IsNullOrEmpty(c.ActionTaken) ? "Awaiting Response" : c.ActionTaken)</div>
                                </td>
                                <td>
                                    @if(string.IsNullOrEmpty(c.ActionTaken)) {
                                        <span class="badge bg-danger-soft text-danger border border-danger-light fw-800 px-3 py-2 rounded-12 shadow-sm animate-pulse-soft">OPEN CASE</span>
                                    } else {
                                        <span class="badge bg-success-soft text-success border border-success-light fw-800 px-3 py-2 rounded-12">RESOLVED</span>
                                    }
                                </td>
                                <td class="pe-4 text-end">
                                    <div class="d-flex gap-2 justify-content-end">
                                        <button class="btn btn-light btn-sm text-info border-0 rounded-circle" style="width: 32px; height: 32px;" title="Update Action">
                                            <i class="fas fa-edit small"></i>
                                        </button>
                                        <a asp-action="DeleteComplaint" asp-route-id="@c.Id" class="btn btn-light btn-sm text-danger border-0 rounded-circle" style="width: 32px; height: 32px;" onclick="return confirm('Archive this case?')">
                                            <i class="fas fa-trash small"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        
        @if (!Model.Any())
        {
            <div class="text-center py-5">
                <i class="fas fa-thumbs-up fa-4x text-gray-100 mb-3"></i>
                <h4 class="text-muted fw-700">Zero active grievances found.</h4>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        function toggleForm() {
            const formCol = document.getElementById('formColumn');
            const listCol = document.getElementById('listColumn');
            
            if(formCol.classList.contains('d-none')) {
                formCol.classList.remove('d-none');
                listCol.classList.replace('col-xl-12', 'col-xl-8');
            } else {
                formCol.classList.add('d-none');
                listCol.classList.replace('col-xl-8', 'col-xl-12');
            }
        }
    </script>
}
