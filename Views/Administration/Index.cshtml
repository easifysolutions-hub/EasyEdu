<!-- Necessary Modals (Moved from previous but kept for functionality) -->
<div class="modal fade" id="addTodoModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 rounded-16">
            <div class="modal-header bg-primary text-white p-4">
                <h5 class="modal-title fw-800">Assign New Task</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="AddToDo" method="post">
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label fw-700 small text-uppercase">Task Title</label>
                        <input type="text" name="title" class="form-control form-control-premium" required placeholder="e.g. Schedule meeting">
                    </div>
                </div>
                <div class="modal-footer border-0 p-4 pt-0">
                    <button type="submit" class="btn btn-premium-primary w-100">SAVE TASK</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="addEventModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 rounded-16 overflow-hidden">
            <div class="modal-header text-white p-4" style="background: #7c3aed;">
                <h5 class="modal-title fw-800" id="addEventModalLabel">Add Event</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="AddCalendarEvent" method="post">
                <div class="modal-body p-4">
                    <input type="hidden" id="eventDateInput" name="EventDate" />
                    <div class="row g-3">
                        <div class="col-md-6"><input type="text" name="EventTitle" class="form-control-premium w-100" placeholder="Event Title*" required></div>
                        <div class="col-md-6">
                            <select name="Role" class="form-select form-control-premium" required>
                                <option value="">Select Role*</option>
                                <option value="All">All</option>
                                <option value="Teacher">Teacher</option>
                                <option value="Student">Student</option>
                            </select>
                        </div>
                        <div class="col-12"><textarea name="Description" rows="3" class="form-control-premium w-100" placeholder="Description*"></textarea></div>
                    </div>
                </div>
                <div class="modal-footer border-0 p-4 pt-0">
                    <button type="submit" class="btn btn-premium-primary w-100">SAVE EVENT</button>
                </div>
            </form>
        </div>
    </div>
</div>

