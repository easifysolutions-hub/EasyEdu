@model EasyEdu.Models.OnlineExam
@{
    ViewData["Title"] = "Establish Online Evaluation";
    Layout = "_Layout";
}

<div class="content-wrapper p-4 animate-fade-in text-dark">
    <div class="d-flex justify-content-between align-items-center mb-5">
        <div>
            <h2 class="fw-900 text-dark mb-1">Establish Evaluation Node</h2>
            <p class="text-muted small fw-600">Architect a new digital examination cycle with specific curriculum parameters</p>
        </div>
        <a href="@Url.Action("OnlineExam")" class="btn btn-light-soft px-4 py-2 rounded-12 fw-700">
            <i class="fas fa-arrow-left me-2"></i>EVALUATION REGISTRY
        </a>
    </div>

    <div class="row justify-content-center">
        <div class="col-xl-8">
            <div class="premium-card p-5 border-0 shadow-lg" style="border-radius: 24px;">
                <form asp-action="CreateOnlineExam" method="post">
                    <div class="mb-4">
                        <label class="form-label small fw-800 text-uppercase opacity-50">Evaluation Title*</label>
                        <input name="Title" required class="form-control form-control-premium" placeholder="e.g. Physics Mid-Term Alpha">
                    </div>

                    <div class="row g-4 mb-4">
                        <div class="col-md-6">
                            <label class="form-label small fw-800 text-uppercase opacity-50">Curriculum Class</label>
                            <select name="ClassId" required class="form-select form-control-premium" asp-items="ViewBag.Classes"></select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-800 text-uppercase opacity-50">Subject Node</label>
                            <select name="SubjectId" required class="form-select form-control-premium" asp-items="ViewBag.Subjects"></select>
                        </div>
                    </div>

                    <div class="row g-4 mb-4">
                        <div class="col-md-6">
                            <label class="form-label small fw-800 text-uppercase opacity-50">Activation Date</label>
                            <input name="StartDate" type="date" required value="@DateTime.Now.ToString("yyyy-MM-dd")" class="form-control form-control-premium">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-800 text-uppercase opacity-50">Deactivation Date</label>
                            <input name="EndDate" type="date" required value="@DateTime.Now.AddDays(1).ToString("yyyy-MM-dd")" class="form-control form-control-premium">
                        </div>
                    </div>

                    <div class="row g-4 mb-4">
                        <div class="col-md-4">
                            <label class="form-label small fw-800 text-uppercase opacity-50">Chronology Start</label>
                            <input name="StartTime" type="time" required value="09:00" class="form-control form-control-premium">
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-800 text-uppercase opacity-50">Chronology End</label>
                            <input name="EndTime" type="time" required value="11:00" class="form-control form-control-premium">
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-800 text-uppercase opacity-50">Duration (Min)</label>
                            <input name="DurationMinutes" type="number" required value="120" class="form-control form-control-premium">
                        </div>
                    </div>

                    <div class="mb-5">
                        <label class="form-label small fw-800 text-uppercase opacity-50">Proficiency Threshold (%)</label>
                        <input name="PassPercentage" type="number" required value="33" class="form-control form-control-premium">
                    </div>

                    <div class="d-grid">
                        <button type="submit" class="btn btn-premium-purple py-3 rounded-16 fw-900 h6 mb-0 shadow-lg">INITIALIZE EVALUATION NODE</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<style>
    .rounded-16 { border-radius: 16px; }
    .btn-premium-purple { background: #8b5cf6; color: white; border: none; }
</style>
