@model EasyEdu.Models.OnlineExamSetting
@{
    ViewData["Title"] = "Evaluation Protocol Infrastructure";
    Layout = "_Layout";
}

<div class="content-wrapper p-4 animate-fade-in text-dark">
    <div class="d-flex justify-content-between align-items-center mb-5">
        <div>
            <h2 class="fw-900 text-dark mb-1">Evaluation Infrastructure Architect</h2>
            <p class="text-muted small fw-600">Configure global protocols and digital constraints for the online evaluation ecosystem</p>
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-xl-8">
            <div class="premium-card p-5 border-0 shadow-lg" style="border-radius: 24px;">
                <form asp-action="SaveSettings" method="post">
                    <input type="hidden" asp-for="Id" />
                    
                    <div class="protocol-node p-4 rounded-20 bg-light-soft mb-4 border d-flex align-items-center justify-content-between">
                        <div>
                            <h6 class="fw-900 text-dark mb-1">Negative Marking Protocol</h6>
                            <p class="smallest text-muted fw-700 m-0 text-uppercase ls-1">Deduct marks for incorrect response selection</p>
                        </div>
                        <div class="form-check form-switch p-0">
                            <input class="form-check-input ms-0" type="checkbox" asp-for="EnableNegativeMarking" style="width: 45px; height: 22px;">
                        </div>
                    </div>

                    <div class="protocol-node p-4 rounded-20 bg-light-soft mb-4 border d-flex align-items-center justify-content-between">
                        <div>
                            <h6 class="fw-900 text-dark mb-1">Instant Proficiency Disclosure</h6>
                            <p class="smallest text-muted fw-700 m-0 text-uppercase ls-1">Display evaluation results immediately upon submission</p>
                        </div>
                        <div class="form-check form-switch p-0">
                            <input class="form-check-input ms-0" type="checkbox" asp-for="ShowResultImmediately" style="width: 45px; height: 22px;">
                        </div>
                    </div>

                    <div class="protocol-node p-4 rounded-20 bg-light-soft mb-4 border d-flex align-items-center justify-content-between">
                        <div>
                            <h6 class="fw-900 text-dark mb-1">Retry Authorization</h6>
                            <p class="smallest text-muted fw-700 m-0 text-uppercase ls-1">Allow students to re-initiate the evaluation node</p>
                        </div>
                        <div class="form-check form-switch p-0">
                            <input class="form-check-input ms-0" type="checkbox" asp-for="AllowRetry" style="width: 45px; height: 22px;">
                        </div>
                    </div>

                    <div class="mb-5 p-4 rounded-20 bg-light-soft border">
                         <label class="form-label small fw-800 text-uppercase opacity-50 mb-3">Temporal Session Timeout (Minutes)</label>
                         <div class="d-flex align-items-center gap-3">
                             <input type="number" asp-for="SessionTimeoutMinutes" class="form-control form-control-premium w-25" value="30">
                             <span class="smallest text-muted fw-900 text-uppercase ls-1 italic">Node deactivation delay</span>
                         </div>
                    </div>

                    <div class="d-grid">
                        <button type="submit" class="btn btn-premium-purple py-3 rounded-16 fw-900 h6 mb-0 shadow-lg">SYNCHRONIZE INFRASTRUCTURE</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<style>
    .rounded-20 { border-radius: 20px; }
    .bg-light-soft { background: #f8fafc; }
    .ls-1 { letter-spacing: 1px; }
    .btn-premium-purple { background: #8b5cf6; color: white; border: none; }
</style>
