@model IEnumerable<EasyEdu.Models.WalletTransaction>
@{
    ViewData["Title"] = "Pending Deposits";
}

<div class="content-wrapper p-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-800 text-dark m-0" style="color: #4338ca !important;">Pending Deposits</h2>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0">
                    <li class="breadcrumb-item"><a href="@Url.Action("Index", "Administration")" class="text-decoration-none text-muted small">Dashboard</a></li>
                    <li class="breadcrumb-item text-muted small">Wallet</li>
                    <li class="breadcrumb-item active small" aria-current="page" style="color: #6366f1;">Pending Request</li>
                </ol>
            </nav>
        </div>
        <div>
             <a asp-action="Index" class="btn btn-light text-muted fw-700 shadow-sm border-0"><i class="fas fa-history me-2"></i> All Transactions</a>
        </div>
    </div>

    <!-- Filter Section (Optional Placeholder) -->
    <div class="card border-0 shadow-sm mb-4" style="border-radius: 12px;">
        <div class="card-body p-3">
             <form class="row g-3 align-items-center">
                <div class="col-md-4">
                    <div class="input-group">
                         <span class="input-group-text bg-light border-end-0"><i class="fas fa-search text-muted"></i></span>
                         <input type="text" class="form-control border-start-0 ps-0" placeholder="Search by name or number...">
                    </div>
                </div>
                 <div class="col-md-3">
                     <button type="button" class="btn btn-primary fw-700 w-100" style="background: linear-gradient(135deg, #4338ca 0%, #6366f1 100%); border:none;">SEARCH</button>
                 </div>
             </form>
        </div>
    </div>

    <!-- Data Table -->
    <div class="card border-0 shadow-sm" style="border-radius: 16px; overflow: hidden;">
        <div class="card-header border-0 py-3 px-4 d-flex align-items-center justify-content-between" style="background: white; border-bottom: 2px solid #f1f5f9 !important;">
            <h5 class="fw-700 m-0 text-dark">Deposit Requests</h5>
            <span class="badge bg-warning text-dark">@Model.Count() Pending</span>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light">
                        <tr class="text-uppercase small fw-700 text-muted">
                            <th class="px-4 py-3">Student Name</th>
                            <th class="py-3">Amount</th>
                            <th class="py-3">Date</th>
                            <th class="py-3">Method</th>
                            <th class="py-3">Proof</th>
                            <th class="py-3 text-end px-4">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="6" class="text-center py-5 text-muted">
                                    <i class="fas fa-check-circle fa-2x mb-3 text-success opacity-50"></i>
                                    <p class="m-0 fw-600">No pending deposits found.</p>
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="px-4">
                                        <div class="d-flex align-items-center">
                                            <div class="avatar-sm bg-primary-soft text-primary fw-800 rounded-circle me-3 d-flex align-items-center justify-content-center" style="width: 40px; height: 40px; background: #eef2ff;">
                                                @(item.Student?.FirstName.Substring(0,1))
                                            </div>
                                            <div>
                                                <div class="fw-700 text-dark">@item.Student?.FirstName @item.Student?.LastName</div>
                                                <div class="small text-muted">#@item.Student?.AdmissionNumber</div>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="fw-700 text-success">â‚¹@item.Amount.ToString("N2")</span>
                                    </td>
                                    <td>
                                        <div class="small fw-600">@item.Date.ToString("MMM dd, yyyy")</div>
                                        <div class="small text-muted" style="font-size: 0.7rem;">@item.Date.ToString("hh:mm tt")</div>
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-dark border">@item.PaymentMethod</span>
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(item.ProofOfPayment))
                                        {
                                            <a href="@item.ProofOfPayment" target="_blank" class="btn btn-sm btn-light-soft text-primary fw-600">
                                                <i class="fas fa-file-image me-1"></i> View
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">N/A</span>
                                        }
                                    </td>
                                    <td class="text-end px-4">
                                        <div class="d-flex gap-2 justify-content-end">
                                            <form asp-action="ApproveDeposit" asp-route-id="@item.Id" method="post">
                                                <button type="submit" class="btn btn-success btn-sm fw-600 px-3" onclick="return confirm('Approve this deposit?')">
                                                     <i class="fas fa-check me-1"></i> Approve
                                                </button>
                                            </form>
                                            <form asp-action="RejectDeposit" asp-route-id="@item.Id" method="post">
                                                <button type="submit" class="btn btn-outline-danger btn-sm fw-600 px-3" onclick="return confirm('Reject this deposit?')">
                                                     <i class="fas fa-times me-1"></i> Reject
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
