@model EasyEdu.Models.Certificate
@{
    Layout = null; // We want a clean page for printing
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Certificate - @Model.CertificateNumber</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <style>
        body { font-family: 'Times New Roman', serif; margin: 0; padding: 0; background-color: #f0f0f0; }
        .certificate-container {
            width: 800px;
            height: 560px;
            padding: 50px;
            margin: 50px auto;
            background-color: #fff;
            position: relative;
            border: 20px solid #e2e8f0;
            box-shadow: 0 10px 30px rgba(0,0,0,0.1);
        }
        .outer-border {
            border: 2px solid #4f46e5;
            height: 100%;
            width: 100%;
            position: relative;
            padding: 40px;
            box-sizing: border-box;
        }
        .watermark {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%) rotate(-30deg);
            font-size: 80px;
            color: rgba(79, 70, 229, 0.03);
            font-weight: 800;
            z-index: 0;
            user-select: none;
            text-transform: uppercase;
        }
        .cert-header { text-align: center; border-bottom: 2px solid #f1f5f9; padding-bottom: 20px; margin-bottom: 30px; position: relative; z-index: 1; }
        .cert-header h1 { margin: 0; color: #1e293b; font-size: 32px; text-transform: uppercase; letter-spacing: 2px; }
        .cert-header p { margin: 5px 0; color: #64748b; font-weight: 700; }
        
        .cert-body { text-align: center; position: relative; z-index: 1; }
        .cert-title { font-size: 42px; font-weight: 700; color: #4f46e5; margin: 20px 0; font-family: 'Georgia', serif; }
        .cert-content { font-size: 18px; line-height: 1.8; color: #334155; margin-bottom: 40px; }
        .student-name { font-size: 24px; font-weight: 800; color: #1e293b; border-bottom: 1px dashed #cbd5e1; display: inline-block; padding: 0 20px; }
        
        .cert-footer { display: flex; justify-content: space-between; margin-top: 60px; position: relative; z-index: 1; }
        .sign-area { text-align: center; width: 200px; }
        .sign-line { border-top: 2px solid #1e293b; margin-top: 50px; padding-top: 10px; font-weight: 700; color: #1e293b; }
        
        .cert-ref { position: absolute; bottom: 20px; left: 40px; font-size: 12px; color: #94a3b8; font-family: monospace; }
        
        @@media print {
            body { background-color: #fff; margin: 0; }
            .certificate-container { margin: 0; border: none; box-shadow: none; width: 100%; height: auto; }
            .btn-print { display: none; }
        }

        .btn-print {
            position: fixed;
            top: 20px;
            right: 20px;
            padding: 12px 25px;
            background: #4f46e5;
            color: white;
            border: none;
            border-radius: 8px;
            cursor: pointer;
            font-weight: 700;
            box-shadow: 0 4px 15px rgba(79, 70, 229, 0.3);
        }
    </style>
</head>
<body>
    <button class="btn-print" onclick="window.print()">
        <i class="fas fa-print me-2"></i> Confirm & Print
    </button>

    <div class="certificate-container">
        <div class="outer-border">
            <div class="watermark">EasyEdu OFFICIAL</div>
            
            <div class="cert-header">
                <i class="fas fa-graduation-cap fa-3x" style="color: #4f46e5; margin-bottom: 15px;"></i>
                <h1>Institutional Document</h1>
                <p>EasyEdu Excellence Academy</p>
            </div>

            <div class="cert-body">
                <div class="cert-title">@Model.CertificateType</div>
                
                <div class="cert-content">
                    This is to officially certify that <br>
                    <span class="student-name">@Model.Student.FirstName @Model.Student.LastName</span> <br>
                    of Class <span class="fw-800">@(Model.Student.Class?.Name ?? "N/A")</span>, Admission Number <span class="fw-800">@Model.Student.AdmissionNumber</span>, <br>
                    has been issued this document for the stated purpose of: <br>
                    <span style="font-style: italic; font-weight: 600;">"@Model.Purpose"</span>
                </div>
            </div>

            <div class="cert-footer">
                <div class="sign-area">
                    <div class="sign-line">Registrar Office</div>
                </div>
                <div class="sign-area">
                    <div class="sign-line">@Model.ApprovedBy</div>
                </div>
            </div>

            <div class="cert-ref">
                REF: @Model.CertificateNumber | ISSUED: @Model.IssueDate.ToString("MMM dd, yyyy") | ID: @Model.Id
            </div>
        </div>
    </div>
</body>
</html>
