@model IEnumerable<EasyEdu.Models.Student>
@{
    ViewData["Title"] = "Institutional Identity Portal";
}

<div class="page-header d-flex justify-content-between align-items-center mb-4 no-print">
    <div>
        <h1 class="page-title animate-slide-in">Identifier Management</h1>
        <p class="text-muted fw-600">Generate high-fidelity institutional credentials for academic batches</p>
    </div>
    <div class="d-flex gap-3">
        <button class="btn-premium btn-premium-primary animate-fade-in shadow-lg" onclick="window.print()">
            <i class="fas fa-print"></i> Dispatch to Printer
        </button>
    </div>
</div>

<div class="premium-card p-4 bg-white mb-5 shadow-sm no-print animate-fade-in">
    <form method="get" class="row g-4 align-items-end">
        <div class="col-md-4">
            <label class="form-label small fw-800 text-muted uppercase">Selection Batch</label>
            <select name="classId" class="form-select border-2 fw-700" asp-items="ViewBag.ClassId" onchange="this.form.submit()">
                <option value="">-- All Academy Batches --</option>
            </select>
        </div>
        <div class="col-md-4">
            <label class="form-label small fw-800 text-muted uppercase">Search Member</label>
            <div class="input-group">
                <span class="input-group-text bg-light border-2 text-muted"><i class="fas fa-search"></i></span>
                <input type="text" class="form-control border-2" placeholder="Member ID or Name...">
            </div>
        </div>
        <div class="col-md-4 text-end">
            <div class="bg-primary-soft p-2 px-3 rounded-pill d-inline-block">
                <span class="text-primary fw-800 small">QUEUE: @Model.Count() Identifiers Pending</span>
            </div>
        </div>
    </form>
</div>

<div class="id-card-grid">
    @foreach (var student in Model)
    {
        <div class="id-card-item">
            <div class="id-card-front">
                <div class="id-card-header">
                    <div class="inst-logo">
                        <i class="fas fa-graduation-cap"></i>
                    </div>
                    <div class="inst-meta">
                        <span class="inst-name">EASYEDU ACADEMY</span>
                        <span class="inst-slogan">Legacy of Excellence</span>
                    </div>
                    <div class="id-chip"></div>
                </div>
                
                <div class="id-card-body">
                    <div class="id-profile-mesh">
                        <div class="id-photo-container">
                            <div class="id-photo-frame">
                                @if (!string.IsNullOrEmpty(student.ProfilePicture))
                                {
                                    <img src="@student.ProfilePicture" alt="@student.FirstName" />
                                }
                                else
                                {
                                    <span class="photo-alt">@(student.FirstName.Substring(0,1))</span>
                                }
                            </div>
                        </div>
                        <div class="id-badge-type">STUDENT</div>
                    </div>

                    <div class="id-primary-info">
                        <h3 class="member-name">@student.FirstName @student.LastName</h3>
                        <div class="info-mesh">
                            <div class="mesh-item">
                                <label>Member ID</label>
                                <span>#@student.AdmissionNumber</span>
                            </div>
                            <div class="mesh-item">
                                <label>Academic Batch</label>
                                <span>@(student.Class?.Name ?? "General")</span>
                            </div>
                            <div class="mesh-item">
                                <label>Date of Birth</label>
                                <span>@student.DateOfBirth.ToString("dd MMM yyyy")</span>
                            </div>
                            <div class="mesh-item">
                                <label>Validity</label>
                                <span>2024 - 2026</span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="id-card-footer">
                    <div class="barcode-box">
                        <i class="fas fa-barcode"></i>
                        <span class="barcode-text">@student.AdmissionNumber</span>
                    </div>
                    <div class="auth-area">
                        <div class="auth-sign"></div>
                        <span>ISSUING AUTHORITY</span>
                    </div>
                </div>
                <!-- Security Watermark -->
                <div class="mesh-watermark text-uppercase">EasyEdu Secure Identifier</div>
            </div>
        </div>
    }
</div>

@if (!Model.Any())
{
    <div class="text-center py-5">
        <i class="fas fa-id-card-clip fa-6x text-gray-100 mb-4"></i>
        <h3 class="text-muted fw-800">No identity records found in this batch.</h3>
    </div>
}

<style>
    :root {
        --id-primary: #1e293b;
        --id-secondary: #4f46e5;
        --id-gold: #fbbf24;
    }

    .id-card-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(360px, 1fr));
        gap: 40px;
    }

    .id-card-item {
        width: 360px;
        height: 230px;
        perspective: 1000px;
        margin: 0 auto;
    }

    .id-card-front {
        width: 100%;
        height: 100%;
        background: white;
        border-radius: 20px;
        position: relative;
        overflow: hidden;
        box-shadow: 0 20px 40px rgba(0,0,0,0.1);
        border: 1px solid #e2e8f0;
        display: flex;
        flex-direction: column;
        transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }

    .id-card-front:hover {
        transform: translateY(-8px) scale(1.02);
        box-shadow: 0 30px 60px rgba(79, 70, 229, 0.15);
    }

    .id-card-header {
        background: linear-gradient(135deg, var(--id-primary) 0%, #0f172a 100%);
        padding: 15px 20px;
        display: flex;
        align-items: center;
        color: white;
        height: 65px;
        position: relative;
    }

    .inst-logo {
        width: 35px;
        height: 35px;
        background: rgba(255,255,255,0.1);
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.2rem;
        margin-right: 15px;
        border: 1px solid rgba(255,255,255,0.1);
    }

    .inst-meta .inst-name {
        display: block;
        font-weight: 900;
        font-size: 0.9rem;
        letter-spacing: 1px;
    }

    .inst-meta .inst-slogan {
        display: block;
        font-size: 0.55rem;
        text-transform: uppercase;
        letter-spacing: 2px;
        opacity: 0.6;
        font-weight: 700;
    }

    .id-chip {
        position: absolute;
        right: 20px;
        top: 20px;
        width: 30px;
        height: 24px;
        background: linear-gradient(135deg, #d4d4d8 0%, #a1a1aa 100%);
        border-radius: 4px;
        opacity: 0.4;
    }

    .id-card-body {
        flex: 1;
        display: flex;
        padding: 15px 20px;
        background: radial-gradient(circle at 0% 100%, rgba(79, 70, 229, 0.05) 0%, transparent 60%);
    }

    .id-profile-mesh {
        width: 100px;
        display: flex;
        flex-direction: column;
        align-items: center;
        margin-right: 20px;
    }

    .id-photo-frame {
        width: 90px;
        height: 110px;
        background: #f8fafc;
        border-radius: 12px;
        border: 3px solid white;
        box-shadow: 0 8px 20px rgba(0,0,0,0.1);
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        margin-bottom: 10px;
    }

    .id-photo-frame img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .photo-alt {
        font-size: 2.5rem;
        font-weight: 900;
        color: #cbd5e1;
    }

    .id-badge-type {
        background: var(--id-gold);
        color: #78350f;
        font-size: 0.55rem;
        font-weight: 900;
        padding: 3px 12px;
        border-radius: 100px;
        letter-spacing: 1px;
    }

    .id-primary-info .member-name {
        margin: 0 0 10px 0;
        font-size: 1.25rem;
        font-weight: 900;
        color: var(--id-primary);
        letter-spacing: -0.8px;
    }

    .info-mesh {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 10px;
    }

    .mesh-item label {
        display: block;
        font-size: 0.5rem;
        text-transform: uppercase;
        font-weight: 800;
        color: #94a3b8;
        margin-bottom: 2px;
    }

    .mesh-item span {
        display: block;
        font-size: 0.75rem;
        font-weight: 800;
        color: var(--id-primary);
    }

    .id-card-footer {
        height: 45px;
        border-top: 1px dashed #e2e8f0;
        background: #f8fafc;
        padding: 0 20px;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .barcode-box {
        display: flex;
        flex-direction: column;
        align-items: center;
        color: #cbd5e1;
    }

    .barcode-box i { font-size: 1.4rem; margin-bottom: -5px; }
    .barcode-text { font-size: 0.5rem; font-weight: 800; letter-spacing: 1px; color: #94a3b8; }

    .auth-area {
        text-align: center;
    }

    .auth-sign {
        width: 80px;
        height: 1px;
        background: #cbd5e1;
        margin-bottom: 3px;
    }

    .auth-area span {
        font-size: 0.5rem;
        font-weight: 800;
        color: #94a3b8;
    }

    .mesh-watermark {
        position: absolute;
        bottom: 50px;
        right: -30px;
        font-size: 3rem;
        font-weight: 900;
        color: rgba(79, 70, 229, 0.02);
        transform: rotate(-25deg);
        z-index: 0;
        pointer-events: none;
        white-space: nowrap;
    }

    @@media print {
        .no-print, .btn-premium { display: none !important; }
        .content-wrapper { padding: 0 !important; margin: 0 !important; }
        .id-card-grid { display: block !important; }
        .id-card-item { 
            display: inline-block; 
            margin: 15px; 
            page-break-inside: avoid;
            transform: none !important;
            box-shadow: none !important;
            border: 1px solid #eee !important;
        }
        .id-card-front { -webkit-print-color-adjust: exact; }
    }
</style>
