@model IEnumerable<EasyEdu.Models.Certificate>
@{
    ViewData["Title"] = "Bulk Certificate Print";
}

<div class="container-fluid animate-fade-in">
    <div class="card premium-card mb-4">
        <div class="card-header bg-gradient-success text-white d-flex justify-content-between align-items-center py-3">
            <h5 class="mb-0"><i class="fas fa-certificate me-2"></i>Bulk Certificate Print</h5>
            <div class="d-flex gap-2">
                <button onclick="window.print()" class="btn btn-light btn-sm"><i class="fas fa-print me-1"></i> Print All</button>
            </div>
        </div>
        <div class="card-body">
            <form method="get" class="row g-3 mb-4">
                <div class="col-md-4">
                    <label class="form-label">Filter by Class</label>
                    <select name="classId" class="form-select form-control-premium" asp-items="ViewBag.Classes" onchange="this.form.submit()">
                        <option value="">All Classes</option>
                    </select>
                </div>
            </form>

            <div class="d-print-block">
                @foreach (var cert in Model)
                {
                    <div class="certificate-container p-5 mb-5 border rounded shadow-sm bg-white position-relative" style="min-height: 600px; border: 15px double #ae946d !important;">
                        <div class="text-center mb-5">
                            <img src="~/images/easyedu_full_logo.png" style="height: 60px;" alt="Logo" class="mb-3" />
                            <h1 class="display-4 fw-bold" style="color: #ae946d; font-family: 'Georgia', serif;">CERTIFICATE</h1>
                            <h4 class="text-uppercase tracking-widest">OF APPRECIATION</h4>
                        </div>
                        
                        <div class="content text-center mt-5">
                            <p class="lead">This is to certify that</p>
                            <h2 class="display-5 fw-bold text-dark border-bottom d-inline-block px-5 pb-2">@cert.Student?.FirstName @cert.Student?.LastName</h2>
                            <p class="mt-4 fs-5">has successfully demonstrated excellence in academics and behavior during the session.</p>
                            <p class="mt-2 text-muted">Awarded on: @cert.IssueDate.ToString("MMMM dd, yyyy")</p>
                        </div>

                        <div class="footer-signatures d-flex justify-content-between mt-auto pt-5 mt-5">
                            <div class="text-center">
                                <div class="border-top px-4 pt-2">Principal Signature</div>
                            </div>
                            <div class="text-center">
                                <div class="border-top px-4 pt-2">Seal of Institute</div>
                            </div>
                        </div>
                        
                        <div class="watermark position-absolute top-50 start-50 translate-middle opacity-10" style="z-index: 0;">
                            <i class="fas fa-graduation-cap fa-10x"></i>
                        </div>
                    </div>
                    <div class="page-break d-none d-print-block" style="page-break-after: always;"></div>
                }
            </div>
        </div>
    </div>
</div>

<style>
    @@media print {
        .card-header, .btn, .form-label, .form-select, .sidebar, .topbar, footer { display: none !important; }
        .main-content { margin: 0 !important; padding: 0 !important; }
        .certificate-container { border: 15px double #ae946d !important; width: 100%; height: 95vh; margin: 0; box-shadow: none !important; }
    }
</style>
