@model EasyEdu.Models.FeeCollection
@{
    ViewData["Title"] = "Professional Fee Receipt";
    Layout = null;
    var company = ViewBag.Company as EasyEdu.Models.Company;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>Receipt #@Model.ReceiptNumber</title>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <style>
        body { font-family: 'Outfit', sans-serif; background: #f0f2f5; padding: 30px; color: #1e293b; }
        .receipt-card {
            max-width: 850px;
            margin: 0 auto;
            background: white;
            border-radius: 20px;
            box-shadow: 0 20px 50px rgba(0,0,0,0.1);
            overflow: hidden;
            border-top: 10px solid #10b981;
        }
        .receipt-header {
            padding: 40px;
            border-bottom: 2px dashed #f1f5f9;
        }
        .student-info {
            background: #f8fafc;
            padding: 25px 40px;
            border-bottom: 1px solid #e2e8f0;
        }
        .receipt-body { padding: 40px; }
        .amount-highlight {
            background: #ecfdf5;
            color: #065f46;
            padding: 20px;
            border-radius: 12px;
            text-align: center;
        }
        .info-label { font-size: 11px; font-weight: 700; color: #64748b; text-transform: uppercase; }
        .info-value { font-size: 15px; font-weight: 700; color: #1e293b; display: block; }
        .stamp-circle {
            width: 120px;
            height: 120px;
            border: 4px solid #10b981;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #10b981;
            font-weight: 900;
            text-transform: uppercase;
            font-size: 20px;
            transform: rotate(-15deg);
            opacity: 0.8;
            margin: 0 auto;
        }
        @@media print {
            body { background: white; padding: 0; }
            .receipt-card { box-shadow: none; border: 1px solid #eee; width: 100%; border-top: 10px solid #10b981; }
            .print-btn { display: none; }
        }
    </style>
</head>
<body>

    <div class="receipt-card">
        <!-- Header -->
        <div class="receipt-header">
            <div class="row align-items-center">
                <div class="col-6">
                    <h3 class="fw-800 text-success mb-1">PAYMENT RECEIPT</h3>
                    <p class="text-muted small fw-600 mb-0">Acknowledgement of fee payment</p>
                </div>
                <div class="col-6 text-end">
                    <h5 class="fw-800 mb-0">@company.Name</h5>
                    <div class="small text-muted">Receipt No: @Model.ReceiptNumber</div>
                    <div class="small text-muted">Date: @Model.CreatedAt.ToString("dd MMM yyyy, hh:mm tt")</div>
                </div>
            </div>
        </div>

        <!-- Student Details -->
        <div class="student-info">
            <div class="row g-4">
                <div class="col-md-3">
                     <span class="info-label">Admission No</span>
                     <span class="info-value">@Model.Student.AdmissionNumber</span>
                </div>
                <div class="col-md-5">
                     <span class="info-label">Student Name</span>
                     <span class="info-value">@Model.Student.FirstName @Model.Student.LastName</span>
                </div>
                <div class="col-md-4">
                     <span class="info-label">Class / Section</span>
                     <span class="info-value">@Model.Student.Class?.Name - @(Model.Student.Section?.Name ?? "N/A")</span>
                </div>
            </div>
            @if (Model.Student.Route != null)
            {
                <div class="mt-3 small text-primary fw-700">
                    <i class="fas fa-bus me-1"></i> Transport: @Model.Student.Route.Name
                </div>
            }
        </div>

        <!-- Receipt Body -->
        <div class="receipt-body">
            <div class="row g-4 mb-4">
                <div class="col-md-8">
                    <h6 class="fw-700 mb-3">Payment Details</h6>
                    <div class="table-responsive">
                        <table class="table table-borderless">
                            <tr>
                                <td class="ps-0 text-muted">Reference Invoice:</td>
                                <td class="text-end fw-700">@Model.FeesInvoice?.InvoiceNumber</td>
                            </tr>
                            <tr>
                                <td class="ps-0 text-muted">Payment Mode:</td>
                                <td class="text-end fw-700">@Model.PaymentMethod</td>
                            </tr>
                            <tr class="border-top">
                                <td class="ps-0 fw-800">Total Received:</td>
                                <td class="text-end fw-800 fs-5 text-success">@Model.AmountPaid.ToString("C2")</td>
                            </tr>
                        </table>
                    </div>
                </div>
                <div class="col-md-4 text-center">
                    <div class="stamp-circle mt-3">RECEIVED</div>
                </div>
            </div>

            <div class="amount-highlight">
                <div class="fw-700">AMOUNT IN WORDS</div>
                <div class="fw-800 mt-1">@Model.AmountPaid.ToString("N2") Only</div>
            </div>

            <!-- Footer Details -->
            <div class="row mt-5 pt-4">
                <div class="col-6">
                    <div style="border-bottom: 2px solid #eee; width: 150px; margin-bottom: 5px;"></div>
                    <span class="small fw-700 text-muted">Depositor's Signature</span>
                </div>
                <div class="col-6 text-end">
                     <div style="border-bottom: 2px solid #eee; width: 150px; margin-bottom: 5px; display: inline-block;"></div>
                     <br><span class="small fw-700 text-muted">Authorized Signatory</span>
                </div>
            </div>
        </div>
    </div>

    <div class="text-center mt-4">
        <button onclick="window.print()" class="btn btn-success rounded-pill px-5 py-3 fw-bold print-btn shadow">
            <i class="fas fa-print me-2"></i> Print Fee Receipt
        </button>
        <a href="javascript:window.close()" class="btn btn-light rounded-pill px-4 py-3 fw-bold print-btn ms-2">Close</a>
    </div>

</body>
</html>
