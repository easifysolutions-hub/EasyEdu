@model EasyEdu.Models.FeesInvoice
@{
    ViewData["Title"] = "Professional Fee Invoice";
    Layout = null; 
    var company = ViewBag.Company as EasyEdu.Models.Company;
    var balance = Model.TotalAmount + Model.TotalFine - Model.TotalWaiver - Model.PaidAmount;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>Invoice #@Model.InvoiceNumber</title>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <style>
        body { font-family: 'Outfit', sans-serif; background: #f0f2f5; padding: 30px; color: #1e293b; }
        .invoice-card {
            max-width: 900px;
            margin: 0 auto;
            background: white;
            border-radius: 20px;
            box-shadow: 0 20px 50px rgba(0,0,0,0.1);
            overflow: hidden;
            position: relative;
        }
        .header-gradient {
            background: linear-gradient(135deg, #6366f1 0%, #a855f7 100%);
            padding: 50px 40px;
            color: white;
            position: relative;
        }
        .header-logo {
            font-size: 28px;
            font-weight: 800;
            letter-spacing: -0.5px;
            display: flex;
            align-items: center;
            gap: 12px;
        }
        .invoice-label {
            position: absolute;
            top: 40px;
            right: 40px;
            font-size: 60px;
            font-weight: 900;
            opacity: 0.1;
            text-transform: uppercase;
        }
        .student-profile-bar {
            background: #f8fafc;
            padding: 30px 40px;
            border-bottom: 1px solid #e2e8f0;
        }
        .student-photo {
            width: 110px;
            height: 110px;
            border-radius: 15px;
            object-fit: cover;
            border: 5px solid white;
            box-shadow: 0 10px 15px -3px rgba(0,0,0,0.1);
        }
        .info-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 20px;
        }
        .info-item label {
            display: block;
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
            color: #64748b;
            margin-bottom: 4px;
        }
        .info-item span {
            font-size: 15px;
            font-weight: 600;
            color: #1e293b;
        }
        .table-area { padding: 40px; }
        .invoice-table thead th {
            background: #f1f5f9;
            padding: 15px 20px;
            font-size: 12px;
            font-weight: 700;
            color: #475569;
            border: none;
            text-transform: uppercase;
        }
        .invoice-table tbody td {
            padding: 20px;
            border-bottom: 1px solid #f1f5f9;
            vertical-align: middle;
        }
        .summary-box {
            background: #f8fafc;
            border-radius: 15px;
            padding: 25px;
        }
        .summary-item {
            display: flex;
            justify-content: space-between;
            margin-bottom: 10px;
            font-size: 15px;
        }
        .summary-item.grand-total {
            margin-top: 15px;
            padding-top: 15px;
            border-top: 2px dashed #cbd5e1;
            font-size: 22px;
            font-weight: 800;
            color: #6366f1;
        }
        .stamp {
            border: 4px solid;
            padding: 10px 20px;
            border-radius: 10px;
            font-size: 24px;
            font-weight: 900;
            text-transform: uppercase;
            transform: rotate(-15deg);
            display: inline-block;
            margin-top: 20px;
        }
        .stamp-unpaid { color: #ef4444; border-color: #ef4444; }
        .stamp-paid { color: #10b981; border-color: #10b981; }
        .stamp-partial { color: #f59e0b; border-color: #f59e0b; }

        .transport-badge {
            background: #eef2ff;
            color: #4338ca;
            padding: 8px 15px;
            border-radius: 8px;
            font-size: 12px;
            font-weight: 700;
            display: inline-flex;
            align-items: center;
            gap: 8px;
        }

        @@media print {
            body { background: white; padding: 0; }
            .invoice-card { box-shadow: none; border-radius: 0; width: 100%; max-width: 100%; }
            .print-btn { display: none; }
            .header-gradient { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
        }
    </style>
</head>
<body>

    <div class="invoice-card">
        <div class="invoice-label">Invoice</div>
        
        <!-- Header -->
        <div class="header-gradient">
            <div class="row align-items-center">
                <div class="col-6">
                    <div class="header-logo"><i class="fas fa-graduation-cap"></i> @company.Name</div>
                    <div class="mt-3 opacity-75 small fw-500">
                        <div><i class="fas fa-map-marker-alt me-2"></i> @company.Address</div>
                        <div><i class="fas fa-phone me-2"></i> @company.Phone | @company.Email</div>
                    </div>
                </div>
                <div class="col-6 text-end">
                    <div class="fw-800 fs-3">#@Model.InvoiceNumber</div>
                    <div class="small opacity-75 fw-600 mt-1">
                        Academic Year: @Model.AcademicYear?.Name <br>
                        Issue Date: @Model.Date.ToString("dd MMM, yyyy")
                    </div>
                </div>
            </div>
        </div>

        <!-- Student Info -->
        <div class="student-profile-bar">
            <div class="d-flex align-items-center gap-4">
                <img src="@(string.IsNullOrEmpty(Model.Student.ProfilePicture) ? "https://ui-avatars.com/api/?name=" + Model.Student.FirstName : Model.Student.ProfilePicture)" class="student-photo" alt="Photo">
                <div class="flex-grow-1">
                    <div class="info-grid">
                        <div class="info-item">
                            <label>Student Name</label>
                            <span>@Model.Student.FirstName @Model.Student.LastName</span>
                        </div>
                        <div class="info-item">
                            <label>Admission No</label>
                            <span>@Model.Student.AdmissionNumber</span>
                        </div>
                        <div class="info-item">
                            <label>Class / Section</label>
                            <span>@Model.Student.Class?.Name - @(Model.Student.Section?.Name ?? "N/A")</span>
                        </div>
                        <div class="info-item">
                            <label>Guardian Name</label>
                            <span>@Model.Student.GuardianName</span>
                        </div>
                        <div class="info-item">
                            <label>Contact</label>
                            <span>@Model.Student.GuardianPhone</span>
                        </div>
                        <div class="info-item">
                            <label>Roll Number</label>
                            <span>@(Model.Student.RollNumber.HasValue ? Model.Student.RollNumber.Value.ToString() : "-")</span>
                        </div>
                    </div>
                    @if (Model.Student.Route != null)
                    {
                        <div class="mt-3">
                            <div class="transport-badge">
                                <i class="fas fa-bus"></i>
                                TRANSPORT: @Model.Student.Route.Name | Fee: @(Model.Student.Route.RouteFee?.ToString("C2") ?? "N/A")
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Table -->
        <div class="table-area">
            <table class="table invoice-table w-100">
                <thead>
                    <tr>
                        <th style="width: 50%;">Fee Description</th>
                        <th class="text-end">Amount</th>
                        <th class="text-end">Waiver</th>
                        <th class="text-end">Total</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var detail in Model.Details)
                    {
                        <tr>
                            <td>
                                <div class="fw-700 text-dark">@detail.FeesType.Name</div>
                                <div class="text-muted small">@detail.FeesType.FeesCode</div>
                            </td>
                            <td class="text-end fw-600">@detail.Amount.ToString("N2")</td>
                            <td class="text-end text-danger fw-600">-@detail.Waiver.ToString("N2")</td>
                            <td class="text-end fw-700">@((detail.Amount - detail.Waiver).ToString("N2"))</td>
                        </tr>
                    }
                </tbody>
            </table>

            <div class="row mt-5">
                <div class="col-md-5">
                    <div class="text-center">
                        @if (Model.Status == "Paid") { <div class="stamp stamp-paid">Paid</div> }
                        else if (Model.Status == "Partial") { <div class="stamp stamp-partial">Partial</div> }
                        else { <div class="stamp stamp-unpaid">Unpaid</div> }
                    </div>
                </div>
                <div class="col-md-7">
                    <div class="summary-box">
                        <div class="summary-item">
                            <span class="text-muted fw-600">Sub Total</span>
                            <span class="fw-700">@Model.TotalAmount.ToString("C2")</span>
                        </div>
                        <div class="summary-item">
                            <span class="text-muted fw-600">Fine / Penalty</span>
                            <span class="fw-700">@Model.TotalFine.ToString("C2")</span>
                        </div>
                        <div class="summary-item">
                            <span class="text-muted fw-600">Waiver</span>
                            <span class="text-danger fw-700">-@Model.TotalWaiver.ToString("C2")</span>
                        </div>
                        <div class="summary-item">
                            <span class="text-muted fw-600">Paid Amount</span>
                            <span class="text-success fw-700">-@Model.PaidAmount.ToString("C2")</span>
                        </div>
                        <div class="summary-item grand-total">
                            <span>Balance Due</span>
                            <span>@balance.ToString("C2")</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Footer -->
        <div class="p-4 border-top text-center text-muted small fw-600">
            * This is a computer generated invoice and does not require a physical signature.
            <div class="mt-2 text-primary">Generated by EasyEdu Education Management System</div>
        </div>
    </div>

    <div class="text-center mt-4">
        <button onclick="window.print()" class="btn btn-primary rounded-pill px-5 py-3 fw-bold print-btn">
            <i class="fas fa-print me-2"></i> Print Professional Invoice
        </button>
    </div>

</body>
</html>
