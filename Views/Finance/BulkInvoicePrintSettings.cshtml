@model EasyEdu.Models.BulkInvoiceSettings
@{
    ViewData["Title"] = "Bulk Invoice Architect";
    Layout = "_Layout";
}

<div class="content-wrapper p-4 animate-fade-in text-dark">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="page-title mb-1 fw-900 text-dark">Invoice Distribution Architect</h3>
            <p class="text-muted small fw-600">Global configuration for bulk generated financial documents and PDF branding</p>
        </div>
        <div class="d-flex gap-2">
             <a href="@Url.Action("BulkInvoice", "Finance")" class="btn btn-light-soft btn-sm rounded-8">
                <i class="fas fa-file-invoice me-2"></i>BULK GENERATOR
            </a>
            <a href="@Url.Action("BulkInvoicePrint", "Finance")" class="btn btn-premium-purple btn-sm rounded-8">
                <i class="fas fa-print me-2"></i>PRINT QUEUE
            </a>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-xl-8">
            <form asp-action="SaveBulkInvoiceSettings" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="CompanyId" />

                <div class="premium-card p-5 mb-4 border-0 shadow-lg">
                    <h5 class="fw-900 text-dark mb-4 border-bottom pb-3">Branding & Layout Nexus</h5>
                    <div class="row g-4 mb-4">
                        <div class="col-md-6">
                            <label class="form-label small fw-800 text-uppercase opacity-50">Invoice Prefix*</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-0"><i class="fas fa-hashtag text-primary"></i></span>
                                <input asp-for="InvoicePrefix" class="form-control form-control-premium border-0 bg-light" placeholder="e.g. INV-">
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-800 text-uppercase opacity-50">Starting Sequence Number*</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-0"><i class="fas fa-sort-numeric-up text-primary"></i></span>
                                <input asp-for="NextInvoiceNumber" type="number" class="form-control form-control-premium border-0 bg-light">
                            </div>
                        </div>
                    </div>

                    <div class="row g-4 mb-4">
                        <div class="col-md-6">
                            <div class="form-check form-switch p-0 d-flex align-items-center justify-content-between mb-3">
                                <label class="small fw-800 text-uppercase opacity-75 m-0">Institutional Logo on Header</label>
                                <input class="form-check-input ms-0" type="checkbox" asp-for="ShowInstitutionalLogo" style="width: 45px; height: 22px;">
                            </div>
                            <div class="form-check form-switch p-0 d-flex align-items-center justify-content-between">
                                <label class="small fw-800 text-uppercase opacity-75 m-0">Authorized Signature Field</label>
                                <input class="form-check-input ms-0" type="checkbox" asp-for="ShowAuthorizedSignature" style="width: 45px; height: 22px;">
                            </div>
                        </div>
                        <div class="col-md-6">
                             <label class="form-label small fw-800 text-uppercase opacity-50">Authorized Signature Image</label>
                             @if(!string.IsNullOrEmpty(Model.SignaturePath)) {
                                 <div class="mb-2 p-2 bg-light border-dashed rounded text-center">
                                     <img src="@Model.SignaturePath" style="height: 50px;" class="mb-2">
                                     <p class="smallest text-muted m-0">Current Signature Uploaded</p>
                                 </div>
                             }
                             <input type="file" name="signature" class="form-control form-control-premium">
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label small fw-800 text-uppercase opacity-50">Terms and Legal Conditions</label>
                        <textarea asp-for="TermsAndConditions" rows="4" class="form-control form-control-premium" placeholder="Enter standard legal terms displayed on all invoices..."></textarea>
                    </div>

                    <div class="mb-0">
                        <label class="form-label small fw-800 text-uppercase opacity-50">Footer Note / Acknowledgement</label>
                        <input asp-for="FooterNote" class="form-control form-control-premium" placeholder="e.g. This is a computer generated invoice.">
                    </div>
                </div>

                <div class="premium-card p-4 bg-premium-dark d-flex justify-content-between align-items-center" style="border-radius: 20px;">
                    <div class="d-flex align-items-center">
                        <i class="fas fa-info-circle text-info me-3 fa-lg"></i>
                        <p class="text-white opacity-50 m-0 small fw-700">Settings will apply to all future bulk-generated invoices.</p>
                    </div>
                    <button type="submit" class="btn btn-premium-success px-5 py-3 rounded-12 shadow-lg fw-900 h6 mb-0">
                        <i class="fas fa-check-double me-2"></i>SAVE ARCHITECTURAL SETTINGS
                    </button>
                </div>
            </form>
        </div>

        <div class="col-xl-4">
            <div class="premium-card p-5 border-0 shadow-lg text-center bg-light-soft">
                <i class="fas fa-eye fa-4x text-muted opacity-10 mb-4"></i>
                <h5 class="fw-900 text-muted">Preview Simulator</h5>
                <p class="small text-muted mb-4 fw-600">Visual live preview of the invoice layout based on selected settings will be rendered here.</p>
                <div class="p-4 border border-2 border-dashed rounded-20 bg-white shadow-sm opacity-50">
                    <div class="d-flex justify-content-between mb-3 border-bottom pb-2">
                         <div class="dot bg-light" style="width: 60px; height: 10px;"></div>
                         <div class="dot bg-light" style="width: 40px; height: 10px;"></div>
                    </div>
                    <div class="dot bg-light w-100 mb-2" style="height: 15px;"></div>
                    <div class="dot bg-light w-100 mb-2" style="height: 15px;"></div>
                    <div class="dot bg-light w-75" style="height: 15px;"></div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .bg-premium-dark { background: #1e293b; }
    .bg-light-soft { background: #f8fafc; }
    .border-dashed { border: 2px dashed #e2e8f0; }
    .rounded-20 { border-radius: 20px; }
    .smallest { font-size: 0.75rem; }
    .btn-premium-success { background: linear-gradient(135deg, #10b981 0%, #059669 100%); color: white; border: none; }
</style>
