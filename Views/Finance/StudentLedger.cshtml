@model IEnumerable<EasyEdu.Models.FeeCollection>
@{
    var student = (EasyEdu.Models.Student)ViewBag.Student;
    ViewData["Title"] = "Financial Ledger - " + student.FirstName;
}

<div class="page-header d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="page-title animate-slide-in">Individual Financial Ledger</h1>
        <p class="text-muted fw-600">Complete transaction history for @student.FirstName @student.LastName</p>
    </div>
    <div class="d-flex gap-2">
        <button class="btn-premium btn-premium-primary animate-fade-in" onclick="window.print()">
            <i class="fas fa-file-invoice"></i> Download PDF Statement
        </button>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-xl-4 col-md-12">
        <div class="premium-card p-4 bg-white shadow-md border-top border-5 border-primary">
            <h5 class="fw-800 text-dark mb-3">Student Profile</h5>
            <div class="d-flex align-items-center mb-3">
                <div class="avatar-lg bg-primary text-white rounded-circle me-3 d-flex align-items-center justify-content-center" style="width: 60px; height: 60px; font-size: 1.5rem; font-weight: 800;">
                    @student.FirstName.Substring(0,1)@student.LastName.Substring(0,1)
                </div>
                <div>
                    <h5 class="fw-800 mb-0">@student.FirstName @student.LastName</h5>
                    <div class="text-muted fw-600">Roll: @student.AdmissionNumber</div>
                </div>
            </div>
            <div class="row g-2 pt-2">
                <div class="col-6">
                    <div class="small text-muted">Class & Section</div>
                    <div class="fw-700">@student.Class?.Name</div>
                </div>
                <div class="col-6">
                    <div class="small text-muted">Academic Status</div>
                    <span class="badge-premium badge-success-premium">Active</span>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xl-8 col-md-12">
        <div class="row g-4">
            <div class="col-md-6">
                <div class="premium-card p-4 bg-white text-center h-100 shadow-sm">
                    <div class="text-muted fw-700 text-uppercase small mb-1">Total Amount Billed</div>
                    <h2 class="fw-800 text-dark">$@((Model.Sum(m => m.AmountPaid) + Model.Sum(m => m.AmountPending)).ToString("N2"))</h2>
                </div>
            </div>
            <div class="col-md-6">
                <div class="premium-card p-4 bg-white text-center h-100 shadow-sm border-start border-5 border-warning">
                    <div class="text-muted fw-700 text-uppercase small mb-1">Current Outstanding Dues</div>
                    <h2 class="fw-800 text-warning">$@Model.Sum(m => m.AmountPending).ToString("N2")</h2>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="premium-card bg-white shadow-xl animate-fade-in">
    <div class="card-header border-0 bg-transparent py-4 px-4">
        <h5 class="fw-800 m-0">Consolidated Fee History</h5>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table premium-table mb-0">
                <thead>
                    <tr>
                        <th class="px-5">DATE</th>
                        <th>RECEIPT #</th>
                        <th>FEE TYPE</th>
                        <th>METHOD</th>
                        <th class="text-end">PAID</th>
                        <th class="text-end px-5">OUTSTANDING</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="px-5 fw-600">@item.PaidDate?.ToString("MMM dd, yyyy")</td>
                            <td><span class="badge-premium badge-info-premium fw-700">#@item.ReceiptNumber</span></td>
                            <td>@(item.FeeStructure?.Name ?? "Institutional Fee")</td>
                            <td><i class="fas fa-university me-2 text-muted"></i>@item.PaymentMethod</td>
                            <td class="text-end fw-800 text-success">$@item.AmountPaid.ToString("N2")</td>
                            <td class="text-end px-5 fw-800 text-danger">$@item.AmountPending.ToString("N2")</td>
                        </tr>
                    }
                </tbody>
                <tfoot class="bg-light">
                    <tr class="fw-800">
                        <td colspan="4" class="px-5 py-3">GRAND TOTALS FOR THIS STUDENT</td>
                        <td class="text-end py-3 text-success">$@Model.Sum(m => m.AmountPaid).ToString("N2")</td>
                        <td class="text-end px-5 py-3 text-danger">$@Model.Sum(m => m.AmountPending).ToString("N2")</td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>
</div>
