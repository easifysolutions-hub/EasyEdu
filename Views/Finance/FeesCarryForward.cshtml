@model IEnumerable<EasyEdu.Models.FeesCarryForward>
@{
    ViewData["Title"] = "Fees Carry Forward";
    Layout = "_Layout";
}

<div class="content-wrapper p-4 animate-fade-in">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="page-title mb-1">Fees Carry Forward</h3>
            <p class="text-muted small fw-600">Transfer pending dues to the next academic session</p>
        </div>
        <button class="btn btn-premium-purple btn-sm rounded-8">
            <i class="fas fa-forward me-2"></i>BULK TRANSFER
        </button>
    </div>

    <div class="premium-card">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table premium-table mb-0">
                    <thead>
                        <tr>
                            <th class="px-4">STUDENT</th>
                            <th>FROM YEAR</th>
                            <th>TO YEAR</th>
                            <th>DUE AMOUNT</th>
                            <th>TRANSFER DATE</th>
                            <th class="text-end px-4">REMARKS</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="px-4">
                                    <div class="fw-800 text-dark">@item.Student.FirstName @item.Student.LastName</div>
                                    <div class="small text-muted">ID: @item.Student.AdmissionNumber</div>
                                </td>
                                <td><span class="badge bg-light-subtle text-muted fw-800 border">Session 2024</span></td>
                                <td><span class="badge bg-primary-soft text-primary fw-800 border border-primary">Session 2025</span></td>
                                <td class="fw-900 text-danger">@item.DueAmount.ToString("C2")</td>
                                <td class="small fw-600">@item.TransferDate.ToString("dd MMM yyyy")</td>
                                <td class="text-end px-4 small font-italic text-muted">@item.Remarks</td>
                            </tr>
                        }
                         @if(!Model.Any()){
                            <tr><td colspan="6" class="text-center py-5 text-muted small fw-600">No carry forward records found.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
