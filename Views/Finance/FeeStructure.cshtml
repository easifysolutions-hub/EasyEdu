@model IEnumerable<EasyEdu.Models.FeeStructure>
@{
    ViewData["Title"] = "Fee Structure Master";
    Layout = "_Layout";
}

<div class="content-wrapper pt-0 animate-up">
    <!-- Premium Header -->
    <div class="d-flex justify-content-between align-items-center mb-4 px-3">
        <div>
            <h3 class="fw-800 text-dark mb-1">Fee Structure Master</h3>
            <p class="text-muted small fw-700 uppercase tracking-wider">
                <i class="fas fa-sitemap me-2 text-primary"></i> 
                Define standard fee amounts for each class/grade
            </p>
        </div>
        <a href="@Url.Action("CreateFeeStructure")" class="btn btn-premium-purple btn-sm px-4 rounded-pill shadow-lg fw-800 animate-up">
            <i class="fas fa-plus-circle me-2"></i> CREATE STRUCTURE
        </a>
    </div>

    <div class="premium-card bg-white shadow-md">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table premium-table mb-0">
                    <thead>
                        <tr>
                            <th class="px-4">STRUCTURE NAME</th>
                            <th>CLASS / GRADE</th>
                            <th>TOTAL AMOUNT</th>
                            <th>FREQUENCY</th>
                            <th>STATUS</th>
                            <th class="text-end px-4">ACTION</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr class="align-middle">
                                <td class="px-4">
                                    <div class="fw-800 text-dark">@item.Name</div>
                                    <div class="x-small text-muted fw-600">Created: @item.CreatedAt.ToString("dd MMM yyyy")</div>
                                </td>
                                <td>
                                    <span class="badge bg-primary-soft text-primary fw-800 px-3 py-2 rounded-pill">
                                        @item.Class?.Name
                                    </span>
                                </td>
                                <td class="fw-900 text-dark fs-5">@item.Amount.ToString("C2")</td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <i class="far fa-clock text-muted"></i>
                                        <span class="small fw-700">@item.Frequency</span>
                                    </div>
                                </td>
                                <td>
                                    @if(item.IsActive) {
                                        <span class="badge bg-success-soft text-success fw-800">ACTIVE</span>
                                    } else {
                                        <span class="badge bg-danger-soft text-danger fw-800">INACTIVE</span>
                                    }
                                </td>
                                <td class="text-end px-4">
                                    <div class="btn-group">
                                        <button class="btn btn-sm btn-light-soft rounded-circle px-2" title="Edit"><i class="fas fa-edit text-primary"></i></button>
                                        <button class="btn btn-sm btn-light-soft rounded-circle px-2" title="Delete"><i class="fas fa-trash text-danger"></i></button>
                                    </div>
                                </td>
                            </tr>
                        }
                        @if(!Model.Any())
                        {
                            <tr>
                                <td colspan="6" class="text-center py-5">
                                    <div class="py-5">
                                        <i class="fas fa-folder-open fa-4x text-gray-200 mb-3"></i>
                                        <h4 class="text-gray-400 fw-700">No Fee Structures Defined</h4>
                                        <p class="text-muted">Start by creating a fee structure for your classes.</p>
                                        <a href="@Url.Action("CreateFeeStructure")" class="btn btn-primary rounded-pill px-4 mt-3">Create First Structure</a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
