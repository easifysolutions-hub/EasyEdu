@{
    ViewData["Title"] = "Direct Transmission - Utilities";
    Layout = "_Layout";
    var templates = ViewBag.Templates as IEnumerable<EasyEdu.Models.MessageTemplate> ?? new List<EasyEdu.Models.MessageTemplate>();
}

<div class="page-header d-flex justify-content-between align-items-center mb-4 px-4">
    <div>
        <h1 class="page-title animate-slide-in"><i class="fas fa-paper-plane me-2 text-primary"></i> Direct Transmission</h1>
        <p class="text-muted fw-600">Enterprise communication interface for immediate institutional reach</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="MessageLog" class="btn btn-premium-blue rounded-12 px-4 shadow-sm fw-800">
            <i class="fas fa-history me-2"></i> AUDIT LOG
        </a>
    </div>
</div>

<div class="container-fluid px-4 pb-5">
    <div class="row g-4">
        <div class="col-xl-4 col-lg-5 mb-4">
            <div class="premium-card bg-white shadow-xl border-0 p-4 rounded-24 animate-fade-in transition-all h-100">
                <h5 class="fw-800 text-dark mb-4">Select Communication Protocol</h5>
                <div class="nav flex-column nav-pills gap-3" id="commTabs" role="tablist">
                    <a class="nav-link active rounded-20 p-4 d-flex align-items-center gap-3 border transition-all" id="emailTab" data-bs-toggle="pill" href="#emailContent">
                        <div class="icon-box bg-primary-soft text-primary rounded-circle shadow-sm">
                            <i class="fas fa-envelope fs-4"></i>
                        </div>
                        <div>
                            <h6 class="fw-800 mb-1">Electronic Mail</h6>
                            <p class="extra-small text-muted mb-0 fw-600">Secure, high-reach digital delivery</p>
                        </div>
                    </a>
                    <a class="nav-link rounded-20 p-4 d-flex align-items-center gap-3 border transition-all" id="smsTab" data-bs-toggle="pill" href="#smsContent">
                        <div class="icon-box bg-success-soft text-success rounded-circle shadow-sm">
                            <i class="fas fa-mobile-screen-button fs-4"></i>
                        </div>
                        <div>
                            <h6 class="fw-800 mb-1">Short Message Service</h6>
                            <p class="extra-small text-muted mb-0 fw-600">Urgent, mobile-first instant alerts</p>
                        </div>
                    </a>
                </div>
                
                <div class="mt-5 p-4 bg-light rounded-24">
                    <h6 class="fw-800 text-dark mb-3"><i class="fas fa-shield-halved text-success me-2"></i> Dispatch Parameters</h6>
                    <ul class="list-unstyled space-y-3">
                        <li class="d-flex gap-2 align-items-start mb-3">
                            <i class="fas fa-check-circle text-primary mt-1 small"></i>
                            <span class="small fw-700 text-muted">Audited transmission logs</span>
                        </li>
                        <li class="d-flex gap-2 align-items-start mb-3">
                            <i class="fas fa-check-circle text-primary mt-1 small"></i>
                            <span class="small fw-700 text-muted">Variables injection enabled</span>
                        </li>
                        <li class="d-flex gap-2 align-items-start">
                            <i class="fas fa-check-circle text-primary mt-1 small"></i>
                            <span class="small fw-700 text-muted">End-to-end institutional trust</span>
                        </li>
                    </ul>
                </div>
            </div>
        </div>

        <div class="col-xl-8 col-lg-7">
            <div class="tab-content border-0">
                <!-- EMAIL Content -->
                <div class="tab-pane fade show active" id="emailContent">
                    <div class="premium-card bg-white shadow-xl border-0 p-5 rounded-24 animate-fade-in transition-all">
                        <h5 class="fw-800 text-dark mb-4">ELECTRONIC MAIL DISPATCH</h5>
                        <form id="emailForm">
                            <div class="mb-4">
                                <label class="form-label fw-800 text-dark small-caps">Template Nexus</label>
                                <select id="emailTemplate" class="form-select premium-input shadow-none">
                                    <option value="">-- Zero Knowledge (Draft New) --</option>
                                    @foreach (var t in templates.Where(x => x.Type == "Email"))
                                    {
                                        <option value="@t.Body" data-subject="@t.Subject">@t.Name</option>
                                    }
                                </select>
                            </div>
                            <div class="mb-4">
                                <label class="form-label fw-800 text-dark small-caps">Recipient Nexus (Email Address)</label>
                                <input type="email" id="emailRecipient" class="form-control premium-input shadow-none" placeholder="e.g. academic@institution.edu" required>
                            </div>
                            <div class="mb-4">
                                <label class="form-label fw-800 text-dark small-caps">Transmission Header (Subject)</label>
                                <input type="text" id="emailSubject" class="form-control premium-input shadow-none" placeholder="Primary transmission title..." required>
                            </div>
                            <div class="mb-5">
                                <label class="form-label fw-800 text-dark small-caps">Transmission Body</label>
                                <textarea id="emailBody" class="form-control premium-input shadow-none" rows="8" placeholder="Enter detailed communication content..." required></textarea>
                            </div>
                            <button type="submit" class="btn btn-premium-primary w-100 py-3 rounded-16 shadow-lg fw-900 border-0">AUTHORIZE & DISPATCH MAIL</button>
                        </form>
                    </div>
                </div>

                <!-- SMS Content -->
                <div class="tab-pane fade" id="smsContent">
                    <div class="premium-card bg-white shadow-xl border-0 p-5 rounded-24 animate-fade-in transition-all">
                        <h5 class="fw-800 text-dark mb-4">SHORT MESSAGE DISPATCH</h5>
                        <form id="smsForm">
                             <div class="mb-4">
                                <label class="form-label fw-800 text-dark small-caps">Template Nexus</label>
                                <select id="smsTemplate" class="form-select premium-input shadow-none">
                                    <option value="">-- Zero Knowledge (Draft New) --</option>
                                    @foreach (var t in templates.Where(x => x.Type == "SMS"))
                                    {
                                        <option value="@t.Body">@t.Name</option>
                                    }
                                </select>
                            </div>
                            <div class="mb-4">
                                <label class="form-label fw-800 text-dark small-caps">Recipient Nexus (Phone Number)</label>
                                <input type="text" id="smsRecipient" class="form-control premium-input shadow-none" placeholder="e.g. +91 98765 43210" required>
                            </div>
                            <div class="mb-5">
                                <label class="form-label fw-800 text-dark small-caps">Transmission Body (160 Chars/Msg)</label>
                                <textarea id="smsBody" class="form-control premium-input shadow-none" rows="6" placeholder="Enter urgent alert content..." required></textarea>
                            </div>
                            <button type="submit" class="btn btn-success w-100 py-3 rounded-16 shadow-lg fw-900 border-0">AUTHORIZE & DISPATCH SMS</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .bg-primary-soft { background: rgba(99,102,241,0.08); }
    .bg-success-soft { background: rgba(16, 185, 129, 0.1); }
    .nav-pills .nav-link { color: #64748b; background: white; border: 2px solid #f3f4f6; }
    .nav-pills .nav-link.active { background-color: rgba(99,102,241,0.08) !important; color: #6366f1 !important; border-color: #6366f1 !important; }
    .premium-input { border: 2px solid #f3f4f6; border-radius: 12px; padding: 12px 16px; font-weight: 600; }
    .premium-input:focus { border-color: #6366f1; background: rgba(99,102,241,0.02); }
    .icon-box { width: 52px; height: 52px; display: flex; align-items: center; justify-content: center; }
    .small-caps { text-transform: uppercase; font-size: 0.75rem; letter-spacing: 0.05em; }
    .rounded-20 { border-radius: 20px; }
    .rounded-16 { border-radius: 16px; }
</style>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Template selection logic
            $("#emailTemplate").on("change", function() {
                var body = $(this).val();
                var sub = $(this).find('option:selected').data('subject') || "";
                $("#emailBody").val(body);
                $("#emailSubject").val(sub);
            });
            $("#smsTemplate").on("change", function() {
                var body = $(this).val();
                $("#smsBody").val(body);
            });

            // Form submission logic
            $("#emailForm").on("submit", function(e) {
                e.preventDefault();
                submitMessage("Email", $("#emailRecipient").val(), $("#emailSubject").val(), $("#emailBody").val());
            });
            $("#smsForm").on("submit", function(e) {
                e.preventDefault();
                submitMessage("SMS", $("#smsRecipient").val(), "SMS Blast", $("#smsBody").val());
            });

            function submitMessage(type, recipient, sub, body) {
                $.post("/Communicate/ExecuteSendMessage", { type: type, recipient: recipient, subject: sub, body: body }, function(res) {
                    if (res.success) {
                        Swal.fire({ icon: 'success', title: 'Transmission Successful', text: res.message, timer: 2000, showConfirmButton: false });
                        $("#emailBody, #emailRecipient, #emailSubject, #smsBody, #smsRecipient").val("");
                    }
                });
            }
        });
    </script>
}
