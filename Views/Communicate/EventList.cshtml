@model IEnumerable<EasyEdu.Models.CalendarEvent>
@{
    ViewData["Title"] = "Event Registry - Utilities";
    Layout = "_Layout";
}

<div class="page-header d-flex justify-content-between align-items-center mb-4 px-4">
    <div>
        <h1 class="page-title animate-slide-in"><i class="fas fa-list me-2 text-primary"></i> Objective Registry</h1>
        <p class="text-muted fw-600">Unified list of all scheduled institutional activities and milestones</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Calendar" class="btn btn-premium-blue rounded-12 px-4 shadow-sm fw-800">
            <i class="fas fa-calendar-day me-2"></i> INTERACTIVE MAP
        </a>
    </div>
</div>

<div class="container-fluid px-4 pb-5">
    <div class="premium-card bg-white shadow-xl border-0 overflow-hidden rounded-24 animate-fade-in">
        <div class="table-responsive">
            <table class="table premium-table mb-0">
                <thead>
                    <tr>
                        <th class="ps-4">SIGNAIL</th>
                        <th>EVENT HEADER</th>
                        <th>ACTIVATION START</th>
                        <th>ACTIVATION END</th>
                        <th>OPERATIONAL SCOPE</th>
                        <th class="text-end pe-4">STATUS</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var ev in Model)
                    {
                        <tr class="align-middle transition-all hover-light">
                            <td class="ps-4">
                                <div class="icon-box-sm rounded-circle shadow-sm" style="background: @ev.Color;"></div>
                            </td>
                            <td>
                                <div class="fw-800 text-dark">@ev.Title</div>
                            </td>
                            <td>
                                <div class="small fw-800 text-dark">@ev.StartDate.ToString("dd MMM yyyy")</div>
                                <div class="extra-small fw-600 text-muted">@ev.StartDate.ToString("HH:mm")</div>
                            </td>
                            <td>
                                <div class="small fw-800 text-dark">@ev.EndDate.ToString("dd MMM yyyy")</div>
                                <div class="extra-small fw-600 text-muted">@ev.EndDate.ToString("HH:mm")</div>
                            </td>
                            <td>
                                <div class="small fw-600 text-muted text-truncate" style="max-width: 300px;">@(ev.Description ?? "No description provided.")</div>
                            </td>
                            <td class="text-end pe-4">
                                @if (ev.EndDate < DateTime.Now)
                                {
                                    <span class="badge bg-light text-muted rounded-pill fw-800 px-3 py-2">TERMINATED</span>
                                }
                                else if (ev.StartDate <= DateTime.Now && ev.EndDate >= DateTime.Now)
                                {
                                    <span class="badge bg-success-soft text-success rounded-pill fw-800 px-3 py-2">LIVE NOW</span>
                                }
                                else
                                {
                                    <span class="badge bg-primary-soft text-primary rounded-pill fw-800 px-3 py-2">SCHEDULED</span>
                                }
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5">
                                <i class="fas fa-calendar-times fa-4x text-muted opacity-25 mb-4 d-block"></i>
                                <h5 class="fw-800 text-muted">No scheduled objectives found in the registry.</h5>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<style>
    .bg-primary-soft { background: rgba(99,102,241,0.08); }
    .bg-success-soft { background: rgba(16, 185, 129, 0.1); }
    .icon-box-sm { width: 24px; height: 24px; border: 3px solid white; }
    .hover-light:hover { background: rgba(0,0,0,0.01); }
    .extra-small { font-size: 0.7rem; }
</style>
