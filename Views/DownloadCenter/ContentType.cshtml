@model IEnumerable<string>
@{
    ViewData["Title"] = "Content Type";
    Layout = "_Layout";
}

<div class="content-wrapper p-4 animate-fade-in">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="page-title mb-1">Content Type</h3>
            <p class="text-muted small fw-600">Manage content categories and types</p>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-4">
            <div class="premium-card h-100">
                <div class="card-header bg-white border-0 p-4">
                    <h5 class="fw-800 text-dark m-0">Add Type</h5>
                </div>
                <div class="card-body p-4 pt-0">
                    <form>
                        <div class="mb-3">
                            <label class="form-label small fw-700 text-uppercase">Type Name *</label>
                            <input type="text" class="form-control-premium w-100" placeholder="e.g. Syllabus" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label small fw-700 text-uppercase">Description</label>
                            <textarea class="form-control-premium w-100" rows="3"></textarea>
                        </div>
                        <button type="button" class="btn btn-premium-primary w-100">SAVE TYPE</button>
                    </form>
                </div>
            </div>
        </div>
        <div class="col-lg-8">
            <div class="premium-card h-100">
                <div class="card-header bg-white border-0 p-4">
                    <h5 class="fw-800 text-dark m-0">Type List</h5>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table premium-table mb-0">
                            <thead>
                                <tr>
                                    <th class="px-4">NAME</th>
                                    <th>DESCRIPTION</th>
                                    <th class="text-end px-4">ACTION</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td class="px-4 fw-800">Assignment</td>
                                    <td class="text-muted small">Homework assignments for students</td>
                                    <td class="text-end px-4">
                                        <button class="btn btn-sm btn-light-soft rounded-circle px-2 text-primary"><i class="fas fa-edit"></i></button>
                                        <button class="btn btn-sm btn-light-soft rounded-circle px-2 text-danger"><i class="fas fa-trash-alt"></i></button>
                                    </td>
                                </tr>
                                <tr>
                                    <td class="px-4 fw-800">Syllabus</td>
                                    <td class="text-muted small">Course syllabus documents</td>
                                    <td class="text-end px-4">
                                        <button class="btn btn-sm btn-light-soft rounded-circle px-2 text-primary"><i class="fas fa-edit"></i></button>
                                        <button class="btn btn-sm btn-light-soft rounded-circle px-2 text-danger"><i class="fas fa-trash-alt"></i></button>
                                    </td>
                                </tr>
                                <tr>
                                    <td class="px-4 fw-800">Other Downloads</td>
                                    <td class="text-muted small">General downloadable content</td>
                                    <td class="text-end px-4">
                                        <button class="btn btn-sm btn-light-soft rounded-circle px-2 text-primary"><i class="fas fa-edit"></i></button>
                                        <button class="btn btn-sm btn-light-soft rounded-circle px-2 text-danger"><i class="fas fa-trash-alt"></i></button>
                                    </td>
                                </tr>
                                <tr>
                                    <td class="px-4 fw-800">Video</td>
                                    <td class="text-muted small">Educational videos</td>
                                    <td class="text-end px-4">
                                        <button class="btn btn-sm btn-light-soft rounded-circle px-2 text-primary"><i class="fas fa-edit"></i></button>
                                        <button class="btn btn-sm btn-light-soft rounded-circle px-2 text-danger"><i class="fas fa-trash-alt"></i></button>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
