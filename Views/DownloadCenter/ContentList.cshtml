@model IEnumerable<EasyEdu.Models.StudyMaterial>
@{
    ViewData["Title"] = ViewBag.ActiveType + " List";
    Layout = "_Layout";
}

<div class="content-wrapper p-4 animate-fade-in">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="page-title mb-1">@ViewBag.ActiveType</h3>
            <p class="text-muted small fw-600">Educational resources and reference materials</p>
        </div>
        <a href="@Url.Action("UploadContent")" class="btn btn-premium-purple btn-sm rounded-8">
            <i class="fas fa-upload me-2"></i>UPLOAD NEW
        </a>
    </div>

    <div class="premium-card">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table premium-table mb-0">
                    <thead>
                        <tr>
                            <th class="px-4">TITLE</th>
                            <th>TYPE</th>
                            <th>CLASS (SUBJECT)</th>
                            <th>DATE</th>
                            <th class="text-end px-4">ACTION</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="px-4">
                                    <div class="d-flex align-items-center">
                                        <div class="file-icon me-3 bg-light rounded-8 p-2">
                                            <i class="fas @(item.FileExtension == ".pdf" ? "fa-file-pdf text-danger" : "fa-file-word text-primary") fa-lg"></i>
                                        </div>
                                        <div>
                                            <div class="fw-800 text-dark">@item.Title</div>
                                            <div class="small text-muted fw-600">@item.FileExtension.ToUpper() File</div>
                                        </div>
                                    </div>
                                </td>
                                <td><span class="badge bg-light-subtle text-muted fw-800 border">@item.Type</span></td>
                                <td>
                                    @if(item.Class != null){
                                        <span class="fw-700">@item.Class.Name</span>
                                        <span class="small text-muted">(@(item.Subject?.Name ?? "General"))</span>
                                    } else {
                                        <span class="text-muted small fw-800">GLOBAL</span>
                                    }
                                </td>
                                <td class="small fw-700">@item.UploadDate.ToString("dd MMM yyyy")</td>
                                <td class="text-end px-4">
                                    <div class="btn-group">
                                        <a href="@item.FilePath" class="btn btn-sm btn-light-soft rounded-circle px-2" download><i class="fas fa-download text-success"></i></a>
                                        <button class="btn btn-sm btn-light-soft rounded-circle px-2"><i class="fas fa-trash text-danger"></i></button>
                                    </div>
                                </td>
                            </tr>
                        }
                        @if (!Model.Any())
                        {
                            <tr><td colspan="5" class="text-center py-5 text-muted small fw-600">No content found in this category.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
