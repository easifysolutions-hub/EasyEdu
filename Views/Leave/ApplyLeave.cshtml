@model IEnumerable<EasyEdu.Models.LeaveRequest>
@{
    ViewData["Title"] = "Personal Leave Terminal";
    Layout = "_Layout";
    var today = DateTime.Now.ToString("yyyy-MM-dd");
}

<div class="page-header d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="page-title animate-slide-in">Apply Leave</h1>
        <p class="text-muted fw-600">Submit leave requests and monitor approval status</p>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show d-flex align-items-center gap-2 mb-4" role="alert">
        <i class="fas fa-check-circle fs-5"></i>
        <div>@TempData["Success"]</div>
        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center gap-2 mb-4" role="alert">
        <i class="fas fa-exclamation-circle fs-5"></i>
        <div>@TempData["Error"]</div>
        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row g-4 animate-fade-in">
    <div class="col-xl-4">
        <div class="premium-card bg-white shadow-xl border-0 overflow-hidden h-100">
            <div class="p-4 border-bottom bg-primary text-white">
                <h5 class="fw-900 mb-0"><i class="fas fa-file-pen me-2"></i> NEW_APPLICATION</h5>
            </div>
            <div class="p-4">
                <form asp-action="ApplyLeave" method="post" enctype="multipart/form-data">
                    <div class="mb-3">
                        <label class="form-label fw-800 text-muted small uppercase">Leave Classification</label>
                        <select name="LeaveTypeId" class="form-select form-control-premium" asp-items="ViewBag.LeaveTypes" required>
                            <option value="">-- Choose Category --</option>
                        </select>
                    </div>
                    
                    <div class="row mb-3">
                        <div class="col-6">
                            <label class="form-label fw-800 text-muted small uppercase">From Date</label>
                            <input type="date" name="FromDate" class="form-control form-control-lg" required value="@today" />
                        </div>
                        <div class="col-6">
                            <label class="form-label fw-800 text-muted small uppercase">To Date</label>
                            <input type="date" name="ToDate" class="form-control form-control-lg" required value="@today" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-800 text-muted small uppercase">Reason for Leave</label>
                        <textarea name="Reason" class="form-control" rows="3" placeholder="Briefly state the reason for leave..."></textarea>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-800 text-muted small uppercase">Supporting Documents</label>
                        <input type="file" name="file" class="form-control" />
                    </div>

                    <button type="submit" class="btn btn-primary w-100 py-3 fs-6 fw-bold shadow-lg mt-2">
                        <i class="fas fa-paper-plane me-2"></i> Submit Leave Application
                    </button>
                </form>
            </div>
        </div>
    </div>

    <div class="col-xl-8">
        <div class="premium-card bg-white shadow-xl border-0 overflow-hidden h-100">
            <div class="p-4 border-bottom bg-info text-white">
                <h5 class="fw-900 mb-0"><i class="fas fa-history me-2"></i> My Leave History</h5>
            </div>
            <div class="table-responsive">
                <table class="table premium-table mb-0">
                    <thead>
                        <tr>
                            <th class="ps-4">Leave Type</th>
                            <th>Period</th>
                            <th>Days</th>
                            <th>Status</th>
                            <th class="text-end pe-4">Reason</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in Model)
                        {
                            <tr>
                                <td class="ps-4">
                                    <div class="fw-900 text-dark">
                                        @r.LeaveType?.Name
                                        @if (!string.IsNullOrEmpty(r.AttachmentPath))
                                        {
                                            <a href="@r.AttachmentPath" target="_blank" class="ms-2 text-primary animate-pulse" title="Download Document">
                                                <i class="fas fa-paperclip"></i>
                                            </a>
                                        }
                                    </div>
                                    <div class="small text-muted fw-700">Ref: LEV_@r.Id</div>
                                </td>
                                <td class="fw-700 text-muted small">
                                    @r.FromDate.ToString("MMM dd") - @r.ToDate.ToString("MMM dd, yyyy")
                                </td>
                                <td>
                                    <span class="badge bg-light text-primary fw-900 px-3 py-2 rounded-8">
                                        @((r.ToDate - r.FromDate).TotalDays + 1) DAYS
                                    </span>
                                </td>
                                <td>
                                    @if(r.Status == "Approved") {
                                        <span class="badge badge-success-premium shadow-sm px-3"><i class="fas fa-check-double me-1"></i> AUTHORIZED</span>
                                    } else if(r.Status == "Rejected") {
                                        <span class="badge badge-danger-premium shadow-sm px-3"><i class="fas fa-ban me-1"></i> REJECTED</span>
                                    } else {
                                        <span class="badge badge-warning-premium shadow-sm px-3 animate-pulse"><i class="fas fa-hourglass-half me-1"></i> PENDING_REVIEW</span>
                                    }
                                </td>
                                <td class="text-end pe-4">
                                    <button class="btn btn-sm btn-light-soft rounded-circle px-2" title="View Reason - @r.Reason"><i class="fas fa-info-circle text-info"></i></button>
                                </td>
                            </tr>
                        }
                        @if(!Model.Any()){
                            <tr>
                                <td colspan="5" class="text-center py-5 text-muted fw-600">No active leave dossiers found.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
