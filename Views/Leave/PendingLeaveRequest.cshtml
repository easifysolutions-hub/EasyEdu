@model IEnumerable<EasyEdu.Models.LeaveRequest>
@{
    ViewData["Title"] = "Absence Authorization Terminal";
    Layout = "_Layout";
}

<div class="page-header d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="page-title animate-slide-in">Absence Authorization Terminal</h1>
        <p class="text-muted fw-600">Review and authorize pending faculty and staff absence requests for currently active dossiers</p>
    </div>
</div>

<div class="premium-card bg-white shadow-xl border-0 overflow-hidden h-100 animate-fade-in">
    <div class="p-4 border-bottom bg-primary text-white">
        <h5 class="fw-900 mb-0"><i class="fas fa-hourglass-half me-2"></i> PENDING_AUTHORIZATION_DOSSIERS (@Model.Count())</h5>
    </div>
    <div class="table-responsive">
        <table class="table premium-table mb-0">
            <thead>
                <tr>
                    <th class="ps-4">STAFF_MEMBER</th>
                    <th>LEAVE_CLASSIFICATION</th>
                    <th>PERIOD_INDEX</th>
                    <th>DURATION</th>
                    <th>INSTITUTIONAL_REASON</th>
                    <th class="text-end pe-4">AUTHORIZATION_ACTION</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in Model)
                {
                    <tr id="req-@r.Id">
                        <td class="ps-4">
                            <div class="d-flex align-items-center">
                                <div class="avatar-sm bg-primary-soft text-primary rounded-circle me-3 d-flex align-items-center justify-content-center fw-900" style="width: 40px; height: 40px;">
                                    @r.User.UserName[0].ToString().ToUpper()
                                </div>
                                <div class="fw-800 text-dark">@r.User.UserName</div>
                            </div>
                        </td>
                        <td class="fw-800 text-muted">
                            @r.LeaveType?.Name
                            @if (!string.IsNullOrEmpty(r.AttachmentPath))
                            {
                                <a href="@r.AttachmentPath" target="_blank" class="ms-2 text-primary animate-pulse" title="Download Document">
                                    <i class="fas fa-paperclip"></i>
                                </a>
                            }
                        </td>
                        <td class="fw-700 text-muted small">
                            @r.FromDate.ToString("MMM dd") - @r.ToDate.ToString("MMM dd, yyyy")
                        </td>
                        <td>
                            <span class="badge bg-light text-primary fw-900 px-3 py-2 rounded-8 fs-6">
                                @((r.ToDate - r.FromDate).TotalDays + 1) DAYS
                            </span>
                        </td>
                        <td class="small fw-600 text-muted">@r.Reason</td>
                        <td class="text-end pe-4">
                            <div class="btn-group shadow-sm">
                                <button onclick="updateLeave(@r.Id, 'Approved')" class="btn btn-sm btn-success fw-900 px-3 py-2 rounded-start-8"><i class="fas fa-check-double me-1"></i> VERIFY</button>
                                <button onclick="updateLeave(@r.Id, 'Rejected')" class="btn btn-sm btn-danger fw-900 px-3 py-2 rounded-end-8"><i class="fas fa-ban me-1"></i> DENY</button>
                            </div>
                        </td>
                    </tr>
                }
                @if(!Model.Any()){
                    <tr>
                        <td colspan="6" class="text-center py-5 text-muted fw-600">No pending leave dossiers detected for review.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
    async function updateLeave(id, status) {
        const result = await Swal.fire({
            title: `Confirm Absence Authorization?`,
            text: `You are about to mark this request as ${status}.`,
            icon: 'question',
            showCancelButton: true,
            confirmButtonColor: status === 'Approved' ? '#22c55e' : '#ef4444',
            confirmButtonText: `YES, AUTHORIZE`
        });

        if (result.isConfirmed) {
            const response = await fetch('/Leave/UpdateStatus', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: `id=${id}&status=${status}`
            });
            const data = await response.json();
            if (data.success) {
                Swal.fire('AUTHORIZED!', `Dossier ${id} updated gracefully.`, 'success');
                document.getElementById(`req-${id}`).remove();
            }
        }
    }
</script>

<style>
    .bg-primary-soft { background: rgba(13, 110, 253, 0.1); }
</style>
