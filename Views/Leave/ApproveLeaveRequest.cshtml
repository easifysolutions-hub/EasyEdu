@model IEnumerable<EasyEdu.Models.LeaveRequest>
@{
    ViewData["Title"] = "Leave Authorization Terminal";
    Layout = "_Layout";
}

<div class="page-header d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="page-title animate-slide-in">Absence Authorization Archive</h1>
        <p class="text-muted fw-600">Complete historical index of faculty and staff leave requests and authorizations</p>
    </div>
</div>

<div class="premium-card bg-white shadow-xl border-0 overflow-hidden h-100">
    <div class="p-4 border-bottom bg-info text-white">
        <h5 class="fw-900 mb-0"><i class="fas fa-certificate me-2"></i> GLOBAL_LEAVE_DOSSIER_ARCHIVE</h5>
    </div>
    <div class="table-responsive">
        <table class="table premium-table mb-0">
            <thead>
                <tr>
                    <th class="ps-4">STAFF_MEMBER</th>
                    <th>LEAVE_CLASSIFICATION</th>
                    <th>PERIOD_INDEX</th>
                    <th>DURATION</th>
                    <th>STATUS_PROTOCOL</th>
                    <th class="text-end pe-4">AUTHORIZATION_LOG</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in Model)
                {
                    <tr>
                        <td class="ps-4">
                            <div class="d-flex align-items-center">
                                <div class="avatar-sm bg-light-soft text-primary rounded-circle me-3 d-flex align-items-center justify-content-center fw-900" style="width: 40px; height: 40px;">
                                    @r.User.UserName[0].ToString().ToUpper()
                                </div>
                                <div class="fw-800 text-dark">@r.User.UserName</div>
                            </div>
                        </td>
                        <td class="fw-800 text-muted">
                            @r.LeaveType?.Name
                            @if (!string.IsNullOrEmpty(r.AttachmentPath))
                            {
                                <a href="@r.AttachmentPath" target="_blank" class="ms-2 text-primary animate-pulse" title="Download Document">
                                    <i class="fas fa-paperclip"></i>
                                </a>
                            }
                        </td>
                        <td class="fw-700 text-muted small">
                            @r.FromDate.ToString("MMM dd") - @r.ToDate.ToString("MMM dd, yyyy")
                        </td>
                        <td>
                            <span class="badge bg-light text-primary fw-900 px-3 py-2 rounded-8 fs-6">
                                @((r.ToDate - r.FromDate).TotalDays + 1) DAYS
                            </span>
                        </td>
                        <td>
                            @if(r.Status == "Approved") {
                                <span class="badge badge-success-premium shadow-sm px-3"><i class="fas fa-check-double me-1"></i> AUTHORIZED</span>
                            } else if(r.Status == "Rejected") {
                                <span class="badge badge-danger-premium shadow-sm px-3"><i class="fas fa-ban me-1"></i> REJECTED</span>
                            } else {
                                <span class="badge badge-warning-premium shadow-sm px-3 animate-pulse"><i class="fas fa-hourglass-half me-1"></i> PENDING_REVIEW</span>
                            }
                        </td>
                        <td class="text-end pe-4">
                            @if(!string.IsNullOrEmpty(r.ApprovedBy)) {
                                <div class="small fw-800 text-muted uppercase">By: @r.ApprovedBy</div>
                                <div class="small text-muted fw-600">@r.ApprovedDate?.ToString("MMM dd, HH:mm")</div>
                            } else {
                                <span class="text-muted small fw-600 ms-auto">LOG_ENTRY_PENDING</span>
                            }
                        </td>
                    </tr>
                }
                @if(!Model.Any()){
                    <tr>
                        <td colspan="6" class="text-center py-5 text-muted fw-600">No leave dossiers detected in current repository.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<style>
    .bg-light-soft { background: rgba(13, 110, 253, 0.05); }
</style>
