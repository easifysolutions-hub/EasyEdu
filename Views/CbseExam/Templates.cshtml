@model IEnumerable<EasyEdu.Models.CbseMarkSheetTemplate>
@{
    ViewData["Title"] = "Certification Design Architect";
    Layout = "_Layout";
}

<div class="content-wrapper p-4 animate-fade-in text-dark">
    <div class="d-flex justify-content-between align-items-center mb-5">
        <div>
            <h2 class="fw-900 text-dark mb-1">Certification Design Architect</h2>
            <p class="text-muted small fw-600">Architect high-fidelity CBSE marksheet templates with institutional branding</p>
        </div>
        <button class="btn btn-premium-purple px-4 py-2 rounded-12 shadow-sm fw-900" data-bs-toggle="modal" data-bs-target="#templateModal">
            <i class="fas fa-magic me-2"></i>ARCHITECT TEMPLATE
        </button>
    </div>

    <div class="row g-4">
        @foreach (var t in Model)
        {
            <div class="col-md-6">
                <div class="premium-card p-0 overflow-hidden border-0 shadow-lg" style="border-radius: 20px;">
                    <div class="bg-premium-dark p-4 d-flex justify-content-between align-items-center">
                         <h5 class="fw-900 text-white m-0">@t.Name.ToUpper()</h5>
                         @if(t.IsDefault) { <span class="badge bg-success px-3 py-1 rounded-pill smallest fw-900">DEFAULT</span> }
                    </div>
                    <div class="p-4 bg-white">
                         <div class="d-flex align-items-center mb-4">
                             <div class="bg-light p-3 rounded-circle me-3">
                                 <i class="fas fa-file-invoice text-primary"></i>
                             </div>
                             <div>
                                 <p class="smallest text-muted fw-900 uppercase mb-0">Template Node</p>
                                 <h6 class="fw-900 text-dark m-0">Institutional Standard Pattern</h6>
                             </div>
                         </div>
                         <hr class="opacity-10 mb-4">
                         <div class="d-flex gap-2">
                             <button class="btn btn-light-soft w-100 rounded-12 fw-900 small">CONFIGURE DESIGN</button>
                             <button class="btn btn-light-soft text-danger rounded-circle shadow-sm"><i class="fas fa-trash"></i></button>
                         </div>
                    </div>
                </div>
            </div>
        }
        @if(!Model.Any()){
            <div class="col-12">
                 <div class="premium-card p-5 border-2 border-dashed text-center" style="border-radius: 24px; background: transparent;">
                     <i class="fas fa-drafting-compass fa-3x text-muted opacity-25 mb-4"></i>
                     <h5 class="fw-800 text-muted">Zero certification templates designed. Initializing standard architect nodes...</h5>
                 </div>
            </div>
        }
    </div>
</div>

<!-- Modal -->
<div class="modal fade animate-slide-up" id="templateModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 24px;">
            <form asp-action="SaveTemplate" method="post">
                <div class="modal-header border-0 bg-premium-dark text-white p-4">
                    <h5 class="fw-900 m-0"><i class="fas fa-palette me-2 text-info"></i>ARCHITECT CERTIFICATION NODE</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-4 text-dark text-dark">
                    <div class="mb-4">
                         <label class="form-label small fw-800 text-uppercase opacity-50">Template Architecture Title*</label>
                         <input name="Name" required class="form-control form-control-premium" placeholder="e.g. CBSE Pattern 2026 - Standard">
                    </div>
                    <div class="row g-4 mb-4">
                        <div class="col-md-12">
                             <label class="form-label small fw-800 text-uppercase opacity-50">Header Logic (HTML Content)</label>
                             <textarea name="HeaderContent" class="form-control form-control-premium" rows="3" placeholder="Institutional branding HTML..."></textarea>
                        </div>
                    </div>
                    <div class="row g-4 mb-0 align-items-center">
                        <div class="col-md-6">
                            <div class="form-check form-switch p-0 d-flex align-items-center">
                                <label class="small fw-900 text-uppercase opacity-75 m-0 me-3">Authorize Digital Signatures</label>
                                <input class="form-check-input ms-0" type="checkbox" name="ShowSignature" value="true" checked style="width: 45px; height: 22px;">
                            </div>
                        </div>
                         <div class="col-md-6">
                            <div class="form-check form-switch p-0 d-flex align-items-center">
                                <label class="small fw-900 text-uppercase opacity-75 m-0 me-3">Set as Default Node</label>
                                <input class="form-check-input ms-0" type="checkbox" name="IsDefault" value="true" style="width: 45px; height: 22px;">
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0 p-4 pt-0">
                    <button type="submit" class="btn btn-premium-purple w-100 py-3 rounded-12 shadow-lg fw-900 h6 mb-0">DEPLOY TEMPLATE</button>
                </div>
            </form>
        </div>
    </div>
</div>
