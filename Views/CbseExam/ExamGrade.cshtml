@model IEnumerable<EasyEdu.Models.CbseGrade>
@{
    ViewData["Title"] = "CBSE Grading Architecture";
    Layout = "_Layout";
}

<div class="content-wrapper p-4 animate-fade-in text-dark">
    <div class="d-flex justify-content-between align-items-center mb-5">
        <div>
            <h2 class="fw-900 text-dark mb-1">Grading Architecture Nexus</h2>
            <p class="text-muted small fw-600">Coordinate standard CBSE grading scales and percentage thresholds</p>
        </div>
        <button class="btn btn-premium-purple px-4 py-2 rounded-12 shadow-sm fw-900" data-bs-toggle="modal" data-bs-target="#gradeModal">
            <i class="fas fa-layer-group me-2"></i>ESTABLISH GRADE NODE
        </button>
    </div>

    <div class="premium-card p-0 overflow-hidden border-0 shadow-lg" style="border-radius: 24px;">
        <table class="table premium-table mb-0 align-middle text-dark">
            <thead class="bg-premium-dark text-white">
                <tr>
                    <th class="ps-5 py-4 fw-900 small text-uppercase">GRADE IDENTIFIER</th>
                    <th class="py-4 fw-900 small text-uppercase">PERCENTAGE THRESHOLD</th>
                    <th class="py-4 fw-900 small text-uppercase">DESCRIPTIVE LOG</th>
                    <th class="pe-5 text-end py-4 fw-900 small text-uppercase">ACTIONS</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var g in Model)
                {
                    <tr>
                        <td class="ps-5 py-4">
                            <span class="badge bg-primary px-4 py-2 rounded-8 fw-900 h6 mb-0">@g.Name</span>
                        </td>
                        <td class="py-4">
                            <div class="fw-900 text-dark">@g.MinPercentage% - @g.MaxPercentage%</div>
                        </td>
                        <td class="py-4">
                            <span class="text-muted small fw-700 italic">@g.Description</span>
                        </td>
                        <td class="pe-5 text-end py-4">
                             <div class="d-flex justify-content-end gap-2">
                                <button class="btn btn-icon btn-light-soft rounded-circle shadow-sm border"><i class="fas fa-edit text-primary"></i></button>
                                <button class="btn btn-icon btn-light-soft rounded-circle shadow-sm border"><i class="fas fa-trash text-danger"></i></button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Modal -->
<div class="modal fade animate-slide-up" id="gradeModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 24px;">
            <form asp-action="SaveGrade" method="post">
                <div class="modal-header border-0 bg-premium-dark text-white p-4">
                    <h5 class="fw-900 m-0"><i class="fas fa-graduation-cap me-2 text-info"></i>DEFINE GRADE NODE</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="mb-4 text-dark">
                        <label class="form-label small fw-800 text-uppercase opacity-50">Grade Code (e.g. A1)*</label>
                        <input name="Name" required class="form-control form-control-premium" placeholder="A1">
                    </div>
                    <div class="row g-4 mb-4">
                         <div class="col-6 text-dark">
                             <label class="form-label small fw-800 text-uppercase opacity-50">Min Percentage</label>
                             <input name="MinPercentage" type="number" step="0.01" required value="91" class="form-control form-control-premium">
                        </div>
                         <div class="col-6 text-dark">
                             <label class="form-label small fw-800 text-uppercase opacity-50">Max Percentage</label>
                             <input name="MaxPercentage" type="number" step="0.01" required value="100" class="form-control form-control-premium">
                        </div>
                    </div>
                    <div class="mb-0 text-dark">
                        <label class="form-label small fw-800 text-uppercase opacity-50">Descriptive Interpretation</label>
                        <textarea name="Description" class="form-control form-control-premium" rows="2" placeholder="e.g. Outstanding Performance"></textarea>
                    </div>
                </div>
                <div class="modal-footer border-0 p-4 pt-0">
                    <button type="submit" class="btn btn-premium-purple w-100 py-3 rounded-12 shadow-lg fw-900 h6 mb-0">ESTABLISH GRADE NODE</button>
                </div>
            </form>
        </div>
    </div>
</div>
