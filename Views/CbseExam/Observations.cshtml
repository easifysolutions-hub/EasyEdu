@model IEnumerable<EasyEdu.Models.CbseObservation>
@{
    ViewData["Title"] = "Qualitative Observation Domains";
    Layout = "_Layout";
}

<div class="content-wrapper p-4 animate-fade-in text-dark">
    <div class="d-flex justify-content-between align-items-center mb-5">
        <div>
            <h2 class="fw-900 text-dark mb-1">Observation Domain Architect</h2>
            <p class="text-muted small fw-600">Coordinate qualitative assessment domains and their associated behavioral parameters</p>
        </div>
        <div class="d-flex gap-3">
             <a href="@Url.Action("ObservationParameters")" class="btn btn-light-soft px-4 py-2 rounded-12 fw-700">
                <i class="fas fa-list me-2"></i>PARAMETER REGISTRY
            </a>
            <button class="btn btn-premium-purple px-4 py-2 rounded-12 shadow-sm fw-900" data-bs-toggle="modal" data-bs-target="#obsModal">
                <i class="fas fa-plus me-2"></i>ADD DOMAIN NODE
            </button>
        </div>
    </div>

    <div class="row g-4">
        @foreach (var o in Model)
        {
            <div class="col-md-6">
                <div class="premium-card p-0 overflow-hidden border-0 shadow-lg" style="border-radius: 20px;">
                    <div class="card-header bg-premium-dark text-white p-4 d-flex justify-content-between align-items-center">
                         <h5 class="fw-900 m-0 ls-1">@o.Name.ToUpper()</h5>
                         <span class="badge bg-info px-3 py-2 rounded-pill fw-900">@o.Parameters.Count PARAMETERS</span>
                    </div>
                    <div class="card-body p-4 bg-white">
                         <ul class="list-unstyled mb-4">
                             @foreach(var p in o.Parameters.Take(3))
                             {
                                 <li class="d-flex align-items-center mb-2 small fw-700 text-muted">
                                     <i class="fas fa-check-circle text-success me-2 opacity-50"></i> @p.Name
                                 </li>
                             }
                             @if(o.Parameters.Count > 3) { <li class="smallest text-muted italic fw-700 opacity-50">+ @(o.Parameters.Count - 3) more parameters</li> }
                         </ul>
                         <hr class="opacity-10 mb-4">
                         <div class="d-flex gap-2">
                             <a href="@Url.Action("ObservationParameters")" class="btn btn-light-soft w-100 rounded-12 fw-900 small">MANAGE REGISTRY</a>
                             <button class="btn btn-light-soft text-danger rounded-circle shadow-sm"><i class="fas fa-trash"></i></button>
                         </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<!-- Modal -->
<div class="modal fade animate-slide-up" id="obsModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 24px;">
            <form asp-action="SaveObservation" method="post">
                <div class="modal-header border-0 bg-premium-dark text-white p-4">
                    <h5 class="fw-900 m-0"><i class="fas fa-eye me-2 text-info"></i>DEFINE DOMAIN NODE</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-4 text-dark">
                    <div class="mb-0">
                        <label class="form-label small fw-800 text-uppercase opacity-50">Domain Title (e.g. Co-Curricular)*</label>
                        <input name="Name" required class="form-control form-control-premium" placeholder="Personality Development">
                    </div>
                </div>
                <div class="modal-footer border-0 p-4 pt-0">
                    <button type="submit" class="btn btn-premium-purple w-100 py-3 rounded-12 shadow-lg fw-900 h6 mb-0">ESTABLISH DOMAIN</button>
                </div>
            </form>
        </div>
    </div>
</div>
