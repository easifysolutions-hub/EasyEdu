@{
    ViewData["Title"] = "Academic Performance Intelligence";
    Layout = "_Layout";
}

<div class="content-wrapper p-4 animate-fade-in text-dark">
    <div class="d-flex justify-content-between align-items-center mb-5">
        <div>
            <h2 class="fw-900 text-dark mb-1">Academic Performance Intelligence</h2>
            <p class="text-muted small fw-600">High-fidelity cross-term performance analytics and institutional evaluation metrics</p>
        </div>
        <button onclick="window.print()" class="btn btn-light-soft px-4 py-2 rounded-12 shadow-sm fw-700">
            <i class="fas fa-print me-2"></i>BATCH EXPORT
        </button>
    </div>

    <div class="row g-4">
        <div class="col-md-4">
            <div class="premium-card p-5 border-0 shadow-lg text-center h-100" style="border-radius: 24px;">
                 <i class="fas fa-chart-pie fa-3x text-primary opacity-25 mb-4"></i>
                 <h5 class="fw-900 text-dark mb-4 ls-1 uppercase italic opacity-50">Cross-Term Analytics</h5>
                 <p class="text-muted small fw-700 mb-4 text-dark">Analyze institutional performance trends between academic terms and evaluation cycles.</p>
                 <button class="btn btn-premium-purple w-100 py-3 rounded-12 shadow-sm fw-900 h6 opacity-50">TRACE TRENDS</button>
            </div>
        </div>
        <div class="col-md-4">
            <div class="premium-card p-5 border-0 shadow-lg text-center h-100" style="border-radius: 24px;">
                 <i class="fas fa-user-graduate fa-3x text-success opacity-25 mb-4"></i>
                 <h5 class="fw-900 text-dark mb-4 ls-1 uppercase italic opacity-50">Student Proficiency</h5>
                 <p class="text-muted small fw-700 mb-4 text-dark">Aggregated student proficiency reports based on standard CBSE grading nodes.</p>
                 <button class="btn btn-premium-purple w-100 py-3 rounded-12 shadow-sm fw-900 h6 opacity-50">EXAMINE LOGS</button>
            </div>
        </div>
        <div class="col-md-4">
            <div class="premium-card p-5 border-0 shadow-lg text-center h-100" style="border-radius: 24px;">
                 <i class="fas fa-brain fa-3x text-warning opacity-25 mb-4"></i>
                 <h5 class="fw-900 text-dark mb-4 ls-1 uppercase italic opacity-50">Qualitative Intelligence</h5>
                 <p class="text-muted small fw-700 mb-4 text-dark">Synthesis of behavioral observations and co-scholastic parameter metrics.</p>
                 <button class="btn btn-premium-purple w-100 py-3 rounded-12 shadow-sm fw-900 h6 opacity-50">ANALYZE QUALITATIVE</button>
            </div>
        </div>
    </div>
</div>

<style>
    .ls-1 { letter-spacing: 1px; }
</style>
