@model IEnumerable<EasyEdu.Models.ChatBlockedUser>
@{
    ViewData["Title"] = "Blocked Directory - Utilities";
    Layout = "_Layout";
}

<div class="page-header d-flex justify-content-between align-items-center mb-4 px-4">
    <div>
        <h1 class="page-title animate-slide-in"><i class="fas fa-user-slash me-2 text-primary"></i> Access Restriction</h1>
        <p class="text-muted fw-600">Manage individuals restricted from institutional communication</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Settings" class="btn btn-premium-blue rounded-12 px-4 shadow-sm fw-800">
            <i class="fas fa-arrow-left me-2"></i> SETTINGS
        </a>
    </div>
</div>

<div class="container-fluid px-4 pb-5">
    <div class="row justify-content-center">
        <div class="col-xl-9 col-lg-10">
            <div class="premium-card bg-white shadow-xl border-0 overflow-hidden rounded-24 animate-fade-in">
                <div class="p-4 border-bottom bg-light d-flex align-items-center">
                    <div class="icon-box-sm bg-danger text-white rounded-circle me-3">
                        <i class="fas fa-shield-alt"></i>
                    </div>
                    <h5 class="fw-800 text-dark mb-0">Restricted Communication Registry</h5>
                </div>
                <div class="table-responsive">
                    <table class="table premium-table mb-0">
                        <thead>
                            <tr>
                                <th class="ps-4">RESTRICTED COLLEAGUE</th>
                                <th>RESTRICTION DATE</th>
                                <th>SECURITY STATUS</th>
                                <th class="text-end pe-4">ACTIONS</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var b in Model)
                            {
                                <tr class="align-middle">
                                    <td class="ps-4">
                                        <div class="d-flex align-items-center">
                                            @if (!string.IsNullOrEmpty(b.Blocked?.ProfilePicture))
                                            {
                                                <img src="@b.Blocked.ProfilePicture" class="rounded-circle shadow-sm me-3" style="width: 44px; height: 44px; object-fit: cover;" alt="" />
                                            }
                                            else
                                            {
                                                <div class="avatar-placeholder rounded-circle bg-light text-muted d-flex align-items-center justify-content-center me-3" style="width: 44px; height: 44px; font-weight: 800;">
                                                    @(b.Blocked?.FullName?[0] ?? '?')
                                                </div>
                                            }
                                            <div>
                                                <div class="fw-800 text-dark">@b.Blocked?.FullName</div>
                                                <div class="small fw-600 text-muted">@b.Blocked?.Email</div>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="small fw-700 text-muted uppercase">@b.BlockedAt.ToString("dd MMM yyyy, HH:mm")</div>
                                    </td>
                                    <td>
                                        <span class="badge bg-danger-soft text-danger fw-800 px-3 py-2 rounded-pill">
                                            <i class="fas fa-ban me-1"></i> RESTRICTED
                                        </span>
                                    </td>
                                    <td class="text-end pe-4">
                                        <form asp-action="UnblockUser" method="post">
                                            <input type="hidden" name="id" value="@b.Id" />
                                            <button type="submit" class="btn btn-success-soft text-success rounded-pill px-4 fw-800 border-0">
                                                <i class="fas fa-unlock me-1"></i> RESTORE ACCESS
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                            @if (!Model.Any())
                            {
                                <tr>
                                    <td colspan="4" class="text-center py-5">
                                        <i class="fas fa-shield-check fa-3x text-muted opacity-25 mb-3 d-block"></i>
                                        <div class="fw-800 text-muted">Registry clean. No colleagues are currently restricted.</div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .bg-danger-soft { background: rgba(239, 68, 68, 0.1); }
    .btn-success-soft { background: rgba(16, 185, 129, 0.1); }
    .btn-success-soft:hover { background: rgba(16, 185, 129, 0.2); }
    .icon-box-sm { width: 32px; height: 32px; display: flex; align-items: center; justify-content: center; }
</style>
