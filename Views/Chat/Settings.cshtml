@model EasyEdu.Models.ChatSettings
@{
    ViewData["Title"] = "Chat Configuration - Utilities";
    Layout = "_Layout";
}

<div class="page-header d-flex justify-content-between align-items-center mb-4 px-4">
    <div>
        <h1 class="page-title animate-slide-in"><i class="fas fa-user-gear me-2 text-primary"></i> Communication Policy</h1>
        <p class="text-muted fw-600">Define your visibility and security parameters for the messaging terminal</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Index" class="btn btn-premium-blue rounded-12 px-4 shadow-sm fw-800">
            <i class="fas fa-arrow-left me-2"></i> CHAT TERMINAL
        </a>
    </div>
</div>

<div class="container-fluid px-4 pb-5">
    <div class="row justify-content-center">
        <div class="col-xl-8 col-lg-10">
            <div class="premium-card bg-white shadow-xl border-0 overflow-hidden rounded-24 animate-fade-in">
                <div class="p-4 border-bottom bg-light">
                    <h5 class="fw-800 text-dark mb-0">Personal Safety & Signal Parameters</h5>
                </div>
                <div class="p-5">
                    <form asp-action="UpdateSettings" method="post">
                        <div class="row g-5">
                            <div class="col-md-7">
                                <!-- Visibility Toggle -->
                                <div class="setting-item d-flex justify-content-between align-items-center mb-5 p-4 bg-light rounded-24 border">
                                    <div class="me-4">
                                        <h6 class="fw-800 text-dark mb-1">Terminal Availability</h6>
                                        <p class="small text-muted mb-0 fw-600">Toggle your overall ability to send and receive institutional messages.</p>
                                    </div>
                                    <div class="form-check form-switch fs-3">
                                        <input asp-for="IsChatActive" class="form-check-input shadow-none cursor-pointer" type="checkbox">
                                    </div>
                                </div>

                                <!-- Online Status Toggle -->
                                <div class="setting-item d-flex justify-content-between align-items-center mb-5 p-4 bg-light rounded-24 border">
                                    <div class="me-4">
                                        <h6 class="fw-800 text-dark mb-1">Presence Signal</h6>
                                        <p class="small text-muted mb-0 fw-600">Show a real-time 'Online' indicator to your colleagues when you are active.</p>
                                    </div>
                                    <div class="form-check form-switch fs-3">
                                        <input asp-for="ShowOnlineStatus" class="form-check-input shadow-none cursor-pointer" type="checkbox">
                                    </div>
                                </div>

                                <!-- Invitation Policy Toggle -->
                                <div class="setting-item d-flex justify-content-between align-items-center mb-0 p-4 bg-light rounded-24 border">
                                    <div class="me-4">
                                        <h6 class="fw-800 text-dark mb-1">Collaborative Openness</h6>
                                        <p class="small text-muted mb-0 fw-600">Allow connection requests from any verified colleague within the institution.</p>
                                    </div>
                                    <div class="form-check form-switch fs-3">
                                        <input asp-for="AllowInvitationsFromEveryone" class="form-check-input shadow-none cursor-pointer" type="checkbox">
                                    </div>
                                </div>
                            </div>

                            <div class="col-md-5">
                                <div class="premium-card bg-primary-soft border-0 p-4 h-100 rounded-24">
                                    <div class="icon-box-sm bg-primary text-white rounded-circle shadow-sm mb-3">
                                        <i class="fas fa-info-circle"></i>
                                    </div>
                                    <h6 class="fw-800 text-primary-dark mb-3">Privacy Intelligence</h6>
                                    <ul class="list-unstyled space-y-3">
                                        <li class="d-flex gap-2 align-items-start mb-3">
                                            <i class="fas fa-check-circle text-primary mt-1"></i>
                                            <span class="small fw-700 text-muted">Your modifications will reflect company-wide.</span>
                                        </li>
                                        <li class="d-flex gap-2 align-items-start mb-3">
                                            <i class="fas fa-check-circle text-primary mt-1"></i>
                                            <span class="small fw-700 text-muted">Restricted users from your <a asp-action="BlockedUsers" class="text-decoration-underline fw-800">Blacklist</a> take precedence.</span>
                                        </li>
                                        <li class="d-flex gap-2 align-items-start">
                                            <i class="fas fa-check-circle text-primary mt-1"></i>
                                            <span class="small fw-700 text-muted">Real-time status is cached for 5 minutes.</span>
                                        </li>
                                    </ul>
                                    <div class="mt-auto pt-4">
                                        <button type="submit" class="btn btn-premium-primary w-100 py-3 shadow-lg fw-900 rounded-16 border-0">
                                            <i class="fas fa-save me-2"></i> COMMIT CHANGES
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .bg-primary-soft { background: rgba(99,102,241,0.08); }
    .text-primary-dark { color: #312e81; }
    .cursor-pointer { cursor: pointer; }
    .icon-box-sm { width: 32px; height: 32px; display: flex; align-items: center; justify-content: center; }
    .rounded-16 { border-radius: 16px; }
</style>
