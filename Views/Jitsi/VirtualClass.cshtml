@model IEnumerable<EasyEdu.Models.JitsiVirtualClass>
@{
    ViewData["Title"] = "Virtual Learning Hub";
    Layout = "_Layout";
}

<div class="content-wrapper p-4 animate-fade-in text-dark">
    <div class="d-flex justify-content-between align-items-center mb-5">
        <div>
            <h2 class="fw-900 text-dark mb-1">Jitsi Virtual Classroom</h2>
            <p class="text-muted small fw-600">Coordinate and deploy interactive peer-to-peer curriculum sessions</p>
        </div>
        <button class="btn btn-premium-purple px-4 py-3 rounded-12 shadow-lg fw-900" data-bs-toggle="modal" data-bs-target="#addClassModal">
            <i class="fas fa-satellite-dish me-2"></i>DEPLOY ACADEMIC NODE
        </button>
    </div>

    <!-- Active Grid -->
    <div class="row g-4 mb-5">
        @foreach (var vclass in Model.Where(m => m.Status == "Pending" || m.Status == "Live"))
        {
            <div class="col-xl-4 col-md-6">
                <div class="premium-card overflow-hidden border-0 shadow-lg h-100 position-relative" style="border-radius: 24px;">
                    <div class="bg-primary bg-opacity-10 p-4 border-bottom d-flex justify-content-between align-items-start">
                         <div class="d-flex align-items-center gap-3">
                             <div class="bg-white p-3 rounded-circle shadow-sm">
                                 <i class="fas fa-graduation-cap text-primary fa-lg"></i>
                             </div>
                             <div>
                                 <h6 class="fw-900 text-dark mb-0 ls-1">@vclass.Class?.Name</h6>
                                 <p class="smallest text-muted m-0 fw-700 uppercase">SECTION @vclass.Section?.Name</p>
                             </div>
                         </div>
                         <span class="badge @(vclass.Status == "Live" ? "bg-success" : "bg-warning text-dark") rounded-pill px-3 py-2 fw-900 shadow-sm border border-opacity-50 pulse-animation">
                              <i class="fas fa-circle smallest me-1 text-white opacity-75"></i> @vclass.Status.ToUpper()
                         </span>
                    </div>

                    <div class="p-4">
                        <h5 class="fw-900 text-dark mb-1">@vclass.Topic</h5>
                        <p class="smallest text-muted fw-700 mb-3">
                            Room ID: @vclass.MeetingId 
                            | <a href="@Url.Action("JoinRoom", new { meetingId = vclass.MeetingId })" target="_blank" class="text-primary fw-800 text-decoration-underline">Direct Join Link</a>
                        </p>
                        
                        <div class="d-flex gap-4 mb-4">
                             <div class="bg-light-soft p-3 rounded-16 flex-fill border shadow-sm">
                                  <i class="far fa-calendar-alt text-muted mb-2 fa-lg"></i>
                                  <p class="smallest text-muted fw-800 m-0 uppercase flex-fill">Temporal Mark</p>
                                  <h6 class="fw-900 text-dark m-0">@vclass.Date.ToString("dd MMM yyyy")</h6>
                             </div>
                             <div class="bg-light-soft p-3 rounded-16 flex-fill border shadow-sm">
                                  <i class="far fa-clock text-info mb-2 fa-lg"></i>
                                  <p class="smallest text-muted fw-800 m-0 uppercase flex-fill">Chronology</p>
                                  <h6 class="fw-900 text-dark m-0">@vclass.StartTime</h6>
                             </div>
                        </div>

                        <div class="bg-light-soft p-3 rounded-16 mb-4 border shadow-sm d-flex align-items-center justify-content-between">
                            <div class="d-flex align-items-center gap-3">
                                 <i class="fas fa-hourglass-half text-warning"></i>
                                 <p class="small fw-900 text-dark m-0">@vclass.DurationMinutes MINUTES</p>
                            </div>
                            <span class="badge bg-secondary rounded-pill uppercase fw-800 me-2">DUR</span>
                        </div>
                        
                        <div class="d-grid mt-auto">
                            <a href="@Url.Action("HostRoom", new { meetingId = vclass.MeetingId })" target="_blank" class="btn btn-primary py-3 rounded-16 fw-900 h6 mb-0 shadow-lg">
                                <i class="fas fa-play me-2"></i> INITIALIZE BROADCAST
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
        @if(!Model.Any(m => m.Status == "Pending" || m.Status == "Live")) {
             <div class="col-12 py-5 text-center text-muted fw-700 italic opacity-50">
                 <i class="fas fa-satellite fa-3x mb-3 text-secondary"></i>
                 <p>Zero active virtual academic nodes broadcasting.</p>
             </div>
        }
    </div>

    <!-- Modal Form -->
    <div class="modal fade animate-slide-up" id="addClassModal" tabindex="-1">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg" style="border-radius: 24px;">
                <form asp-action="SaveVirtualClass" method="post">
                    <input type="hidden" name="Id" value="0" />
                    <div class="modal-header border-0 bg-premium-dark text-white p-4">
                        <div class="d-flex align-items-center gap-3">
                             <div class="bg-white bg-opacity-10 p-2 rounded-circle border border-white border-opacity-25">
                                 <i class="fas fa-cogs fa-lg text-info"></i>
                             </div>
                             <h4 class="fw-900 m-0">Deploy Academic Node</h4>
                        </div>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                    </div>
                    
                    <div class="modal-body p-5 pt-4 text-dark bg-secondary bg-opacity-10">
                        <div class="row g-4">
                            <div class="col-12">
                                <label class="form-label small fw-800 text-uppercase opacity-75 d-flex gap-2 align-items-center"><i class="fas fa-heading text-primary"></i> Topic Designation</label>
                                <input name="Topic" required class="form-control form-control-premium shadow-sm py-3 fw-900" placeholder="e.g. Advanced Quantum Mechanics">
                            </div>

                            <div class="col-md-4">
                                <label class="form-label small fw-800 text-uppercase opacity-75 d-flex gap-2 align-items-center"><i class="fas fa-layer-group text-info"></i> Class Hierarchy</label>
                                <select name="ClassId" class="form-select form-control-premium shadow-sm py-3" required>
                                    @foreach(var cls in ViewBag.Classes){ <option value="@cls.Id">@cls.Name</option> }
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label small fw-800 text-uppercase opacity-75 d-flex gap-2 align-items-center"><i class="fas fa-puzzle-piece text-info"></i> Section Node</label>
                                <select name="SectionId" class="form-select form-control-premium shadow-sm py-3" required>
                                    @foreach(var sec in ViewBag.Sections){ <option value="@sec.Id">@sec.Name</option> }
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label small fw-800 text-uppercase opacity-75 d-flex gap-2 align-items-center"><i class="fas fa-book text-info"></i> Subject Matrix</label>
                                <select name="SubjectId" class="form-select form-control-premium shadow-sm py-3" required>
                                    @foreach(var sub in ViewBag.Subjects){ <option value="@sub.Id">@sub.Name</option> }
                                </select>
                            </div>

                            <div class="col-md-4">
                                <label class="form-label small fw-800 text-uppercase opacity-75 d-flex gap-2 align-items-center"><i class="far fa-calendar text-danger"></i> Temporal Input</label>
                                <input name="Date" type="date" required class="form-control form-control-premium shadow-sm py-3 text-dark fw-900">
                            </div>
                            <div class="col-md-4">
                                <label class="form-label small fw-800 text-uppercase opacity-75 d-flex gap-2 align-items-center"><i class="far fa-clock text-danger"></i> Chronology Sync</label>
                                <input name="StartTime" type="time" required class="form-control form-control-premium shadow-sm py-3 text-dark fw-900">
                            </div>
                            <div class="col-md-4">
                                <label class="form-label small fw-800 text-uppercase opacity-75 d-flex gap-2 align-items-center"><i class="fas fa-hourglass text-danger"></i> Duration (Mins)</label>
                                <input name="DurationMinutes" type="number" required class="form-control form-control-premium shadow-sm py-3 fw-900" placeholder="60">
                            </div>

                            <div class="col-12">
                                <label class="form-label small fw-800 text-uppercase opacity-75 d-flex gap-2 align-items-center"><i class="fas fa-align-left text-secondary"></i> Narrative Parameters (Optional)</label>
                                <textarea name="Description" rows="3" class="form-control form-control-premium shadow-sm py-3" placeholder="Context details..."></textarea>
                            </div>
                        </div>
                    </div>

                    <div class="modal-footer border-0 p-5 pt-3 bg-secondary bg-opacity-10">
                        <button type="submit" class="btn btn-premium-purple w-100 py-4.5 rounded-16 shadow-lg fw-900 h5 mb-0 ls-1">
                            <i class="fas fa-rocket me-2"></i> DEPLOY ACADEMIC BROADCAST
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<style>
    .bg-premium-dark { background: #0f172a; }
    .bg-light-soft { background: #f8fafc; }
    .ls-1 { letter-spacing: 1px; }
    .uppercase { text-transform: uppercase; }
    .btn-premium-purple { background: #8b5cf6; color: white; border: none; }
    .rounded-16 { border-radius: 16px; }
</style>
