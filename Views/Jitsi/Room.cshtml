@{
    ViewData["Title"] = "Jitsi Communication Node";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Communication Node | EasyEdu Interlink</title>
    <script src="https://@(ViewBag.Domain)/external_api.js"></script>
    <style>
        body, html { margin: 0; padding: 0; width: 100%; height: 100%; overflow: hidden; background-color: #0f172a; font-family: 'Inter', sans-serif;}
        #jitsi-container { width: 100%; height: 100%; }
        .loading-overlay { position: fixed; top:0; left:0; width:100%; height:100%; display: flex; flex-direction:column; align-items: center; justify-content: center; background: #0f172a; z-index: 9999; color: white;}
        .hidden { display: none !important; }
        .spinner { width: 40px; height: 40px; border: 4px solid rgba(255,255,255,0.1); border-left-color: #0d6efd; border-radius: 50%; animation: spin 1s linear infinite; margin-bottom: 20px;}
        @@keyframes spin { 100% { transform: rotate(360deg); } }
        .branding { text-transform: uppercase; letter-spacing: 2px; font-weight: 800; font-size: 14px; opacity: 0.7;}
    </style>
</head>
<body>
    
    <div id="loader" class="loading-overlay">
        <div class="spinner"></div>
        <div class="branding">INITIALIZING P2P PROTOCOL...</div>
    </div>

    <div id="jitsi-container"></div>

    <script>
        document.addEventListener("DOMContentLoaded", () => {
             const domain = '@ViewBag.Domain';
             const options = {
                 roomName: '@ViewBag.RoomId',
                 width: '100%',
                 height: '100%',
                 parentNode: document.querySelector('#jitsi-container'),
                 userInfo: {
                     displayName: '@ViewBag.UserName'
                 },
                 configOverwrite: { 
                     startWithAudioMuted: @ViewBag.MuteOnStart.ToString().ToLower(),
                     startWithVideoMuted: false,
                     disableDeepLinking: true,
                 },
                 interfaceConfigOverwrite: {
                     DISABLE_DOMINANT_SPEAKER_INDICATOR: false,
                     SHOW_CHROME_EXTENSION_BANNER: false,
                     TOOLBAR_BUTTONS: [
                        'microphone', 'camera', 'closedcaptions', 'desktop', 'embedmeeting', 'fullscreen',
                        'fodeviceselection', 'hangup', 'profile', 'chat', 'recording',
                        'livestreaming', 'etherpad', 'sharedvideo', 'settings', 'raisehand',
                        'videoquality', 'filmstrip', 'invite', 'feedback', 'stats', 'shortcuts',
                        'tileview', 'videobackgroundblur', 'download', 'help', 'mute-everyone', 'security'
                     ]
                 }
             };
             
             // Dynamic Screen sharing access
             if(@ViewBag.AllowScreenShare.ToString().ToLower() === false) {
                 options.interfaceConfigOverwrite.TOOLBAR_BUTTONS = options.interfaceConfigOverwrite.TOOLBAR_BUTTONS.filter(b => b !== 'desktop');
             }

             const api = new JitsiMeetExternalAPI(domain, options);
             
             api.addEventListener('videoConferenceJoined', () => {
                 document.getElementById('loader').classList.add('hidden');
             });
        });
    </script>
</body>
</html>
