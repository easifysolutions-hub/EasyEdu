@{
    ViewData["Title"] = "Jitsi Meet Hub";
    Layout = "_Layout";
}
<div class="page-header px-4 mb-4 animate-slide-in">
    <h1 class="page-title"><i class="fas fa-headset me-2 text-warning"></i> Jitsi Addon</h1>
    <p class="text-muted fw-600">Open-source video conferencing integration</p>
</div>
<div class="container-fluid px-4">
    <div class="premium-card bg-white shadow-xl border-0 rounded-24 p-5 text-center">
        <i class="fas fa-comments fa-4x text-warning opacity-25 mb-4"></i>
        <h3 class="fw-900">Jitsi Bridge Connected</h3>
        <p class="text-muted">Direct institutional video bridging enabled.</p>
        <button class="btn btn-warning text-white rounded-pill px-5 py-3 mt-4 fw-800 shadow-lg">JOIN CHANNEL</button>
    </div>
</div>
