@{
    ViewData["Title"] = "Profit & Loss";
    Layout = "_Layout";
    decimal revenue = ViewBag.TotalRevenue ?? 0;
    decimal expense = ViewBag.TotalExpense ?? 0;
    decimal profit = revenue - expense;
}

<div class="content-wrapper p-4 animate-fade-in">
    <div class="d-flex justify-content-between align-items-center mb-4 text-dark">
        <div>
            <h3 class="page-title mb-1">Profit & Loss Statement</h3>
            <p class="text-muted small fw-600">Overview of institutional financial performance</p>
        </div>
        <div class="badge bg-light-subtle text-primary border px-4 py-2 rounded-8 fw-800">
            @ViewBag.DateRange
        </div>
    </div>

    <div class="row g-4 mb-5">
        <div class="col-md-4">
            <div class="premium-card p-4 text-center border-0" style="background: linear-gradient(135deg, #10b981 0%, #059669 100%); color: white;">
                <div class="small fw-700 opacity-80 text-uppercase mb-2">Total Revenue</div>
                <h2 class="fw-900 m-0">@revenue.ToString("C0")</h2>
                <div class="mt-3 small opacity-70">Incl. Fees & Direct Income</div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="premium-card p-4 text-center border-0" style="background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%); color: white;">
                <div class="small fw-700 opacity-80 text-uppercase mb-2">Total Expenses</div>
                <h2 class="fw-900 m-0">@expense.ToString("C0")</h2>
                <div class="mt-3 small opacity-70">Incl. Salaries & Utility</div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="premium-card p-4 text-center border-0" style="background: linear-gradient(135deg, #6366f1 0%, #4f46e5 100%); color: white;">
                <div class="small fw-700 opacity-80 text-uppercase mb-2">Net Profit</div>
                <h2 class="fw-900 m-0">@profit.ToString("C0")</h2>
                <div class="mt-3 small opacity-70">Current Session Surplus</div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-xl-6">
            <div class="premium-card">
                <div class="card-header bg-white border-0 p-4">
                    <h5 class="fw-800 text-dark m-0">Revenue Breakdown</h5>
                </div>
                <div class="card-body p-4 pt-0">
                    <div class="d-flex justify-content-between mb-3">
                        <span class="text-muted fw-700">Student Fees</span>
                        <span class="fw-900 text-dark">@(ViewBag.TotalRevenue - 0) ???</span> @* Placeholder logic *@
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-6">
             <div class="premium-card">
                <div class="card-header bg-white border-0 p-4">
                    <h5 class="fw-800 text-dark m-0">Expense Breakdown</h5>
                </div>
                <div class="card-body p-4 pt-0">
                    <div class="d-flex justify-content-between mb-3">
                        <span class="text-muted fw-700">Staff Salaries</span>
                        <span class="fw-900 text-dark">Placeholder</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
