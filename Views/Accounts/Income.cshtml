@model IEnumerable<EasyEdu.Models.Income>
@{
    ViewData["Title"] = "Direct Income";
    Layout = "_Layout";
}

<div class="content-wrapper p-4 animate-fade-in">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div class="d-flex align-items-center gap-3">
            <h3 class="page-title m-0">Direct Income Registry</h3>
            <form asp-action="Income" method="get" class="d-flex gap-2">
                <input type="text" name="searchTerm" class="form-control-premium py-1 px-3" style="width: 250px;" placeholder="Search income..." value="@ViewBag.SearchTerm">
                <button type="submit" class="btn btn-premium-primary btn-sm rounded-8 px-3">SEARCH</button>
            </form>
        </div>
        <button class="btn btn-premium-purple btn-sm rounded-8" onclick="toggleForm()">
            <i class="fas fa-plus me-2"></i>ADD INCOME
        </button>
    </div>

    <div class="row g-4">
        <div class="col-xl-4" id="formColumn">
            <div class="premium-card">
                <div class="card-header bg-white border-0 p-4">
                    <h5 class="fw-800 text-dark m-0">Add Income Entry</h5>
                </div>
                <div class="card-body p-4 pt-0">
                    <form asp-action="CreateIncome" method="post">
                        <div class="mb-3">
                            <label class="form-label small fw-700 text-uppercase">Income Title*</label>
                            <input type="text" name="Title" class="form-control-premium w-100" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label small fw-700 text-uppercase">Amount*</label>
                            <input type="number" name="Amount" class="form-control-premium w-100" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label small fw-700 text-uppercase">Category/Head*</label>
                            <select name="Category" class="form-select form-control-premium" asp-items="ViewBag.Heads" required>
                                <option value="">Select Head</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label small fw-700 text-uppercase">Payment Method</label>
                            <select name="PaymentMethod" class="form-select form-control-premium">
                                <option value="Cash">Cash</option>
                                <option value="Cheque">Cheque</option>
                                <option value="Bank">Bank Transfer</option>
                            </select>
                        </div>
                        <button type="submit" class="btn btn-premium-primary w-100">SAVE INCOME</button>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-xl-8" id="listColumn">
            <div class="premium-card">
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table premium-table mb-0">
                            <thead>
                                <tr>
                                    <th class="px-4">TITLE</th>
                                    <th>HEAD</th>
                                    <th>DATE</th>
                                    <th>AMOUNT</th>
                                    <th>METHOD</th>
                                    <th class="text-end px-4">CONTROL</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var i in Model)
                                {
                                    <tr>
                                        <td class="px-4 fw-800 text-dark">@i.Title</td>
                                        <td><span class="badge bg-success-soft text-success fw-800 border-0">@i.Category</span></td>
                                        <td class="small fw-700">@i.Date.ToShortDateString()</td>
                                        <td class="fw-900 text-dark">@i.Amount.ToString("C0")</td>
                                        <td class="small fw-800 text-muted">@i.PaymentMethod.ToUpper()</td>
                                        <td class="text-end px-4">
                                            <form asp-action="DeleteIncome" method="post" style="display:inline;" onsubmit="return confirm('Are you sure you want to delete this income entry?')">
                                                <input type="hidden" name="id" value="@i.Id" />
                                                <button type="submit" class="btn btn-sm btn-light-soft rounded-circle px-2 text-danger"><i class="fas fa-trash"></i></button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    function toggleForm() {
        const form = document.getElementById('formColumn');
        const list = document.getElementById('listColumn');
        if (form.style.display === 'none') {
            form.style.display = 'block';
            list.className = 'col-xl-8';
        } else {
            form.style.display = 'none';
            list.className = 'col-xl-12';
        }
    }
</script>
