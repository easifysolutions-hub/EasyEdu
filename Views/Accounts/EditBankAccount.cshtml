@model EasyEdu.Models.BankAccount
@{
    ViewData["Title"] = "Edit Bank Account";
    Layout = "_Layout";
}

<div class="content-wrapper p-4 animate-fade-in">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="page-title mb-1">Edit Bank Account</h3>
            <p class="text-muted small fw-600">Update account particulars</p>
        </div>
         <a href="@Url.Action("BankAccount")" class="btn btn-outline-secondary btn-sm rounded-8 fw-700">Back to List</a>
    </div>

    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="premium-card">
                <div class="card-body p-4">
                    <form asp-action="EditBankAccount" method="post">
                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="CurrentBalance" />
                        
                        <div class="mb-3">
                            <label class="form-label small fw-700 text-uppercase">Bank Name*</label>
                            <input asp-for="BankName" class="form-control form-control-premium w-100" required>
                            <span asp-validation-for="BankName" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label small fw-700 text-uppercase">Account Name*</label>
                            <input asp-for="AccountName" class="form-control form-control-premium w-100" required>
                            <span asp-validation-for="AccountName" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label small fw-700 text-uppercase">Account Number*</label>
                            <input asp-for="AccountNumber" class="form-control form-control-premium w-100" required>
                            <span asp-validation-for="AccountNumber" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label small fw-700 text-uppercase">Opening Balance</label>
                            <input asp-for="OpeningBalance" class="form-control form-control-premium w-100" type="number" step="0.01">
                            <span asp-validation-for="OpeningBalance" class="text-danger small"></span>
                        </div>

                        <button type="submit" class="btn btn-premium-primary w-100 mt-2">SAVE CHANGES</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
