@model IEnumerable<EasyEdu.Models.ChartOfAccount>
@{
    ViewData["Title"] = "Chart of Accounts";
    Layout = "_Layout";
}

<div class="content-wrapper p-4 animate-fade-in">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div class="d-flex align-items-center gap-3">
            <h3 class="page-title m-0">Chart of Accounts (Ledger Heads)</h3>
            <form asp-action="ChartOfAccount" method="get" class="d-flex gap-2">
                <input type="text" name="searchTerm" class="form-control-premium py-1 px-3" style="width: 250px;" placeholder="Search heads..." value="@ViewBag.SearchTerm">
                <button type="submit" class="btn btn-premium-primary btn-sm rounded-8 px-3">SEARCH</button>
            </form>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-xl-4">
            <div class="premium-card">
                <div class="card-header bg-white border-0 p-4">
                    <h5 class="fw-800 text-dark m-0">Add Ledger Head</h5>
                </div>
                <div class="card-body p-4 pt-0">
                    <form asp-action="CreateChartOfAccount" method="post">
                        <div class="mb-3">
                            <label class="form-label small fw-700 text-uppercase">Head Name*</label>
                            <input type="text" name="Head" class="form-control-premium w-100" required placeholder="e.g. Sales Revenue">
                        </div>
                        <div class="mb-3">
                            <label class="form-label small fw-700 text-uppercase">Account Type*</label>
                            <select name="Type" class="form-select form-control-premium" required>
                                <option value="Income">Income</option>
                                <option value="Expense">Expense</option>
                            </select>
                        </div>
                        <button type="submit" class="btn btn-premium-primary w-100">SAVE HEAD</button>
                    </form>
                </div>
            </div>
        </div>
        <div class="col-xl-8">
            <div class="premium-card">
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table premium-table mb-0">
                            <thead>
                                <tr>
                                    <th class="px-4">HEAD NAME</th>
                                    <th>TYPE</th>
                                    <th>STATUS</th>
                                    <th class="text-end px-4">ACTION</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var c in Model)
                                {
                                    <tr>
                                        <td class="px-4 fw-800 text-dark">@c.Head</td>
                                        <td>
                                            <span class="badge @(c.Type == "Income" ? "bg-success-soft text-success" : "bg-danger-soft text-danger") fw-800 border-0">
                                                @c.Type.ToUpper()
                                            </span>
                                        </td>
                                        <td>
                                            @if(c.IsActive){
                                                <span class="badge badge-success-premium">ACTIVE</span>
                                            } else {
                                                <span class="badge badge-danger-premium">INACTIVE</span>
                                            }
                                        </td>
                                        <td class="text-end px-4">
                                            <form asp-action="DeleteChartOfAccount" method="post" style="display:inline;" onsubmit="return confirm('Are you sure you want to delete this ledger head?')">
                                                <input type="hidden" name="id" value="@c.Id" />
                                                <button type="submit" class="btn btn-sm btn-light-soft rounded-circle px-2 text-danger"><i class="fas fa-trash"></i></button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
