@model IEnumerable<EasyEdu.Models.Attendance>
@{
    ViewData["Title"] = "QR Attendance Dashboard";
    Layout = "_Layout";
}

<div class="content-wrapper p-4 animate-fade-in text-dark">
    <div class="d-flex justify-content-between align-items-center mb-5">
        <div>
            <h2 class="fw-900 text-dark mb-1">QR Attendance Nexus</h2>
            <p class="text-muted small fw-600">Real-time synchronized logs from dynamic QR participation nodes</p>
        </div>
        <div class="d-flex gap-3">
             <a href="@Url.Action("Settings")" class="btn btn-premium-purple px-4 py-2 rounded-12 shadow-sm fw-900">
                <i class="fas fa-qrcode me-2"></i>GENERATE QR
            </a>
            <a href="@Url.Action("AutoSubmission")" class="btn btn-light-soft px-4 py-2 rounded-12 fw-700">
                <i class="fas fa-robot me-2"></i>AUTO STATUS
            </a>
        </div>
    </div>

    <!-- Stats Matrix -->
    <div class="row g-4 mb-5">
        <div class="col-md-3">
            <div class="stat-card p-4 rounded-24 bg-white shadow-sm border-0 border-start border-4 border-success">
                <p class="text-uppercase smallest fw-900 text-muted mb-2">Synchronized Today</p>
                <div class="d-flex align-items-end justify-content-between">
                    <h3 class="fw-900 m-0 text-dark">@ViewBag.StatsToday</h3>
                    <i class="fas fa-check-circle text-success opacity-25 fa-2x"></i>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stat-card p-4 rounded-24 bg-white shadow-sm border-0 border-start border-4 border-warning">
                <p class="text-uppercase smallest fw-900 text-muted mb-2">Late Detection</p>
                <div class="d-flex align-items-end justify-content-between">
                    <h3 class="fw-900 m-0 text-dark">@ViewBag.LateToday</h3>
                    <i class="fas fa-clock text-warning opacity-25 fa-2x"></i>
                </div>
            </div>
        </div>
         <div class="col-md-3">
            <div class="stat-card p-4 rounded-24 bg-white shadow-sm border-0 border-start border-4 border-primary">
                <p class="text-uppercase smallest fw-900 text-muted mb-2">Total Logged (QR)</p>
                <div class="d-flex align-items-end justify-content-between">
                    <h3 class="fw-900 m-0 text-dark">@ViewBag.StatsTotal</h3>
                    <i class="fas fa-database text-primary opacity-25 fa-2x"></i>
                </div>
            </div>
        </div>
         <div class="col-md-3">
            <div class="stat-card p-4 rounded-24 bg-premium-dark text-white shadow-lg border-0">
                <p class="text-uppercase smallest fw-900 opacity-50 mb-4 ls-1">Infrastructure Status</p>
                <div class="d-flex justify-content-between align-items-center">
                    <span class="badge bg-success px-3 rounded-pill fw-900">ACTIVE</span>
                    <i class="fas fa-shield-virus text-info opacity-50"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="premium-card p-0 overflow-hidden border-0 shadow-lg" style="border-radius: 24px;">
        <div class="card-header bg-white border-bottom p-4 d-flex justify-content-between align-items-center">
             <h5 class="fw-900 text-dark m-0"><i class="fas fa-stream me-2 text-primary opacity-50"></i>Live Synchronization Logs</h5>
             <button class="smallest fw-900 text-uppercase ls-1 text-primary border-0 bg-transparent">Export Nexus Trace</button>
        </div>
        <div class="card-body p-0">
            <table class="table premium-table mb-0 align-middle">
                <thead class="bg-light-soft">
                    <tr class="text-muted smaller fw-900 uppercase ls-1">
                        <th class="ps-5 py-3 border-0">IDENTIFIER</th>
                        <th class="py-3 border-0">ACADEMIC LOCATION</th>
                        <th class="py-3 border-0">TEMPORAL LOG</th>
                        <th class="py-3 border-0">STATUS</th>
                        <th class="pe-5 text-end py-3 border-0">ACTIONS</th>
                    </tr>
                </thead>
                <tbody class="bg-white">
                    @foreach (var log in Model)
                    {
                        <tr>
                            <td class="ps-5 py-4">
                                <span class="fw-900 text-dark d-block">@log.Student?.FullName</span>
                                <span class="smallest text-muted fw-700 font-monospace uppercase">ID: @log.Student?.AdmissionNumber</span>
                            </td>
                            <td>
                                <div class="small fw-800 text-dark">@log.Student?.Class?.Name</div>
                                <div class="smallest text-muted fw-700">QR NODE SYNC</div>
                            </td>
                             <td>
                                <div class="fw-700 text-dark small">@log.CreatedAt.ToString("HH:mm:ss")</div>
                                <div class="smallest text-muted fw-700 opacity-50">@log.Date.ToString("dd MMM yyyy")</div>
                            </td>
                            <td>
                                <span class="badge @(log.Status == "Present" ? "bg-success" : (log.Status == "Late" ? "bg-warning" : "bg-danger")) px-3 rounded-pill fw-900 shadow-sm border small">@log.Status.ToUpper()</span>
                            </td>
                            <td class="pe-5 text-end">
                                <button class="btn btn-sm btn-light rounded-pill px-3 fw-900"><i class="fas fa-eye me-1 opacity-50"></i>TRACE</button>
                            </td>
                        </tr>
                    }
                    @if(!Model.Any()){
                        <tr>
                            <td colspan="5" class="text-center py-5">
                                 <i class="fas fa-user-clock fa-3x text-muted opacity-20 mb-3"></i>
                                 <h5 class="fw-800 text-muted italic">Zero QR participation events detected in current audit window.</h5>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<style>
    .bg-premium-dark { background: #1e293b; }
    .bg-light-soft { background: #f8fafc; }
    .rounded-24 { border-radius: 24px; }
    .rounded-12 { border-radius: 12px; }
    .ls-1 { letter-spacing: 1px; }
    .btn-premium-purple { background: #8b5cf6; color: white; border: none; }
</style>
