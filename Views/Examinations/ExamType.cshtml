@model IEnumerable<EasyEdu.Models.ExamType>
@{
    ViewData["Title"] = "Exam Categories";
}

<div class="container-fluid animate-fade-in">
    <div class="row">
        <div class="col-lg-4">
            <div class="card premium-card border-0 shadow-sm">
                <div class="card-header bg-gradient-info text-white py-3">
                    <h5 class="mb-0 fw-800"><i class="fas fa-plus-circle me-2"></i>Create Exam Type</h5>
                </div>
                <div class="card-body p-4">
                    <form asp-action="CreateExamType" method="post">
                        <div class="mb-3">
                            <label class="form-label fw-700 small text-muted uppercase">Exam Type Name</label>
                            <input name="Name" class="form-control border-2" placeholder="e.g. Unit Test, Final Exam" required />
                        </div>
                        <div class="mb-4 d-flex align-items-center">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" name="IsPaid" id="isPaid">
                                <label class="form-check-label fw-600 ms-2" for="isPaid">Is Paid Exam?</label>
                            </div>
                        </div>
                        <button type="submit" class="btn btn-info w-100 py-2 fw-800 text-white shadow-sm">
                            <i class="fas fa-save me-2"></i>SAVE EXAM TYPE
                        </button>
                    </form>
                </div>
            </div>
        </div>
        <div class="col-lg-8">
            <div class="card premium-card border-0 shadow-sm">
                <div class="card-header bg-white py-3">
                    <h5 class="mb-0 fw-800 text-dark"><i class="fas fa-list me-2"></i>Exam Type List</h5>
                </div>
                <div class="table-responsive">
                    <table class="table premium-table mb-0">
                        <thead class="bg-light">
                            <tr>
                                <th class="ps-4">#</th>
                                <th>Name</th>
                                <th class="text-center">Paid Status</th>
                                <th class="text-end pe-4">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var type in Model)
                            {
                                <tr>
                                    <td class="ps-4">@type.Id</td>
                                    <td class="fw-800 text-dark">@type.Name</td>
                                    <td class="text-center">
                                        @if (type.IsPaid)
                                        {
                                            <span class="badge bg-success-soft text-success px-3 py-2 rounded-pill fw-800">PAID</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-light text-muted px-3 py-2 rounded-pill fw-700">FREE</span>
                                        }
                                    </td>
                                    <td class="text-end pe-4">
                                        <button class="btn btn-icon-premium text-danger"><i class="fas fa-trash"></i></button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .bg-success-soft { background: rgba(16, 185, 129, 0.1); }
</style>
