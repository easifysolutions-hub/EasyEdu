@model IEnumerable<EasyEdu.Models.ExamSchedule>
@{
    ViewData["Title"] = "Exam Schedule";
}

<div class="container-fluid animate-fade-in">
    <div class="card premium-card border-0 shadow-sm mb-4">
        <div class="card-header bg-gradient-primary text-white py-3 d-flex justify-content-between align-items-center">
            <h5 class="mb-0 fw-800"><i class="fas fa-calendar-alt me-2"></i>Examination Schedule</h5>
            <button class="btn btn-white btn-sm fw-800" data-bs-toggle="modal" data-bs-target="#addScheduleModal">
                <i class="fas fa-plus me-1"></i> ADD SCHEDULE
            </button>
        </div>
        <div class="card-body p-4">
            <form method="get" class="row g-3 mb-4">
                <div class="col-md-5">
                    <select name="examId" class="form-select border-2" asp-items="ViewBag.Exams">
                        <option value="">Select Examination...</option>
                    </select>
                </div>
                <div class="col-md-5">
                    <select name="classId" class="form-select border-2" asp-items="ViewBag.Classes">
                        <option value="">Select Class...</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-primary w-100 fw-800">FILTER</button>
                </div>
            </form>

            <div class="table-responsive">
                <table class="table premium-table">
                    <thead>
                        <tr>
                            <th>Exam</th>
                            <th>Class/Section</th>
                            <th>Subject</th>
                            <th>Date</th>
                            <th>Time</th>
                            <th>Room</th>
                            <th>Marks (F/P)</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var s in Model)
                        {
                            <tr>
                                <td class="fw-800 text-primary">@s.Examination.Name</td>
                                <td class="fw-700">@s.Class.Name (@s.Section.Name)</td>
                                <td class="fw-800 text-dark">@s.Subject.Name</td>
                                <td class="fw-700">@s.ExamDate.ToString("dd MMM yyyy")</td>
                                <td><span class="badge bg-light text-dark fw-700">@s.StartTime - @s.EndTime</span></td>
                                <td class="fw-600">@s.ClassRoom.RoomNo</td>
                                <td class="fw-800">@s.FullMarks / <span class="text-danger">@s.PassMarks</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
