@model IEnumerable<EasyEdu.Models.MarkGrade>
@{
    ViewData["Title"] = "Marking Grades";
}

<div class="container-fluid animate-fade-in">
    <div class="row">
        <div class="col-lg-4">
            <div class="card premium-card border-0 shadow-sm">
                <div class="card-header bg-gradient-warning text-white py-3">
                    <h5 class="mb-0 fw-800"><i class="fas fa-plus-circle me-2"></i>Configure Grade</h5>
                </div>
                <div class="card-body p-4">
                    <form asp-action="CreateGrade" method="post">
                        <div class="mb-3">
                            <label class="form-label fw-800 small text-muted uppercase">Grade Name (A+, B, etc.)</label>
                            <input name="Name" class="form-control border-2 fw-900 fs-5" required />
                        </div>
                        <div class="row g-3 mb-3">
                            <div class="col-6">
                                <label class="form-label fw-700 small">Min %</label>
                                <input name="MinPercentage" type="number" step="0.01" class="form-control border-2" required />
                            </div>
                            <div class="col-6">
                                <label class="form-label fw-700 small">Max %</label>
                                <input name="MaxPercentage" type="number" step="0.01" class="form-control border-2" required />
                            </div>
                        </div>
                        <div class="mb-4">
                            <label class="form-label fw-700 small">GPA Point</label>
                            <input name="Gpa" type="number" step="0.01" class="form-control border-2" required />
                        </div>
                        <button type="submit" class="btn btn-warning w-100 py-2 fw-800 text-white shadow-sm">
                            <i class="fas fa-save me-2"></i>SAVE GRADE CONFIG
                        </button>
                    </form>
                </div>
            </div>
        </div>
        <div class="col-lg-8">
            <div class="card premium-card border-0 shadow-sm">
                <div class="card-header bg-white py-3">
                    <h5 class="mb-0 fw-800 text-dark">Established Grade Structure</h5>
                </div>
                <div class="table-responsive">
                    <table class="table premium-table mb-0">
                        <thead>
                            <tr class="bg-light">
                                <th class="ps-4">Grade</th>
                                <th>Range (%)</th>
                                <th>GPA</th>
                                <th class="text-end pe-4">Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var g in Model)
                            {
                                <tr>
                                    <td class="ps-4 fw-900 fs-5 text-primary">@g.Name</td>
                                    <td class="fw-700">@g.MinPercentage% - @g.MaxPercentage%</td>
                                    <td><span class="badge bg-primary-soft text-primary px-3 py-1 fw-800">@g.Gpa</span></td>
                                    <td class="text-end pe-4">
                                        <span class="text-success fw-800"><i class="fas fa-check-circle me-1"></i>Active</span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .bg-primary-soft { background: rgba(13, 110, 253, 0.1); }
</style>
