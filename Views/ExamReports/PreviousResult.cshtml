@model IEnumerable<EasyEdu.Models.Mark>
@{
    ViewData["Title"] = "Previous Academic Results";
    Layout = "_Layout";
}

<div class="content-wrapper p-4 animate-fade-in">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="page-title mb-1">Previous Result History</h3>
            <p class="text-muted small fw-600">Complete archive of past examination performances</p>
        </div>
        <div class="no-print">
            <button class="btn btn-premium-primary btn-sm rounded-8" onclick="window.print()">
                <i class="fas fa-print me-2"></i>PRINT ARCHIVE
            </button>
        </div>
    </div>

    <div class="premium-card p-4 mb-4 no-print">
        <form method="get" class="row g-3 align-items-end">
            <div class="col-md-8">
                <label class="form-label small fw-800 text-uppercase opacity-50">Select Student Register</label>
                <select name="studentId" class="form-select form-control-premium select2" asp-items="ViewBag.Students" required>
                    <option value="">Search by Admission Number / Name</option>
                </select>
            </div>
            <div class="col-md-4">
                <button type="submit" class="btn btn-premium-purple w-100">FETCH HISTORY</button>
            </div>
        </form>
    </div>

    @if (Model.Any())
    {
        var groupedByExam = Model.GroupBy(m => m.Examination.Name);
        
        @foreach (var group in groupedByExam)
        {
            <div class="premium-card mb-4 border-start border-4 border-primary">
                <div class="card-header bg-white py-3 px-4 d-flex justify-content-between align-items-center">
                    <h5 class="mb-0 fw-800 text-dark text-uppercase">@group.Key</h5>
                    <span class="badge bg-primary-soft text-primary px-3 rounded-pill">ACADEMIC SESSION</span>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table premium-table mb-0">
                            <thead>
                                <tr>
                                    <th class="px-4">SUBJECT</th>
                                    <th class="text-center">MAX</th>
                                    <th class="text-center">OBTAINED</th>
                                    <th class="text-center">GRADE</th>
                                    <th class="px-4 text-end">REMARKS</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var m in group)
                                {
                                    <tr>
                                        <td class="px-4 fw-700">@m.Subject.Name</td>
                                        <td class="text-center fw-600">@m.MaxMarks</td>
                                        <td class="text-center fw-800 text-primary">@m.MarksObtained</td>
                                        <td class="text-center fw-900">@m.Grade</td>
                                        <td class="px-4 text-end small italic text-muted">@m.Remarks</td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot class="bg-light-subtle">
                                <tr>
                                    <td class="px-4 fw-800">CUMULATIVE RESULT</td>
                                    <td class="text-center fw-800">@group.Sum(x => x.MaxMarks)</td>
                                    <td class="text-center fw-900 text-primary">@group.Sum(x => x.MarksObtained)</td>
                                    <td colspan="2" class="px-4 text-end">
                                        @{
                                            var perc = (group.Sum(x => x.MarksObtained) / (group.Sum(x => x.MaxMarks) > 0 ? group.Sum(x => x.MaxMarks) : 1)) * 100;
                                        }
                                        <span class="fw-800">PERCENTAGE: @perc.ToString("F1")%</span>
                                    </td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
            </div>
        }
    }
    else if (Context.Request.Query.ContainsKey("studentId"))
    {
        <div class="premium-card p-5 text-center">
            <i class="fas fa-history fa-3x text-muted opacity-20 mb-3"></i>
            <h5 class="fw-800 text-dark">No Historical Data Found</h5>
            <p class="text-muted">This student has no past examination records in the current database tracking system.</p>
        </div>
    }
</div>

<style>
    .bg-primary-soft { background: rgba(37, 99, 235, 0.1); }
    @@media print {
        .no-print { display: none !important; }
    }
</style>
