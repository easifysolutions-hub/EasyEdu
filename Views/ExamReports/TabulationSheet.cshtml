@model IEnumerable<EasyEdu.Models.Student>
@{
    ViewData["Title"] = "Tabulation Sheet";
    Layout = "_Layout";
    var subjects = ViewBag.Subjects as List<EasyEdu.Models.Subject> ?? new List<EasyEdu.Models.Subject>();
    var marks = ViewBag.Marks as List<EasyEdu.Models.Mark> ?? new List<EasyEdu.Models.Mark>();
}

<div class="content-wrapper p-4 animate-fade-in">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="page-title mb-1">Tabulation Sheet</h3>
            <p class="text-muted small fw-600">Cross-tabular mark distribution for internal auditing</p>
        </div>
        <button class="btn btn-premium-primary btn-sm rounded-8" onclick="window.print()">
            <i class="fas fa-print me-2"></i>PRINT SHEET
        </button>
    </div>

    <div class="premium-card p-4 mb-4 no-print">
        <form method="get" class="row g-3 align-items-end">
            <div class="col-md-5">
                <label class="form-label small fw-800 text-uppercase opacity-50">Examination</label>
                <select name="examId" class="form-select form-control-premium" asp-items="ViewBag.Examinations" required>
                    <option value="">Select Exam</option>
                </select>
            </div>
            <div class="col-md-5">
                <label class="form-label small fw-800 text-uppercase opacity-50">Class</label>
                <select name="classId" class="form-select form-control-premium" asp-items="ViewBag.Classes" required>
                    <option value="">Select Class</option>
                </select>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-premium-purple w-100">GENERATE</button>
            </div>
        </form>
    </div>

    <div class="premium-card border-0 shadow-sm overflow-hidden" style="border-radius: 20px;">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-bordered mb-0 align-middle">
                    <thead class="bg-light-subtle">
                        <tr>
                            <th class="px-3 py-3 small fw-900 border-0" style="min-width: 150px;">STUDENT (REG)</th>
                            @foreach (var sub in subjects)
                            {
                                <th class="text-center py-3 small fw-900 border-0">@sub.Name.ToUpper()</th>
                            }
                            <th class="text-center py-3 small fw-900 border-0 bg-primary-soft text-primary">TOTAL</th>
                            <th class="text-center py-3 small fw-900 border-0 bg-success-soft text-success">PERCENT</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var s in Model)
                        {
                            var studentMarks = marks.Where(m => m.StudentId == s.Id).ToList();
                            var total = studentMarks.Sum(m => m.MarksObtained);
                            var max = studentMarks.Sum(m => m.MaxMarks);
                            var percent = max > 0 ? (total / max) * 100 : 0;
                            
                            <tr>
                                <td class="px-3 py-3 border-0 border-bottom">
                                    <div class="fw-800 text-dark">@s.FirstName @s.LastName</div>
                                    <div class="small text-muted fw-700">@s.AdmissionNumber</div>
                                </td>
                                @foreach (var sub in subjects)
                                {
                                    var mark = studentMarks.FirstOrDefault(m => m.SubjectId == sub.Id);
                                    <td class="text-center py-3 border-0 border-bottom fw-700">
                                        @(mark?.MarksObtained.ToString() ?? "-")
                                    </td>
                                }
                                <td class="text-center py-3 border-0 border-bottom bg-primary-soft text-primary fw-900">@total</td>
                                <td class="text-center py-3 border-0 border-bottom bg-success-soft text-success fw-900">@percent.ToString("F1")%</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<style>
    .table-bordered > :not(caption) > * > * { border-width: 0 1px 0 0; border-color: #f1f5f9; }
    .table-bordered > :not(caption) > * > *:last-child { border-right-width: 0; }
    @@media print { .no-print { display: none !important; } }
</style>
