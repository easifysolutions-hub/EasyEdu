@model IEnumerable<EasyEdu.Models.Mark>
@{
    ViewData["Title"] = "Mark Sheet Report";
    Layout = "_Layout";
    var student = ViewBag.Student as EasyEdu.Models.Student;
    var exam = ViewBag.Exam as EasyEdu.Models.Examination;
}

<div class="content-wrapper p-4 animate-fade-in">
    @if (student == null)
    {
        <div class="premium-card p-5 text-center mb-4 border-start border-4 border-primary">
             <h4 class="fw-800 text-dark mb-4">Official Mark Sheet Generator</h4>
             <form method="get" class="row g-3 justify-content-center align-items-end">
                <div class="col-md-5 text-start">
                    <label class="form-label small fw-800 text-uppercase opacity-50">Student Admission No</label>
                    <select name="studentId" class="form-select form-control-premium select2" asp-items="ViewBag.Students" required>
                        <option value="">Select Student</option>
                    </select>
                </div>
                <div class="col-md-5 text-start">
                    <label class="form-label small fw-800 text-uppercase opacity-50">Examination</label>
                    <select name="examId" class="form-select form-control-premium" asp-items="ViewBag.Examinations" required>
                        <option value="">Select Exam</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-premium-primary w-100 py-3">GENERATE SHEET</button>
                </div>
             </form>
        </div>
    }
    else
    {
        <div class="d-flex justify-content-between align-items-center mb-4 no-print">
            <button class="btn btn-light-soft rounded-8" onclick="location.href='@Url.Action("MarkSheetReport")'">
                <i class="fas fa-arrow-left me-2"></i>GO BACK
            </button>
            <button class="btn btn-premium-dark rounded-8 px-4" onclick="window.print()">
                <i class="fas fa-print me-2"></i>PRINT OFFICIAL SHEET
            </button>
        </div>

        <div class="premium-card p-5 official-marksheet border-2 border-dark">
            <!-- Institutional Header -->
            <div class="text-center mb-5 pb-3 border-bottom border-dark border-3">
                <h1 class="fw-900 border-3 border-dark d-inline-block px-4 mb-2">OFFICIAL MARK SHEET</h1>
                <h2 class="fw-800 text-dark mb-0">EasyEdu ACADEMIC INSTITUTION</h2>
                <p class="text-muted fw-700 m-0">ACADEMIC RECORD FOR SESSION @DateTime.Now.Year</p>
                <h5 class="mt-3 fw-900 text-primary">@exam?.Name.ToUpper()</h5>
            </div>

            <div class="row mb-5 g-4">
                <div class="col-4">
                    <div class="small fw-800 opacity-50">STUDENT NAME</div>
                    <div class="fw-900 h5 text-dark">@student.FirstName.ToUpper() @student.LastName.ToUpper()</div>
                </div>
                <div class="col-4">
                    <div class="small fw-800 opacity-50">REGISTRATION NO</div>
                    <div class="fw-900 h5 text-dark">@student.AdmissionNumber</div>
                </div>
                <div class="col-4">
                    <div class="small fw-800 opacity-50">CLASS / SECTION</div>
                    <div class="fw-900 h5 text-dark">@student.Class.Name (@(student.Section?.Name ?? "A"))</div>
                </div>
            </div>

            <!-- Detailed Grid -->
            <div class="table-responsive">
                <table class="table table-bordered border-dark text-center align-middle">
                    <thead class="bg-dark text-white">
                        <tr>
                            <th class="py-3 text-start px-4" rowspan="2">ACADEMIC SUBJECTS</th>
                            <th colspan="2">MARKS CRITERIA</th>
                            <th colspan="3">RESULT ACHIEVEMENT</th>
                        </tr>
                        <tr>
                            <th>MAX</th>
                            <th>PASS</th>
                            <th>OBTAINED</th>
                            <th>GRADE</th>
                            <th>POINT</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var m in Model)
                        {
                            <tr>
                                <td class="py-3 text-start px-4 fw-800 text-dark">@m.Subject.Name</td>
                                <td class="fw-700">@m.MaxMarks</td>
                                <td class="fw-700">@(m.MaxMarks * 0.33m)</td>
                                <td class="fw-900 text-primary" style="font-size: 1.1rem;">@m.MarksObtained</td>
                                <td class="fw-900 bg-light-subtle">@m.Grade</td>
                                <td class="fw-900">@GetPoint(m.Grade)</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot class="fw-900 border-dark border-3">
                        <tr class="bg-light">
                            <td class="text-end px-4 py-3">GRAND TOTAL</td>
                            <td>@Model.Sum(m => m.MaxMarks)</td>
                            <td>@Model.Sum(m => m.MaxMarks * 0.33m)</td>
                            <td class="text-primary" style="font-size: 1.3rem;">@Model.Sum(m => m.MarksObtained)</td>
                            <td colspan="2">
                                @{
                                    var avg = Model.Any() ? Model.Average(m => (m.MarksObtained / (m.MaxMarks > 0 ? m.MaxMarks : 100)) * 100) : 0;
                                }
                                <div class="badge @(avg >= 33 ? "bg-success" : "bg-danger") px-4 py-2 w-100 h5 mb-0">
                                    @(avg >= 33 ? "QUALIFIED" : "DISQUALIFIED")
                                </div>
                            </td>
                        </tr>
                    </tfoot>
                </table>
            </div>

            <!-- Grade Scale Key -->
             <div class="mt-5 p-3 border border-dark border-dashed rounded-8 bg-light-subtle">
                 <div class="row">
                     <div class="col-12 text-center mb-2">
                         <span class="fw-800 small text-muted">ACADEMIC GRADING SCALE</span>
                     </div>
                     <div class="col-12 text-center">
                         <span class="badge border border-dark text-dark mx-1">A+ (90-100) / 4.0</span>
                         <span class="badge border border-dark text-dark mx-1">A (80-89) / 3.5</span>
                         <span class="badge border border-dark text-dark mx-1">B (70-79) / 3.0</span>
                         <span class="badge border border-dark text-dark mx-1">C (60-69) / 2.5</span>
                         <span class="badge border border-dark text-dark mx-1">D (50-59) / 2.0</span>
                         <span class="badge border border-dark text-dark mx-1">F (&lt;50) / 0.0</span>
                     </div>
                 </div>
             </div>

            <!-- Signatures Section -->
            <div class="row mt-5 pt-5 text-center">
                <div class="col-md-4">
                    <div class="border-top border-dark pt-2 mx-5">
                        <p class="small fw-900 text-dark m-0">CONTROLLER OF EXAMS</p>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="signature-stamp opacity-10">
                         <i class="fas fa-stamp fa-4x text-premium-purple"></i>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="border-top border-dark pt-2 mx-5">
                        <p class="small fw-900 text-dark m-0">HEAD OF INSTITUTION</p>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@functions {
    string GetPoint(string grade)
    {
        return grade switch { "A+" => "4.0", "A" => "3.5", "B" => "3.0", "C" => "2.5", "D" => "2.0", _ => "0.0" };
    }
}

<style>
    .official-marksheet { font-family: 'Inter', sans-serif; letter-spacing: -0.2px; }
    .border-dashed { border-style: dashed !important; }
    .opacity-10 { opacity: 0.1; }
    
    @@media print {
        .no-print { display: none !important; }
        .sidebar, .topbar { display: none !important; }
        .main-content { margin: 0 !important; padding: 0 !important; }
        .premium-card { border: none !important; box-shadow: none !important; }
    }
</style>
