@model IEnumerable<EasyEdu.Models.Mark>
@{
    ViewData["Title"] = "Subject Wise Marksheet";
    Layout = "_Layout";
}

<div class="content-wrapper p-4 animate-fade-in">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="page-title mb-1">Subject Wise Marksheet</h3>
            <p class="text-muted small fw-600">Performance categorization by academic subject</p>
        </div>
    </div>

    <div class="premium-card p-4 mb-4">
        <form method="get" class="row g-3 align-items-end">
            <div class="col-md-3">
                <label class="form-label small fw-800 text-uppercase opacity-50">Exam</label>
                <select name="examId" class="form-select form-control-premium" asp-items="ViewBag.Examinations" required>
                    <option value="">Select Exam</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-800 text-uppercase opacity-50">Class</label>
                <select name="classId" class="form-select form-control-premium" asp-items="ViewBag.Classes" required>
                    <option value="">Select Class</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-800 text-uppercase opacity-50">Subject</label>
                <select name="subjectId" class="form-select form-control-premium" asp-items="ViewBag.Subjects" required>
                    <option value="">Select Subject</option>
                </select>
            </div>
            <div class="col-md-3">
                <button type="submit" class="btn btn-premium-purple w-100">FILTER MARKS</button>
            </div>
        </form>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="premium-card">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table premium-table mb-0">
                        <thead>
                            <tr>
                                <th class="px-4">ADM NO</th>
                                <th>STUDENT NAME</th>
                                <th>FULL MARKS</th>
                                <th>MARKS OBTAINED</th>
                                <th>GRADE</th>
                                <th class="text-end px-4">REMARKS</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var m in Model)
                            {
                                <tr>
                                    <td class="px-4 fw-800 text-primary">@m.Student.AdmissionNumber</td>
                                    <td class="fw-700 text-dark">@m.Student.FirstName @m.Student.LastName</td>
                                    <td><span class="small fw-700 text-muted">@m.MaxMarks</span></td>
                                    <td class="fw-900 @(m.MarksObtained < (m.MaxMarks * 0.33m) ? "text-danger" : "text-success")">@m.MarksObtained</td>
                                    <td><span class="badge bg-primary-soft text-primary fw-900">@m.Grade</span></td>
                                    <td class="text-end px-4 small font-italic text-muted">@m.Remarks</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>
