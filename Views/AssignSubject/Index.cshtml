@model IEnumerable<EasyEdu.Models.AssignSubject>
@{
    ViewData["Title"] = "Assign Subject";
    Layout = "_Layout";
}

<div class="content-wrapper p-4">

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show rounded-12 mb-4" role="alert">
        <i class="fas fa-check-circle me-2"></i> @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show rounded-12 mb-4" role="alert">
        <i class="fas fa-exclamation-triangle me-2"></i> @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

    <div class="row g-4 d-flex align-items-stretch">
        <!-- Assign Subject Form -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-12 h-100">
                <div class="card-header bg-white border-bottom border-light py-3">
                    <h5 class="fw-800 text-primary m-0">Assign Subject</h5>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Create" method="post">
                        <div class="mb-3">
                            <label class="form-label fw-700 text-muted small text-uppercase">Class *</label>
                            <select name="ClassId" id="ddlClass" class="form-select" asp-items="ViewBag.Classes" required>
                                <option value="">Select Class</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-700 text-muted small text-uppercase">Section *</label>
                            <select name="SectionId" id="ddlSection" class="form-select" required>
                                <option value="">Select Class First</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-700 text-muted small text-uppercase">Subject *</label>
                            <select name="SubjectId" id="ddlSubject" class="form-select" required>
                                 <option value="">Select Class First</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-700 text-muted small text-uppercase">Teacher *</label>
                            <select name="TeacherId" class="form-select" asp-items="ViewBag.Teachers" required>
                                <option value="">Select Teacher</option>
                            </select>
                        </div>
                         <div class="d-grid mt-4">
                            <button type="submit" class="btn btn-primary fw-700 py-2 shadow-sm">
                                <i class="fas fa-check me-2"></i> Save Assign
                            </button>
                        </div>
                        <div asp-validation-summary="ModelOnly" class="text-danger mt-2 small"></div>
                    </form>
                </div>
            </div>
        </div>

        <!-- Assignment List -->
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-12 h-100">
                <div class="card-header bg-white border-bottom border-light py-3 d-flex justify-content-between align-items-center">
                    <h5 class="fw-800 text-dark m-0">Subject Assign List</h5>
                    <div class="search-box">
                        <input type="text" class="form-control form-control-sm border-0 bg-light" placeholder="Search...">
                    </div>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="bg-light text-muted small text-uppercase">
                                <tr>
                                    <th class="px-4 py-3 fw-700">Class (Section)</th>
                                    <th class="py-3 fw-700">Subject</th>
                                    <th class="py-3 fw-700">Teacher</th>
                                    <th class="text-end px-4 py-3 fw-700">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model != null && Model.Any())
                                {
                                    foreach (var item in Model)
                                    {
                                        <tr>
                                            <td class="px-4 fw-700 text-dark">
                                                @item.Class?.Name <span class="badge bg-light text-muted border ms-1">@item.Section?.Name</span>
                                            </td>
                                            <td>
                                                <span class="fw-600 text-primary">@item.Subject?.Name</span>
                                            </td>
                                            <td>
                                                <div class="d-flex align-items-center">
                                                    <span class="fw-600 text-dark">@item.Teacher?.FullName</span>
                                                </div>
                                            </td>
                                            <td class="text-end px-4">
                                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-light text-primary me-1">
                                                    <i class="fas fa-edit"></i>
                                                </a>
                                                <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Delete this assignment?');">
                                                    <button type="submit" class="btn btn-sm btn-light text-danger">
                                                        <i class="fas fa-trash"></i>
                                                    </button>
                                                </form>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="4" class="text-center py-5">
                                            <div class="py-4">
                                                <i class="fas fa-book-reader text-muted mb-3" style="font-size: 2rem; opacity: 0.2;"></i>
                                                <p class="text-muted small">No subjects assigned.</p>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const ddlClass = document.getElementById('ddlClass');
        const ddlSection = document.getElementById('ddlSection');
        const ddlSubject = document.getElementById('ddlSubject');

        ddlClass.addEventListener('change', function() {
            const classId = this.value;
            ddlSection.innerHTML = '<option value="">Loading...</option>';
            ddlSubject.innerHTML = '<option value="">Loading...</option>';
            
            if(classId) {
                // Fetch Sections
                fetch('/AssignSubject/GetSectionsByClass?classId=' + classId)
                    .then(response => response.json())
                    .then(data => {
                        ddlSection.innerHTML = '<option value="">Select Section</option>';
                        data.forEach(item => {
                            const option = document.createElement('option');
                            option.value = item.id;
                            option.textContent = item.name;
                            ddlSection.appendChild(option);
                        });
                    });

                // Fetch Subjects
                fetch('/AssignSubject/GetSubjectsByClass?classId=' + classId)
                    .then(response => response.json())
                    .then(data => {
                         ddlSubject.innerHTML = '<option value="">Select Subject</option>';
                        data.forEach(item => {
                            const option = document.createElement('option');
                            option.value = item.id;
                            option.textContent = item.name;
                            ddlSubject.appendChild(option);
                        });
                    });

            } else {
                ddlSection.innerHTML = '<option value="">Select Class First</option>';
                 ddlSubject.innerHTML = '<option value="">Select Class First</option>';
            }
        });
    });
</script>
