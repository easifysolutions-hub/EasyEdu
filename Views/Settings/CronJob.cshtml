@{
    ViewData["Title"] = "Background Operations (Cron)";
    Layout = "_Layout";
}

<div class="content-wrapper p-4 animate-fade-in">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="page-title mb-1 fw-900">Background Automation Nexus</h3>
            <p class="text-muted small fw-600">Real-time monitoring of asynchronous institutional tasks</p>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-md-4">
            <div class="premium-card p-4 border-0 shadow-sm bg-white rounded-24">
                <h6 class="fw-800 text-muted uppercase smallest mb-3">Worker Capacity</h6>
                <div class="d-flex align-items-center justify-content-between">
                    <h2 class="fw-900 mb-0">98.4%</h2>
                    <i class="fas fa-microchip fa-2x text-primary opacity-25"></i>
                </div>
                <div class="progress mt-3 rounded-pill" style="height: 6px;">
                    <div class="progress-bar bg-primary" style="width: 98%;"></div>
                </div>
            </div>
        </div>
        <div class="col-12">
             <div class="premium-card p-4 border-0 shadow-sm bg-dark text-success rounded-24 font-monospace small">
                 <div class="mb-2 border-bottom border-success border-opacity-25 pb-2 text-white-50">SYSTEM_LOG_STREAM // @DateTime.Now.ToString("HH:mm:ss")</div>
                 <div>[INFO] Initializing Master Orchestrator...</div>
                 <div>[INFO] Scanning for pending fee notifications...</div>
                 <div>[INFO] 0 notifications queued.</div>
                 <div>[INFO] Scanning for backup schedules...</div>
                 <div>[OK] Backup service idle.</div>
                 <div class="mt-3"><span class="blink">_</span></div>
             </div>
        </div>
    </div>
</div>
