@{
    ViewData["Title"] = "Holiday Master Registry";
    Layout = "_Layout";
}

<div class="content-wrapper p-4 animate-fade-in">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="page-title mb-1 fw-900">Institutional Holiday Registry</h3>
            <p class="text-muted small fw-600">Archival management of non-operational institutional periods</p>
        </div>
        <button class="btn btn-premium-purple btn-sm rounded-12 px-4 shadow-sm fw-900">
            <i class="fas fa-plus me-2"></i>DECLARE NEW HOLIDAY
        </button>
    </div>

    <div class="premium-card border-0 shadow-sm p-5 text-center bg-white rounded-24">
        <div class="opacity-10 mb-3"><i class="fas fa-umbrella-beach fa-4x"></i></div>
        <h5 class="fw-900 text-dark">Registry Synchronized</h5>
        <p class="text-muted fw-600">The historical holiday registry is currently empty for the active academic cycle.</p>
    </div>
</div>
