@model EasyEdu.Models.Student
@{
    var marks = ViewBag.Marks as List<EasyEdu.Models.Mark>;
    var academicYear = ViewBag.AcademicYear as EasyEdu.Models.AcademicYear;
    ViewData["Title"] = "Report Card - " + Model.FirstName;
    Layout = null; // Clean print layout
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Report Card - @Model.FirstName</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Outfit', sans-serif; background: #fff; padding: 40px; }
        .report-card { border: 4px double #4f46e5; padding: 40px; border-radius: 20px; position: relative; }
        .institution-header { text-align: center; margin-bottom: 40px; border-bottom: 2px solid #f1f5f9; padding-bottom: 20px; }
        .institution-name { font-weight: 800; font-size: 2.5rem; color: #1e293b; margin: 0; }
        .student-sec { background: #f8fafc; padding: 25px; border-radius: 12px; margin-bottom: 30px; }
        .info-label { color: #64748b; text-transform: uppercase; font-size: 0.75rem; font-weight: 700; margin-bottom: 2px; }
        .info-value { font-weight: 700; color: #1e293b; font-size: 1.1rem; }
        .marks-table th { background: #4f46e5; color: white; border: none; padding: 12px 20px; }
        .marks-table td { padding: 12px 20px; border-bottom: 1px solid #f1f5f9; }
        .grade-pill { padding: 4px 12px; border-radius: 8px; font-weight: 700; font-size: 0.85rem; }
        .grade-A { background: #dcfce7; color: #166534; }
        .grade-B { background: #dbeafe; color: #1e40af; }
        .footer-sec { margin-top: 60px; }
        .sign-box { border-top: 1px solid #334155; width: 200px; text-align: center; padding-top: 10px; font-weight: 600; color: #64748b; }
        
        @@media print {
            .btn-print { display: none; }
            body { padding: 0; }
            .report-card { border: 2px solid #000; }
        }
    </style>
</head>
<body>
    <div class="container text-end mb-4 no-print">
        <button onclick="window.print()" class="btn btn-primary btn-print rounded-12 px-4 shadow">
            <i class="fas fa-print me-2"></i> Print Report Card
        </button>
    </div>

    <div class="report-card mx-auto" style="max-width: 900px;">
        <div class="institution-header">
            <h1 class="institution-name">@Model.Company?.Name</h1>
            <div class="text-muted fw-500">Academic Year @academicYear?.Name</div>
            <div class="text-muted small">Progress Report Card</div>
        </div>

        <div class="student-sec row g-3">
            <div class="col-md-4">
                <div class="info-label">Student Name</div>
                <div class="info-value">@Model.FirstName @Model.LastName</div>
            </div>
            <div class="col-md-2">
                <div class="info-label">Roll No.</div>
                <div class="info-value">@Model.AdmissionNumber</div>
            </div>
            <div class="col-md-3">
                <div class="info-label">Class & Section</div>
                <div class="info-value">@Model.Class?.Name (@Model.Class?.Section)</div>
            </div>
            <div class="col-md-3">
                <div class="info-label">Father's Name</div>
                <div class="info-value">@Model.FatherName</div>
            </div>
        </div>

        <table class="table marks-table mt-4 w-100">
            <thead>
                <tr>
                    <th>SUBJECT</th>
                    <th class="text-center">MAX MARKS</th>
                    <th class="text-center">OBTAINED</th>
                    <th class="text-center">PERCENTAGE</th>
                    <th>REMARKS</th>
                </tr>
            </thead>
            <tbody>
                @if (marks != null && marks.Any())
                {
                    foreach (var mark in marks)
                    {
                        var perc = (mark.MarksObtained / mark.MaxMarks) * 100;
                        <tr>
                            <td class="fw-700">@mark.Subject?.Name</td>
                            <td class="text-center">@mark.MaxMarks</td>
                            <td class="text-center fw-800 text-primary">@mark.MarksObtained</td>
                            <td class="text-center">
                                <span class="grade-pill grade-@(perc >= 80 ? "A" : "B")">@perc.ToString("0.0")%</span>
                            </td>
                            <td class="small text-muted italic">@mark.Remarks</td>
                        </tr>
                    }
                }
            </tbody>
            <tfoot>
                <tr class="bg-light">
                    <td class="fw-800">GRAND TOTAL</td>
                    <td class="text-center fw-800">@marks?.Sum(m => m.MaxMarks)</td>
                    <td class="text-center fw-800 text-dark">@marks?.Sum(m => m.MarksObtained)</td>
                    <td class="text-center fw-800">
                        @if (marks != null && marks.Any()) {
                            @((marks.Sum(m => m.MarksObtained) / marks.Sum(m => m.MaxMarks) * 100).ToString("0.0")) @:%
                        }
                    </td>
                    <td></td>
                </tr>
            </tfoot>
        </table>

        <div class="footer-sec d-flex justify-content-between mt-5 pt-5">
            <div class="sign-box">Class Teacher</div>
            <div class="sign-box">Principal</div>
            <div class="sign-box">Date of Issue</div>
        </div>
    </div>
</body>
</html>
