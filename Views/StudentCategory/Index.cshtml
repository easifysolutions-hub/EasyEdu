@model IEnumerable<EasyEdu.Models.StudentCategory>
@{
    ViewData["Title"] = "Student Category";
    Layout = "_Layout";
}

<div class="content-wrapper p-4">
    <div class="row g-4 d-flex align-items-stretch">
        <!-- Add Category Form -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-12 h-100">
                <div class="card-header bg-white border-bottom border-light py-3">
                    <h5 class="fw-800 text-primary m-0">Add Student Category</h5>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Create" method="post">
                        <div class="mb-3">
                            <label class="form-label fw-700 text-muted small text-uppercase">Category Name *</label>
                            <input type="text" name="Name" class="form-control" placeholder="e.g. GENERAL, OBC, STAFF" required>
                        </div>
                        <div class="mb-3">
                             <div class="form-check form-switch mt-4">
                                <input class="form-check-input" type="checkbox" name="IsActive" id="isActiveSwitch" value="true" checked>
                                <label class="form-check-label fw-700 text-dark" for="isActiveSwitch">Is Active?</label>
                            </div>
                        </div>
                        <div class="d-grid mt-4">
                            <button type="submit" class="btn btn-primary fw-700 py-2 shadow-sm">
                                <i class="fas fa-check me-2"></i> Save Category
                            </button>
                        </div>
                         <div asp-validation-summary="All" class="text-danger mt-2 small"></div>
                    </form>
                </div>
            </div>
        </div>

        <!-- Category List -->
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-12 h-100">
                <div class="card-header bg-white border-bottom border-light py-3 d-flex justify-content-between align-items-center">
                    <h5 class="fw-800 text-dark m-0">Student Category List</h5>
                    <div class="search-box">
                        <input type="text" class="form-control form-control-sm border-0 bg-light" placeholder="Search...">
                    </div>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="bg-light text-muted small text-uppercase">
                                <tr>
                                    <th class="px-4 py-3 fw-700">ID</th>
                                    <th class="py-3 fw-700">Category</th>
                                    <th class="py-3 fw-700">Status</th>
                                    <th class="text-end px-4 py-3 fw-700">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model != null && Model.Any())
                                {
                                    foreach (var item in Model)
                                    {
                                        <tr>
                                            <td class="px-4 fw-600 text-muted">@item.Id</td>
                                            <td class="fw-700 text-dark">@item.Name</td>
                                            <td>
                                                @if (item.IsActive)
                                                {
                                                    <span class="badge bg-success bg-opacity-10 text-success fw-700 px-3 py-1 rounded-pill small">Active</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-danger bg-opacity-10 text-danger fw-700 px-3 py-1 rounded-pill small">Inactive</span>
                                                }
                                            </td>
                                            <td class="text-end px-4">
                                                <button class="btn btn-sm btn-light text-primary me-2" onclick="editCategory(@item.Id, '@item.Name', @item.IsActive.ToString().ToLower())">
                                                    <i class="fas fa-pen"></i>
                                                </button>
                                                <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Delete this category?');">
                                                    <button type="submit" class="btn btn-sm btn-light text-danger">
                                                        <i class="fas fa-trash"></i>
                                                    </button>
                                                </form>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="4" class="text-center py-5">
                                            <div class="py-4">
                                                <i class="fas fa-tags text-muted mb-3" style="font-size: 2rem; opacity: 0.2;"></i>
                                                <p class="text-muted small">No categories found.</p>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Edit Category Modal -->
<div class="modal fade" id="editCategoryModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-12">
            <div class="modal-header bg-primary text-white border-0">
                <h5 class="modal-title fw-800">Edit Student Category</h5>
                <button type="button" class="btn-close btn-close-white shadow-none" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="Edit" method="post">
                <div class="modal-body p-4">
                    <input type="hidden" name="id" id="edit_id">
                    <div class="mb-3">
                        <label class="form-label fw-700 small text-uppercase">Category Name</label>
                        <input type="text" name="name" id="edit_name" class="form-control border-0 bg-light shadow-none fw-600" required>
                    </div>
                    <div class="form-check form-switch mt-3">
                        <input class="form-check-input" type="checkbox" name="isActive" id="edit_isActive" value="true">
                        <label class="form-check-label fw-600" for="edit_isActive">Is Active?</label>
                    </div>
                </div>
                <div class="modal-footer border-0 p-4 pt-0">
                    <button type="button" class="btn btn-light fw-700" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary fw-700 px-4">Update Category</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    function editCategory(id, name, isActive) {
        document.getElementById('edit_id').value = id;
        document.getElementById('edit_name').value = name;
        document.getElementById('edit_isActive').checked = isActive;
        new bootstrap.Modal(document.getElementById('editCategoryModal')).show();
    }
</script>
