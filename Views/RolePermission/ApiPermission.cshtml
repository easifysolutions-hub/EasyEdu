@{
    ViewData["Title"] = "API Permission";
}

<div class="content-wrapper p-4 animate-fade-in text-dark">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="page-title mb-1 fw-900">API Access Management</h3>
            <p class="text-muted small fw-600">Control external machine and device connectivity protocols</p>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-dark-premium rounded-12 px-4 fw-800 shadow-sm d-flex align-items-center gap-2">
                <i class="fas fa-key"></i> GENERATE NEW KEY
            </button>
        </div>
    </div>

    <div class="alert alert-warning-soft border-0 rounded-16 p-4 mb-4 d-flex align-items-center gap-3">
        <i class="fas fa-triangle-exclamation fa-2x text-warning"></i>
        <div>
            <h6 class="fw-900 mb-1">Security Advisory</h6>
            <p class="mb-0 small fw-600 text-muted">Never share your API keys in plain text. API access allows external hardware (Biometric Machines, QR Scanners) to push data directly to the server database.</p>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-md-6 col-lg-3">
            <div class="premium-card p-4 border-0 shadow-sm rounded-20 overflow-hidden bg-white">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <div class="icon-box-md bg-info-soft text-info rounded-16">
                        <i class="fas fa-fingerprint fa-lg"></i>
                    </div>
                    <div class="form-check form-switch p-0 m-0">
                        <input class="form-check-input" type="checkbox" role="switch" checked>
                    </div>
                </div>
                <h6 class="fw-800 text-dark mb-1">Biometric Attendance</h6>
                <p class="text-muted small fw-600 mb-3">Sync staff and student clock-in data from external ZKTeco/Matrix machines.</p>
                <div class="d-flex align-items-center gap-2 mt-auto">
                    <span class="badge bg-success-soft text-success px-2 rounded-8 fw-700">ACTIVE</span>
                    <span class="text-muted small fw-700">| REST API</span>
                </div>
            </div>
        </div>
        <div class="col-md-6 col-lg-3">
            <div class="premium-card p-4 border-0 shadow-sm rounded-20 overflow-hidden bg-white opacity-75">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <div class="icon-box-md bg-primary-soft text-primary rounded-16">
                        <i class="fas fa-book-sparkles fa-lg"></i>
                    </div>
                    <div class="form-check form-switch p-0 m-0">
                        <input class="form-check-input" type="checkbox" role="switch">
                    </div>
                </div>
                <h6 class="fw-800 text-dark mb-1">Library Kiosk</h6>
                <p class="text-muted small fw-600 mb-3">Allow self-checkout kiosks to query book availability and member status.</p>
                <div class="d-flex align-items-center gap-2 mt-auto">
                    <span class="badge bg-light text-muted px-2 rounded-8 fw-700">INACTIVE</span>
                    <span class="text-muted small fw-700">| WEBSOCKET</span>
                </div>
            </div>
        </div>
        <div class="col-md-6 col-lg-3">
            <div class="premium-card p-4 border-0 shadow-sm rounded-20 overflow-hidden bg-white">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <div class="icon-box-md bg-success-soft text-success rounded-16">
                        <i class="fas fa-envelope-open-text fa-lg"></i>
                    </div>
                    <div class="form-check form-switch p-0 m-0">
                        <input class="form-check-input" type="checkbox" role="switch" checked>
                    </div>
                </div>
                <h6 class="fw-800 text-dark mb-1">SMS Gateway</h6>
                <p class="text-muted small fw-600 mb-3">Connect to external SMS service providers (Twilio, BulkSMS) for notifications.</p>
                <div class="d-flex align-items-center gap-2 mt-auto">
                    <span class="badge bg-success-soft text-success px-2 rounded-8 fw-700">ACTIVE</span>
                    <span class="text-muted small fw-700">| WEBHOOK</span>
                </div>
            </div>
        </div>
        <div class="col-md-6 col-lg-3">
            <div class="premium-card p-4 border-0 shadow-sm rounded-20 overflow-hidden bg-white">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <div class="icon-box-md bg-warning-soft text-warning rounded-16">
                        <i class="fas fa-qrcode fa-lg"></i>
                    </div>
                    <div class="form-check form-switch p-0 m-0">
                        <input class="form-check-input" type="checkbox" role="switch" checked>
                    </div>
                </div>
                <h6 class="fw-800 text-dark mb-1">Mobile App Sync</h6>
                <p class="text-muted small fw-600 mb-3">Enable data exchange between school ERP and native Android/iOS mobile apps.</p>
                <div class="d-flex align-items-center gap-2 mt-auto">
                    <span class="badge bg-success-soft text-success px-2 rounded-8 fw-700">ACTIVE</span>
                    <span class="text-muted small fw-700">| JSON API</span>
                </div>
            </div>
        </div>
    </div>

    <div class="premium-card p-0 overflow-hidden">
        <div class="p-4 border-bottom d-flex justify-content-between align-items-center">
            <h5 class="mb-0 fw-800 text-dark">Active API Access Tokens</h5>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light-soft text-dark">
                    <tr>
                        <th class="ps-4 py-3 fw-800 small text-uppercase">Client Machine ID</th>
                        <th class="py-3 fw-800 small text-uppercase">API Token (Masked)</th>
                        <th class="py-3 fw-800 small text-uppercase">Assigned Role</th>
                        <th class="py-3 fw-800 small text-uppercase">Last Access</th>
                        <th class="pe-4 py-3 text-end fw-800 small text-uppercase">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td class="ps-4">
                            <div class="fw-800 text-dark">BIOM-SERVER-01</div>
                            <div class="small text-muted fw-600 text-uppercase">static ip: 192.168.1.200</div>
                        </td>
                        <td><code>EE_LIVE_••••••••••••••••3A2B</code></td>
                        <td><span class="badge bg-primary-soft text-primary px-3 rounded-pill fw-800">Biometric Sync</span></td>
                         <td class="fw-700">Just Now</td>
                        <td class="pe-4 text-end">
                            <button class="btn btn-sm btn-light-soft text-danger p-2 text-decoration-none fw-800"><i class="fas fa-ban"></i> REVOKE</button>
                        </td>
                    </tr>
                     <tr>
                        <td class="ps-4">
                            <div class="fw-800 text-dark">SMS-TWILIO-GATEWAY</div>
                            <div class="small text-muted fw-600 text-uppercase">Cloud Integration</div>
                        </td>
                        <td><code>EE_LIVE_••••••••••••••••7F9E</code></td>
                        <td><span class="badge bg-primary-soft text-primary px-3 rounded-pill fw-800">SMS Broadcaster</span></td>
                         <td class="fw-700">10 mins ago</td>
                        <td class="pe-4 text-end">
                            <button class="btn btn-sm btn-light-soft text-danger p-2 text-decoration-none fw-800"><i class="fas fa-ban"></i> REVOKE</button>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>
