@model IEnumerable<EasyEdu.Models.AccountGroup>
@{
    ViewData["Title"] = "Item Account Master";
    Layout = "_Layout";
}

<div class="content-wrapper p-4 animate-fade-in">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="page-title mb-1">Item Account Master</h3>
            <p class="text-muted small fw-600">Configure Service & Product Ledger Heads</p>
        </div>
        <div class="d-flex gap-2">
            <a href="@Url.Action("CreateLedger")" class="btn btn-premium-primary btn-sm rounded-8">
                <i class="fas fa-plus me-2"></i> Create New Item Head
            </a>
        </div>
    </div>

    <div class="row">
        @foreach (var group in Model)
        {
            <div class="col-xl-4 col-md-6 mb-4">
                <div class="premium-card h-100">
                    <div class="card-header bg-light-soft border-0 p-3 d-flex justify-content-between align-items-center">
                        <h6 class="m-0 fw-800 text-dark">@group.Name</h6>
                        <span class="badge bg-white text-muted border small">@group.Nature</span>
                    </div>
                    <div class="card-body p-0">
                        <ul class="list-group list-group-flush">
                            @if (!group.Ledgers.Any())
                            {
                                <li class="list-group-item text-center py-4 text-muted small">No items defined</li>
                            }
                            @foreach (var ledger in group.Ledgers)
                            {
                                <li class="list-group-item border-0 border-bottom d-flex justify-content-between align-items-center py-3">
                                    <div>
                                        <div class="fw-700 text-dark">@ledger.Name</div>
                                        <div class="small text-muted">@group.Name</div>
                                    </div>
                                    <div class="btn-group align-items-center">
                                        <a href="@Url.Action("AccountLedger", new { ledgerId = ledger.Id })" class="btn btn-sm btn-light-soft" title="History"><i class="fas fa-history"></i></a>
                                        <a href="@Url.Action("EditLedger", new { id = ledger.Id })" class="btn btn-sm btn-light-soft ms-1" title="Edit"><i class="fas fa-edit"></i></a>
                                        <form asp-action="DeleteLedger" method="post" style="display: inline; margin: 0; padding: 0;" onsubmit="return confirm('Are you sure you want to delete this ledger?')">
                                            <input type="hidden" name="id" value="@ledger.Id" />
                                            <button type="submit" class="btn btn-sm btn-light-soft text-danger ms-1" title="Delete"><i class="fas fa-trash-alt"></i></button>
                                        </form>
                                    </div>
                                </li>
                            }
                        </ul>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
