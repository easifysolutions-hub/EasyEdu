@{
    if (ViewBag.Title != null) {
        ViewData["Title"] = ViewBag.Title;
    }
    else {
        ViewData["Title"] = "Voucher Entry";
    }
    Layout = "_Layout";
}

<div class="content-wrapper pt-0 animate-up">
    <!-- Premium Header -->
    <div class="d-flex justify-content-between align-items-center mb-4 px-3">
        <div>
            <h3 class="fw-800 text-dark mb-1">Financial Entry Module</h3>
            <p class="text-muted small fw-700 uppercase tracking-wider">
                <i class="fas fa-file-invoice-dollar me-2 text-primary"></i> 
                <span id="voucherTitleText">@ViewData["Title"]</span> Selection
            </p>
        </div>
        <div class="d-flex gap-2">
            <a href="@Url.Action("AccountLedger")" class="btn btn-premium-white btn-sm px-3 rounded-pill shadow-sm fw-800">
                <i class="fas fa-book-open me-2 text-indigo"></i> LEDGER
            </a>
            <a href="@Url.Action("ChartOfAccounts")" class="btn btn-premium-white btn-sm px-3 rounded-pill shadow-sm fw-800">
                <i class="fas fa-sitemap me-2 text-primary"></i> CHART
            </a>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-12">
            <div class="premium-card-animated shadow-lg border-0 bg-white overflow-hidden">
                <div class="card-header bg-white border-0 p-4">
                    <div class="row g-4">
                        <div class="col-md-3">
                            <label class="form-label-premium">Voucher Category</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-0"><i class="fas fa-tag text-muted"></i></span>
                                <select id="voucherType" class="form-select form-control-premium border-0 bg-light">
                                    <option value="1">Payment</option>
                                    <option value="2">Receipt</option>
                                    <option value="3">Contra</option>
                                    <option value="4">Journal</option>
                                </select>
                            </div>
                            @if (ViewBag.SelectedType != null)
                            {
                                <input type="hidden" id="voucherTypeHidden" value="@ViewBag.SelectedType" />
                            }
                        </div>
                        <div class="col-md-3">
                            <label class="form-label-premium">Fiscal Date</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-0"><i class="fas fa-calendar-alt text-muted"></i></span>
                                <input type="date" id="voucherDate" class="form-control-premium border-0 bg-light" value="@DateTime.Now.ToString("yyyy-MM-dd")">
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label-premium">Official Narration</label>
                            <div class="input-group shadow-sm rounded-12 overflow-hidden">
                                <span class="input-group-text bg-light border-0"><i class="fas fa-pen-nib text-muted"></i></span>
                                <input type="text" id="voucherNarration" class="form-control-premium border-0 bg-light w-100 py-3" placeholder="Describe this transaction comprehensively...">
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card-body p-0">
                    <div class="table-responsive" style="min-height: 400px;">
                        <table class="table align-middle mb-0" id="voucherTable">
                            <thead class="bg-light-soft fw-800 small text-muted text-uppercase">
                                <tr style="border-bottom: 2px solid #f1f5f9;">
                                    <th width="10%" class="ps-4 py-3">Type</th>
                                    <th width="30%" class="py-3">Account Head / Ledger</th>
                                    <th width="12%" class="py-3">Balance</th>
                                    <th width="14%" class="text-end py-3">Debit ($)</th>
                                    <th width="14%" class="text-end py-3">Credit ($)</th>
                                    <th width="15%" class="py-3">Remarks</th>
                                    <th width="5%" class="text-center py-3"></th>
                                </tr>
                            </thead>
                            <tbody id="voucherBody" class="snug-rows">
                                <!-- Dynamic Professional Rows -->
                            </tbody>
                        </table>
                    </div>

                    <!-- Enhanced Footer Actions -->
                    <div class="p-4 bg-light-subtle border-top">
                        <div class="row align-items-center">
                            <div class="col-md-4">
                                <div class="btn-group shadow-sm rounded-pill overflow-hidden">
                                    <button class="btn btn-emerald-gradient border-0 px-4 fw-800 text-white" onclick="addRow('Dr')">
                                        <i class="fas fa-plus-circle me-2"></i> ADD DR
                                    </button>
                                    <button class="btn btn-rose-gradient border-0 px-4 fw-800 text-white" onclick="addRow('Cr')">
                                        <i class="fas fa-plus-circle me-2"></i> ADD CR
                                    </button>
                                </div>
                            </div>
                            <div class="col-md-4 text-center">
                                <div id="balanceDiff" class="animate-bounce-in"></div>
                            </div>
                            <div class="col-md-4 text-end d-flex align-items-center justify-content-end gap-4">
                                <div class="total-summary-mini px-4 border-end">
                                    <div class="small fw-800 text-muted opacity-50 uppercase mb-2">ACCUMULATED TOTAL</div>
                                    <div class="d-flex gap-5">
                                        <div class="text-end">
                                            <span class="d-block small fw-700 text-muted">Total Debit</span>
                                            <span class="fs-4 fw-900 text-dark transition-all" id="totalDebit">0.00</span>
                                        </div>
                                        <div class="text-end">
                                            <span class="d-block small fw-700 text-muted">Total Credit</span>
                                            <span class="fs-4 fw-900 text-dark transition-all" id="totalCredit">0.00</span>
                                        </div>
                                    </div>
                                </div>
                                <button class="btn btn-premium-blue-lg rounded-16 px-5 py-3 shadow-premium animate-up" onclick="saveVoucher(this)">
                                    <span class="fw-900 fs-5"><i class="fas fa-cloud-upload-alt me-2"></i> POST VOUCHER</span>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    // Ledgers data from server
    const ledgers = @Html.Raw(Json.Serialize(ViewBag.Ledgers));
    
    // Initial rows
    document.addEventListener('DOMContentLoaded', () => {
        const hiddenType = document.getElementById('voucherTypeHidden');
        if (hiddenType) {
            document.getElementById('voucherType').value = hiddenType.value;
        }
        
        addRow('Dr');
        addRow('Cr');
        
        // Initialize Select2 if exists
        if($.fn.select2) {
            $('.select2-simple').select2({
                placeholder: "Search account...",
                allowClear: true,
                width: '100%'
            });
        }
    });

    // Keyboard Navigation handled globally in _Layout
    
    const voucherTypeNames = {
        '1': 'Payment Voucher',
        '2': 'Receipt Voucher',
        '3': 'Contra Voucher',
        '4': 'Journal Voucher'
    };

    document.getElementById('voucherType').addEventListener('change', (e) => {
        const type = e.target.value;
        if (type == '1') window.location.href = '/Accounting/PaymentVoucher';
        else if (type == '2') window.location.href = '/Accounting/ReceiptVoucher';
        else if (type == '3') window.location.href = '/Accounting/ContraVoucher';
        else if (type == '4') window.location.href = '/Accounting/JournalVoucher';
    });

    function getAllowedLedgers(voucherType, rowType) {
        function isCashOrBank(l) {
            const g = (l.group || l.Group || "").toLowerCase();
            const n = (l.name || l.Name || "").toLowerCase();
            return g === "cash-in-hand" || g === "bank accounts" || n.includes("cash") || n.includes("bank");
        }

        if (voucherType === '1') { // Payment
            if (rowType === 'Dr') {
                return ledgers.filter(l => !isCashOrBank(l));
            } else {
                return ledgers.filter(l => isCashOrBank(l));
            }
        } 
        else if (voucherType === '2') { // Receipt
            if (rowType === 'Dr') {
                return ledgers.filter(l => isCashOrBank(l));
            } else {
                return ledgers.filter(l => !isCashOrBank(l));
            }
        } 
        else if (voucherType === '3') { // Contra
            return ledgers.filter(l => isCashOrBank(l));
        } 
        else { // Journal
            return ledgers;
        }
    }

    function addRow(type = 'Dr') {
        const tbody = document.getElementById('voucherBody');
        const tr = document.createElement('tr');
        tr.className = 'align-middle animate-slide-right-row';
        
        const voucherType = document.getElementById('voucherType').value;
        const allowed = getAllowedLedgers(voucherType, type);

        let ledgerOptions = '<option value="">Search Ledger Account...</option>';
        allowed.sort((a,b) => {
            const nameA = (a.name || a.Name || "").toLowerCase();
            const nameB = (b.name || b.Name || "").toLowerCase();
            return nameA.localeCompare(nameB);
        }).forEach(l => {
            const id = l.id || l.Id;
            const name = l.name || l.Name;
            const group = l.group || l.Group;
            ledgerOptions += `<option value="${id}">${name} (${group})</option>`;
        });

        tr.innerHTML = `
            <td class="ps-4">
                <div class="badge-row-type ${type === 'Dr' ? 'dr-bg' : 'cr-bg'} shadow-sm">
                    <select class="form-select form-select-sm border-0 fw-800 bg-transparent text-white row-type" onchange="updateRowColor(this); toggleInputs(this);">
                        <option value="Dr" ${type === 'Dr' ? 'selected' : ''}>BY (DR)</option>
                        <option value="Cr" ${type === 'Cr' ? 'selected' : ''}>TO (CR)</option>
                    </select>
                </div>
            </td>
            <td>
                <div class="select2-wrapper" style="min-width: 0;">
                    <select class="form-select form-select-sm row-ledger select2-simple" onchange="updateBalance(this)">
                        ${ledgerOptions}
                    </select>
                </div>
            </td>
            <td>
                <span class="ledger-balance-pill shadow-xs">Awaiting...</span>
            </td>
            <td>
                <div class="input-group input-group-sm shadow-sm rounded-8 overflow-hidden voucher-input-group">
                    <span class="input-group-text">$</span>
                    <input type="number" class="form-control row-debit" value="0" step="0.01" oninput="calculateTotals()" ${type === 'Cr' ? 'disabled' : ''}>
                </div>
            </td>
            <td>
                 <div class="input-group input-group-sm shadow-sm rounded-8 overflow-hidden voucher-input-group">
                    <span class="input-group-text">$</span>
                    <input type="number" class="form-control row-credit" value="0" step="0.01" oninput="calculateTotals()" ${type === 'Dr' ? 'disabled' : ''}>
                </div>
            </td>
            <td>
                <input type="text" class="form-control form-control-sm row-note voucher-note-input" placeholder="Reference note...">
            </td>
            <td class="text-center">
                <button class="btn btn-sm btn-light-soft text-danger rounded-circle hover-scale" style="width: 38px; height: 38px; display: inline-flex; align-items: center; justify-content: center;" onclick="removeRow(this)"><i class="fas fa-trash-alt"></i></button>
            </td>
        `;
        tbody.appendChild(tr);
        if($.fn.select2) {
            $(tr).find('.select2-simple').select2({ width: '100%' });
        }
    }

    function refreshLedgerOptions() {
        const voucherType = document.getElementById('voucherType').value;
        document.querySelectorAll('#voucherBody tr').forEach(tr => {
            const rowType = tr.querySelector('.row-type').value;
            const select = tr.querySelector('.row-ledger');
            const currentVal = select.value; // Preserve selection if possible
            
            const allowed = getAllowedLedgers(voucherType, rowType);
            let html = '<option value="">Search Ledger Account...</option>';
            
            allowed.sort((a,b) => {
                const nameA = (a.name || a.Name || "").toLowerCase();
                const nameB = (b.name || b.Name || "").toLowerCase();
                return nameA.localeCompare(nameB);
            }).forEach(l => {
                const id = l.id || l.Id;
                const name = l.name || l.Name;
                const group = l.group || l.Group;
                const selected = id == currentVal ? 'selected' : '';
                html += `<option value="${id}" ${selected}>${name} (${group})</option>`;
            });
            
            $(select).empty().append(html).trigger('change.select2'); // Update Select2
        });
    }

    function updateRowColor(select) {
        const badge = select.closest('.badge-row-type');
        if(select.value === 'Dr') {
            badge.className = 'badge-row-type dr-bg';
        } else {
            badge.className = 'badge-row-type cr-bg';
        }
        // Also refresh options because row type changed
        refreshLedgerOptions();
    }

    function updateBalance(select) {
        const id = select.value;
        if (!id) return;
        
        const tr = select.closest('tr');
        const pill = tr.querySelector('.ledger-balance-pill');
        pill.innerHTML = '<i class="fas fa-circle-notch fa-spin"></i> Checking...';
        
        fetch(`@Url.Action("GetLedgerBalance")?id=${id}`)
            .then(res => res.json())
            .then(data => {
                pill.innerHTML = `Bal: ${data.balance} <span class="text-secondary fw-800">${data.nature}</span>`;
                pill.classList.add('ready');
            })
            .catch(() => {
                pill.innerHTML = 'Error fetching balance';
            });
    }

    function toggleInputs(select) {
        const tr = select.closest('tr');
        const debitInput = tr.querySelector('.row-debit');
        const creditInput = tr.querySelector('.row-credit');
        
        if (select.value === 'Dr') {
            creditInput.value = 0;
            creditInput.disabled = true;
            debitInput.disabled = false;
        } else {
            debitInput.value = 0;
            debitInput.disabled = true;
            creditInput.disabled = false;
        }
        calculateTotals();
    }

    function removeRow(btn) {
        if (document.querySelectorAll('#voucherBody tr').length > 1) {
            btn.closest('tr').remove();
            calculateTotals();
        } else {
            alert('At least one row is required.');
        }
    }

    function calculateTotals() {
        let totalDr = 0;
        let totalCr = 0;
        
        document.querySelectorAll('.row-debit').forEach(i => totalDr += parseFloat(i.value || 0));
        document.querySelectorAll('.row-credit').forEach(i => totalCr += parseFloat(i.value || 0));
        
        document.getElementById('totalDebit').innerText = totalDr.toLocaleString('en-US', { minimumFractionDigits: 2 });
        document.getElementById('totalCredit').innerText = totalCr.toLocaleString('en-US', { minimumFractionDigits: 2 });
        
        const diff = Math.abs(totalDr - totalCr);
        const diffDiv = document.getElementById('balanceDiff');
        
        if (diff < 0.01 && totalDr > 0) {
            document.getElementById('totalDebit').className = 'text-end text-success';
            document.getElementById('totalCredit').className = 'text-end text-success';
            diffDiv.innerHTML = '<span class="badge bg-success-soft text-success px-3 py-2 rounded-pill"><i class="fas fa-check-circle me-1"></i> BALANCED</span>';
        } else {
            document.getElementById('totalDebit').className = 'text-end text-danger';
            document.getElementById('totalCredit').className = 'text-end text-danger';
            if (totalDr > 0 || totalCr > 0) {
                diffDiv.innerHTML = `<span class="badge bg-danger-soft text-danger px-3 py-2 rounded-pill"><i class="fas fa-exclamation-triangle me-1"></i> DIFF: ${diff.toLocaleString('en-US', { minimumFractionDigits: 2 })}</span>`;
            } else {
                diffDiv.innerHTML = "";
            }
        }
    }

    async function saveVoucher(btn) {
        const type = document.getElementById('voucherType').value;
        const date = document.getElementById('voucherDate').value;
        const narration = document.getElementById('voucherNarration').value;
        
        const rows = [];
        let totalDr = 0;
        let totalCr = 0;
        
        document.querySelectorAll('#voucherBody tr').forEach(tr => {
            const ledgerId = tr.querySelector('.row-ledger').value;
            const debit = parseFloat(tr.querySelector('.row-debit').value) || 0;
            const credit = parseFloat(tr.querySelector('.row-credit').value) || 0;
            const note = tr.querySelector('.row-note').value;
            
            if (!ledgerId) return;
            
            totalDr += debit;
            totalCr += credit;
            rows.push({ ledgerId: parseInt(ledgerId), debit, credit, note });
        });

        if (rows.length === 0) {
            Swal.fire('Error', 'Please add at least one ledger entry.', 'error');
            return;
        }

        if (Math.abs(totalDr - totalCr) > 0.01) {
            Swal.fire('Imbalanced', 'Debit and Credit totals must match! Current Diff: ' + (totalDr - totalCr).toFixed(2), 'warning');
            return;
        }

        const payload = {
            date,
            type: parseInt(type),
            narration,
            rows
        };

        const originalHtml = btn.innerHTML;
        btn.disabled = true;
        btn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i> POSTING...';

        try {
            const response = await fetch('/Accounting/CreateVoucher', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });
            
            if (response.ok) {
                Swal.fire({
                    icon: 'success',
                    title: 'Voucher Posted',
                    text: 'The financial entry has been recorded successfully.',
                    timer: 2000,
                    showConfirmButton: false
                }).then(() => {
                    window.location.reload();
                });
            } else {
                const text = await response.text();
                Swal.fire('Error', text, 'error');
                btn.disabled = false;
                btn.innerHTML = originalHtml;
            }
        } catch (e) {
            Swal.fire('Error', 'Error saving voucher: ' + e, 'error');
            btn.disabled = false;
            btn.innerHTML = originalHtml;
        }
    }
</script>

