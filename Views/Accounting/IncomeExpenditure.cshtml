@model IEnumerable<EasyEdu.Models.AccountGroup>
@using EasyEdu.Models
@{
    ViewData["Title"] = "Income & Expenditure Account";
    Layout = "_Layout";
    var balances = ViewBag.LedgerBalances as Dictionary<int, decimal>;
    
    decimal GetGroupBalance(AccountGroup group)
    {
        decimal total = 0;
        if(group.Ledgers != null)
        {
            foreach(var ledger in group.Ledgers)
            {
               if(balances != null && balances.ContainsKey(ledger.Id))
               {
                   total += balances[ledger.Id];
               }
            }
        }
        if(group.SubGroups != null)
        {
            foreach(var sub in group.SubGroups)
            {
                total += GetGroupBalance(sub);
            }
        }
        return total;
    }

    var income = Model.Where(g => g.Nature == AccountNature.Income).ToList();
    var expenses = Model.Where(g => g.Nature == AccountNature.Expenses).ToList();
    
    decimal totalIncome = income.Sum(a => GetGroupBalance(a)); 
    decimal totalExpenses = expenses.Sum(l => GetGroupBalance(l)); 

    decimal difference = totalIncome - totalExpenses;
    string resultLabel = difference >= 0 ? "Surplus (Excess of Income over Expenditure)" : "Deficit (Excess of Expenditure over Income)";
}

<div class="content-wrapper pt-0 animate-up">
    <div class="d-flex justify-content-between align-items-center mb-4 px-3">
        <div>
            <h3 class="fw-800 text-dark mb-1">Income & Expenditure Account</h3>
            <p class="text-muted small fw-700 uppercase tracking-wider"><i class="fas fa-hand-holding-usd me-2"></i> For the period ending @DateTime.Now.ToString("dd MMM yyyy")</p>
        </div>
         <div>
            <button class="btn btn-premium-purple btn-sm px-4 rounded-pill shadow-sm fw-800" onclick="window.print()">
                <i class="fas fa-print me-2"></i> EXPORT I/E STATEMENT
            </button>
        </div>
    </div>

    <div class="premium-card">
        <div class="card-body p-0">
            <div class="row g-0">
                <!-- Expenses Side -->
                <div class="col-md-6 border-end">
                    <div class="p-3 bg-light fw-800 text-center border-bottom text-uppercase">Expenses</div>
                    <div class="p-4">
                        @foreach(var group in expenses)
                        {
                            var balance = Math.Abs(GetGroupBalance(group));
                            <div class="d-flex justify-content-between mb-2">
                                <span class="fw-700">@group.Name</span>
                                <span class="fw-700">@balance.ToString("N2")</span>
                            </div>
                            @if(group.SubGroups != null)
                            {
                                foreach(var sub in group.SubGroups)
                                {
                                    var subBal = Math.Abs(GetGroupBalance(sub));
                                    if(subBal != 0) {
                                        <div class="d-flex justify-content-between mb-1 ps-3 text-muted small">
                                            <span>@sub.Name</span>
                                            <span>@subBal.ToString("N2")</span>
                                        </div>
                                    }
                                }
                            }
                        }
                        
                        @if(difference >= 0)
                        {
                            <div class="d-flex justify-content-between mt-4 border-top pt-2 text-success">
                                <span class="fw-800">Net Profit</span>
                                <span class="fw-800">@difference.ToString("N2")</span>
                            </div>
                        }
                    </div>
                </div>

                <!-- Income Side -->
                <div class="col-md-6">
                    <div class="p-3 bg-light fw-800 text-center border-bottom text-uppercase">Income</div>
                    <div class="p-4">
                        @foreach(var group in income)
                        {
                            var balance = Math.Abs(GetGroupBalance(group));
                             <div class="d-flex justify-content-between mb-2">
                                <span class="fw-700">@group.Name</span>
                                <span class="fw-700">@balance.ToString("N2")</span>
                            </div>
                        }
                        
                        @if(difference < 0)
                        {
                            <div class="d-flex justify-content-between mt-4 border-top pt-2 text-danger">
                                <span class="fw-800">Net Loss</span>
                                <span class="fw-800">@Math.Abs(difference).ToString("N2")</span>
                            </div>
                        }
                    </div>
                </div>
            </div>
            
            <div class="row g-0 bg-light border-top">
                <div class="col-md-6 border-end text-end p-3 fw-900 border-bottom">
                    Total: @Math.Max(totalExpenses + (difference > 0 ? difference : 0), totalExpenses).ToString("N2")
                </div>
                <div class="col-md-6 text-end p-3 fw-900 border-bottom">
                   Total: @Math.Max(totalIncome + (difference < 0 ? Math.Abs(difference) : 0), totalIncome).ToString("N2")
                </div>
            </div>
        </div>
    </div>
</div>
