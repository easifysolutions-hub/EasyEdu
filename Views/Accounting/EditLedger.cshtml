@model EasyEdu.Models.Ledger
@{
    ViewData["Title"] = "Edit Ledger";
    Layout = "_Layout";
}

<div class="content-wrapper p-4 animate-fade-in">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="page-title mb-1">Edit Ledger Account</h3>
            <p class="text-muted small fw-600">Update ledger properties</p>
        </div>
         <a href="@Url.Action("ChartOfAccounts")" class="btn btn-outline-secondary btn-sm rounded-8 fw-700">Back to List</a>
    </div>

    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="premium-card">
                <div class="card-body p-4">
                    <form asp-action="EditLedger" method="post">
                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="CompanyId" />
                        <input type="hidden" asp-for="IsSystem" />
                        <input type="hidden" asp-for="StudentId" />

                        <div class="mb-3">
                            <label class="form-label small fw-700 text-uppercase">Ledger Name *</label>
                            <input asp-for="Name" class="form-control form-control-premium w-100" required>
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label small fw-700 text-uppercase">Account Group *</label>
                            <select asp-for="AccountGroupId" class="form-select form-control-premium" required>
                                <option value="">-- Select Group --</option>
                                @foreach (var group in ViewBag.Groups)
                                {
                                    <option value="@group.Id">@group.Name</option>
                                }
                            </select>
                            <span asp-validation-for="AccountGroupId" class="text-danger small"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label small fw-700 text-uppercase">Opening Balance</label>
                                <input asp-for="OpeningBalance" class="form-control form-control-premium w-100" type="number" step="0.01">
                                <span asp-validation-for="OpeningBalance" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label small fw-700 text-uppercase">Dr/Cr</label>
                                <select asp-for="IsDebitOpening" class="form-select form-control-premium">
                                    <option value="true">Dr</option>
                                    <option value="false">Cr</option>
                                </select>
                                <span asp-validation-for="IsDebitOpening" class="text-danger small"></span>
                            </div>
                        </div>

                        <button type="submit" class="btn btn-premium-primary w-100 mt-2">SAVE CHANGES</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
