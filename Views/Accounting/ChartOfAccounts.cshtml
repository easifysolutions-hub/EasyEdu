@model IEnumerable<EasyEdu.Models.AccountGroup>
@{
    ViewData["Title"] = "Chart of Accounts";
    Layout = "_Layout";
}

<div class="content-wrapper p-4 animate-fade-in">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="page-title mb-1">Chart of Accounts</h3>
            <p class="text-muted small fw-600">Master list of Ledger Accounts and Groups</p>
        </div>
        <div class="d-flex gap-2">
            <a href="@Url.Action("SeedDefaults")" class="btn btn-outline-warning btn-sm rounded-8" onclick="return confirm('This will create default groups and ledgers. Continue?')">
                <i class="fas fa-magic me-2"></i> Seed Defaults
            </a>
            <a href="@Url.Action("CreateLedger")" class="btn btn-premium-purple btn-sm rounded-8">
                <i class="fas fa-plus me-2"></i> Create Ledger
            </a>
        </div>
    </div>

    <div class="row">
        <div class="col-12">
            <div class="premium-card">
                <div class="card-body p-4">
                    <div class="tree-view">
                        <ul class="list-unstyled">
                            @foreach (var group in Model)
                            {
                                <li class="mb-2">
                                    <div class="d-flex align-items-center fw-800 text-dark mb-1 p-2 bg-light rounded-8">
                                        <i class="fas fa-folder me-2 text-warning"></i> @group.Name
                                        <span class="badge bg-light text-muted border ms-2">@group.Nature</span>
                                    </div>
                                    @if(group.Ledgers.Any() || group.SubGroups.Any())
                                    {
                                        <ul class="list-unstyled ms-4 border-start border-2 ps-3">
                                            @foreach(var sub in group.SubGroups)
                                            {
                                                <li class="mb-2">
                                                    <div class="d-flex align-items-center fw-700 text-secondary mb-1">
                                                        <i class="fas fa-folder-open me-2 text-secondary opacity-75"></i> @sub.Name
                                                    </div>
                                                    <!-- Recursive checking could be better, but assuming 2 levels for now in seeding -->
                                                    @if(sub.Ledgers.Any()){
                                                        <ul class="list-unstyled ms-4">
                                                            @foreach(var l in sub.Ledgers)
                                                            {
                                                                 <li class="d-flex justify-content-between align-items-center border-bottom py-1">
                                                                     <span class="small fw-600"><i class="fas fa-file-alt me-2 text-primary opacity-75"></i> @l.Name</span>
                                                                     <span class="badge bg-light text-muted">Ledger</span>
                                                                 </li>
                                                            }
                                                        </ul>
                                                    }
                                                </li>
                                            }
                                            @foreach(var ledger in group.Ledgers)
                                            {
                                                <li class="d-flex justify-content-between align-items-center border-bottom py-1">
                                                     <span class="small fw-600"><i class="fas fa-file-alt me-2 text-primary opacity-75"></i> @ledger.Name</span>
                                                     <a href="@Url.Action("AccountLedger", new { ledgerId = ledger.Id })" class="btn btn-sm btn-link text-decoration-none">View</a>
                                                </li>
                                            }
                                        </ul>
                                    }
                                </li>
                            }
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
