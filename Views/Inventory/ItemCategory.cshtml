@model IEnumerable<EasyEdu.Models.ItemCategory>
@{
    ViewData["Title"] = "Item Category - Inventory";
    Layout = "_Layout";
}

<div class="page-header d-flex justify-content-between align-items-center mb-4 px-4">
    <div>
        <h1 class="page-title animate-slide-in"><i class="fas fa-tags me-2 text-primary"></i> Item Categories</h1>
        <p class="text-muted fw-600">Categorize your inventory items for better organization and reporting</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Index" class="btn btn-premium-blue rounded-12 px-4 fw-800 shadow-sm">
            <i class="fas fa-list me-2"></i> VIEW ALL ITEMS
        </a>
    </div>
</div>

<div class="container-fluid px-4">
    <div class="row g-4 animate-fade-in">
        <!-- Add Category Form -->
        <div class="col-xl-4">
            <div class="premium-card bg-white shadow-xl border-0 overflow-hidden rounded-20 h-100">
                <div class="p-4 border-bottom text-white" style="background: linear-gradient(135deg, #6366f1, #4f46e5);">
                    <h5 class="fw-800 mb-0"><i class="fas fa-plus-circle me-2"></i> Register Category</h5>
                    <p class="opacity-75 small mb-0 mt-1">Add a new classification for inventory assets</p>
                </div>
                <div class="p-4">
                    <form asp-action="CreateCategory" method="post">
                        <div class="mb-4">
                            <label class="form-label fw-800 small text-uppercase text-muted">Category Name</label>
                            <input type="text" name="Name" class="form-control-premium w-100" placeholder="e.g. Stationery, Electronics" required />
                        </div>
                        <div class="mb-4">
                            <label class="form-label fw-800 small text-uppercase text-muted">Description</label>
                            <textarea name="Description" class="form-control-premium w-100" rows="4" placeholder="Brief scope of items in this category..."></textarea>
                        </div>
                        <button type="submit" class="btn btn-premium-primary w-100 py-3 shadow-sm fs-6 fw-800 mt-2">
                            <i class="fas fa-save me-2"></i> SAVE CATEGORY
                        </button>
                    </form>
                </div>
            </div>
        </div>

        <!-- Categories List -->
        <div class="col-xl-8">
            <div class="premium-card bg-white shadow-xl border-0 overflow-hidden rounded-20">
                <div class="p-4 border-bottom d-flex align-items-center justify-content-between" style="background: linear-gradient(135deg, #0ea5e9, #0284c7);">
                    <h5 class="fw-800 mb-0 text-white"><i class="fas fa-table-list me-2"></i> Active Classifications</h5>
                    <span class="badge bg-white text-primary rounded-pill px-3 py-2 fw-800">@Model.Count() DEFINED</span>
                </div>
                <div class="table-responsive">
                    <table class="table premium-table mb-0">
                        <thead>
                            <tr>
                                <th class="ps-4">CATEGORY NAME</th>
                                <th>DESCRIPTION</th>
                                <th class="text-end pe-4">ACTIONS</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr class="align-middle">
                                    <td class="ps-4">
                                        <div class="d-flex align-items-center">
                                            <div class="icon-box-sm bg-primary-soft text-primary rounded-8 me-3">
                                                <i class="fas fa-folder-open small"></i>
                                            </div>
                                            <div>
                                                <div class="fw-800 text-dark">@item.Name</div>
                                                <div class="text-muted small fw-600" style="font-size: 0.7rem;">SYSTEM CATEGORY</div>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="text-muted small fw-600" style="max-width: 300px;">
                                            @(item.Description ?? "No description provided.")
                                        </div>
                                    </td>
                                    <td class="text-end pe-4">
                                        <div class="d-flex gap-2 justify-content-end">
                                            <button class="btn btn-sm btn-light-soft text-primary p-2 rounded-8" title="Edit Category">
                                                <i class="fas fa-edit"></i>
                                            </button>
                                            <button class="btn btn-sm btn-light-soft text-danger p-2 rounded-8" title="Delete Category">
                                                <i class="fas fa-trash-alt"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                            @if (!Model.Any())
                            {
                                <tr>
                                    <td colspan="3" class="text-center py-5">
                                        <i class="fas fa-tags fa-3x text-muted opacity-25 mb-3 d-block"></i>
                                        <div class="fw-800 text-muted">No categories registered yet.</div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .bg-primary-soft { background: rgba(99,102,241,0.1); color: #6366f1; }
    .icon-box-sm { width: 36px; height: 36px; display: flex; align-items: center; justify-content: center; }
</style>
