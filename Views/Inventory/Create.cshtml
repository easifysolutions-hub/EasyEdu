@model EasyEdu.Models.Inventory
@{
    ViewData["Title"] = "Register New Asset - Inventory Hub";
    Layout = "_Layout";
    var categories = ViewBag.Categories as IEnumerable<EasyEdu.Models.ItemCategory>;
}

<div class="page-header d-flex justify-content-between align-items-center mb-4 px-4">
    <div>
        <h1 class="page-title animate-slide-in"><i class="fas fa-plus-circle me-2 text-primary"></i> Asset Registration</h1>
        <p class="text-muted fw-600">Provision a new physical resource into the institutional logistics registry</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Index" class="btn btn-premium-blue rounded-12 px-4 shadow-sm fw-800">
            <i class="fas fa-arrow-left me-2"></i> INVENTORY HUB
        </a>
    </div>
</div>

<div class="container-fluid px-4 pb-5">
    <div class="row justify-content-center">
        <div class="col-xl-10 col-lg-12">
            <div class="premium-card bg-white shadow-xl border-0 overflow-hidden rounded-24 animate-fade-in">
                <div class="p-4 border-bottom bg-light d-flex align-items-center">
                    <div class="icon-box-sm bg-primary text-white rounded-circle me-3">
                        <i class="fas fa-database"></i>
                    </div>
                    <h5 class="fw-800 text-dark mb-0">Operational Parameter Definition</h5>
                </div>
                <div class="p-5">
                    <form asp-action="Create" method="post">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger-soft border-0 rounded-12 small fw-700 mb-4"></div>
                        
                        <div class="row g-5">
                            <div class="col-lg-7">
                                <h6 class="fw-800 text-muted text-uppercase mb-4" style="letter-spacing: 1px;">Sovereign Asset Information</h6>
                                
                                <div class="mb-4">
                                    <label asp-for="ItemName" class="form-label fw-800 text-muted small text-uppercase">Asset Nomenclature (Item Name)</label>
                                    <input asp-for="ItemName" class="form-control-premium w-100 fs-5 fw-900" placeholder="e.g. Logic-Master Workstation 4K" required />
                                    <span asp-validation-for="ItemName" class="text-danger small fw-700"></span>
                                </div>

                                <div class="row g-4 mb-4">
                                    <div class="col-md-6">
                                        <label asp-for="CategoryId" class="form-label fw-800 text-muted small text-uppercase">Strategic Classification</label>
                                        <select asp-for="CategoryId" class="form-control-premium w-100 select2" required>
                                            <option value="">Select Category</option>
                                            @if (categories != null)
                                            {
                                                @foreach(var cat in categories)
                                                {
                                                    <option value="@cat.Id">@cat.Name</option>
                                                }
                                            }
                                        </select>
                                        <span asp-validation-for="CategoryId" class="text-danger small fw-700"></span>
                                    </div>
                                    <div class="col-md-6">
                                        <label asp-for="SKU" class="form-label fw-800 text-muted small text-uppercase">Stock Keeping Unit (SKU)</label>
                                        <input asp-for="SKU" class="form-control-premium w-100" placeholder="e.g. EL-WST-001" />
                                        <span asp-validation-for="SKU" class="text-danger small fw-700"></span>
                                    </div>
                                </div>

                                <div class="mb-4">
                                    <label asp-for="Description" class="form-label fw-800 text-muted small text-uppercase">Logistics Specification</label>
                                    <textarea asp-for="Description" class="form-control-premium w-100" rows="4" placeholder="Technical specs, dimensions, or manufacturer details..."></textarea>
                                    <span asp-validation-for="Description" class="text-danger small fw-700"></span>
                                </div>

                                <div class="row g-4 mb-4">
                                    <div class="col-md-6">
                                        <label asp-for="Unit" class="form-label fw-800 text-muted small text-uppercase">Operational Unit</label>
                                        <select asp-for="Unit" class="form-control-premium w-100">
                                            <option value="Pieces">Pieces</option>
                                            <option value="Kilograms">Kilograms</option>
                                            <option value="Liters">Liters</option>
                                            <option value="Boxes">Boxes</option>
                                            <option value="Sets">Sets</option>
                                        </select>
                                    </div>
                                    <div class="col-md-6">
                                        <label asp-for="ReorderLevel" class="form-label fw-800 text-muted small text-uppercase">Critical Reserve Level (Reorder)</label>
                                        <input asp-for="ReorderLevel" type="number" class="form-control-premium w-100" placeholder="10" />
                                    </div>
                                </div>
                            </div>

                            <div class="col-lg-5">
                                <div class="premium-card p-4 border-0 shadow-none mb-4 bg-light rounded-24">
                                    <h6 class="fw-800 text-dark mb-4 text-uppercase" style="letter-spacing: 1px;">Valuation & Capacity</h6>
                                    
                                    <div class="mb-4">
                                        <label asp-for="Quantity" class="form-label fw-800 text-muted small">INITIAL RESERVE QUANTITY</label>
                                        <div class="input-group">
                                            <span class="input-group-text bg-white border-0 text-primary"><i class="fas fa-layer-group"></i></span>
                                            <input asp-for="Quantity" type="number" class="form-control-premium border-0 w-75 fw-900 fs-4" value="0" required />
                                        </div>
                                        <span asp-validation-for="Quantity" class="text-danger small fw-700"></span>
                                    </div>

                                    <div class="mb-5">
                                        <label asp-for="UnitPrice" class="form-label fw-800 text-muted small">ACQUISITION COST (PER UNIT)</label>
                                        <div class="input-group">
                                            <span class="input-group-text bg-white border-0 text-success"><i class="fas fa-dollar-sign"></i></span>
                                            <input asp-for="UnitPrice" type="number" step="0.01" class="form-control-premium border-0 w-75 fw-900 fs-4 text-success" placeholder="0.00" required />
                                        </div>
                                        <span asp-validation-for="UnitPrice" class="text-danger small fw-700"></span>
                                    </div>

                                    <div class="alert bg-primary-soft border-0 rounded-20 mb-0">
                                        <div class="d-flex align-items-center gap-3">
                                            <div class="icon-box-sm bg-primary text-white rounded-circle shadow-sm">
                                                <i class="fas fa-calculator"></i>
                                            </div>
                                            <div class="small fw-700 text-primary-dark opacity-75">Global valuation ($) will be calculated automatically upon registry commit.</div>
                                        </div>
                                    </div>
                                </div>

                                <div class="px-4 py-3 bg-light rounded-24 border mb-5 d-flex align-items-center justify-content-between">
                                    <div>
                                        <div class="fw-800 text-dark small text-uppercase">Registry Visibility</div>
                                        <div class="text-muted small fw-600">Show on terminal immediately</div>
                                    </div>
                                    <div class="form-check form-switch fs-4">
                                        <input asp-for="IsActive" class="form-check-input shadow-none" type="checkbox" checked />
                                    </div>
                                </div>

                                <div class="d-grid gap-3">
                                    <button type="submit" class="btn btn-premium-primary py-3 shadow-lg fs-5 fw-800">
                                        <i class="fas fa-database me-2"></i> COMMIT TO REGISTRY
                                    </button>
                                    <button type="reset" class="btn btn-light-soft py-2 rounded-12 fw-800 text-muted">CLEAR PARAMETERS</button>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .bg-primary-soft { background: rgba(99,102,241,0.1); color: #6366f1; }
    .text-primary-dark { color: #312e81; }
    .icon-box-sm { width: 36px; height: 36px; display: flex; align-items: center; justify-content: center; font-size: 0.9rem; }
    .btn-light-soft { background: rgba(0,0,0,0.03); color: #334155; border: none; }
</style>

@section Scripts {
    <script>
        $(document).ready(function() {
            $('.select2').select2({
                placeholder: "Select Category...",
                width: '100%'
            });
        });
    </script>
}
