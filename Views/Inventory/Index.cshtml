@model IEnumerable<EasyEdu.Models.Inventory>
@{
    ViewData["Title"] = "Item List - Inventory Hub";
    Layout = "_Layout";
}

<div class="page-header d-flex justify-content-between align-items-center mb-4 px-4">
    <div>
        <h1 class="page-title animate-slide-in"><i class="fas fa-cubes me-2 text-primary"></i> Inventory Master</h1>
        <p class="text-muted fw-600">Track and manage all institutional assets with real-time stock surveillance</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Reports" class="btn btn-premium-blue rounded-12 px-4 fw-800 shadow-sm">
            <i class="fas fa-chart-pie me-2"></i> ANALYTICS
        </a>
        <a asp-action="Create" class="btn btn-premium-primary rounded-12 px-4 fw-800 shadow-sm ms-2">
            <i class="fas fa-plus-circle me-2"></i> REGISTER ASSET
        </a>
    </div>
</div>

<div class="container-fluid px-4">
    <!-- Stat Cards -->
    <div class="row g-4 mb-5 animate-fade-in">
        <div class="col-xl-3 col-md-6">
            <div class="premium-card bg-white p-4 shadow-xl border-0 rounded-20 position-relative overflow-hidden">
                <div class="d-flex align-items-center">
                    <div class="icon-box-lg bg-primary-soft text-primary rounded-16 me-4">
                        <i class="fas fa-boxes-stacked h4 mb-0"></i>
                    </div>
                    <div>
                        <div class="small fw-800 text-muted text-uppercase mb-1" style="font-size: 0.65rem; letter-spacing: 0.5px;">Global SKUs</div>
                        <div class="h3 fw-900 text-dark mb-0">@Model.Count()</div>
                    </div>
                </div>
                <div class="position-absolute" style="bottom: -10px; right: -10px; opacity: 0.05;">
                    <i class="fas fa-boxes-stacked fa-4x"></i>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="premium-card bg-white p-4 shadow-xl border-0 rounded-20 position-relative overflow-hidden">
                <div class="d-flex align-items-center">
                    <div class="icon-box-lg bg-success-soft text-success rounded-16 me-4">
                        <i class="fas fa-hand-holding-dollar h4 mb-0"></i>
                    </div>
                    <div>
                        <div class="small fw-800 text-muted text-uppercase mb-1" style="font-size: 0.65rem; letter-spacing: 0.5px;">Vault Valuation</div>
                        <div class="h3 fw-900 text-dark mb-0">$@Model.Sum(i => i.TotalValue).ToString("N0")</div>
                    </div>
                </div>
                <div class="position-absolute" style="bottom: -10px; right: -10px; opacity: 0.05;">
                    <i class="fas fa-hand-holding-dollar fa-4x"></i>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="premium-card bg-white p-4 shadow-xl border-0 rounded-20 position-relative overflow-hidden">
                <div class="d-flex align-items-center">
                    <div class="icon-box-lg bg-warning-soft text-warning rounded-16 me-4">
                        <i class="fas fa-triangle-exclamation h4 mb-0"></i>
                    </div>
                    <div>
                        <div class="small fw-800 text-muted text-uppercase mb-1" style="font-size: 0.65rem; letter-spacing: 0.5px;">Low Stock Alerts</div>
                        <div class="h3 fw-900 text-dark mb-0">@Model.Count(i => i.Quantity < (i.ReorderLevel ?? 10) && i.Quantity > 0)</div>
                    </div>
                </div>
                <div class="position-absolute" style="bottom: -10px; right: -10px; opacity: 0.05;">
                    <i class="fas fa-triangle-exclamation fa-4x"></i>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="premium-card bg-white p-4 shadow-xl border-0 rounded-20 position-relative overflow-hidden">
                <div class="d-flex align-items-center">
                    <div class="icon-box-lg bg-danger-soft text-danger rounded-16 me-4">
                        <i class="fas fa-ban h4 mb-0"></i>
                    </div>
                    <div>
                        <div class="small fw-800 text-muted text-uppercase mb-1" style="font-size: 0.65rem; letter-spacing: 0.5px;">Depleted Assets</div>
                        <div class="h3 fw-900 text-dark mb-0">@Model.Count(i => i.Quantity <= 0)</div>
                    </div>
                </div>
                <div class="position-absolute" style="bottom: -10px; right: -10px; opacity: 0.05;">
                    <i class="fas fa-ban fa-4x"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Inventory Table -->
    <div class="premium-card bg-white shadow-xl border-0 overflow-hidden rounded-20">
        <div class="p-4 border-bottom bg-light d-flex justify-content-between align-items-center">
            <h5 class="fw-800 mb-0"><i class="fas fa-table me-2 text-primary"></i> Asset Registry</h5>
            <div class="input-group search-box shadow-none border rounded-pill px-3" style="max-width: 300px; background: white;">
                <span class="input-group-text border-0 bg-transparent text-muted"><i class="fas fa-search"></i></span>
                <input type="text" class="form-control border-0 shadow-none bg-transparent" placeholder="Search assets..." />
            </div>
        </div>
        <div class="table-responsive">
            <table class="table premium-table mb-0">
                <thead>
                    <tr>
                        <th class="ps-4">ASSET CLASSIFICATION</th>
                        <th>CATEGORY</th>
                        <th class="text-center">CURRENT STOCK</th>
                        <th>UNIT PRICE</th>
                        <th>VALUATION</th>
                        <th>HEALTH STATUS</th>
                        <th class="text-end pe-4">PROTOCOLS</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        var healthClass = item.Quantity <= 0 ? "bg-danger" : (item.Quantity < (item.ReorderLevel ?? 10) ? "bg-warning" : "bg-success");
                        var healthText = item.Quantity <= 0 ? "OUT OF STOCK" : (item.Quantity < (item.ReorderLevel ?? 10) ? "CRITICAL" : "HEALTHY");
                        
                        <tr class="align-middle transition-all">
                            <td class="ps-4">
                                <div class="d-flex align-items-center">
                                    <div class="icon-box-sm bg-light-soft text-primary rounded-12 me-3">
                                        <i class="fas fa-box-open small"></i>
                                    </div>
                                    <div>
                                        <div class="fw-800 text-dark">@item.ItemName</div>
                                        <div class="text-muted small fw-600" style="font-size: 0.7rem;">SKU: @(item.SKU ?? "NO-SKU")</div>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <span class="badge bg-primary-soft text-primary border-primary-soft fw-800 px-3 py-2 rounded-8" style="font-size: 0.7rem;">
                                    @(item.Category?.Name ?? "General")
                                </span>
                            </td>
                            <td class="text-center">
                                <div class="d-flex flex-column align-items-center">
                                    <span class="h5 fw-900 text-dark mb-0">@item.Quantity</span>
                                    <span class="text-muted small fw-700 uppercase" style="font-size: 0.6rem;">@item.Unit</span>
                                </div>
                            </td>
                            <td>
                                <div class="fw-800 text-dark">$@item.UnitPrice.ToString("N2")</div>
                            </td>
                            <td>
                                <div class="fw-900 text-primary">$@item.TotalValue.ToString("N2")</div>
                            </td>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <div class="health-pulse @healthClass"></div>
                                    <span class="fw-900 text-dark" style="font-size: 0.75rem;">@healthText</span>
                                </div>
                            </td>
                            <td class="text-end pe-4">
                                <div class="d-flex gap-2 justify-content-end">
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-light-soft text-primary p-2 rounded-8" title="Edit Parameters">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    <a asp-action="IssueItem" asp-route-id="@item.Id" class="btn btn-sm btn-light-soft text-purple p-2 rounded-8" title="Issue Asset">
                                        <i class="fas fa-hand-holding-box"></i>
                                    </a>
                                    <button type="button" class="btn btn-sm btn-light-soft text-danger p-2 rounded-8" onclick="confirmDecommission(@item.Id)">
                                        <i class="fas fa-trash-alt"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5">
                                <i class="fas fa-boxes-stacked fa-3x text-muted opacity-25 mb-3 d-block"></i>
                                <div class="fw-800 text-muted">Registry is currently empty.</div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function confirmDecommission(id) {
            Swal.fire({
                title: 'Decommission Asset?',
                text: "Removing this asset from registry will purge all related stock records.",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#ef4444',
                cancelButtonColor: '#6366f1',
                confirmButtonText: 'PURGE ASSET',
                background: '#fff',
                borderRadius: '20px'
            }).then((result) => {
                if (result.isConfirmed) {
                    // Implement delete logic
                }
            })
        }
    </script>
}

<style>
    .bg-primary-soft { background: rgba(99,102,241,0.1); color: #6366f1; }
    .bg-success-soft { background: rgba(16,185,129,0.1); color: #10b981; }
    .bg-warning-soft { background: rgba(245,158,11,0.1); color: #f59e0b; }
    .bg-danger-soft { background: rgba(239,68,68,0.1); color: #ef4444; }
    .bg-light-soft { background: rgba(0,0,0,0.03); color: #334155; }
    
    .icon-box-lg { width: 64px; height: 64px; display: flex; align-items: center; justify-content: center; }
    .icon-box-sm { width: 40px; height: 40px; display: flex; align-items: center; justify-content: center; }
    
    .health-pulse { width: 8px; height: 8px; border-radius: 50%; }
    .health-pulse.bg-success { box-shadow: 0 0 0 0 rgba(16,185,129, 0.7); animation: pulse-green 2s infinite; }
    .health-pulse.bg-warning { box-shadow: 0 0 0 0 rgba(245,158,11, 0.7); animation: pulse-orange 2s infinite; }
    .health-pulse.bg-danger { box-shadow: 0 0 0 0 rgba(239,68,68, 0.7); animation: pulse-red 2s infinite; }
    
    @@keyframes pulse-green { 0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(16,185,129, 0.7); } 70% { transform: scale(1); box-shadow: 0 0 0 6px rgba(16,185,129, 0); } 100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(16,185,129, 0); } }
    @@keyframes pulse-orange { 0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(245,158,11, 0.7); } 70% { transform: scale(1); box-shadow: 0 0 0 6px rgba(245,158,11, 0); } 100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(245,158,11, 0); } }
    @@keyframes pulse-red { 0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(239,68,68, 0.7); } 70% { transform: scale(1); box-shadow: 0 0 0 6px rgba(239,68,68, 0); } 100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(239,68,68, 0); } }
</style>
