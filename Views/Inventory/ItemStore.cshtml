@model IEnumerable<EasyEdu.Models.ItemStore>
@{
    ViewData["Title"] = "Item Store - Inventory";
    Layout = "_Layout";
}

<div class="page-header d-flex justify-content-between align-items-center mb-4 px-4">
    <div>
        <h1 class="page-title animate-slide-in"><i class="fas fa-warehouse me-2 text-primary"></i> Storage Facilities</h1>
        <p class="text-muted fw-600">Manage your institutional warehouses and storage locations</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Index" class="btn btn-premium-blue rounded-12 px-4 fw-800 shadow-sm">
            <i class="fas fa-list me-2"></i> INVENTORY HUB
        </a>
    </div>
</div>

<div class="container-fluid px-4">
    <div class="row g-4 animate-fade-in">
        <!-- Add Store Form -->
        <div class="col-xl-4">
            <div class="premium-card bg-white shadow-xl border-0 overflow-hidden rounded-20 h-100">
                <div class="p-4 border-bottom text-white" style="background: linear-gradient(135deg, #10b981, #059669);">
                    <h5 class="fw-800 mb-0"><i class="fas fa-plus-circle me-2"></i> Register facility</h5>
                    <p class="opacity-75 small mb-0 mt-1">Initialize a new storage unit or warehouse</p>
                </div>
                <div class="p-4">
                    <form asp-action="CreateStore" method="post">
                        <div class="mb-4">
                            <label class="form-label fw-800 small text-uppercase text-muted">Store Name / Warehouse</label>
                            <input type="text" name="StoreName" class="form-control-premium w-100" placeholder="e.g. Main Laboratory Depot" required />
                        </div>
                        <div class="mb-4">
                            <label class="form-label fw-800 small text-uppercase text-muted">Reference Number / Code</label>
                            <input type="text" name="StoreNumber" class="form-control-premium w-100" placeholder="e.g. WH-001" />
                        </div>
                        <button type="submit" class="btn btn-premium-primary w-100 py-3 shadow-sm fs-6 fw-800 mt-2" style="background: #10b981; border-color: #10b981;">
                            <i class="fas fa-save me-2"></i> INITIALIZE STORE
                        </button>
                    </form>
                </div>
            </div>
        </div>

        <!-- Stores List -->
        <div class="col-xl-8">
            <div class="premium-card bg-white shadow-xl border-0 overflow-hidden rounded-20">
                <div class="p-4 border-bottom d-flex align-items-center justify-content-between" style="background: linear-gradient(135deg, #f59e0b, #d97706);">
                    <h5 class="fw-800 mb-0 text-white"><i class="fas fa-boxes-stacked me-2"></i> Operational Storage Units</h5>
                    <span class="badge bg-white text-warning rounded-pill px-3 py-2 fw-800">@Model.Count() REGISTERED</span>
                </div>
                <div class="table-responsive">
                    <table class="table premium-table mb-0">
                        <thead>
                            <tr>
                                <th class="ps-4">FACILITY NAME</th>
                                <th>REFERENCE CODE</th>
                                <th class="text-end pe-4">ACTIONS</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr class="align-middle">
                                    <td class="ps-4">
                                        <div class="d-flex align-items-center">
                                            <div class="icon-box-sm bg-success-soft text-success rounded-8 me-3">
                                                <i class="fas fa-warehouse small"></i>
                                            </div>
                                            <div>
                                                <div class="fw-800 text-dark">@item.StoreName</div>
                                                <div class="text-muted small fw-600" style="font-size: 0.7rem;">STORAGE COMPONENT</div>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-dark fw-800 px-3 py-2 border rounded-8">
                                            @(item.StoreNumber ?? "N/A")
                                        </span>
                                    </td>
                                    <td class="text-end pe-4">
                                        <div class="d-flex gap-2 justify-content-end">
                                            <button class="btn btn-sm btn-light-soft text-primary p-2 rounded-8">
                                                <i class="fas fa-edit"></i>
                                            </button>
                                            <button class="btn btn-sm btn-light-soft text-danger p-2 rounded-8">
                                                <i class="fas fa-trash-alt"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                            @if (!Model.Any())
                            {
                                <tr>
                                    <td colspan="3" class="text-center py-5">
                                        <i class="fas fa-store-slash fa-3x text-muted opacity-25 mb-3 d-block"></i>
                                        <div class="fw-800 text-muted">No storage facilities registered.</div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .bg-success-soft { background: rgba(16,185,129,0.1); color: #10b981; }
    .icon-box-sm { width: 36px; height: 36px; display: flex; align-items: center; justify-content: center; }
</style>
