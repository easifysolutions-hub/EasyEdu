@model EasyEdu.Models.InventoryTransaction
@{
    ViewData["Title"] = "Asset Sales - Inventory";
    Layout = "_Layout";
    var inventories = ViewBag.Inventories as IEnumerable<EasyEdu.Models.Inventory>;
    var students = ViewBag.Students as IEnumerable<EasyEdu.Models.Student>;
}

<div class="page-header d-flex justify-content-between align-items-center mb-4 px-4">
    <div>
        <h1 class="page-title animate-slide-in"><i class="fas fa-cart-shopping me-2 text-primary"></i> Inventory Sales Terminal</h1>
        <p class="text-muted fw-600">Commercial distribution and direct sales of university-owned merchandise or supplies</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Transactions" class="btn btn-premium-blue rounded-12 px-4 shadow-sm fw-800">
            <i class="fas fa-file-invoice-dollar me-2"></i> SALES REVENUE LOGS
        </a>
    </div>
</div>

<div class="container-fluid px-4">
    <div class="row justify-content-center">
        <div class="col-xl-11">
            <div class="premium-card bg-white shadow-xl border-0 overflow-hidden rounded-24 animate-fade-in">
                <div class="row g-0">
                    <!-- Left Sidebar (Sales Info) -->
                    <div class="col-lg-5 p-5 text-white d-flex flex-column justify-content-between" style="background: linear-gradient(135deg, #0f172a, #1e293b);">
                        <div>
                            <div class="badge bg-success-soft text-success px-3 py-2 rounded-pill fw-800 small uppercase mb-4">Point of Sale</div>
                            <h2 class="fw-900 mb-4 display-6">Asset Commercialization</h2>
                            <p class="opacity-75 fw-600 mb-5 fs-5">Generate revenue by distributing assets through direct sales. Ensure unit prices are validated before processing the transaction.</p>
                            
                            <div class="premium-card bg-white-10 border-0 p-4 rounded-20 mb-4">
                                <div class="d-flex align-items-start gap-3">
                                    <div class="icon-box-sm bg-success text-white rounded-circle shadow-sm">
                                        <i class="fas fa-money-bill-transfer"></i>
                                    </div>
                                    <div>
                                        <div class="fw-900 text-white">Revenue Generation</div>
                                        <div class="small opacity-75">All sales transactions are linked to user accounts. Financial balances will be updated in the global ledger.</div>
                                    </div>
                                </div>
                            </div>

                            <div class="premium-card bg-white-10 border-0 p-4 rounded-20">
                                <div class="d-flex align-items-start gap-3">
                                    <div class="icon-box-sm bg-primary text-white rounded-circle shadow-sm">
                                        <i class="fas fa-barcode"></i>
                                    </div>
                                    <div>
                                        <div class="fw-900 text-white">Stock Adjustment</div>
                                        <div class="small opacity-75">Quantities will be deducted immediately. Ensure real-time stock availability before authorizing sale.</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        
                        <div class="pt-5 border-top border-white-10 d-flex align-items-center justify-content-between">
                            <div class="d-flex align-items-center gap-3">
                                <div class="icon-box-sm bg-white-10 rounded-circle text-white">
                                    <i class="fas fa-cash-register"></i>
                                </div>
                                <div class="fw-700 opacity-75 small">Operator: @User.Identity?.Name</div>
                            </div>
                            <div class="small fw-800 text-uppercase opacity-25">POS-AX400</div>
                        </div>
                    </div>
                    
                    <!-- Right Content (Sales Form) -->
                    <div class="col-lg-7 p-5 bg-white">
                        <form asp-action="SellItem" method="post">
                            @Html.AntiForgeryToken()
                            
                            <div class="mb-4">
                                <label class="form-label fw-800 text-muted small text-uppercase">Commercial Asset</label>
                                <select asp-for="InventoryId" class="form-control-premium w-100 select2" required id="assetSelector">
                                    <option value="">Select Item for Sale</option>
                                    @if (inventories != null)
                                    {
                                        @foreach(var item in inventories)
                                        {
                                            <option value="@item.Id" data-price="@item.UnitPrice">@item.ItemName (Stock: @item.Quantity)</option>
                                        }
                                    }
                                </select>
                            </div>

                            <div class="mb-4">
                                <label class="form-label fw-800 text-muted small text-uppercase">Customer / Student</label>
                                <select asp-for="StudentId" class="form-control-premium w-100 select2" required>
                                    <option value="">Search Student Admission / Name</option>
                                    @if (students != null)
                                    {
                                        @foreach(var s in students)
                                        {
                                            <option value="@s.Id">@s.AdmissionNumber - @s.FirstName @s.LastName</option>
                                        }
                                    }
                                </select>
                            </div>

                            <div class="row g-4 mb-5">
                                <div class="col-md-6">
                                    <label asp-for="Quantity" class="form-label fw-800 text-muted small text-uppercase">Sale Quantity</label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-light border-0"><i class="fas fa-boxes-packing text-primary"></i></span>
                                        <input asp-for="Quantity" type="number" class="form-control-premium border-0 w-75" id="saleQty" value="1" min="1" required />
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="UnitPrice" class="form-label fw-800 text-muted small text-uppercase">Unit Sale Price</label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-light border-0"><i class="fas fa-dollar-sign text-success"></i></span>
                                        <input asp-for="UnitPrice" type="number" step="0.01" class="form-control-premium border-0 w-75 fw-900" id="salePrice" required />
                                    </div>
                                </div>
                            </div>

                            <div class="premium-card bg-light p-4 rounded-20 mb-5 border-0">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <div class="fw-800 text-muted small text-uppercase mb-1">Total Transaction Value</div>
                                        <div class="h2 fw-900 text-dark mb-0">$<span id="totalValue">0.00</span></div>
                                    </div>
                                    <div class="icon-box-lg bg-white shadow-sm rounded-circle text-primary">
                                        <i class="fas fa-calculator h4 mb-0"></i>
                                    </div>
                                </div>
                            </div>

                            <div class="mb-5">
                                <label asp-for="Remarks" class="form-label fw-800 text-muted small text-uppercase">Remarks / Reference</label>
                                <textarea asp-for="Remarks" class="form-control-premium w-100" rows="3" placeholder="Invoice reference, payment details, or special terms..."></textarea>
                            </div>

                            <div class="d-grid gap-3 pt-3">
                                <button type="submit" class="btn btn-premium-primary py-3 shadow-lg fs-5 fw-800" style="background: linear-gradient(135deg, #10b981, #059669); border: none;">
                                    <i class="fas fa-cash-register me-2"></i> AUTHORIZE TRANSACTION
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .bg-white-10 { background: rgba(255, 255, 255, 0.1); }
    .border-white-10 { border-color: rgba(255, 255, 255, 0.1) !important; }
    .rounded-24 { border-radius: 24px; }
    .rounded-20 { border-radius: 20px; }
    .icon-box-sm { width: 36px; height: 36px; display: flex; align-items: center; justify-content: center; font-size: 0.9rem; }
    .icon-box-lg { width: 64px; height: 64px; display: flex; align-items: center; justify-content: center; }
</style>

@section Scripts {
    <script>
        $(document).ready(function() {
            $('.select2').each(function() {
                $(this).select2({
                    dropdownParent: $(this).parent(),
                    placeholder: $(this).data('placeholder') || "Search selection...",
                    allowClear: true,
                    width: '100%'
                });
            });

            $('#assetSelector').on('change', function() {
                const price = $(this).find(':selected').data('price');
                if(price) $('#salePrice').val(price);
                calculateTotal();
            });

            $('#saleQty, #salePrice').on('input', function() {
                calculateTotal();
            });

            function calculateTotal() {
                const qty = parseFloat($('#saleQty').val()) || 0;
                const price = parseFloat($('#salePrice').val()) || 0;
                const total = (qty * price).toFixed(2);
                $('#totalValue').text(total);
            }
        });
    </script>
}
