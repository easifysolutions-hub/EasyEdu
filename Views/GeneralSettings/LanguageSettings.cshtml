@{
    ViewData["Title"] = "Language Settings";
}

<div class="content-wrapper p-4 animate-fade-in text-dark">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="page-title mb-1 fw-900">Language Management</h3>
            <p class="text-muted small fw-600">Localize your platform for different regions</p>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-primary-premium rounded-12 px-4 fw-800 shadow-sm d-flex align-items-center gap-2">
                <i class="fas fa-plus"></i> ADD NEW LANGUAGE
            </button>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-md-6 col-lg-3">
             <div class="premium-card p-4 text-center border-2 border-primary-soft shadow-lg rounded-20 overflow-hidden" style="background: linear-gradient(135deg, #f0f7ff 0%, #ffffff 100%);">
                <div class="mb-3">
                    <img src="https://flagcdn.com/w160/us.png" class="rounded-8 shadow-sm" style="width: 64px; height: 42px; object-fit: cover; border: 2px solid #fff;" />
                </div>
                <h5 class="fw-800 mb-1">English (US)</h5>
                <div class="badge bg-primary-soft text-primary px-3 rounded-pill fw-800 mb-3 small">DEFAULT</div>
                <div class="d-flex gap-2">
                    <button class="btn btn-sm btn-light text-muted w-100 fw-700 disabled">ACTIVE</button>
                    <button class="btn btn-sm btn-light-soft text-primary w-100 fw-700" title="Manage Phrases"><i class="fas fa-edit"></i></button>
                </div>
            </div>
        </div>
        <div class="col-md-6 col-lg-3">
             <div class="premium-card p-4 text-center border-0 shadow-sm rounded-20 overflow-hidden bg-white">
                <div class="mb-3">
                    <img src="https://flagcdn.com/w160/in.png" class="rounded-8 shadow-sm" style="width: 64px; height: 42px; object-fit: cover; border: 2px solid #fff;" />
                </div>
                <h5 class="fw-800 mb-1">Kannada</h5>
                <div class="badge bg-success-soft text-success px-3 rounded-pill fw-800 mb-3 small text-uppercase">Regional</div>
                <div class="d-flex gap-2">
                    <button class="btn btn-sm btn-primary-soft text-primary w-100 fw-700">SET DEFAULT</button>
                    <button class="btn btn-sm btn-light-soft text-primary w-100 fw-700" title="Manage Phrases"><i class="fas fa-edit"></i></button>
                    <button class="btn btn-sm btn-light-soft text-danger w-100 fw-700" title="Delete"><i class="fas fa-trash"></i></button>
                </div>
            </div>
        </div>
        <div class="col-md-6 col-lg-3">
             <div class="premium-card p-4 text-center border-0 shadow-sm rounded-20 overflow-hidden bg-white">
                <div class="mb-3">
                    <img src="https://flagcdn.com/w160/in.png" class="rounded-8 shadow-sm" style="width: 64px; height: 42px; object-fit: cover; border: 2px solid #fff;" />
                </div>
                <h5 class="fw-800 mb-1">Malayalam</h5>
                <div class="badge bg-success-soft text-success px-3 rounded-pill fw-800 mb-3 small text-uppercase">Regional</div>
                <div class="d-flex gap-2">
                    <button class="btn btn-sm btn-primary-soft text-primary w-100 fw-700">SET DEFAULT</button>
                    <button class="btn btn-sm btn-light-soft text-primary w-100 fw-700" title="Manage Phrases"><i class="fas fa-edit"></i></button>
                    <button class="btn btn-sm btn-light-soft text-danger w-100 fw-700" title="Delete"><i class="fas fa-trash"></i></button>
                </div>
            </div>
        </div>
        <div class="col-md-6 col-lg-3">
             <div class="premium-card p-4 text-center border-0 shadow-sm rounded-20 overflow-hidden bg-white">
                <div class="mb-3">
                    <img src="https://flagcdn.com/w160/in.png" class="rounded-8 shadow-sm" style="width: 64px; height: 42px; object-fit: cover; border: 2px solid #fff;" />
                </div>
                <h5 class="fw-800 mb-1">Tamil</h5>
                <div class="badge bg-success-soft text-success px-3 rounded-pill fw-800 mb-3 small text-uppercase">Regional</div>
                <div class="d-flex gap-2">
                    <button class="btn btn-sm btn-primary-soft text-primary w-100 fw-700">SET DEFAULT</button>
                    <button class="btn btn-sm btn-light-soft text-primary w-100 fw-700" title="Manage Phrases"><i class="fas fa-edit"></i></button>
                    <button class="btn btn-sm btn-light-soft text-danger w-100 fw-700" title="Delete"><i class="fas fa-trash"></i></button>
                </div>
            </div>
        </div>
        <div class="col-md-6 col-lg-3">
             <div class="premium-card p-4 text-center border-0 shadow-sm rounded-20 overflow-hidden bg-white">
                <div class="mb-3">
                    <img src="https://flagcdn.com/w160/in.png" class="rounded-8 shadow-sm" style="width: 64px; height: 42px; object-fit: cover; border: 2px solid #fff;" />
                </div>
                <h5 class="fw-800 mb-1">Hindi</h5>
                <div class="badge bg-warning-soft text-warning px-3 rounded-pill fw-800 mb-3 small text-uppercase">National</div>
                <div class="d-flex gap-2">
                    <button class="btn btn-sm btn-primary-soft text-primary w-100 fw-700">SET DEFAULT</button>
                    <button class="btn btn-sm btn-light-soft text-primary w-100 fw-700" title="Manage Phrases"><i class="fas fa-edit"></i></button>
                    <button class="btn btn-sm btn-light-soft text-danger w-100 fw-700" title="Delete"><i class="fas fa-trash"></i></button>
                </div>
            </div>
        </div>
        <div class="col-md-6 col-lg-3">
             <div class="premium-card p-4 text-center border-0 shadow-sm rounded-20 overflow-hidden bg-white">
                <div class="mb-3">
                    <img src="https://flagcdn.com/w160/pk.png" class="rounded-8 shadow-sm" style="width: 64px; height: 42px; object-fit: cover; border: 2px solid #fff;" />
                </div>
                <h5 class="fw-800 mb-1">Urdu</h5>
                <div class="badge bg-info-soft text-info px-3 rounded-pill fw-800 mb-3 small text-uppercase">International</div>
                <div class="d-flex gap-2">
                    <button class="btn btn-sm btn-primary-soft text-primary w-100 fw-700">SET DEFAULT</button>
                    <button class="btn btn-sm btn-light-soft text-primary w-100 fw-700" title="Manage Phrases"><i class="fas fa-edit"></i></button>
                    <button class="btn btn-sm btn-light-soft text-danger w-100 fw-700" title="Delete"><i class="fas fa-trash"></i></button>
                </div>
            </div>
        </div>
    </div>
    </div>

    <div class="premium-card p-0 overflow-hidden">
        <div class="p-4 border-bottom d-flex justify-content-between align-items-center">
            <h5 class="mb-0 fw-800 text-dark">Phrase Translation Manager</h5>
             <div class="search-bar-modern p-0 bg-light-soft" style="width: 300px;">
                <input type="text" class="form-control border-0 bg-transparent py-2 px-3 fw-600 small" placeholder="Search phrase..." />
            </div>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light-soft text-dark">
                    <tr>
                        <th class="ps-4 py-3 fw-800 small text-uppercase">Phrase Key</th>
                        <th class="py-3 fw-800 small text-uppercase">English (Source)</th>
                        <th class="py-3 fw-800 small text-uppercase">Spanish (Target)</th>
                        <th class="pe-4 py-3 text-end fw-800 small text-uppercase">Last Update</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td class="ps-4 fw-800 text-primary">btn_login</td>
                        <td class="fw-700">Log In</td>
                        <td class="fw-700 text-dark">Iniciar Sesión</td>
                        <td class="pe-4 text-end text-muted small fw-600">03 Mar 2026</td>
                    </tr>
                     <tr>
                        <td class="ps-4 fw-800 text-primary">lbl_welcome</td>
                        <td class="fw-700">Welcome to EasyEdu</td>
                        <td class="fw-700 text-dark">Bienvenido a EasyEdu</td>
                        <td class="pe-4 text-end text-muted small fw-600">03 Mar 2026</td>
                    </tr>
                     <tr>
                        <td class="ps-4 fw-800 text-primary">nav_dashboard</td>
                        <td class="fw-700">Dashboard</td>
                        <td class="fw-700 text-dark">Tablero</td>
                        <td class="pe-4 text-end text-muted small fw-600">03 Mar 2026</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>
