@model IEnumerable<EasyEdu.Models.AdminSetupItem>
@{
    ViewData["Title"] = "Base Setup";
}

<div class="content-wrapper p-4 animate-fade-in text-dark">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="page-title mb-1 fw-900">Base Setup</h3>
            <p class="text-muted small fw-600">Configure global categories and system masters</p>
        </div>
        <button class="btn btn-primary-premium rounded-12 px-4 fw-800 shadow-sm" data-bs-toggle="modal" data-bs-target="#addSetupModal">
            <i class="fas fa-plus me-2"></i>ADD NEW ITEM
        </button>
    </div>

    <div class="row g-4">
        @{
            var groups = Model.GroupBy(x => x.Category);
        }
        @foreach (var group in groups)
        {
            <div class="col-md-6 col-xl-4">
                <div class="premium-card h-100">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div class="d-flex align-items-center gap-3">
                            <div class="icon-box-sm bg-primary-soft text-primary rounded-12">
                                <i class="fas fa-layer-group"></i>
                            </div>
                            <h5 class="mb-0 fw-800 text-dark">@group.Key</h5>
                        </div>
                        <span class="badge bg-light text-dark fw-700 rounded-pill">@group.Count() Items</span>
                    </div>
                    <div class="list-group list-group-flush rounded-12 border-0">
                        @foreach (var item in group)
                        {
                            <div class="list-group-item d-flex justify-content-between align-items-center border-0 px-0 py-2">
                                <div class="fw-600 text-muted">@item.Name</div>
                                <div class="d-flex gap-2">
                                    <button class="btn btn-sm btn-link text-primary p-0"><i class="fas fa-edit"></i></button>
                                    <button class="btn btn-sm btn-link text-danger p-0"><i class="fas fa-trash"></i></button>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<!-- Modal for Add New Item -->
<div class="modal fade" id="addSetupModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 rounded-20 shadow-xl overflow-hidden">
            <div class="modal-header bg-primary text-white p-4">
                <h5 class="modal-title fw-800">New Setup Item</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="CreateSetupItem" method="post">
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label fw-700 small text-muted">CATEGORY</label>
                        <select name="Category" class="form-select border-light-subtle p-3 rounded-12 fw-600" required>
                            <option value="Purpose">Purpose</option>
                            <option value="Complaint Type">Complaint Type</option>
                            <option value="Source">Source</option>
                            <option value="Reference">Reference</option>
                            <option value="Class">Class</option>
                            <option value="Session">Session</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-700 small text-muted">NAME</label>
                        <input type="text" name="Name" class="form-control border-light-subtle p-3 rounded-12 fw-600" placeholder="e.g. Admission" required />
                    </div>
                </div>
                <div class="modal-footer border-0 p-4 pt-0">
                    <button type="button" class="btn btn-light-soft fw-800 px-4 rounded-12" data-bs-dismiss="modal">CANCEL</button>
                    <button type="submit" class="btn btn-primary-premium fw-800 px-4 rounded-12">SAVE CHANGES</button>
                </div>
            </form>
        </div>
    </div>
</div>
