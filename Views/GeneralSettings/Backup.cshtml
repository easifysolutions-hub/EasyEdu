@{
    ViewData["Title"] = "Database Backup";
}

<div class="content-wrapper p-4 animate-fade-in text-dark">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="page-title mb-1 fw-900">Database Backup</h3>
            <p class="text-muted small fw-600">Secure your system data and configuration</p>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-primary-premium rounded-12 px-4 fw-800 shadow-sm d-flex align-items-center gap-2">
                <i class="fas fa-database"></i> CREATE BACKUP NOW
            </button>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-md-6 col-lg-4">
            <div class="premium-card p-4 text-center text-md-start h-100 border-0 shadow-sm rounded-20 overflow-hidden">
                <div class="d-flex flex-column align-items-center text-center">
                    <div class="icon-box-lg bg-success-soft text-success rounded-circle mb-3 p-4">
                        <i class="fas fa-shield-check fa-2x"></i>
                    </div>
                    <h5 class="fw-800 text-dark mb-1">Manual Database Backup</h5>
                    <p class="text-muted small fw-600 mb-3 text-center">Export your entire SQL database as a secure .bak file for manual storage.</p>
                    <button class="btn btn-outline-success border-2 rounded-12 w-100 fw-800 p-2">DOWNLOAD .BAK</button>
                </div>
            </div>
        </div>
        <div class="col-md-6 col-lg-4">
            <div class="premium-card p-4 text-center text-md-start h-100 border-0 shadow-sm rounded-20 overflow-hidden">
                 <div class="d-flex flex-column align-items-center text-center">
                    <div class="icon-box-lg bg-primary-soft text-primary rounded-circle mb-3 p-4">
                        <i class="fas fa-folder-open fa-2x"></i>
                    </div>
                    <h5 class="fw-800 text-dark mb-1">File Archive Backup</h5>
                    <p class="text-muted small fw-600 mb-3 text-center">Package all uploaded student documents, profile pictures, and reports into a ZIP archive.</p>
                    <button class="btn btn-outline-primary border-2 rounded-12 w-100 fw-800 p-2">CREATE ZIP ARCHIVE</button>
                </div>
            </div>
        </div>
        <div class="col-md-6 col-lg-4">
            <div class="premium-card p-4 text-center text-md-start h-100 border-0 shadow-sm rounded-20 overflow-hidden">
                 <div class="d-flex flex-column align-items-center text-center">
                    <div class="icon-box-lg bg-warning-soft text-warning rounded-circle mb-3 p-4">
                        <i class="fas fa-clock-rotate-left fa-2x"></i>
                    </div>
                    <h5 class="fw-800 text-dark mb-1">Auto Backup Schedule</h5>
                    <p class="text-muted small fw-600 mb-3 text-center">Currently: <strong class="text-dark">Daily at 02:00 AM</strong>. Configure cloud storage sync.</p>
                    <button class="btn btn-outline-warning border-2 rounded-12 w-100 fw-800 p-2">CONFIGURE AUTO-BACKUP</button>
                </div>
            </div>
        </div>
    </div>

    <div class="premium-card p-0 overflow-hidden">
        <div class="p-4 border-bottom d-flex justify-content-between align-items-center">
            <h5 class="mb-0 fw-800 text-dark">Backup History</h5>
            <button class="btn btn-link-soft text-danger p-2 text-decoration-none fw-800 small text-uppercase">
                <i class="fas fa-trash-can me-2"></i>Clear All Logs
            </button>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light-soft text-dark">
                    <tr>
                        <th class="ps-4 py-3 fw-800 small text-uppercase">Time Stamp</th>
                        <th class="py-3 fw-800 small text-uppercase">Backup Type</th>
                        <th class="py-3 fw-800 small text-uppercase">File Size</th>
                        <th class="py-3 fw-800 small text-uppercase">Status</th>
                        <th class="pe-4 py-3 text-end fw-800 small text-uppercase">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td class="ps-4">
                            <div class="fw-800 text-dark">02 Mar 2026, 02:00 AM</div>
                            <div class="small text-muted fw-600">Automated System Backup</div>
                        </td>
                        <td><span class="badge bg-primary-soft text-primary px-3 rounded-pill fw-800">DATABASE</span></td>
                        <td class="fw-700">12.4 MB</td>
                        <td><span class="badge bg-success-soft text-success px-3 rounded-pill fw-800">STABLE</span></td>
                        <td class="pe-4 text-end">
                            <button class="btn btn-sm btn-light-soft text-primary rounded-8 px-3 fw-800">DOWNLOAD</button>
                        </td>
                    </tr>
                     <tr>
                        <td class="ps-4">
                            <div class="fw-800 text-dark">01 Mar 2026, 02:00 AM</div>
                            <div class="small text-muted fw-600">Automated System Backup</div>
                        </td>
                        <td><span class="badge bg-primary-soft text-primary px-3 rounded-pill fw-800">DATABASE</span></td>
                        <td class="fw-700">12.1 MB</td>
                        <td><span class="badge bg-success-soft text-success px-3 rounded-pill fw-800">STABLE</span></td>
                        <td class="pe-4 text-end">
                            <button class="btn btn-sm btn-light-soft text-primary rounded-8 px-3 fw-800">DOWNLOAD</button>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>
