@model EasyEdu.Controllers.GmeetDashboardViewModel
@{
    ViewData["Title"] = "Gmeet Learning Hub";
    Layout = "_Layout";
}

<div class="content-wrapper p-4 animate-fade-in text-dark">
    <div class="d-flex justify-content-between align-items-center mb-5">
        <div>
            <h2 class="fw-900 text-dark mb-1">Google Meet Architect</h2>
            <p class="text-muted small fw-600">Coordinate and automate virtual learning via Google Workspace infrastructure</p>
        </div>
        <div class="d-flex gap-3">
             <a href="@Url.Action("VirtualClass")" class="btn btn-google px-4 py-2 rounded-12 shadow-sm fw-900">
                <i class="fab fa-google me-2"></i>CREATE CLASS
            </a>
            <a href="@Url.Action("Settings")" class="btn btn-light-soft px-4 py-2 rounded-12 fw-700">
                <i class="fas fa-cog me-2"></i>SERVICE CONFIG
            </a>
        </div>
    </div>

    <!-- Stats Matrix -->
    <div class="row g-4 mb-5">
        <div class="col-md-3">
            <div class="stat-card p-4 rounded-24 bg-white shadow-sm border-0 border-start border-4 border-primary">
                <p class="text-uppercase smallest fw-900 text-muted mb-2">Google Classrooms</p>
                <div class="d-flex align-items-end justify-content-between">
                    <h3 class="fw-900 m-0 text-dark">@ViewBag.ClassCount</h3>
                    <i class="fab fa-google-drive text-primary opacity-25 fa-2x"></i>
                </div>
            </div>
        </div>
        <div class="col-md-3">
             <div class="stat-card p-4 rounded-24 bg-white shadow-sm border-0 border-start border-4 border-success">
                <p class="text-uppercase smallest fw-900 text-muted mb-2">Active Summits</p>
                <div class="d-flex align-items-end justify-content-between">
                    <h3 class="fw-900 m-0 text-dark">@ViewBag.MeetingCount</h3>
                    <i class="fas fa-video text-success opacity-25 fa-2x"></i>
                </div>
            </div>
        </div>
        <div class="col-md-3">
             <div class="stat-card p-4 rounded-24 bg-light-soft border-dashed text-center">
                 <p class="smallest fw-900 text-muted uppercase ls-1 mb-0">API Handshake</p>
                 <span class="badge bg-success rounded-pill px-3 fw-900 mt-2">OPTIMAL</span>
             </div>
        </div>
        <div class="col-md-3">
            <div class="premium-card p-4 bg-google text-white shadow-lg border-0 h-100" style="border-radius: 20px;">
                <p class="text-uppercase smallest fw-900 opacity-75 mb-4">Workspace Status</p>
                <div class="d-flex justify-content-between align-items-end">
                    <h4 class="fw-900 m-0">SYNCED</h4>
                    <i class="fab fa-google fa-2x opacity-50"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-xl-9">
            <div class="premium-card p-0 overflow-hidden border-0 shadow-lg" style="border-radius: 24px;">
                <div class="card-header bg-white border-bottom p-4 d-flex justify-content-between align-items-center">
                    <h5 class="fw-900 text-dark m-0"><i class="fas fa-calendar-alt me-2 text-primary opacity-50"></i>Upcoming Google Sessions</h5>
                    <a href="@Url.Action("VirtualClass")" class="smallest fw-900 text-uppercase ls-1 text-primary">Full Queue</a>
                </div>
                <div class="card-body p-0">
                    <table class="table premium-table mb-0 align-middle">
                        <tbody class="bg-white">
                            @foreach (var cls in Model.RecentClasses)
                            {
                                <tr>
                                    <td class="ps-4 py-4">
                                        <div class="fw-900 text-dark">@cls.Topic</div>
                                        <div class="smallest text-muted fw-700 font-monospace">SYNC ID: @cls.Id</div>
                                    </td>
                                    <td>
                                        <div class="small fw-800 text-dark">@cls.Subject?.Name</div>
                                        <div class="smallest text-muted fw-700">@cls.Class?.Name</div>
                                    </td>
                                     <td>
                                        <div class="fw-700 text-dark small">@cls.Date.ToString("dd MMM")</div>
                                        <div class="smallest text-muted fw-700 opacity-50">@cls.StartTime</div>
                                    </td>
                                    <td class="pe-4 text-end">
                                        <a href="@cls.MeetUrl" target="_blank" class="btn btn-sm btn-light rounded-pill px-4 fw-900 border">LAUNCH MEET</a>
                                    </td>
                                </tr>
                            }
                            @if(!Model.RecentClasses.Any()){
                                <tr><td colspan="4" class="text-center py-5 text-muted fw-700 italic opacity-50">Zero upcoming Google Meet sessions detected.</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="col-xl-3">
             <div class="premium-card p-5 border-0 shadow-lg bg-light-soft text-center h-100" style="border-radius: 24px;">
                 <i class="fab fa-google-play fa-3x text-danger opacity-25 mb-4"></i>
                 <h5 class="fw-900 text-dark mb-4 ls-1">GOOGLE WORKSPACE</h5>
                 <div class="d-grid gap-3">
                     <a href="@Url.Action("VirtualMeeting")" class="btn btn-white shadow-sm py-3 rounded-16 fw-900 border-0 h6">STAFF SUMMIT</a>
                     <a href="@Url.Action("ClassReports")" class="btn btn-white shadow-sm py-3 rounded-16 fw-900 border-0 h6">USAGE ANALYTICS</a>
                 </div>
                 <hr class="my-5 opacity-10">
                 <p class="smallest text-muted fw-700 uppercase ls-1">Integration Healthy</p>
             </div>
        </div>
    </div>
</div>

<style>
    .rounded-24 { border-radius: 24px; }
    .rounded-16 { border-radius: 16px; }
    .ls-1 { letter-spacing: 1px; }
    .btn-google { background: #4285F4; color: white; border: none; }
    .bg-google { background: linear-gradient(135deg, #4285F4 0%, #34A853 100%); }
    .border-dashed { border: 2px dashed #e2e8f0; }
</style>
