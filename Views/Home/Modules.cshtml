@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const downloadBtn = document.getElementById('downloadProspectus');
            if (downloadBtn) {
                downloadBtn.addEventListener('click', function(e) {
                    e.preventDefault();
                    
                    const btn = this;
                    const originalHTML = btn.innerHTML;
                    
                    // Ultra-Premium Feedback State
                    if (window.Swal) {
                        Swal.fire({
                            title: 'Generating Prospectus',
                            html: 'Applying ultra-premium branding and AI optimizations...',
                            allowOutsideClick: false,
                            showConfirmButton: false,
                            didOpen: () => {
                                Swal.showLoading();
                            }
                        });
                    }

                    btn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i> OPTIMIZING FOR PDF...';
                    btn.disabled = true;

                    const element = document.getElementById('pdf-export-container');
                    
                    // TECHNICAL FIX: The "onclone" method ensures the element is 
                    // visible during the capture phase regardless of current UI state.
                    const opt = {
                        margin:       0,
                        filename:     'EasyEdu_Premium_Prospectus_2026.pdf',
                        image:        { type: 'jpeg', quality: 1.0 },
                        html2canvas:  { 
                            scale: 2, 
                            useCORS: true, 
                            letterRendering: true,
                            scrollY: 0,
                            scrollX: 0,
                            windowWidth: 1200, // Force a wider capture window for high-end rendering
                            onclone: (clonedDoc) => {
                                const clonedWrapper = clonedDoc.getElementById('pdf-container-wrapper');
                                const clonedElement = clonedDoc.getElementById('pdf-export-container');
                                if (clonedWrapper) {
                                    clonedWrapper.style.position = 'static';
                                    clonedWrapper.style.left = '0';
                                    clonedWrapper.style.visibility = 'visible';
                                    clonedWrapper.style.height = 'auto';
                                    clonedWrapper.style.display = 'block';
                                }
                                if (clonedElement) {
                                    clonedElement.style.display = 'block';
                                }
                            }
                        },
                        jsPDF:        { unit: 'mm', format: 'a4', orientation: 'portrait' },
                        pagebreak:    { mode: ['avoid-all', 'css', 'legacy'] }
                    };

                    // Delay slightly to ensure fonts/images are fully initialized in the browser session
                    setTimeout(() => {
                        html2pdf().set(opt).from(element).toPdf().get('pdf').then(function (pdf) {
                            // Professional final Polish
                            pdf.setAuthor('Easify Solutions');
                            pdf.setKeywords('Institution ERP, Education Technology, Prospectus');
                        }).save().then(() => {
                            btn.innerHTML = originalHTML;
                            btn.disabled = false;
                            
                            if (window.Swal) {
                                Swal.close();
                                Swal.fire({
                                    icon: 'success',
                                    title: 'Prospectus Downloaded',
                                    text: 'Our professional brochure is now ready for your review.',
                                    timer: 3000,
                                    showConfirmButton: false
                                });
                            }
                        }).catch(err => {
                            console.error('PDF Engine Error:', err);
                            if (window.Swal) { Swal.close(); }
                            btn.innerHTML = originalHTML;
                            btn.disabled = false;
                        });
                    }, 800);
                });
            }
        });
    </script>
}

