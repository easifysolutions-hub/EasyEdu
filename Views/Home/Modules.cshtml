@{
    Layout = "_LandingLayout";
    ViewData["Title"] = "Feature Prospectus - Complete Institution Ecosystem";
}

<section class="section-padding" style="background: transparent;">
    <div class="container">
        <div class="section-title text-center mb-5" data-aos="fade-up">
            <h5 class="text-primary fw-800 text-uppercase mb-2" style="letter-spacing: 2px;">Comprehensive Prospectus</h5>
            <h2 class="display-5 fw-900 mb-3">The EasyEdu Digital Ecosystem</h2>
            <p class="lead text-muted mx-auto" style="max-width: 800px;">A modular, scalable, and highly integrated ERP solution designed to transform every aspect of your educational institution.</p>
        </div>

        <!-- Tier 1: Core Institutional Management -->
        <h3 class="fw-800 mb-4 border-start border-primary border-4 ps-3">Core Institutional ERP</h3>
        <div class="row g-4 mb-5">
            <div class="col-md-4" data-aos="fade-up">
                <div class="premium-prospect-card h-100">
                    <div class="icon-header bg-primary-soft text-primary"><i class="fas fa-university"></i></div>
                    <h4>Multi-Campus Management</h4>
                    <p>Manage multiple school branches or colleges from a single dashboard. Synchronize data across institutes while maintaining independent financial records.</p>
                    <ul class="feature-list">
                        <li>Global Administrator Panel</li>
                        <li>Branch-wise Reporting</li>
                        <li>Cross-campus Data Migration</li>
                    </ul>
                </div>
            </div>
            <div class="col-md-4" data-aos="fade-up" data-aos-delay="100">
                <div class="premium-prospect-card h-100">
                    <div class="icon-header bg-success-soft text-success"><i class="fas fa-users-cog"></i></div>
                    <h4>Advanced RBAC</h4>
                    <p>Role-Based Access Control with granular permissions. Define exactly what your staff can see and edit based on their professional requirements.</p>
                    <ul class="feature-list">
                        <li>Custom Role Creation</li>
                        <li>Permission Matrices</li>
                        <li>Security Audit Logs</li>
                    </ul>
                </div>
            </div>
            <div class="col-md-4" data-aos="fade-up" data-aos-delay="200">
                <div class="premium-prospect-card h-100">
                    <div class="icon-header bg-info-soft text-info"><i class="fas fa-fingerprint"></i></div>
                    <h4>Biometric & RFID Integration</h4>
                    <p>Seamlessly integrate with hardware for automated attendance. Supports fingerprint, facial recognition, and RFID cards for students and staff.</p>
                    <ul class="feature-list">
                        <li>Real-time Sync</li>
                        <li>Automated Absence Alerts</li>
                        <li>Gate Entry Management</li>
                    </ul>
                </div>
            </div>
        </div>

        <!-- Tier 2: Academic & Learning -->
        <h3 class="fw-800 mb-4 border-start border-warning border-4 ps-3">Academic Excellence</h3>
        <div class="row g-4 mb-5">
            <div class="col-md-4" data-aos="fade-up">
                <div class="premium-prospect-card h-100">
                    <div class="icon-header bg-warning-soft text-warning"><i class="fas fa-chalkboard-teacher"></i></div>
                    <h4>Dynamic Timetable Engine</h4>
                    <p>AI-assisted scheduling to avoid teacher clashes and optimize classroom usage. Supports elective subjects and specialized lab sessions.</p>
                    <ul class="feature-list">
                        <li>Conflict Detection</li>
                        <li>Substitution Management</li>
                        <li>Classroom Optimization</li>
                    </ul>
                </div>
            </div>
            <div class="col-md-4" data-aos="fade-up" data-aos-delay="100">
                <div class="premium-prospect-card h-100">
                    <div class="icon-header bg-danger-soft text-danger"><i class="fas fa-laptop-code"></i></div>
                    <h4>Hybrid Learning & LMS</h4>
                    <p>Complete Learning Management System for sharing notes, video lectures, and online assignments. Integrated with Zoom and Google Meet.</p>
                    <ul class="feature-list">
                        <li>Question Bank Management</li>
                        <li>Automated Grading</li>
                        <li>Course Progress Tracking</li>
                    </ul>
                </div>
            </div>
            <div class="col-md-4" data-aos="fade-up" data-aos-delay="200">
                <div class="premium-prospect-card h-100">
                    <div class="icon-header bg-purple-soft text-purple"><i class="fas fa-poll-h"></i></div>
                    <h4>Examination & Results</h4>
                    <p>Comprehensive exam management from date-sheet creation to automated mark-sheet printing with customized designs.</p>
                    <ul class="feature-list">
                        <li>GPA/CGPA Calculation</li>
                        <li>CBSE/ICSE/Custom Patterns</li>
                        <li>Online Exam Portal</li>
                    </ul>
                </div>
            </div>
        </div>

        <!-- Tier 3: Finance & Assets -->
        <h3 class="fw-800 mb-4 border-start border-dark border-4 ps-3">Financial Planning & Operations</h3>
        <div class="row g-4 mb-5">
            <div class="col-md-4" data-aos="fade-up">
                <div class="premium-prospect-card h-100">
                    <div class="icon-header bg-dark-soft text-dark"><i class="fas fa-file-invoice-dollar"></i></div>
                    <h4>Fee Management Pro</h4>
                    <p>Automate your entire fee cycle. Support for installments, scholarships, fines, and online payment gateway integration.</p>
                    <ul class="feature-list">
                        <li>Online Fee Portal</li>
                        <li>Custom Receipt Printing</li>
                        <li>Automatic Fine Calculation</li>
                    </ul>
                </div>
            </div>
            <div class="col-md-4" data-aos="fade-up" data-aos-delay="100">
                <div class="premium-prospect-card h-100">
                    <div class="icon-header bg-secondary-soft text-secondary"><i class="fas fa-bus-alt"></i></div>
                    <h4>Transport & Logistics</h4>
                    <p>Manage routes, vehicle maintenance, fuel records, and driver details. Integrated GPS tracking for student safety.</p>
                    <ul class="feature-list">
                        <li>Route Monitoring</li>
                        <li>Pickup/Drop Alerts</li>
                        <li>Vehicle Expense Tracking</li>
                    </ul>
                </div>
            </div>
            <div class="col-md-4" data-aos="fade-up" data-aos-delay="200">
                <div class="premium-prospect-card h-100">
                    <div class="icon-header bg-primary-soft text-primary"><i class="fas fa-comments"></i></div>
                    <h4>Communication 360</h4>
                    <p>Powerful omnichannel communication platform across WhatsApp, SMS, Email, and Push Notifications.</p>
                    <ul class="feature-list">
                        <li>WhatsApp API Integration</li>
                        <li>Personalized Newsletters</li>
                        <li>Emergency Broadcasts</li>
                    </ul>
                </div>
            </div>
        </div>

        <!-- Tier 4: Mobile Application Ecosystem -->
        <h3 class="fw-800 mb-4 border-start border-info border-4 ps-3">Mobile Ecosystem</h3>
        <div class="row g-4 mb-5">
            <div class="col-md-6" data-aos="fade-up">
                <div class="premium-prospect-card h-100" style="background: linear-gradient(135deg, #ffffff 0%, #f0f9ff 100%);">
                    <div class="d-flex align-items-center mb-4">
                        <div class="icon-header bg-info-soft text-info mb-0 me-3"><i class="fas fa-mobile-alt"></i></div>
                        <h4 class="mb-0">Parent & Student App</h4>
                    </div>
                    <p>A comprehensive mobile experience for students and parents to stay connected with the institute 24/7.</p>
                    <div class="row">
                        <div class="col-6">
                            <ul class="feature-list">
                                <li>Real-time Attendance Status</li>
                                <li>Homework & Assignments</li>
                                <li>Instant Fee Payment</li>
                            </ul>
                        </div>
                        <div class="col-6">
                            <ul class="feature-list">
                                <li>Exam Result Notifications</li>
                                <li>School Bus Tracking</li>
                                <li>Direct Teacher Chat</li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-6" data-aos="fade-up" data-aos-delay="100">
                <div class="premium-prospect-card h-100" style="background: linear-gradient(135deg, #ffffff 0%, #fdf2f8 100%);">
                    <div class="d-flex align-items-center mb-4">
                        <div class="icon-header bg-danger-soft text-danger mb-0 me-3"><i class="fas fa-user-tie"></i></div>
                        <h4 class="mb-0">Admin & Staff App</h4>
                    </div>
                    <p>Empower your faculty and administration with on-the-go tools to manage daily operations efficiently.</p>
                    <div class="row">
                        <div class="col-6">
                            <ul class="feature-list">
                                <li>Mobile Attendance Marking</li>
                                <li>Leave Request Approval</li>
                                <li>Class Schedule Viewer</li>
                            </ul>
                        </div>
                        <div class="col-6">
                            <ul class="feature-list">
                                <li>Instant Notice circulars</li>
                                <li>Staff Payroll Access</li>
                                <li>Student Record Finder</li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Download Action -->
        <div class="text-center py-5" data-aos="zoom-in">
            <h4 class="fw-800 mb-3 text-dark">Experience Educational Innovation</h4>
            <p class="text-muted mb-4 text-max-600 mx-auto">Choose your preferred way to explore our ecosystem: Download our high-fidelity prospectus or view an interactive executive presentation.</p>
            <div class="d-flex flex-wrap justify-content-center gap-3">
                <button id="downloadProspectus" class="btn btn-glow-premium px-5 py-3 shadow-lg transform-hover">
                    <i class="fas fa-file-pdf me-2 pulse"></i> GENERATE PREMIUM PROSPECTUS
                </button>
                <a href="/Home/Presentation" class="btn btn-outline-primary px-5 py-3 rounded-pill fw-700 transform-hover">
                    <i class="fas fa-desktop me-2"></i> VIEW EXECUTIVE PRESENTATION
                </a>
            </div>
        </div>
    </div>
</section>

