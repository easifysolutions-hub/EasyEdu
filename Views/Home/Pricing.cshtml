@{
    Layout = "_LandingLayout";
    ViewData["Title"] = "Pricing Plans - Flexible for Every Institution";
}

<section class="section-padding">
    <div class="container">
        <div class="section-title" data-aos="fade-up">
            <h5>Pricing</h5>
            <h2>Choose Your Perfect Plan</h2>
            <p style="color:var(--text-muted);">Transparent pricing for schools and colleges of all sizes.</p>
        </div>

        <div class="row g-4 align-items-center">
            <!-- Basic Plan -->
            <div class="col-lg-4">
                <div class="glass-card" data-aos="fade-up" style="padding: 50px 30px; border-radius: 24px;">
                    <h3 class="mb-2">Starter</h3>
                    <p class="text-muted small mb-4">For small coaching centers</p>
                    <div style="font-size: 3rem; font-weight: 800; color: #fff; margin-bottom: 25px;">₹3,999<span style="font-size: 1rem; color: var(--text-muted);">/mo</span></div>
                    <ul class="list-unstyled text-start mb-5" style="line-height: 2.2;">
                        <li><i class="fas fa-check text-primary me-2"></i> Up to 200 Students</li>
                        <li><i class="fas fa-check text-primary me-2"></i> Basic Admin Module</li>
                        <li><i class="fas fa-check text-primary me-2"></i> Attendance Tracking</li>
                        <li><i class="fas fa-check text-primary me-2"></i> SMS Notifications</li>
                        <li class="opacity-50"><i class="fas fa-times me-2"></i> Customized Mobile App</li>
                    </ul>
                    <a href="#" class="btn-glow w-100" style="background: transparent; border: 1px solid var(--secondary); color: var(--secondary) !important;">Get Started</a>
                </div>
            </div>

            <!-- Professional Plan -->
            <div class="col-lg-4">
                <div class="glass-card" data-aos="fade-up" data-aos-delay="100" style="padding: 60px 30px; border-radius: 30px; border: 2px solid var(--primary); transform: scale(1.05); background: rgba(59, 130, 246, 0.1);">
                    <div class="mb-3"><span style="background: var(--primary); color: white; padding: 5px 15px; border-radius: 20px; font-size: 0.8rem; font-weight: 700; text-transform: uppercase;">Most Popular</span></div>
                    <h3 class="mb-2">Enterprise</h3>
                    <p class="text-muted small mb-4">Perfect for growing schools</p>
                    <div style="font-size: 3.5rem; font-weight: 800; color: #fff; margin-bottom: 25px;">₹7,999<span style="font-size: 1rem; color: var(--text-muted);">/mo</span></div>
                    <ul class="list-unstyled text-start mb-5" style="line-height: 2.2;">
                        <li><i class="fas fa-check text-primary me-2"></i> Unlimited Students</li>
                        <li><i class="fas fa-check text-primary me-2"></i> All 40+ Modules</li>
                        <li><i class="fas fa-check text-primary me-2"></i> Dedicated Server Sync</li>
                        <li><i class="fas fa-check text-primary me-2"></i> Android & iOS App</li>
                        <li><i class="fas fa-check text-primary me-2"></i> 24/7 Premium Support</li>
                    </ul>
                    <a href="#" class="btn-glow w-100">Contact Sales</a>
                </div>
            </div>

            <!-- Custom Plan -->
            <div class="col-lg-4">
                <div class="glass-card" data-aos="fade-up" data-aos-delay="200" style="padding: 50px 30px; border-radius: 24px;">
                    <h3 class="mb-2">Custom</h3>
                    <p class="text-muted small mb-4">For large group of institutes</p>
                    <div style="font-size: 2.5rem; font-weight: 800; color: #fff; margin-bottom: 25px;">Contact Us</div>
                    <ul class="list-unstyled text-start mb-5" style="line-height: 2.2;">
                        <li><i class="fas fa-check text-primary me-2"></i> Multiple Campus Login</li>
                        <li><i class="fas fa-check text-primary me-2"></i> Whitelabel Branding</li>
                        <li><i class="fas fa-check text-primary me-2"></i> On-Premise Installation</li>
                        <li><i class="fas fa-check text-primary me-2"></i> API Access for ERP</li>
                        <li><i class="fas fa-check text-primary me-2"></i> Custom Dev Support</li>
                    </ul>
                    <a href="#" class="btn-glow w-100" style="background: transparent; border: 1px solid var(--secondary); color: var(--secondary) !important;">Inquiry Now</a>
                </div>
            </div>
        </div>
    </div>
</section>
