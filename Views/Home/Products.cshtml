@{
    Layout = "_LandingLayout";
    ViewData["Title"] = "Our Products - Advanced Educational Solutions";
}

<section class="section-padding">
    <div class="container">
        <div class="section-title" data-aos="fade-up">
            <h5>Solutions</h5>
            <h2>Cutting-Edge Educational Products</h2>
            <p style="color:var(--text-muted);">Explore our range of specialized software designed to modernize your institution.</p>
        </div>

        <div class="row g-4">
            <div class="col-lg-4">
                <div class="module-card" data-aos="zoom-in">
                    <div class="module-icon-wrapper"><i class="fas fa-university"></i></div>
                    <h4>EasyEdu ERP</h4>
                    <p>A complete school and college management system with 40+ modules. Highly secure, scalable, and user-friendly.</p>
                    <a href="#" class="mt-4 text-primary">Learn More <i class="fas fa-arrow-right ms-1"></i></a>
                </div>
            </div>
            <div class="col-lg-4">
                <div class="module-card" data-aos="zoom-in" data-aos-delay="100">
                    <div class="module-icon-wrapper"><i class="fas fa-laptop-code"></i></div>
                    <h4>Smart LMS</h4>
                    <p>Interactive learning management system with virtual classrooms, online exams, and content sharing.</p>
                    <a href="#" class="mt-4 text-primary">Learn More <i class="fas fa-arrow-right ms-1"></i></a>
                </div>
            </div>
            <div class="col-lg-4">
                <div class="module-card" data-aos="zoom-in" data-aos-delay="200">
                    <div class="module-icon-wrapper"><i class="fas fa-mobile-alt"></i></div>
                    <h4>EduMobile App</h4>
                    <p>Native Android & iOS apps for students, parents, and teachers to stay connected on the go.</p>
                    <a href="#" class="mt-4 text-primary">Learn More <i class="fas fa-arrow-right ms-1"></i></a>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="section-padding" style="background: rgba(30, 41, 59, 0.3);">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6" data-aos="fade-right">
                <h2 style="font-size: 2.5rem; margin-bottom: 25px;">Why Choose Our Products?</h2>
                <div class="mb-4">
                    <h5 class="text-secondary"><i class="fas fa-shield-alt me-2"></i> Unmatched Security</h5>
                    <p class="text-muted">Your data is protected with industry-standard encryption and regular security audits.</p>
                </div>
                <div class="mb-4">
                    <h5 class="text-secondary"><i class="fas fa-bolt me-2"></i> Lightning Fast</h5>
                    <p class="text-muted">Highly optimized code ensuring smooth performance even with thousands of concurrent users.</p>
                </div>
                <div class="mb-4">
                    <h5 class="text-secondary"><i class="fas fa-sync me-2"></i> Regular Updates</h5>
                    <p class="text-muted">We continuously evolve based on user feedback and educational trends.</p>
                </div>
            </div>
            <div class="col-lg-6" data-aos="fade-left">
                <img src="https://images.unsplash.com/photo-1460925895917-afdab827c52f?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=80" alt="Innovation" class="img-fluid rounded-4 shadow-lg" style="border: var(--glass-border);">
            </div>
        </div>
    </div>
</section>
