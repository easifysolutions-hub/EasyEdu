@model IEnumerable<EasyEdu.Models.SystemModule>
@{
    ViewData["Title"] = "Institutional Module Architect";
    Layout = "_Layout";
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mx-4 rounded-12 shadow-sm border-0" role="alert">
        <i class="fas fa-check-circle me-2"></i> @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show mx-4 rounded-12 shadow-sm border-0" role="alert">
        <i class="fas fa-exclamation-triangle me-2"></i> @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="page-header d-flex justify-content-between align-items-center mb-4 px-4 animate-slide-in">
    <div>
        <h1 class="page-title mb-1"><i class="fas fa-microchip me-2 text-premium-purple"></i> Module Manager</h1>
        <p class="text-muted fw-600 small uppercase">Scalable system architecture & addon orchestration</p>
    </div>
    <div class="d-flex gap-3">
        <button class="btn btn-premium-purple rounded-12 px-4 shadow-lg fw-800" data-bs-toggle="modal" data-bs-target="#uploadModuleModal">
            <i class="fas fa-cloud-upload-alt me-2"></i> UPLOAD / UPDATE MODULE
        </button>
    </div>
</div>

<div class="container-fluid px-4 pb-5">
    <div class="premium-card bg-white shadow-xl border-0 rounded-24 overflow-hidden animate-fade-in">
        <div class="table-responsive">
            <table class="table premium-table mb-0 align-middle">
                <thead class="bg-light-soft">
                    <tr>
                        <th class="ps-4 py-3 fw-900 small uppercase text-muted" style="width: 80px;">SL</th>
                        <th class="py-3 fw-900 small uppercase text-muted">MODULE IDENTITY</th>
                        <th class="py-3 fw-900 small uppercase text-muted text-center">STATUS</th>
                        <th class="pe-4 py-3 fw-900 small uppercase text-muted text-end">ARCHITECT ACTION</th>
                    </tr>
                </thead>
                <tbody>
                    @{ int sl = 1; }
                    @foreach (var module in Model)
                    {
                        <tr class="transition-all hover-bg-light @(!module.IsEnabled ? "opacity-75" : "")">
                            <td class="ps-4 fw-800 text-muted">@sl++</td>
                            <td>
                                <div class="d-flex align-items-center">
                                    <div class="module-icon-box bg-premium-soft rounded-16 p-3 me-3">
                                        <i class="fas @(GetIconForModule(module.Name)) fa-lg text-premium-purple"></i>
                                    </div>
                                    <div>
                                        <div class="d-flex align-items-center mb-1">
                                            <h6 class="fw-900 text-dark mb-0 me-2">@module.Name</h6>
                                            <span class="badge bg-primary-soft text-primary rounded-pill fw-800 small-badge">v@(module.Version ?? "1.0")</span>
                                        </div>
                                        <p class="text-muted small fw-600 mb-0">@module.Description</p>
                                        <div class="small fw-700 text-premium-purple mt-1 opacity-75">
                                            <i class="fas fa-check-circle me-1"></i> Verified | Published on @module.InstalledAt.ToString("MMMM d, yyyy")
                                        </div>
                                    </div>
                                </div>
                            </td>
                            <td class="text-center">
                                <span class="badge @(module.IsEnabled ? "bg-success" : "bg-danger") px-4 py-2 rounded-8 fw-900 shadow-sm">
                                    @(module.IsEnabled ? "ACTIVE" : "DISABLED")
                                </span>
                            </td>
                            <td class="pe-4 text-end">
                                <div class="form-check form-switch d-inline-block p-0">
                                    <form asp-action="ToggleModule" method="post" id="form-@module.Id">
                                        <input type="hidden" name="id" value="@module.Id" />
                                        <div class="custom-switch-wrapper shadow-sm">
                                            <input class="form-check-input cursor-pointer toggle-switch-premium" type="checkbox" @(module.IsEnabled ? "checked" : "") onchange="document.getElementById('form-@module.Id').submit()">
                                        </div>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Upload Module Modal -->
<div class="modal fade" id="uploadModuleModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 rounded-24 shadow-2xl overflow-hidden">
            <div class="modal-header bg-premium-purple text-white p-4 border-0">
                <h5 class="modal-title fw-900"><i class="fas fa-upload me-2"></i> DEPLOY NEW MODULE</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4 bg-light">
                <div class="upload-drop-zone border-dashed border-2 rounded-24 p-5 text-center bg-white transition-all hover-bg-primary-soft cursor-pointer">
                    <i class="fas fa-cloud-upload-alt fa-3x text-premium-purple mb-3"></i>
                    <h6 class="fw-900 mb-2">Drag & Drop Module Zip</h6>
                    <p class="text-muted small fw-600 mb-4">Support only EasyEdu compliant addon packages</p>
                    <button class="btn btn-premium-purple btn-sm px-4 rounded-pill fw-800 shadow-lg">BROWSE FILES</button>
                    <input type="file" hidden id="moduleFile">
                </div>
            </div>
        </div>
    </div>
</div>

@functions {
    string GetIconForModule(string? name)
    {
        if (string.IsNullOrEmpty(name)) return "fa-box-open";
        name = name.ToLower();
        if (name.Contains("zoom")) return "fa-video";
        if (name.Contains("gmeet")) return "fa-microphone-lines";
        if (name.Contains("jitsi")) return "fa-headset";
        if (name.Contains("bigbluebutton")) return "fa-chalkboard-teacher";
        if (name.Contains("live")) return "fa-tower-broadcast";
        if (name.Contains("online exam")) return "fa-laptop-code";
        if (name.Contains("cbse")) return "fa-scroll";
        if (name.Contains("lms")) return "fa-graduation-cap";
        if (name.Contains("registration")) return "fa-user-plus";
        if (name.Contains("qr code")) return "fa-qrcode";
        if (name.Contains("biometrics")) return "fa-fingerprint";
        if (name.Contains("whatsapp")) return "fa-whatsapp";
        if (name.Contains("ai content")) return "fa-robot";
        if (name.Contains("certificate")) return "fa-award";
        return "fa-box-open";
    }
}

<style>
    .bg-premium-purple { background: linear-gradient(135deg, #6366f1 0%, #a855f7 100%); }
    .text-premium-purple { color: #8b5cf6; }
    .bg-premium-soft { background: rgba(139, 92, 246, 0.1); }
    .bg-primary-soft { background: rgba(99, 102, 241, 0.1); }
    .bg-light-soft { background: #f8fafc; }
    
    .premium-table thead th {
        border: none;
        letter-spacing: 0.5px;
    }
    
    .premium-table tbody tr {
        border-bottom: 1px solid #f1f5f9;
        transition: all 0.2s ease;
    }
    
    .hover-bg-light:hover { background-color: #fbfcfe; }
    
    .module-icon-box {
        width: 56px;
        height: 56px;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    
    .small-badge {
        font-size: 0.65rem;
        padding: 0.2rem 0.6rem;
    }
    
    .rounded-24 { border-radius: 24px; }
    .rounded-16 { border-radius: 16px; }
    .rounded-12 { border-radius: 12px; }
    .rounded-8 { border-radius: 8px; }
    
    .toggle-switch-premium {
        width: 3.5rem !important;
        height: 1.75rem !important;
        background-color: #e2e8f0;
        border: none;
        background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='-4 -4 8 8'%3e%3ccircle r='3' fill='null'/%3e%3c/svg%3e") !important;
    }
    
    .toggle-switch-premium:checked {
        background-color: #a855f7;
    }
    
    .border-dashed { border-style: dashed !important; }
    
    .shadow-2xl {
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
    }
</style>
