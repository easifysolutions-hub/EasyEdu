@model IEnumerable<EasyEdu.Models.Incident>
@{
    ViewData["Title"] = "Incidents";
    Layout = "_Layout";
}

<div class="content-wrapper p-4 animate-fade-in">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="page-title mb-1">Behaviour Incidents</h3>
            <p class="text-muted small fw-600">Definition of positive and negative student behaviours</p>
        </div>
        <button class="btn btn-premium-purple btn-sm rounded-8" onclick="toggleForm()">
            <i class="fas fa-plus me-2"></i>ADD INCIDENT
        </button>
    </div>

    <div class="row g-4">
        <div class="col-xl-4" id="formColumn">
            <div class="premium-card">
                <div class="card-header bg-white border-0 p-4">
                    <h5 class="fw-800 text-dark m-0" id="formTitle">Add New Incident</h5>
                </div>
                <div class="card-body p-4 pt-0">
                    <form id="incidentForm" asp-action="CreateIncident" method="post">
                        <input type="hidden" name="Id" id="incidentId" value="0" />
                        <div class="mb-3">
                            <label class="form-label small fw-700 text-uppercase">Title*</label>
                            <input type="text" name="Title" id="incidentTitle" class="form-control-premium w-100" required placeholder="e.g. Helpful to Peer">
                        </div>
                        <div class="mb-3">
                            <label class="form-label small fw-700 text-uppercase">Points*</label>
                            <input type="number" name="Point" id="incidentPoint" class="form-control-premium w-100" required value="0">
                            <small class="text-muted">Use negative values for disciplinary incidents.</small>
                        </div>
                        <div class="mb-3">
                            <label class="form-label small fw-700 text-uppercase">Description</label>
                            <textarea name="Description" id="incidentDescription" rows="3" class="form-control-premium w-100"></textarea>
                        </div>
                        <div class="mb-3" id="isActiveGroup" style="display: none;">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" name="IsActive" id="incidentIsActive" value="true" checked>
                                <label class="form-check-label small fw-700 text-uppercase" for="incidentIsActive">Is Active</label>
                            </div>
                        </div>
                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-premium-primary flex-grow-1" id="submitBtn">SAVE INCIDENT</button>
                            <button type="button" class="btn btn-light-soft text-dark" id="cancelEditBtn" style="display: none;" onclick="resetForm()">Cancel</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-xl-8" id="listColumn">
            <div class="premium-card">
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table premium-table mb-0">
                            <thead>
                                <tr>
                                    <th class="px-4">TITLE</th>
                                    <th>POINTS</th>
                                    <th>STATUS</th>
                                    <th class="text-end px-4">ACTION</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td class="px-4">
                                            <div class="fw-800 text-dark">@item.Title</div>
                                            <div class="small text-muted text-truncate" style="max-width: 250px;">@item.Description</div>
                                        </td>
                                        <td>
                                            <span class="badge @(item.Point >= 0 ? "bg-success-soft" : "bg-danger-soft") fw-900" style="font-size: 0.9rem;">
                                                @(item.Point > 0 ? "+" : "")@item.Point Points
                                            </span>
                                        </td>
                                        <td>
                                            @if (item.IsActive) {
                                                <span class="badge badge-success-premium">ACTIVE</span>
                                            } else {
                                                <span class="badge badge-danger-premium">INACTIVE</span>
                                            }
                                        </td>
                                        <td class="text-end px-4">
                                            <div class="btn-group gap-1">
                                                <button class="btn btn-sm btn-light-soft rounded-circle px-2 btn-edit"
                                                        data-id="@item.Id"
                                                        data-title="@item.Title"
                                                        data-point="@item.Point"
                                                        data-description="@item.Description"
                                                        data-active="@item.IsActive.ToString().ToLower()">
                                                    <i class="fas fa-edit text-primary"></i>
                                                </button>
                                                <form asp-action="DeleteIncident" asp-route-id="@item.Id" method="post" onsubmit="return confirm('Are you sure you want to delete this behavior incident?');" style="display:inline;">
                                                    <button type="submit" class="btn btn-sm btn-light-soft rounded-circle px-2">
                                                        <i class="fas fa-trash text-danger"></i>
                                                    </button>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    function toggleForm() {
        const form = document.getElementById('formColumn');
        const list = document.getElementById('listColumn');
        if (form.style.display === 'none') {
            form.style.display = 'block';
            list.className = 'col-xl-8';
        } else {
            form.style.display = 'none';
            list.className = 'col-xl-12';
        }
    }

    function editIncident(id, title, point, description, isActive) {
        const formCol = document.getElementById('formColumn');
        if (formCol.style.display === 'none') {
            toggleForm();
        }
        
        const form = document.getElementById('incidentForm');
        form.action = '/BehaviourRecords/EditIncident';
        
        document.getElementById('incidentId').value = id;
        document.getElementById('formTitle').innerText = 'Edit Incident';
        document.getElementById('incidentTitle').value = title;
        document.getElementById('incidentPoint').value = point;
        document.getElementById('incidentDescription').value = description || '';
        
        document.getElementById('isActiveGroup').style.display = 'block';
        document.getElementById('incidentIsActive').checked = (isActive === 'true');
        
        document.getElementById('submitBtn').innerText = 'UPDATE INCIDENT';
        document.getElementById('cancelEditBtn').style.display = 'inline-block';
        
        formCol.scrollIntoView({ behavior: 'smooth' });
    }

    function resetForm() {
        const form = document.getElementById('incidentForm');
        form.action = '/BehaviourRecords/CreateIncident';
        
        document.getElementById('incidentId').value = '0';
        document.getElementById('formTitle').innerText = 'Add New Incident';
        document.getElementById('incidentTitle').value = '';
        document.getElementById('incidentPoint').value = '0';
        document.getElementById('incidentDescription').value = '';
        document.getElementById('isActiveGroup').style.display = 'none';
        document.getElementById('incidentIsActive').checked = true;
        document.getElementById('submitBtn').innerText = 'SAVE INCIDENT';
        document.getElementById('cancelEditBtn').style.display = 'none';
    }

    document.addEventListener('DOMContentLoaded', function() {
        document.querySelectorAll('.btn-edit').forEach(btn => {
            btn.addEventListener('click', function() {
                const id = this.getAttribute('data-id');
                const title = this.getAttribute('data-title');
                const point = this.getAttribute('data-point');
                const description = this.getAttribute('data-description');
                const active = this.getAttribute('data-active');
                editIncident(id, title, point, description, active);
            });
        });
    });
</script>
