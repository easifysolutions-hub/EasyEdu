@model IEnumerable<EasyEdu.Models.StudentIncident>
@{
    ViewData["Title"] = "Student Incident Report";
    Layout = "_Layout";
}

<div class="content-wrapper p-4 animate-fade-in">
    <h3 class="page-title mb-4">Student Incident Records</h3>

    <div class="premium-card">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table premium-table mb-0">
                    <thead>
                        <tr>
                            <th>Student</th>
                            <th>Incident</th>
                            <th>Points</th>
                            <th>Reported By</th>
                            <th>Date</th>
                            <th class="text-end">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    <div class="fw-800 text-dark">@item.Student.FirstName @item.Student.LastName</div>
                                    <div class="small text-muted">Adm: @item.Student.AdmissionNumber</div>
                                </td>
                                <td>
                                    <div class="fw-700 text-primary">@item.Incident.Title</div>
                                    <div class="small font-italic text-muted">@item.Remarks</div>
                                </td>
                                <td>
                                    <span class="badge @(item.Incident.Point >= 0 ? "bg-success-soft" : "bg-danger-soft") fw-900">
                                        @(item.Incident.Point > 0 ? "+" : "")@item.Incident.Point
                                    </span>
                                </td>
                                <td><span class="small fw-700 text-muted">@item.ReportedBy</span></td>
                                <td><span class="small fw-600">@item.Date.ToString("dd MMM yyyy")</span></td>
                                <td class="text-end px-4">
                                    <div class="btn-group gap-1">
                                        <button class="btn btn-sm btn-light-soft rounded-circle px-2 btn-edit"
                                                data-id="@item.Id"
                                                data-student="@item.Student.FirstName @item.Student.LastName"
                                                data-incident-id="@item.IncidentId"
                                                data-remarks="@item.Remarks"
                                                data-date="@item.Date.ToString("yyyy-MM-dd")">
                                            <i class="fas fa-edit text-primary"></i>
                                        </button>
                                        <form asp-action="DeleteStudentIncident" asp-route-id="@item.Id" method="post" onsubmit="return confirm('Are you sure you want to delete this incident record?');" style="display:inline;">
                                            <button type="submit" class="btn btn-sm btn-light-soft rounded-circle px-2 text-danger">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Edit Incident Modal -->
<div class="modal fade" id="editStudentIncidentModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-12">
            <div class="modal-header bg-primary text-white border-0">
                <h5 class="modal-title fw-800">Edit Student Incident</h5>
                <button type="button" class="btn-close btn-close-white shadow-none" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="EditStudentIncident" method="post">
                <input type="hidden" name="id" id="editSiId" />
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label small fw-700 text-muted text-uppercase">Student</label>
                        <input type="text" id="editSiStudent" class="form-control border-0 bg-light shadow-none fw-600" readonly />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-700 text-muted text-uppercase">Incident *</label>
                        <select name="incidentId" id="editSiIncidentId" class="form-select border-0 bg-light shadow-none fw-600" asp-items="ViewBag.Incidents" required>
                            <option value="">Select Incident</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-700 text-muted text-uppercase">Date *</label>
                        <input type="date" name="date" id="editSiDate" class="form-control border-0 bg-light shadow-none fw-600" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-700 text-muted text-uppercase">Remarks</label>
                        <textarea name="remarks" id="editSiRemarks" rows="3" class="form-control border-0 bg-light shadow-none fw-600"></textarea>
                    </div>
                </div>
                <div class="modal-footer border-0 p-4 pt-0">
                    <button type="button" class="btn btn-light fw-700" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary fw-700 px-4">Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const editModal = new bootstrap.Modal(document.getElementById('editStudentIncidentModal'));
        
        document.querySelectorAll('.btn-edit').forEach(btn => {
            btn.addEventListener('click', function() {
                const id = this.getAttribute('data-id');
                const student = this.getAttribute('data-student');
                const incidentId = this.getAttribute('data-incident-id');
                const remarks = this.getAttribute('data-remarks');
                const date = this.getAttribute('data-date');
                
                document.getElementById('editSiId').value = id;
                document.getElementById('editSiStudent').value = student;
                document.getElementById('editSiIncidentId').value = incidentId;
                document.getElementById('editSiRemarks').value = remarks || '';
                document.getElementById('editSiDate').value = date;
                
                editModal.show();
            });
        });
    });
</script>
