@model IEnumerable<EasyEdu.Controllers.BehaviourReportViewModel>
@{
    ViewData["Title"] = "Behaviour Report";
    Layout = "_Layout";
}

<div class="content-wrapper p-4 animate-fade-in">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="page-title">Summative Behaviour Report</h3>
        <div class="d-flex gap-2">
             <button class="btn btn-premium-success btn-sm rounded-8 px-3">
                <i class="fas fa-file-excel me-2"></i>EXPORT EXCEL
            </button>
        </div>
    </div>

    <div class="premium-card">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table premium-table mb-0">
                    <thead>
                        <tr>
                            <th>Student Name</th>
                            <th>Admission No</th>
                            <th>Class</th>
                            <th>Incident Count</th>
                            <th>Net Points</th>
                            <th class="text-end">Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="fw-800 text-dark">
                                    <a href="@Url.Action("StudentIncidentReport", "BehaviourRecords", new { studentId = item.StudentId })" class="text-decoration-none text-primary fw-800">
                                        @item.StudentName
                                    </a>
                                </td>
                                <td class="fw-700 text-muted">@item.AdmissionNumber</td>
                                <td><span class="badge bg-light-subtle text-muted fw-800 border">@item.ClassName</span></td>
                                <td><span class="fw-800">@item.TotalIncidents</span></td>
                                <td>
                                    <span class="fw-900 @(item.TotalPoints >= 0 ? "text-success" : "text-danger")" style="font-size: 1.1rem;">
                                        @item.TotalPoints
                                    </span>
                                </td>
                                <td class="text-end px-4">
                                    @if(item.TotalPoints >= 0) {
                                        <span class="badge badge-success-premium">SATISFACTORY</span>
                                    } else {
                                        <span class="badge badge-warning-premium">NEEDS REVIEW</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
