@model IEnumerable<EasyEdu.Models.ZoomVirtualClass>
@{
    ViewData["Title"] = "Virtual Class Analytics";
    Layout = "_Layout";
}

<div class="content-wrapper p-4 animate-fade-in text-dark">
    <div class="d-flex justify-content-between align-items-center mb-5">
        <div>
            <h2 class="fw-900 text-dark mb-1">Class Attendance Intelligence</h2>
            <p class="text-muted small fw-600">Historical performance and participation analytics for all virtual classroom sessions</p>
        </div>
        <div class="d-flex gap-2">
            <button onclick="window.print()" class="btn btn-light-soft px-4 py-2 rounded-12 shadow-sm fw-700">
                <i class="fas fa-print me-2"></i>BATCH EXPORT
            </button>
        </div>
    </div>

    <div class="premium-card p-0 overflow-hidden border-0 shadow-lg mb-5" style="border-radius: 24px;">
        <table class="table premium-table mb-0 align-middle">
            <thead class="bg-premium-dark text-white">
                <tr>
                    <th class="ps-5 py-4 fw-900 small text-uppercase">SESSION TOPIC</th>
                    <th class="py-4 fw-900 small text-uppercase">ACADEMIC LOCATION</th>
                    <th class="py-4 fw-900 small text-uppercase">CHRONOLOGY</th>
                    <th class="py-4 fw-900 small text-uppercase">DURATION</th>
                    <th class="pe-5 py-4 text-end fw-900 small text-uppercase">PARTICIPATION STATUS</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var cls in Model)
                {
                    <tr>
                        <td class="ps-5 py-4">
                            <span class="fw-900 text-dark">@cls.Topic</span>
                            <div class="smallest text-muted fw-700">Meeting #@cls.MeetingId</div>
                        </td>
                        <td class="py-4">
                            <div class="fw-800 text-muted small">@cls.Subject?.Name</div>
                            <div class="smallest text-muted fw-700">@cls.Class?.Name</div>
                        </td>
                         <td class="py-4">
                            <div class="fw-700 text-dark small">@cls.Date.ToString("dd MMM yyyy")</div>
                            <div class="smallest text-muted fw-700 opacity-50">@cls.StartTime</div>
                        </td>
                        <td class="py-4 text-center">
                            <div class="fw-900 text-primary">@cls.DurationMinutes</div>
                            <div class="smallest text-muted fw-700">MINS</div>
                        </td>
                        <td class="pe-5 text-end py-4">
                            <span class="badge @(cls.Status == "Closed" ? "bg-light-soft text-muted border" : "bg-success shadow-sm") px-3 py-2 rounded-pill fw-900 shadow-sm border">@cls.Status.ToUpper()</span>
                        </td>
                    </tr>
                }
                 @if(!Model.Any()){
                    <tr>
                        <td colspan="5" class="text-center py-5">
                            <i class="fas fa-chart-line fa-3x text-muted opacity-20 mb-3"></i>
                            <h5 class="fw-800 text-muted italic">No historical classroom intelligence available yet.</h5>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Analytics Dashboard Mockup -->
    <div class="row g-4 no-print">
        <div class="col-md-6">
            <div class="stat-card p-5 rounded-24 bg-white shadow-lg text-center h-100">
                <i class="fas fa-chart-area fa-3x text-primary opacity-25 mb-4"></i>
                <h5 class="fw-900 text-dark">Session Capacity Analytics</h5>
                <p class="text-muted small fw-600 mb-0">Aggregate attendance patterns across all academic departments over the last 90 days.</p>
                <div class="mt-4 opacity-50 border p-4 rounded-16 bg-light text-muted fw-900 italic ls-2 uppercase">DATA VISUALIZATION UNLOCKED</div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="stat-card p-5 rounded-24 bg-white shadow-lg text-center h-100">
                <i class="fas fa-hourglass-half fa-3x text-info opacity-25 mb-4"></i>
                <h5 class="fw-900 text-dark">Pedagogical Duration Insights</h5>
                <p class="text-muted small fw-600 mb-0">Automated tracking of active teacher-student engagement hours in virtual environments.</p>
                <div class="mt-4 opacity-50 border p-4 rounded-16 bg-light text-muted fw-900 italic ls-2 uppercase">ANALYTICS PIPELINE ACTIVE</div>
            </div>
        </div>
    </div>
</div>

<style>
    .rounded-24 { border-radius: 24px; }
    .rounded-16 { border-radius: 16px; }
    .ls-2 { letter-spacing: 2px; }
    .bg-premium-dark { background: #1e293b; }
    .bg-light-soft { background: #f1f5f9; }
    @@media print {
        .no-print, .btn, .card-header, .sidebar, .topbar { display: none !important; }
        .content-wrapper { padding: 0 !important; margin: 0 !important; }
        .premium-card { border: 1px solid #eee !important; box-shadow: none !important; border-radius: 0 !important; }
    }
</style>
