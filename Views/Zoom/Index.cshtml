@model EasyEdu.Controllers.ZoomDashboardViewModel
@{
    ViewData["Title"] = "Virtual Learning Hub";
    Layout = "_Layout";
}

<div class="content-wrapper p-4 animate-fade-in text-dark">
    <div class="d-flex justify-content-between align-items-center mb-5">
        <div>
            <h2 class="fw-900 text-dark mb-1">Virtual Learning Architect</h2>
            <p class="text-muted small fw-600">Unified command center for Zoom classes & institutional meetings</p>
        </div>
        <div class="d-flex gap-3">
             <a href="@Url.Action("VirtualClass")" class="btn btn-premium-purple px-4 py-2 rounded-12 shadow-sm fw-900">
                <i class="fas fa-plus-circle me-2"></i>CREATE CLASS
            </a>
            <a href="@Url.Action("Settings")" class="btn btn-light-soft px-4 py-2 rounded-12 fw-700">
                <i class="fas fa-cog me-2"></i>API CONFIG
            </a>
        </div>
    </div>

    <!-- Stats Matrix -->
    <div class="row g-4 mb-5">
        <div class="col-md-3">
            <div class="stat-card p-4 rounded-24 bg-white shadow-sm border-0 border-start border-4 border-primary">
                <div class="d-flex align-items-center mb-3">
                    <div class="icon-box bg-light text-primary me-3">
                        <i class="fas fa-video fa-lg"></i>
                    </div>
                    <div>
                        <p class="text-uppercase smallest fw-900 text-muted m-0">Live Classes</p>
                        <h3 class="fw-900 m-0">@ViewBag.ClassesCount</h3>
                    </div>
                </div>
                <div class="progress" style="height: 6px;">
                    <div class="progress-bar bg-primary" style="width: 70%"></div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stat-card p-4 rounded-24 bg-white shadow-sm border-0 border-start border-4 border-success">
                <div class="d-flex align-items-center mb-3">
                    <div class="icon-box bg-light text-success me-3">
                        <i class="fas fa-users fa-lg"></i>
                    </div>
                    <div>
                        <p class="text-uppercase smallest fw-900 text-muted m-0">Meetings</p>
                        <h3 class="fw-900 m-0">@ViewBag.MeetingsCount</h3>
                    </div>
                </div>
                 <div class="progress" style="height: 6px;">
                    <div class="progress-bar bg-success" style="width: 45%"></div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
             <div class="stat-card p-4 rounded-24 bg-white shadow-sm border-0 border-start border-4 border-info">
                <div class="d-flex align-items-center mb-3">
                    <div class="icon-box bg-light text-info me-3">
                        <i class="fas fa-clock fa-lg"></i>
                    </div>
                    <div>
                        <p class="text-uppercase smallest fw-900 text-muted m-0">Next Event</p>
                        <h5 class="fw-900 m-0 text-truncate">@(Model.RecentClasses.FirstOrDefault()?.Topic ?? "N/A")</h5>
                    </div>
                </div>
                <p class="smallest text-muted m-0 fw-700">@(Model.RecentClasses.FirstOrDefault()?.Date.ToString("t") ?? "No upcoming slots")</p>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stat-card p-4 rounded-24 bg-gradient-premium text-white shadow-lg border-0">
                <p class="text-uppercase smallest fw-900 opacity-75 mb-4">Zoom Sync Health</p>
                <div class="d-flex justify-content-between align-items-end">
                    <h3 class="fw-900 m-0">OPTIMAL</h3>
                    <i class="fas fa-check-circle fa-2x opacity-50"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <!-- Virtual Classes -->
        <div class="col-xl-7">
            <div class="premium-card p-0 overflow-hidden border-0 shadow-lg" style="border-radius: 24px;">
                <div class="card-header bg-white border-bottom p-4 d-flex justify-content-between align-items-center">
                    <h5 class="fw-900 text-dark m-0"><i class="fas fa-video me-2 text-primary"></i>Upcoming Class Slots</h5>
                    <a href="@Url.Action("VirtualClass")" class="smallest fw-900 text-uppercase ls-1 text-primary">View Queue</a>
                </div>
                <div class="card-body p-0">
                    <table class="table premium-table mb-0 align-middle">
                        <tbody class="bg-white">
                            @foreach (var cls in Model.RecentClasses)
                            {
                                <tr>
                                    <td class="ps-4">
                                        <div class="fw-900 text-dark">@cls.Topic</div>
                                        <div class="smallest text-muted fw-700">@cls.Subject?.Name | @cls.Class?.Name-@cls.Section?.Name</div>
                                    </td>
                                    <td>
                                        <div class="small fw-800 text-dark">@cls.Date.ToString("dd MMM")</div>
                                        <div class="smallest text-muted fw-700">@cls.StartTime</div>
                                    </td>
                                    <td>
                                        <span class="badge @(cls.Status == "Live" ? "bg-danger flash" : "bg-light text-dark") px-3 rounded-pill fw-900">@cls.Status.ToUpper()</span>
                                    </td>
                                    <td class="pe-4 text-end">
                                        <a href="@cls.JoinUrl" target="_blank" class="btn btn-sm btn-primary rounded-pill px-3 fw-900">JOIN CLASS</a>
                                    </td>
                                </tr>
                            }
                            @if(!Model.RecentClasses.Any()){
                                <tr><td colspan="4" class="text-center py-5 text-muted fw-700">No scheduled classes found.</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- System Meetings -->
        <div class="col-xl-5">
             <div class="premium-card p-0 overflow-hidden border-0 shadow-lg" style="border-radius: 24px;">
                <div class="card-header bg-white border-bottom p-4 d-flex justify-content-between align-items-center">
                    <h5 class="fw-900 text-dark m-0"><i class="fas fa-users me-2 text-success"></i>System Meetings</h5>
                    <a href="@Url.Action("VirtualMeeting")" class="smallest fw-900 text-uppercase ls-1 text-success">All Meetings</a>
                </div>
                <div class="card-body p-4">
                    @foreach (var mt in Model.RecentMeetings)
                    {
                        <div class="meeting-item p-3 mb-3 bg-light rounded-16 border-0 d-flex align-items-center shadow-sm">
                            <div class="icon-circle bg-white text-dark shadow-sm me-3">
                                <i class="fas fa-calendar-day"></i>
                            </div>
                            <div class="flex-grow-1">
                                <h6 class="fw-900 text-dark mb-0">@mt.Topic</h6>
                                <p class="smallest text-muted fw-700 m-0">@mt.Date.ToString("dd MMM") | @mt.StartTime</p>
                            </div>
                            <a href="@mt.JoinUrl" target="_blank" class="btn btn-icon btn-light rounded-circle shadow-sm">
                                <i class="fas fa-external-link-alt"></i>
                            </a>
                        </div>
                    }
                     @if(!Model.RecentMeetings.Any()){
                        <div class="text-center py-4 text-muted opacity-50 fw-700 italic">Zero institutional meetings scheduled.</div>
                    }
                </div>
             </div>
        </div>
    </div>
</div>

<style>
    .rounded-24 { border-radius: 24px; }
    .rounded-16 { border-radius: 16px; }
    .ls-1 { letter-spacing: 1px; }
    .icon-box { width: 45px; height: 45px; display: flex; align-items: center; justify-content: center; border-radius: 14px; }
    .icon-circle { width: 40px; height: 40px; line-height: 40px; text-align: center; border-radius: 50%; display: inline-block; }
    .bg-gradient-premium { background: linear-gradient(135deg, #6366f1 0%, #a855f7 100%); }
    .btn-premium-purple { background: #8b5cf6; color: white; border: none; }
    .flash { animation: flash-anim 1.5s infinite; }
    @@keyframes flash-anim { 0% { opacity: 1; } 50% { opacity: 0.5; } 100% { opacity: 1; } }
</style>
