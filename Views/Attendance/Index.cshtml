@{
    ViewData["Title"] = "Attendance Management";
}

<div class="page-header d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="page-title animate-slide-in">Daily Attendance Hub</h1>
        <p class="text-muted fw-600">Track student presence, automate registers, and generate compliance reports</p>
    </div>
    <div class="d-flex gap-3">
        <a asp-action="QRScanner" class="btn-premium btn-premium-primary animate-fade-in shadow-lg">
            <i class="fas fa-qrcode"></i> QR Kiosk Mode
        </a>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-6">
        <div class="premium-card bg-white p-5 h-100 shadow-md animate-fade-in">
            <div class="d-flex align-items-center mb-4">
                <div class="avatar-lg bg-primary-soft text-primary rounded-12 me-4 d-flex align-items-center justify-content-center" style="width: 60px; height: 60px;">
                    <i class="fas fa-calendar-check h3 mb-0"></i>
                </div>
                <div>
                    <h4 class="fw-800 m-0">Classroom Roll Call</h4>
                    <p class="text-muted m-0 small fw-600">Mark attendance for specific sections</p>
                </div>
            </div>
            
            <form asp-action="MarkStudentAttendance" method="get" class="mt-4">
                <div class="mb-4">
                    <label class="form-label fw-800 text-uppercase small text-muted">Academic Class</label>
                    <select name="classId" class="form-select form-control-premium" asp-items="ViewBag.Classes" required>
                        <option value="">-- Select Target Class --</option>
                    </select>
                </div>
                <div class="mb-5">
                    <label class="form-label fw-800 text-uppercase small text-muted">Session Date</label>
                    <input type="date" name="date" class="form-control form-control-premium" value="@DateTime.Now.ToString("yyyy-MM-dd")" required />
                </div>
                <button type="submit" class="btn-premium btn-premium-primary w-100 py-3 shadow-md">
                    <i class="fas fa-pen-to-square me-2"></i> Open Register
                </button>
            </form>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="premium-card bg-white p-5 h-100 shadow-md animate-fade-in" style="animation-delay: 0.1s;">
            <div class="d-flex align-items-center mb-4">
                <div class="avatar-lg bg-info-soft text-info rounded-12 me-4 d-flex align-items-center justify-content-center" style="width: 60px; height: 60px;">
                    <i class="fas fa-chart-pie h3 mb-0"></i>
                </div>
                <div>
                    <h4 class="fw-800 m-0">Presence Analytics</h4>
                    <p class="text-muted m-0 small fw-600">Compliance reporting and staff tracking</p>
                </div>
            </div>
            
            <div class="d-grid gap-3 mt-4">
                <a asp-action="AttendanceReport" class="btn-premium btn-light-soft text-start p-4 d-flex align-items-center justify-content-between hover-lift">
                    <div class="d-flex align-items-center">
                        <i class="fas fa-list-check me-3 text-success h5 mb-0"></i>
                        <div>
                            <div class="fw-800 text-dark">Daily Summary Report</div>
                            <div class="small text-muted fw-600">View today's absentees list</div>
                        </div>
                    </div>
                    <i class="fas fa-chevron-right text-muted opacity-50"></i>
                </a>
                
                <a href="#" class="btn-premium btn-light-soft text-start p-4 d-flex align-items-center justify-content-between hover-lift">
                    <div class="d-flex align-items-center">
                        <i class="fas fa-book-open-reader me-3 text-warning h5 mb-0"></i>
                        <div>
                            <div class="fw-800 text-dark">Subject-wise Analytics</div>
                            <div class="small text-muted fw-600">Attendance by course module</div>
                        </div>
                    </div>
                    <i class="fas fa-chevron-right text-muted opacity-50"></i>
                </a>

                <a href="#" class="btn-premium btn-light-soft text-start p-4 d-flex align-items-center justify-content-between hover-lift">
                    <div class="d-flex align-items-center">
                        <i class="fas fa-user-tie me-3 text-primary h5 mb-0"></i>
                        <div>
                            <div class="fw-800 text-dark">Faculty Attendance</div>
                            <div class="small text-muted fw-600">Staff login/logout times</div>
                        </div>
                    </div>
                    <i class="fas fa-chevron-right text-muted opacity-50"></i>
                </a>
            </div>
        </div>
    </div>
</div>

<style>
    .hover-lift { transition: transform 0.2s ease, box-shadow 0.2s ease; border: 1px solid var(--gray-200); }
    .hover-lift:hover { transform: translateY(-3px); box-shadow: var(--shadow-md); background: #fff !important; border-color: var(--primary-light); }
</style>
