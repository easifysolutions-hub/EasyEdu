@model IEnumerable<EasyEdu.Models.ClassRoom>
@{
    ViewData["Title"] = "Class Room";
    Layout = "_Layout";
}

<div class="content-wrapper p-4">
    <div class="row g-4 d-flex align-items-stretch">
        <!-- Add Class Room Form -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-12 h-100">
                <div class="card-header bg-white border-bottom border-light py-3">
                    <h5 class="fw-800 text-primary m-0">Add Class Room</h5>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Create" method="post">
                        <div class="mb-3">
                            <label class="form-label fw-700 text-muted small text-uppercase">Room No *</label>
                            <input type="text" name="RoomNo" class="form-control" placeholder="e.g. 101, Lab-A" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-700 text-muted small text-uppercase">Capacity *</label>
                            <input type="number" name="Capacity" class="form-control" placeholder="e.g. 40">
                        </div>
                        <div class="d-grid mt-4">
                            <button type="submit" class="btn btn-primary fw-700 py-2 shadow-sm">
                                <i class="fas fa-check me-2"></i> Save Class Room
                            </button>
                        </div>
                         <div asp-validation-summary="All" class="text-danger mt-2 small"></div>
                    </form>
                </div>
            </div>
        </div>

        <!-- Class Room List -->
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-12 h-100">
                <div class="card-header bg-white border-bottom border-light py-3 d-flex justify-content-between align-items-center">
                    <h5 class="fw-800 text-dark m-0">Class Room List</h5>
                    <div class="search-box">
                        <input type="text" class="form-control form-control-sm border-0 bg-light" placeholder="Search...">
                    </div>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="bg-light text-muted small text-uppercase">
                                <tr>
                                    <th class="px-4 py-3 fw-700">Room No</th>
                                    <th class="py-3 fw-700">Capacity</th>
                                    <th class="py-3 fw-700">Status</th>
                                    <th class="text-end px-4 py-3 fw-700">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model != null && Model.Any())
                                {
                                    foreach (var item in Model)
                                    {
                                        <tr>
                                            <td class="px-4 fw-700 text-dark">@item.RoomNo</td>
                                            <td>
                                                <span class="badge bg-light text-muted border fw-600">@item.Capacity Students</span>
                                            </td>
                                             <td>
                                                @if (item.IsActive)
                                                {
                                                    <span class="badge bg-success bg-opacity-10 text-success fw-700 px-3 py-1 rounded-pill small">Active</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-danger bg-opacity-10 text-danger fw-700 px-3 py-1 rounded-pill small">Inactive</span>
                                                }
                                            </td>
                                            <td class="text-end px-4">
                                                <button class="btn btn-sm btn-light text-primary me-2" onclick="editRoom(@item.Id, '@item.RoomNo', '@item.Capacity', @item.IsActive.ToString().ToLower())">
                                                    <i class="fas fa-pen"></i>
                                                </button>
                                                <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Delete this room?');">
                                                    <button type="submit" class="btn btn-sm btn-light text-danger">
                                                        <i class="fas fa-trash"></i>
                                                    </button>
                                                </form>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="4" class="text-center py-5">
                                            <div class="py-4">
                                                <i class="fas fa-door-open text-muted mb-3" style="font-size: 2rem; opacity: 0.2;"></i>
                                                <p class="text-muted small">No class rooms found.</p>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Edit Room Modal -->
<div class="modal fade" id="editRoomModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title fw-700">Edit Class Room</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="Edit" method="post">
                <div class="modal-body">
                    <input type="hidden" name="id" id="edit_id">
                    <div class="mb-3">
                        <label class="form-label fw-600 small text-uppercase">Room No</label>
                        <input type="text" name="roomNo" id="edit_roomNo" class="form-control" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-600 small text-uppercase">Capacity</label>
                        <input type="number" name="capacity" id="edit_capacity" class="form-control">
                    </div>
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" name="isActive" id="edit_isActive" value="true">
                        <label class="form-check-label fw-600" for="edit_isActive">Is Active?</label>
                    </div>
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary fw-700">Update Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    function editRoom(id, roomNo, capacity, isActive) {
        document.getElementById('edit_id').value = id;
        document.getElementById('edit_roomNo').value = roomNo;
        document.getElementById('edit_capacity').value = capacity;
        document.getElementById('edit_isActive').checked = isActive;
        new bootstrap.Modal(document.getElementById('editRoomModal')).show();
    }
</script>
