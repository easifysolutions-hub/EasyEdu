@model IEnumerable<EasyEdu.Models.BookCategory>
@{
    ViewData["Title"] = "Knowledge Management | Classification";
    Layout = "_Layout";
}

<div class="page-header d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="page-title animate-slide-in">Literary Classification Hub</h1>
        <p class="text-muted fw-600">Defining the organizational hierarchy of institutional wisdom and digital assets</p>
    </div>
    <div>
        <a asp-action="Index" class="btn btn-premium-primary bg-white text-primary border border-primary px-4 shadow-sm">
            <i class="fas fa-arrow-left me-2"></i> Book Registry
        </a>
    </div>
</div>

<div class="row g-4 mb-5">
    <div class="col-xl-4">
        <div class="premium-card bg-white shadow-xl border-0 overflow-hidden animate-fade-in">
            <div class="p-4 border-bottom bg-info text-white">
                <h5 class="fw-900 mb-0"><i class="fas fa-microchip text-white me-2"></i> Classification Logic Entry</h5>
            </div>
            <div class="p-4">
                <form asp-action="CreateCategory" method="post">
                    @Html.AntiForgeryToken()
                    <div class="mb-4">
                        <label class="form-label fw-800 text-muted small uppercase">Discipline Identity (Name)</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-2"><i class="fas fa-tag"></i></span>
                            <input name="Name" class="form-control border-2 fw-900" placeholder="e.g., Quantum Physics, Fiction..." required />
                        </div>
                    </div>

                    <div class="mb-5">
                        <label class="form-label fw-800 text-muted small uppercase">Protocol Description (Optional)</label>
                        <textarea name="Description" class="form-control border-2 fw-700" rows="4" placeholder="Briefly describe the assets in this discipline..."></textarea>
                    </div>

                    <button type="submit" class="btn btn-info w-100 py-3 shadow-lg fs-5 fw-900 text-white">
                        <i class="fas fa-check-double me-2"></i> EXECUTE_CLASSIFICATION
                    </button>
                </form>
            </div>
        </div>
    </div>

    <div class="col-xl-8">
        <div class="premium-card bg-white shadow-xl border-0 overflow-hidden h-100">
            <div class="p-4 border-bottom bg-light d-flex justify-content-between align-items-center">
                <h5 class="fw-900 text-dark mb-0">Active Resource Disciplines</h5>
                <span class="badge bg-info-soft text-info px-3 py-2 rounded-pill fw-800">AUDITED FEED</span>
            </div>
            <div class="table-responsive">
                <table class="table premium-table mb-0">
                    <thead>
                        <tr>
                            <th class="ps-4">STRATEGIC IDENTITY</th>
                            <th>META DESCRIPTION</th>
                            <th class="text-center pe-4">PROTOCOLS</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in Model)
                        {
                            <tr class="align-middle transition-all">
                                <td class="ps-4">
                                    <div class="fw-900 text-dark">@r.Name</div>
                                    <div class="small text-muted fw-600 uppercase" style="font-size: 0.6rem;">ID: @r.Id.ToString("D4")</div>
                                </td>
                                <td>
                                    <div class="small text-muted fw-800 font-monospace">@(string.IsNullOrEmpty(r.Description) ? "No protocol documentation available." : r.Description)</div>
                                </td>
                                <td class="text-end pe-4">
                                    <div class="dropdown">
                                        <button class="btn btn-icon-premium" data-bs-toggle="dropdown">
                                            <i class="fas fa-ellipsis-v"></i>
                                        </button>
                                        <ul class="dropdown-menu dropdown-menu-end shadow-xl border-0">
                                            <li><a class="dropdown-item fw-700 py-2" href="#"><i class="fas fa-edit me-2 text-warning"></i> Modify Data</a></li>
                                            <li><a class="dropdown-item fw-700 py-2 text-danger" href="#"><i class="fas fa-trash-alt me-2"></i> Archive</a></li>
                                        </ul>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<style>
    .bg-info-soft { background: rgba(13, 202, 240, 0.1); }
</style>
