@model IEnumerable<EasyEdu.Models.LibraryMember>
@{
    ViewData["Title"] = "Knowledge Management | Membership Hub";
    Layout = "_Layout";
}

<div class="page-header d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="page-title animate-slide-in">Authorized Membership Registry</h1>
        <p class="text-muted fw-600">Managing access credentials and circulation privileges for institutional users</p>
    </div>
    <div>
        <a asp-action="Index" class="btn btn-premium-primary bg-white text-primary border border-primary px-4 shadow-sm">
            <i class="fas fa-arrow-left me-2"></i> Book Registry
        </a>
    </div>
</div>

<div class="row g-4 mb-5">
    <div class="col-xl-4">
        <div class="premium-card bg-white shadow-xl border-0 overflow-hidden animate-fade-in">
            <div class="p-4 border-bottom bg-success text-white">
                <h5 class="fw-900 mb-0"><i class="fas fa-id-card-clip text-white me-2"></i> Membership Authorization</h5>
            </div>
            <div class="p-4">
                <form asp-action="CreateMember" method="post">
                    @Html.AntiForgeryToken()
                    <div class="mb-4">
                        <label class="form-label fw-800 text-muted small uppercase">Digital Identity (Member ID)</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-2"><i class="fas fa-fingerprint"></i></span>
                            <input name="MemberId" class="form-control border-2 fw-900" placeholder="LIB-@(DateTime.Now.ToString("yyyy"))-XXX" required />
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-800 text-muted small uppercase">Authorized Recipient (Student)</label>
                        <select name="StudentId" class="form-select border-2 fw-800" required>
                            <option value="">Select Student to Authorize...</option>
                            @foreach (var student in ViewBag.Students)
                            {
                                <option value="@student.Id">@student.FirstName @student.LastName (@student.AdmissionNumber)</option>
                            }
                        </select>
                    </div>

                    <div class="mb-5">
                        <label class="form-label fw-800 text-muted small uppercase">Access Authorization Date</label>
                        <input name="JoinedDate" type="date" class="form-control border-2 fw-700" value="@DateTime.Now.ToString("yyyy-MM-dd")" required />
                    </div>

                    <button type="submit" class="btn btn-success w-100 py-3 shadow-lg fs-5 fw-900 text-white">
                        <i class="fas fa-shield-check me-2"></i> ACTIVATE_MEMBERSHIP
                    </button>
                </form>
            </div>
        </div>
    </div>

    <div class="col-xl-8">
        <div class="premium-card bg-white shadow-xl border-0 overflow-hidden h-100">
            <div class="p-4 border-bottom bg-light d-flex justify-content-between align-items-center">
                <h5 class="fw-900 text-dark mb-0">Authorized Knowledge Navigators</h5>
                <span class="badge bg-success-soft text-success px-3 py-2 rounded-pill fw-800">TRUSTED FEED</span>
            </div>
            <div class="table-responsive">
                <table class="table premium-table mb-0">
                    <thead>
                        <tr>
                            <th class="ps-4">MEMBER IDENTITY</th>
                            <th>USER_TYPE</th>
                            <th>CREDENTIAL_STAMP</th>
                            <th>ACCESS STATUS</th>
                            <th class="text-end pe-4">PROTOCOLS</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in Model)
                        {
                            <tr class="align-middle transition-all">
                                <td class="ps-4">
                                    <div class="fw-900 text-dark">@(r.Student?.FirstName ?? "N/A") @(r.Student?.LastName ?? "")</div>
                                    <div class="small text-muted fw-600 uppercase" style="font-size: 0.6rem;">ID: @r.MemberId</div>
                                </td>
                                <td>
                                    <span class="badge bg-light text-primary border border-primary-soft px-3 py-2 rounded-pill fw-800">
                                        @r.UserType
                                    </span>
                                </td>
                                <td>
                                    <div class="fw-800 text-dark">@r.JoinedDate.ToString("dd MMM yyyy")</div>
                                </td>
                                <td>
                                    <span class="badge bg-success-soft text-success fw-900 px-3 py-2 rounded-pill">
                                        <i class="fas fa-shield-check me-1"></i> AUTHORIZED
                                    </span>
                                </td>
                                <td class="text-end pe-4">
                                    <div class="dropdown">
                                        <button class="btn btn-icon-premium" data-bs-toggle="dropdown">
                                            <i class="fas fa-ellipsis-v"></i>
                                        </button>
                                        <ul class="dropdown-menu dropdown-menu-end shadow-xl border-0">
                                            <li><a class="dropdown-item fw-700 py-2" href="#"><i class="fas fa-eye me-2 text-primary"></i> View Portfolio</a></li>
                                            <li><a class="dropdown-item fw-700 py-2 text-danger" href="#"><i class="fas fa-lock me-2"></i> Revoke Access</a></li>
                                        </ul>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<style>
    .bg-success-soft { background: rgba(16, 185, 129, 0.1); }
</style>
