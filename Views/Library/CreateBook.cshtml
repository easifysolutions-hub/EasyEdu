@model EasyEdu.Models.Book
@{
    ViewData["Title"] = "Asset Acquisition | New Book Entry";
    Layout = "_Layout";
}

<div class="page-header d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="page-title animate-slide-in text-gradient primary-gradient">Index New Library Asset</h1>
        <p class="text-muted fw-800 uppercase tracking-widest small"><i class="fas fa-file-import me-1"></i> Data Acquisition Phase</p>
    </div>
    <div>
        <a asp-action="Index" class="btn btn-premium-primary bg-white text-primary border border-primary px-4 shadow-sm">
            <i class="fas fa-arrow-left me-2"></i> Book Registry
        </a>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-xl-9">
        <div class="premium-card bg-white shadow-xl border-0 overflow-hidden animate-fade-in">
            <div class="p-5 border-bottom bg-light">
                <h5 class="fw-900 text-dark mb-0"><i class="fas fa-book-medical text-primary me-2"></i> Metadata Entry Logic</h5>
            </div>
            <div class="p-5">
                <form asp-action="CreateBook" method="post">
                    <div class="row g-4">
                        <div class="col-md-12">
                            <label class="form-label fw-800 text-muted small uppercase">Full Resource Title</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-2"><i class="fas fa-heading"></i></span>
                                <input asp-for="Title" class="form-control border-2 fw-900 fs-5" placeholder="Enter the official book title..." required />
                            </div>
                            <span asp-validation-for="Title" class="text-danger small fw-700"></span>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-800 text-muted small uppercase">Originating Author</label>
                            <input asp-for="Author" class="form-control border-2 fw-800 ps-4 py-2" placeholder="Primary Author Name" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-800 text-muted small uppercase">Indexing Code (ISBN)</label>
                            <input asp-for="ISBN" class="form-control border-2 fw-800 ps-4 py-2" placeholder="International Standard Book Number" />
                        </div>

                        <div class="col-md-4">
                            <label class="form-label fw-800 text-muted small uppercase">Academic Discipline</label>
                            <select asp-for="CategoryId" class="form-select border-2 fw-800 py-2">
                                <option value="">General Class</option>
                                @foreach (var cat in ViewBag.Categories)
                                {
                                    <option value="@cat.Id">@cat.Name</option>
                                }
                            </select>
                        </div>

                        <div class="col-md-4">
                            <label class="form-label fw-800 text-muted small uppercase">Publication Entity</label>
                            <input asp-for="Publisher" class="form-control border-2 fw-800 ps-4 py-2" placeholder="Publisher Name" />
                        </div>

                        <div class="col-md-4">
                            <label class="form-label fw-800 text-muted small uppercase">Intellectual Value ($)</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-2">$</span>
                                <input asp-for="Price" type="number" step="0.01" class="form-control border-2 fw-800 text-success py-2" placeholder="0.00" />
                            </div>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-800 text-muted small uppercase">Subject / Tag</label>
                            <input asp-for="Subject" class="form-control border-2 fw-800 ps-4 py-2" placeholder="e.g. Mathematics, Calculus" />
                        </div>

                        <div class="col-md-3">
                            <label class="form-label fw-800 text-muted small uppercase">Edition</label>
                            <input asp-for="Edition" class="form-control border-2 fw-800 ps-4 py-2" placeholder="1st, 2nd, etc." />
                        </div>

                        <div class="col-md-3">
                            <label class="form-label fw-800 text-muted small uppercase">Language</label>
                            <input asp-for="Language" class="form-control border-2 fw-800 ps-4 py-2" value="English" />
                        </div>

                        <div class="col-md-4">
                            <label class="form-label fw-800 text-muted small uppercase">Storage Location (Rack #)</label>
                            <input asp-for="RackNumber" class="form-control border-2 fw-800 ps-4 py-2" placeholder="e.g. R-12, B-4" />
                        </div>

                        <div class="col-md-4">
                            <label class="form-label fw-800 text-muted small uppercase">Physical Condition</label>
                            <select asp-for="BookCondition" class="form-select border-2 fw-800 py-2">
                                <option value="New">Pristine / New</option>
                                <option value="Good" selected>Good / Used</option>
                                <option value="Old">Old / Fragmented</option>
                                <option value="Damaged">Damaged / Repair Required</option>
                            </select>
                        </div>

                        <div class="col-md-4">
                            <label class="form-label fw-800 text-muted small uppercase">Total Unit Count</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-2"><i class="fas fa-boxes-stacked"></i></span>
                                <input asp-for="TotalCopies" type="number" class="form-control border-2 fw-900 py-2" value="1" min="1" required />
                            </div>
                        </div>

                        <div class="col-md-12">
                            <label class="form-label fw-800 text-muted small uppercase">Physical Year of Publication</label>
                            <input asp-for="PublishedYear" type="number" class="form-control border-2 fw-800 py-2" value="@DateTime.Now.Year" />
                        </div>
                    </div>

                    <div class="mt-5 d-flex gap-3">
                        <button type="submit" class="btn-premium btn-premium-primary w-100 py-3 shadow-lg fs-5">
                            <i class="fas fa-check-circle me-2"></i> Index into Registry
                        </button>
                        <a asp-action="Index" class="btn btn-light border-2 px-5 py-3 fw-900">ABORT</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
