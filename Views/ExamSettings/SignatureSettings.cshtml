@model EasyEdu.Models.ExamSignatureSetting
@{
    ViewData["Title"] = "Exam Signature Architect";
    Layout = "_Layout";
}

<div class="content-wrapper p-4 animate-fade-in text-dark">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="page-title mb-1 fw-900 text-dark">Authentication Assets</h3>
            <p class="text-muted small fw-600">Integrate digital signatures for Principal and Teachers across marking reports</p>
        </div>
    </div>

    <div class="row g-4 justify-content-center">
        <div class="col-xl-9">
            <form asp-action="SaveSignatureSettings" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="CompanyId" />

                <div class="row g-4">
                    <div class="col-md-6">
                        <div class="premium-card p-5 border-0 shadow-lg text-center" style="border-radius: 24px;">
                             <div class="icon-circle-lg bg-light mb-4">
                                <i class="fas fa-file-signature fa-3x text-primary opacity-25"></i>
                             </div>
                             <h5 class="fw-900 text-dark mb-4 border-bottom pb-3">Principal Authority</h5>
                             
                             <div class="mb-4">
                                @if(!string.IsNullOrEmpty(Model.PrincipalSignaturePath)) {
                                     <div class="p-3 bg-light border border-2 border-dashed rounded-16 mb-3">
                                         <img src="@Model.PrincipalSignaturePath" style="height: 60px; filter: contrast(150%) grayscale(100%);" class="mb-2">
                                         <p class="smallest text-muted m-0 fw-700">Digital Signature Cached</p>
                                     </div>
                                 }
                                 <input type="file" name="principalSig" class="form-control form-control-premium">
                                 <p class="smallest text-muted mt-2 fw-600">Transparent PNG recommended (max 500kb)</p>
                             </div>

                             <input asp-for="PrincipalName" class="form-control form-control-premium mb-4" placeholder="Full Principal Name (Optional)">

                             <div class="form-check form-switch p-0 d-flex align-items-center justify-content-between">
                                <label class="small fw-800 text-uppercase opacity-75 m-0">Include Principal Signature</label>
                                <input class="form-check-input ms-0" type="checkbox" asp-for="ShowPrincipalSignature" style="width: 45px; height: 22px;">
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="premium-card p-5 border-0 shadow-lg text-center" style="border-radius: 24px;">
                             <div class="icon-circle-lg bg-light mb-4">
                                <i class="fas fa-signature fa-3x text-info opacity-25"></i>
                             </div>
                             <h5 class="fw-900 text-dark mb-4 border-bottom pb-3">Teacher Validation</h5>
                             
                             <div class="mb-4">
                                @if(!string.IsNullOrEmpty(Model.TeacherSignaturePath)) {
                                     <div class="p-3 bg-light border border-2 border-dashed rounded-16 mb-3">
                                         <img src="@Model.TeacherSignaturePath" style="height: 60px; filter: contrast(150%) grayscale(100%);" class="mb-2">
                                         <p class="smallest text-muted m-0 fw-700">Digital Signature Cached</p>
                                     </div>
                                 }
                                 <input type="file" name="teacherSig" class="form-control form-control-premium">
                                 <p class="smallest text-muted mt-2 fw-600">Standard teacher signature for reports</p>
                             </div>

                             <div class="form-check form-switch p-0 d-flex align-items-center justify-content-between mt-5">
                                <label class="small fw-800 text-uppercase opacity-75 m-0">Include Class Teacher Signature</label>
                                <input class="form-check-input ms-0" type="checkbox" asp-for="ShowTeacherSignature" style="width: 45px; height: 22px;">
                            </div>
                        </div>
                    </div>

                    <div class="col-md-12">
                         <div class="premium-card p-4 bg-premium-dark d-flex justify-content-between align-items-center shadow-lg" style="border-radius: 20px;">
                            <div class="d-flex align-items-center">
                                <i class="fas fa-fingerprint text-success me-3 fa-lg shadow-sm"></i>
                                <p class="text-white opacity-50 m-0 small fw-700">Digital signatures ensure the authenticity of institutional merit reports.</p>
                            </div>
                            <button type="submit" class="btn btn-premium-purple px-5 py-3 rounded-12 shadow-lg fw-900 h6 mb-0">
                                <i class="fas fa-shield-alt me-2 text-info"></i>SYNCHRONIZE AUTHENTICATION ASSETS
                            </button>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

<style>
    .bg-premium-dark { background: #1e293b; }
    .rounded-16 { border-radius: 16px; }
    .border-dashed { border: 2px dashed #e2e8f0; }
    .icon-circle-lg { width: 100px; height: 100px; line-height: 100px; border-radius: 50%; display: inline-block; }
    .btn-premium-purple { background: linear-gradient(135deg, #6366f1 0%, #4f46e5 100%); color: white; border: none; }
</style>
