@model IEnumerable<EasyEdu.Models.ExamPosition>
@{
    ViewData["Title"] = "Exam Position Merit List";
    Layout = "_Layout";
}

<div class="content-wrapper p-4 animate-fade-in text-dark">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="page-title mb-1 fw-900 text-dark">Exam Position & Merit Rank</h3>
            <p class="text-muted small fw-600">Analyze performance and generate definitive ranks for the institutional merit list</p>
        </div>
        <div class="d-flex gap-2">
            <a href="@Url.Action("AllExamPosition")" class="btn btn-light-soft px-4 py-2 rounded-12 shadow-sm fw-700">
                <i class="fas fa-trophy me-2 text-warning"></i>VIEW GLOBAL RANKINGS
            </a>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-xl-4">
            <div class="premium-card p-5 border-0 shadow-lg" style="border-radius: 24px;">
                <h5 class="fw-900 text-dark mb-4 border-bottom pb-3">Merit Calculation Nexus</h5>
                <form asp-action="GeneratePositions" method="post">
                    <div class="mb-4">
                        <label class="form-label small fw-800 text-uppercase opacity-50">Select Target Examination</label>
                        <select name="examinationId" class="form-select form-control-premium" required>
                            <option value="">Select Academic Exam</option>
                            @foreach (var exam in (List<EasyEdu.Models.Examination>)ViewBag.Exams)
                            {
                                <option value="@exam.Id">@exam.Name - @exam.AcademicYear.Name</option>
                            }
                        </select>
                    </div>

                    <div class="p-4 bg-light rounded-16 mb-4 border border-info border-opacity-10">
                        <div class="d-flex gap-2 text-info small fw-800 mb-2">
                            <i class="fas fa-microchip"></i>
                            <span>RANKING ENGINE LOGIC</span>
                        </div>
                        <p class="x-small fw-600 m-0 text-muted">A standard descending sort on total marks will be performed. GPA and status will automatically be derived from individual subject performance.</p>
                    </div>

                    <button type="submit" class="btn btn-premium-success w-100 py-3 rounded-12 shadow-lg fw-900 h6 mb-0">
                        <i class="fas fa-sync-alt me-2"></i>REGENERATE MERIT LIST
                    </button>
                    <p class="text-center smallest text-muted mt-3 fw-700">Note: Previous positions for this exam will be purged.</p>
                </form>
            </div>
        </div>

        <div class="col-xl-8">
            <div class="premium-card p-0 overflow-hidden border-0 shadow-lg" style="border-radius: 24px;">
                <table class="table premium-table mb-0 align-middle">
                    <thead class="bg-premium-dark text-white">
                        <tr>
                            <th class="ps-5 py-4 fw-900 small text-uppercase">RANK</th>
                            <th class="py-4 fw-900 small text-uppercase">STUDENT INDIVIDUAL</th>
                            <th class="py-4 fw-900 small text-uppercase">TOTAL MARKS</th>
                            <th class="py-4 fw-900 small text-uppercase">MERIT PERCENT</th>
                            <th class="pe-5 py-4 text-end fw-900 small text-uppercase">STATUS</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var pos in Model)
                        {
                            <tr>
                                <td class="ps-5 py-4">
                                    <div class="rank-badge @(pos.Rank <= 3 ? "rank-top" : "rank-std")">#@pos.Rank</div>
                                </td>
                                <td class="py-4">
                                     <div class="fw-900 text-dark h6 mb-1">@pos.Student.FirstName @pos.Student.LastName</div>
                                     <div class="small text-muted fw-700">ADM: @pos.Student.AdmissionNumber</div>
                                </td>
                                <td class="py-4"><span class="fw-900 text-dark">@pos.TotalMarks</span></td>
                                <td class="py-4"><span class="fw-900 text-primary h6 mb-0">@pos.Percentage%</span></td>
                                <td class="pe-5 text-end py-4">
                                     <span class="badge @(pos.Status == "Passed" ? "bg-success" : "bg-danger") px-3 rounded-pill fw-900">@pos.Status.ToUpper()</span>
                                </td>
                            </tr>
                        }
                        @if(!Model.Any()){
                            <tr>
                                <td colspan="5" class="text-center py-5">
                                    <i class="fas fa-user-graduate fa-3x text-muted opacity-20 mb-3"></i>
                                    <h5 class="fw-800 text-muted italic">Select an examination to view the generated merit list.</h5>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<style>
    .bg-premium-dark { background: #1e293b; }
    .rounded-16 { border-radius: 16px; }
    .btn-premium-success { background: linear-gradient(135deg, #10b981 0%, #059669 100%); color: white; border: none; }
    .rank-badge { width: 45px; height: 45px; display: flex; align-items: center; justify-content: center; border-radius: 12px; font-weight: 900; }
    .rank-top { background: #fef3c7; color: #b45309; border: 2px solid #f59e0b; }
    .rank-std { background: #f1f5f9; color: #64748b; border: 2px solid #e2e8f0; }
</style>
