@model EasyEdu.Models.AboutUs
@{
    ViewData["Title"] = "About Us";
    Layout = "_Layout";
}

<div class="content-wrapper p-4 animate-fade-in">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="page-title">Institutional Overview (About Us)</h3>
    </div>

    <div class="row">
        <div class="col-xl-8">
            <div class="premium-card">
                <div class="card-body p-4">
                    <form asp-action="UpdateAboutUs" method="post">
                        <div class="mb-4">
                            <label class="form-label small fw-800 text-uppercase">Page Title*</label>
                            <input asp-for="Title" class="form-control-premium w-100" required>
                        </div>
                        <div class="mb-4">
                            <label class="form-label small fw-800 text-uppercase">Main Content*</label>
                            <textarea asp-for="Content" rows="12" class="form-control-premium w-100" required></textarea>
                        </div>
                        <button type="submit" class="btn btn-premium-primary px-5 py-3 rounded-12 shadow-premium">UPDATE ABOUT CONTENT</button>
                    </form>
                </div>
            </div>
        </div>
        <div class="col-xl-4">
            <div class="premium-card p-4">
                <h6 class="fw-800 text-dark mb-3">Live Preview Hint</h6>
                <p class="small text-muted fw-600">This content will be displayed on the public landing page of the institution.</p>
                <div class="mt-4 border-top pt-4">
                    <label class="form-label small fw-800 text-uppercase opacity-50">Feature Image</label>
                    <div class="bg-light rounded-12 d-flex align-items-center justify-content-center mb-3" style="height: 150px;">
                        <i class="fas fa-school fa-3x text-muted opacity-20"></i>
                    </div>
                    <button class="btn btn-light-soft btn-sm w-100">CHANGE IMAGE</button>
                </div>
            </div>
        </div>
    </div>
</div>
