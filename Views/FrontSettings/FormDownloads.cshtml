@model IEnumerable<EasyEdu.Models.FormDownload>
@{
    ViewData["Title"] = "Resource Downloads";
    Layout = "_Layout";
}

<div class="content-wrapper p-4 animate-fade-in text-dark">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="page-title mb-1 fw-900 text-dark">Resource Downloads</h3>
            <p class="text-muted small fw-600">Upload and manage school brochures, application forms, or syllabus files for public download</p>
        </div>
        <button class="btn btn-premium-purple px-4 py-2 rounded-12 shadow-sm" data-bs-toggle="modal" data-bs-target="#addDownloadModal">
            <i class="fas fa-upload me-2"></i>UPLOAD DOCUMENT
        </button>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show d-flex align-items-center gap-2 mb-4" role="alert">
            <i class="fas fa-check-circle fs-5"></i>
            <div>@TempData["Success"]</div>
            <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center gap-2 mb-4" role="alert">
            <i class="fas fa-exclamation-circle fs-5"></i>
            <div>@TempData["Error"]</div>
            <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="premium-card p-0 overflow-hidden border-0 shadow-lg mb-4" style="border-radius: 24px;">
        <div class="table-responsive">
            <table class="table premium-table mb-0 align-middle">
                <thead class="bg-premium-dark text-white">
                    <tr>
                        <th class="ps-5 py-4 fw-900 small text-uppercase">DOCUMENT DETAILS</th>
                        <th class="py-4 fw-900 small text-uppercase">UPLOAD DATE</th>
                        <th class="py-4 fw-900 small text-uppercase text-center">STATUS</th>
                        <th class="pe-5 py-4 text-end fw-900 small text-uppercase">ACTIONS</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var d in Model)
                    {
                        <tr>
                            <td class="ps-5 py-3">
                                <div class="d-flex align-items-center gap-3">
                                    <div class="rounded-8 bg-light border d-flex align-items-center justify-content-center text-primary" style="width: 45px; height: 45px;">
                                        <i class="fas fa-file-pdf fa-lg"></i>
                                    </div>
                                    <div>
                                        <div class="fw-900 text-dark h6 mb-0">@d.Title</div>
                                        <div class="small text-muted fw-600">@d.Description</div>
                                    </div>
                                </div>
                            </td>
                            <td class="py-3">
                                <span class="fw-700 text-muted small">@d.UploadedAt.ToString("dd MMM yyyy HH:mm")</span>
                            </td>
                            <td class="text-center py-3">
                                <span class="badge @(d.IsActive ? "bg-success" : "bg-warning") px-3 rounded-pill fw-900">
                                    @(d.IsActive ? "ACTIVE" : "DISABLED")
                                </span>
                            </td>
                            <td class="pe-5 text-end py-3">
                                <div class="d-flex justify-content-end gap-2">
                                    <a href="@d.FilePath" target="_blank" class="btn btn-sm btn-light-soft rounded-8 shadow-sm" title="View/Download File">
                                        <i class="fas fa-download text-primary"></i>
                                    </a>
                                    <button class="btn btn-sm btn-light-soft rounded-8 shadow-sm" title="Delete File" onclick="openDeleteDownloadModal(@d.Id)">
                                        <i class="fas fa-trash text-danger"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                    @if(!Model.Any()){
                        <tr>
                            <td colspan="4" class="text-center py-5">
                                <i class="fas fa-file-arrow-down fa-3x text-muted opacity-20 mb-3"></i>
                                <h5 class="fw-800 text-muted italic">No resource download documents have been uploaded yet.</h5>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Upload Document Modal -->
<div class="modal fade" id="addDownloadModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 20px;">
            <div class="modal-header bg-premium-dark text-white p-4" style="border-top-left-radius: 20px; border-top-right-radius: 20px;">
                <h5 class="modal-title fw-900"><i class="fas fa-file-arrow-up me-2"></i> UPLOAD RESOURCE DOCUMENT</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="AddDownload" method="post" enctype="multipart/form-data">
                <div class="modal-body p-4 text-dark">
                    <div class="mb-3">
                        <label class="form-label small fw-800 text-uppercase opacity-70">Document Title*</label>
                        <input type="text" name="Title" class="form-control form-control-premium" required placeholder="e.g. Academic Syllabus 2026-27" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-800 text-uppercase opacity-70">Description</label>
                        <textarea name="Description" class="form-control" rows="3" placeholder="Briefly summarize what this document is..."></textarea>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-800 text-uppercase opacity-70">Select File*</label>
                        <input type="file" name="file" class="form-control" required accept=".pdf,.doc,.docx,.xls,.xlsx,.png,.jpg,.jpeg" />
                        <span class="small text-muted italic">Accepted: PDF, Word, Excel, Images (Max 10MB)</span>
                    </div>
                    <div class="form-check form-switch mb-2">
                        <input class="form-check-input" type="checkbox" name="IsActive" value="true" checked id="createIsActive" />
                        <label class="form-check-label small fw-800 text-uppercase opacity-70" for="createIsActive">Active (Available on Public Website)</label>
                    </div>
                </div>
                <div class="modal-footer p-4 border-top-0 d-flex gap-2">
                    <button type="button" class="btn btn-light px-4 py-2.5 rounded-12 fw-700" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-premium-purple px-4 py-2.5 rounded-12 fw-900"><i class="fas fa-cloud-arrow-up me-2"></i>Upload File</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteDownloadModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width: 400px;">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 20px;">
            <div class="modal-body p-4 text-center text-dark">
                <i class="fas fa-exclamation-triangle fa-3x text-danger mb-3"></i>
                <h5 class="fw-900 mb-2">DELETE DOCUMENT?</h5>
                <p class="text-muted small">Are you sure you want to permanently delete this resource file? This action cannot be undone.</p>
                <form asp-action="DeleteDownload" method="post" class="mt-4 d-flex gap-2 justify-content-center">
                    <input type="hidden" name="Id" id="deleteDownloadIdInput" />
                    <button type="button" class="btn btn-light px-4 py-2 rounded-12 fw-700" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger px-4 py-2 rounded-12 fw-900">Delete</button>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    function openDeleteDownloadModal(id) {
        document.getElementById('deleteDownloadIdInput').value = id;
        var myModal = new bootstrap.Modal(document.getElementById('deleteDownloadModal'));
        myModal.show();
    }
</script>

<style>
    .bg-premium-dark { background: #1e293b; }
    .form-control-premium {
        border-radius: 10px;
        border: 1px solid rgba(0,0,0,0.15);
        padding: 12px 16px;
    }
    .rounded-12 { border-radius: 12px; }
</style>
