@model IEnumerable<EasyEdu.Models.Testimonial>
@{
    ViewData["Title"] = "Testimonials";
    Layout = "_Layout";
}

<div class="content-wrapper p-4 animate-fade-in text-dark">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="page-title mb-1 fw-900 text-dark">Testimonials</h3>
            <p class="text-muted small fw-600">Manage public reviews and testimonials</p>
        </div>
        <button class="btn btn-premium-purple px-4 py-2 rounded-12 shadow-sm" data-bs-toggle="modal" data-bs-target="#createTestimonialModal">
            <i class="fas fa-plus me-2"></i>ADD TESTIMONIAL
        </button>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show d-flex align-items-center gap-2 mb-4" role="alert">
            <i class="fas fa-check-circle fs-5"></i>
            <div>@TempData["Success"]</div>
            <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="premium-card p-0 overflow-hidden border-0 shadow-lg mb-4" style="border-radius: 24px;">
        <div class="table-responsive">
            <table class="table premium-table mb-0 align-middle">
                <thead class="bg-premium-dark text-white">
                    <tr>
                        <th class="ps-5 py-4 fw-900 small text-uppercase">AUTHOR</th>
                        <th class="py-4 fw-900 small text-uppercase">DESIGNATION</th>
                        <th class="py-4 fw-900 small text-uppercase text-center">RATING</th>
                        <th class="py-4 fw-900 small text-uppercase text-center">STATUS</th>
                        <th class="pe-5 py-4 text-end fw-900 small text-uppercase">ACTIONS</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var t in Model)
                    {
                        <tr>
                            <td class="ps-5 py-3">
                                <div class="d-flex align-items-center">
                                    @if (!string.IsNullOrEmpty(t.AuthorImage)) {
                                        <img src="@t.AuthorImage" class="rounded-circle me-3" width="40" height="40" style="object-fit: cover;" />
                                    } else {
                                        <div class="rounded-circle me-3 bg-light d-flex align-items-center justify-content-center text-muted fw-bold" style="width:40px; height:40px;">
                                            @(!string.IsNullOrEmpty(t.AuthorName) ? t.AuthorName.Substring(0, 1).ToUpper() : "?")
                                        </div>
                                    }
                                    <div class="fw-900 text-dark h6 mb-0">@t.AuthorName</div>
                                </div>
                            </td>
                            <td class="py-3"><span class="fw-700 text-muted">@t.Designation</span></td>
                            <td class="text-center py-3">
                                <div class="text-warning">
                                    @for(int i=0; i<t.Rating; i++) { <i class="fas fa-star"></i> }
                                    @for(int i=t.Rating; i<5; i++) { <i class="far fa-star"></i> }
                                </div>
                            </td>
                            <td class="text-center py-3">
                                <span class="badge @(t.IsActive ? "bg-success" : "bg-danger") px-3 rounded-pill fw-900">
                                    @(t.IsActive ? "ACTIVE" : "INACTIVE")
                                </span>
                            </td>
                            <td class="pe-5 text-end py-3">
                                <div class="d-flex justify-content-end gap-2">
                                    <button class="btn btn-sm btn-light-soft rounded-8 shadow-sm" title="Edit"
                                            data-id="@t.Id"
                                            data-name="@t.AuthorName"
                                            data-designation="@t.Designation"
                                            data-rating="@t.Rating"
                                            data-active="@t.IsActive.ToString().ToLower()"
                                            data-content="@t.Content"
                                            onclick="openEditTestimonialModal(this)">
                                        <i class="fas fa-edit text-primary"></i>
                                    </button>
                                    <button class="btn btn-sm btn-light-soft rounded-8 shadow-sm" title="Delete" onclick="openDeleteTestimonialModal(@t.Id)">
                                        <i class="fas fa-trash text-danger"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                    @if(!Model.Any()){
                        <tr>
                            <td colspan="5" class="text-center py-5">
                                <i class="far fa-comments fa-3x text-muted opacity-20 mb-3"></i>
                                <h5 class="fw-800 text-muted italic">No testimonials added yet.</h5>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Create Testimonial Modal -->
<div class="modal fade" id="createTestimonialModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 20px;">
            <div class="modal-header bg-premium-dark text-white p-4" style="border-top-left-radius: 20px; border-top-right-radius: 20px;">
                <h5 class="modal-title fw-900"><i class="far fa-comments me-2"></i> ADD TESTIMONIAL</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="CreateTestimonial" method="post" enctype="multipart/form-data">
                <div class="modal-body p-4 text-dark">
                    <div class="mb-3">
                        <label class="form-label small fw-800 text-uppercase opacity-70">Author Name*</label>
                        <input type="text" name="AuthorName" class="form-control form-control-premium" required placeholder="e.g. John Doe" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-800 text-uppercase opacity-70">Designation / Role*</label>
                        <input type="text" name="Designation" class="form-control form-control-premium" required placeholder="e.g. Parent, Alumnus" />
                    </div>
                    <div class="row mb-3">
                        <div class="col-6">
                            <label class="form-label small fw-800 text-uppercase opacity-70">Rating (1-5 Stars)*</label>
                            <select name="Rating" class="form-select form-control-premium" required>
                                <option value="5">5 - Excellent</option>
                                <option value="4">4 - Very Good</option>
                                <option value="3">3 - Good</option>
                                <option value="2">2 - Fair</option>
                                <option value="1">1 - Poor</option>
                            </select>
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-800 text-uppercase opacity-70">Author Photo</label>
                            <input type="file" name="file" class="form-control" accept="image/*" />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-800 text-uppercase opacity-70">Review Content*</label>
                        <textarea name="Content" class="form-control" rows="4" required placeholder="Write the testimonial content here..."></textarea>
                    </div>
                    <div class="form-check form-switch mb-2">
                        <input class="form-check-input" type="checkbox" name="IsActive" value="true" checked id="createIsActive" />
                        <label class="form-check-label small fw-800 text-uppercase opacity-70" for="createIsActive">Active (Display on Homepage)</label>
                    </div>
                </div>
                <div class="modal-footer p-4 border-top-0 d-flex gap-2">
                    <button type="button" class="btn btn-light px-4 py-2.5 rounded-12 fw-700" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-premium-purple px-4 py-2.5 rounded-12 fw-900"><i class="fas fa-plus me-2"></i>Add Testimonial</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Edit Testimonial Modal -->
<div class="modal fade" id="editTestimonialModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 20px;">
            <div class="modal-header bg-primary text-white p-4" style="border-top-left-radius: 20px; border-top-right-radius: 20px;">
                <h5 class="modal-title fw-900"><i class="far fa-edit me-2"></i> EDIT TESTIMONIAL</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="EditTestimonial" method="post" enctype="multipart/form-data">
                <input type="hidden" name="Id" id="editTestimonialId" />
                <div class="modal-body p-4 text-dark">
                    <div class="mb-3">
                        <label class="form-label small fw-800 text-uppercase opacity-70">Author Name*</label>
                        <input type="text" name="AuthorName" id="editTestimonialAuthorName" class="form-control form-control-premium" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-800 text-uppercase opacity-70">Designation / Role*</label>
                        <input type="text" name="Designation" id="editTestimonialDesignation" class="form-control form-control-premium" required />
                    </div>
                    <div class="row mb-3">
                        <div class="col-6">
                            <label class="form-label small fw-800 text-uppercase opacity-70">Rating (1-5 Stars)*</label>
                            <select name="Rating" id="editTestimonialRating" class="form-select form-control-premium" required>
                                <option value="5">5 - Excellent</option>
                                <option value="4">4 - Very Good</option>
                                <option value="3">3 - Good</option>
                                <option value="2">2 - Fair</option>
                                <option value="1">1 - Poor</option>
                            </select>
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-800 text-uppercase opacity-70">Author Photo (leave empty to keep current)</label>
                            <input type="file" name="file" class="form-control" accept="image/*" />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-800 text-uppercase opacity-70">Review Content*</label>
                        <textarea name="Content" id="editTestimonialContent" class="form-control" rows="4" required></textarea>
                    </div>
                    <div class="form-check form-switch mb-2">
                        <input class="form-check-input" type="checkbox" name="IsActive" value="true" id="editTestimonialIsActive" />
                        <label class="form-check-label small fw-800 text-uppercase opacity-70" for="editTestimonialIsActive">Active (Display on Homepage)</label>
                    </div>
                </div>
                <div class="modal-footer p-4 border-top-0 d-flex gap-2">
                    <button type="button" class="btn btn-light px-4 py-2.5 rounded-12 fw-700" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary px-4 py-2.5 rounded-12 fw-900"><i class="fas fa-save me-2"></i>Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteTestimonialModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width: 400px;">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 20px;">
            <div class="modal-body p-4 text-center text-dark">
                <i class="fas fa-exclamation-triangle fa-3x text-danger mb-3"></i>
                <h5 class="fw-900 mb-2">DELETE TESTIMONIAL?</h5>
                <p class="text-muted small">Are you sure you want to permanently delete this testimonial? This action cannot be undone.</p>
                <form asp-action="DeleteTestimonial" method="post" class="mt-4 d-flex gap-2 justify-content-center">
                    <input type="hidden" name="Id" id="deleteTestimonialIdInput" />
                    <button type="button" class="btn btn-light px-4 py-2 rounded-12 fw-700" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger px-4 py-2 rounded-12 fw-900">Delete</button>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    function openEditTestimonialModal(btn) {
        var id = btn.getAttribute('data-id');
        var name = btn.getAttribute('data-name');
        var designation = btn.getAttribute('data-designation');
        var content = btn.getAttribute('data-content');
        var rating = btn.getAttribute('data-rating');
        var isActive = btn.getAttribute('data-active') === 'true';

        document.getElementById('editTestimonialId').value = id;
        document.getElementById('editTestimonialAuthorName').value = name;
        document.getElementById('editTestimonialDesignation').value = designation;
        document.getElementById('editTestimonialContent').value = content;
        document.getElementById('editTestimonialRating').value = rating;
        document.getElementById('editTestimonialIsActive').checked = isActive;

        var myModal = new bootstrap.Modal(document.getElementById('editTestimonialModal'));
        myModal.show();
    }

    function openDeleteTestimonialModal(id) {
        document.getElementById('deleteTestimonialIdInput').value = id;
        var myModal = new bootstrap.Modal(document.getElementById('deleteTestimonialModal'));
        myModal.show();
    }
</script>

<style>
    .bg-premium-dark { background: #1e293b; }
    .form-control-premium {
        border-radius: 10px;
        border: 1px solid rgba(0,0,0,0.15);
        padding: 12px 16px;
    }
    .rounded-12 { border-radius: 12px; }
</style>
