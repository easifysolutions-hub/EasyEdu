@model EasyEdu.Controllers.ClassListViewModel
@{
    ViewData["Title"] = "Class Setup";
    Layout = "_Layout";
}

<div class="content-wrapper p-4">
    <div class="row g-4 d-flex align-items-stretch">
        <!-- Add Class Form -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-12 h-100">
                <div class="card-header bg-white border-bottom border-light py-3">
                    <h5 class="fw-800 text-primary m-0">Add Class</h5>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Create" method="post">
                        <div class="mb-3">
                            <label class="form-label fw-700 text-muted small text-uppercase">Class Name</label>
                            <input type="text" name="Name" class="form-control" placeholder="e.g. Class 1, Grade 10" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-700 text-muted small text-uppercase mb-2">Sections</label>
                            <div class="d-flex flex-wrap gap-2">
                                @foreach (var secItem in Model.ActiveSections)
                                {
                                    <div class="form-check form-check-inline">
                                        <input class="form-check-input" type="checkbox" name="SelectedSectionIds" id="sec_@secItem.Id" value="@secItem.Id">
                                        <label class="form-check-label small fw-600" for="sec_@secItem.Id">
                                            @secItem.Name
                                        </label>
                                    </div>
                                }
                            </div>
                            <div class="form-text small text-muted mt-2">
                                <i class="fas fa-info-circle me-1"></i> Select sections available for this class.
                            </div>
                        </div>
                        <div class="d-grid mt-4">
                            <button type="submit" class="btn btn-primary fw-700 py-2 shadow-sm">
                                <i class="fas fa-check me-2"></i> Save Class
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- Class List -->
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-12 h-100">
                <div class="card-header bg-white border-bottom border-light py-3 d-flex justify-content-between align-items-center">
                    <h5 class="fw-800 text-dark m-0">Class List</h5>
                    <div class="search-box">
                        <input type="text" class="form-control form-control-sm border-0 bg-light" placeholder="Search...">
                    </div>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="bg-light text-muted small text-uppercase">
                                <tr>
                                    <th class="px-4 py-3 fw-700">Class</th>
                                    <th class="py-3 fw-700" style="width: 40%;">Sections</th>
                                    <th class="py-3 fw-700">Students</th>
                                    <th class="text-end px-4 py-3 fw-700">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.Classes != null && Model.Classes.Any())
                                {
                                    foreach (var item in Model.Classes)
                                    {
                                        <tr>
                                            <td class="px-4 fw-700 text-dark">@item.Name</td>
                                            <td>
                                                @if (Model.ClassSections.ContainsKey(item.Id) && Model.ClassSections[item.Id].Any())
                                                {
                                                    <div class="d-flex flex-wrap gap-1">
                                                        @foreach (var sec in Model.ClassSections[item.Id])
                                                        {
                                                            <span class="badge bg-light text-primary border fw-600">@sec.Name</span>
                                                        }
                                                    </div>
                                                }
                                                else
                                                {
                                                    <span class="text-muted small">No Sections</span>
                                                }
                                            </td>
                                            <td>
                                                <span class="badge bg-success bg-opacity-10 text-success fw-700 rounded-pill px-3">0 Students</span>
                                            </td>
                                            <td class="text-end px-4">
                                                <button class="btn btn-sm btn-light text-primary me-2" onclick="editClass(@item.Id, '@item.Name', [@(string.Join(",", Model.ClassSections.ContainsKey(item.Id) ? Model.ClassSections[item.Id].Select(s => s.Id) : new List<int>() ))])">
                                                    <i class="fas fa-pen"></i>
                                                </button>
                                                <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Delete this class?');">
                                                    <button type="submit" class="btn btn-sm btn-light text-danger">
                                                        <i class="fas fa-trash"></i>
                                                    </button>
                                                </form>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="4" class="text-center py-5">
                                            <div class="py-4">
                                                <i class="fas fa-chalkboard text-muted mb-3" style="font-size: 2rem; opacity: 0.2;"></i>
                                                <p class="text-muted small">No classes found.</p>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Edit Class Modal -->
<div class="modal fade" id="editClassModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title fw-700">Edit Class</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="Edit" method="post">
                <div class="modal-body">
                    <input type="hidden" name="id" id="edit_id">
                    <div class="mb-3">
                        <label class="form-label fw-600 small text-uppercase">Class Name</label>
                        <input type="text" name="name" id="edit_name" class="form-control" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-600 small text-uppercase mb-2">Sections</label>
                         <div class="d-flex flex-wrap gap-2">
                            @foreach (var activeSec in Model.ActiveSections)
                            {
                                <div class="form-check form-check-inline">
                                    <input class="form-check-input edit-section-check" type="checkbox" name="sectionIds" id="edit_sec_@activeSec.Id" value="@activeSec.Id">
                                    <label class="form-check-label small fw-600" for="edit_sec_@activeSec.Id">
                                        @activeSec.Name
                                    </label>
                                </div>
                            }
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary fw-700">Update Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    function editClass(id, name, sectionIds) {
        document.getElementById('edit_id').value = id;
        document.getElementById('edit_name').value = name;
        
        // Reset checkboxes
        document.querySelectorAll('.edit-section-check').forEach(cb => cb.checked = false);
        
        // Check active ones
        sectionIds.forEach(sid => {
            const cb = document.getElementById('edit_sec_' + sid);
            if(cb) cb.checked = true;
        });

        new bootstrap.Modal(document.getElementById('editClassModal')).show();
    }
</script>
