<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - EasyEdu</title>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&family=Playfair+Display:wght@700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/aos/2.3.4/aos.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <style>
        :root {
            --bg-color: #0f172a;
            --card-bg: rgba(30, 41, 59, 0.6);
            --nav-bg: rgba(15, 23, 42, 0.95);
            --primary: #3b82f6;
            --secondary: #f59e0b;
            --accent: #8b5cf6;
            --text-main: #f8fafc;
            --text-muted: #94a3b8;
            --gradient: linear-gradient(135deg, #3b82f6 0%, #8b5cf6 100%);
            --glass-border: 1px solid rgba(255, 255, 255, 0.1);
            --shadow-card: 0 10px 30px -5px rgba(0, 0, 0, 0.5);
        }

        * { margin: 0; padding: 0; box-sizing: border-box; outline: none; }

        body {
            font-family: 'Outfit', sans-serif;
            background-color: var(--bg-color);
            color: var(--text-main);
            overflow-x: hidden;
            line-height: 1.6;
            background-image: 
                radial-gradient(circle at 10% 20%, rgba(59, 130, 246, 0.15) 0%, transparent 40%),
                radial-gradient(circle at 90% 80%, rgba(139, 92, 246, 0.15) 0%, transparent 40%);
            background-attachment: fixed;
        }

        h1, h2, h3, h4, h5, h6 {
            font-family: 'Playfair Display', serif;
            color: var(--text-main);
            font-weight: 700;
        }

        a { text-decoration: none; transition: 0.3s; }
        ul { list-style: none; }

        .container {
            width: 100%;
            max-width: 1300px;
            margin: 0 auto;
            padding: 0 20px;
        }

        /* --- Global Styles --- */
        .section-padding { padding: 100px 0; }
        .section-title { text-align: center; margin-bottom: 60px; }
        .section-title h5 { color: var(--secondary); text-transform: uppercase; letter-spacing: 2px; font-size: 0.9rem; margin-bottom: 10px; font-family: 'Outfit', sans-serif; }
        .section-title h2 { font-size: 2.5rem; }

        .btn-glow {
            background: var(--gradient);
            color: white !important;
            padding: 10px 30px;
            border-radius: 50px;
            box-shadow: 0 0 15px rgba(59, 130, 246, 0.4);
            border: 1px solid rgba(255,255,255,0.2);
            display: inline-block;
        }
        .btn-glow:hover { box-shadow: 0 0 25px rgba(59, 130, 246, 0.6); transform: translateY(-2px); }

        /* --- Header --- */
        .header-top {
            background: linear-gradient(90deg, #1e293b, #0f172a);
            padding: 10px 0;
            border-bottom: var(--glass-border);
            font-size: 13px;
        }
        .header-flex { display: flex; justify-content: space-between; align-items: center; }
        .header-contact span { margin-right: 20px; color: var(--text-muted); }
        .header-contact i { color: var(--secondary); margin-right: 8px; }
        .social-icons a { color: var(--text-muted); margin-left: 15px; font-size: 14px; display: inline-block; transition: 0.3s; }
        .social-icons a:hover { color: var(--primary); transform: translateY(-2px); }

        .main-menu {
            background: var(--nav-bg);
            backdrop-filter: blur(10px);
            padding: 15px 0;
            position: sticky;
            top: 0;
            z-index: 1000;
            border-bottom: var(--glass-border);
        }
        .navbar-brand img { height: 60px; width: auto; }
        .nav-items { display: flex; align-items: center; gap: 30px; }
        .nav-items a {
            color: var(--text-main); font-weight: 500; font-size: 14px; text-transform: uppercase; letter-spacing: 0.5px;
        }
        .nav-items a:hover, .nav-items a.active { color: var(--secondary); }

        /* --- Module Cards & Glass Cards --- */
        .module-card {
            background: rgba(30, 41, 59, 0.4);
            backdrop-filter: blur(15px);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 20px;
            padding: 35px 25px;
            transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);
            height: 100%;
            display: flex;
            flex-direction: column;
        }
        .module-card:hover {
            transform: translateY(-12px);
            background: rgba(30, 41, 59, 0.7);
            border-color: var(--primary);
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.6);
        }
        .module-icon-wrapper {
            width: 60px; height: 60px; border-radius: 12px;
            background: rgba(59, 130, 246, 0.1);
            display: flex; align-items: center; justify-content: center;
            margin-bottom: 25px; transition: 0.4s;
            border: 1px solid rgba(59, 130, 246, 0.2);
        }
        .module-card i { font-size: 2rem; color: var(--primary); }
        .module-card h4 { font-size: 1.25rem; font-weight: 700; margin-bottom: 12px; color: #fff; }
        .module-card p { font-size: 0.9rem; color: var(--text-muted); line-height: 1.6; }

        /* --- Footer --- */
        .footer-grid { display: grid; grid-template-columns: 2fr 1fr 1fr 1fr 2fr; gap: 40px; margin-bottom: 60px; }
        .footer-widget h4 { color: white; margin-bottom: 25px; font-size: 1.1rem; font-weight: 700; position: relative; padding-bottom: 10px; }
        .footer-widget h4::after { content: ''; position: absolute; left: 0; bottom: 0; width: 30px; height: 2px; background: var(--secondary); }
        .footer-links li { margin-bottom: 15px; }
        .footer-links a { color: var(--text-muted); transition: 0.3s; font-size: 0.95rem; }
        .footer-links a:hover { color: var(--secondary); padding-left: 8px; }

        .newsletter-form { display: flex; gap: 10px; margin-top: 20px; }
        .newsletter-form input { 
            background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); 
            padding: 12px 15px; border-radius: 8px; color: white; flex: 1; font-size: 0.9rem;
        }
        .newsletter-form button { 
            background: var(--primary); color: white; border: none; padding: 12px 20px; border-radius: 8px; cursor: pointer; transition: 0.3s;
        }

        /* Responsive */
        @@media (max-width: 992px) {
            .footer-grid { grid-template-columns: repeat(2, 1fr); }
            .nav-items { display: none; }
        }
        @@media (max-width: 576px) {
            .footer-grid { grid-template-columns: 1fr; text-align: center; }
            .section-title h2 { font-size: 2rem; }
        }
    </style>
</head>
<body>
    <!-- Top Header Bar with Global Social Icons -->
    <div class="header-top">
        <div class="container">
            <div class="header-flex">
                <div class="header-contact">
                    <span><i class="fas fa-phone-alt"></i> +91 9731615949</span>
                    <span><i class="fas fa-envelope"></i> sales@easifysolutions.com</span>
                </div>
                <div class="social-icons">
                    <a href="#" title="Facebook"><i class="fab fa-facebook-f"></i></a>
                    <a href="#" title="Instagram"><i class="fab fa-instagram"></i></a>
                    <a href="#" title="LinkedIn"><i class="fab fa-linkedin-in"></i></a>
                    <a href="#" title="WhatsApp"><i class="fab fa-whatsapp"></i></a>
                    <a href="#" title="X / Twitter"><i class="fab fa-x-twitter"></i></a>
                </div>
            </div>
        </div>
    </div>

    <nav class="main-menu">
        <div class="container">
            <div class="header-flex">
                <a href="/" class="navbar-brand">
                    <img src="/images/easyedu_full_logo_white.png" alt="Logo">
                </a>
                <div class="nav-items">
                    <a href="/" class="@(ViewContext.RouteData.Values["Action"]?.ToString() == "Index" ? "active" : "")">Home</a>
                    <a href="/Home/Products" class="@(ViewContext.RouteData.Values["Action"]?.ToString() == "Products" ? "active" : "")">Products</a>
                    <a href="/Home/Modules" class="@(ViewContext.RouteData.Values["Action"]?.ToString() == "Modules" ? "active" : "")">Modules</a>
                    <a href="/Home/Presentation" class="@(ViewContext.RouteData.Values["Action"]?.ToString() == "Presentation" ? "active" : "")">Presentation</a>
                    <a href="/Home/Pricing" class="@(ViewContext.RouteData.Values["Action"]?.ToString() == "Pricing" ? "active" : "")">Pricing</a>
                    <a href="/Home/Contact" class="@(ViewContext.RouteData.Values["Action"]?.ToString() == "Contact" ? "active" : "")">Contact Us</a>
                    @if (User.Identity != null && User.Identity.IsAuthenticated)
                    {
                        <a href="/Dashboard" class="btn-glow">DASHBOARD</a>
                    }
                    else
                    {
                        <a href="/Account/Login" class="btn-glow">CLIENT LOGIN</a>
                    }
                </div>
            </div>
        </div>
    </nav>

    <main>
        @RenderBody()
    </main>

    <footer style="background: #020617; border-top: 1px solid rgba(255,255,255,0.05); padding-top: 100px;">
        <div class="container">
            <div class="footer-grid">
                <div class="footer-widget">
                    <a href="/" class="navbar-brand" style="margin-bottom:25px; display: inline-block;">
                        <img src="/images/easyedu_full_logo_white.png" alt="Logo" style="height: 50px;">
                    </a>
                    <p style="line-height: 1.8; font-size: 0.95rem;">EasyEdu is a state-of-the-art education management platform designed to streamline administrative workflows.</p>
                </div>
                <div class="footer-widget footer-links">
                    <h4>Product</h4>
                    <ul>
                        <li><a href="/Home/Products">Features</a></li>
                        <li><a href="/Home/Pricing">Pricing</a></li>
                        <li><a href="/Home/Modules">Modules</a></li>
                    </ul>
                </div>
                <div class="footer-widget footer-links">
                    <h4>Company</h4>
                    <ul>
                        <li><a href="#">Our Story</a></li>
                        <li><a href="/Home/Contact">Contact Us</a></li>
                        <li><a href="#">Careers</a></li>
                    </ul>
                </div>
                <div class="footer-widget footer-links">
                    <h4>Support</h4>
                    <ul>
                        <li><a href="#">Help Center</a></li>
                        <li><a href="#">Privacy</a></li>
                    </ul>
                </div>
                <div class="footer-widget">
                    <h4>Newsletter</h4>
                    <div class="newsletter-form">
                        <input type="email" placeholder="Your Email">
                        <button type="submit"><i class="fas fa-paper-plane"></i></button>
                    </div>
                </div>
            </div>
            <div class="copyright d-flex flex-column flex-md-row justify-content-between align-items-center pt-5 pb-4" style="border-top: 1px solid rgba(255,255,255,0.3); gap: 20px;">
                <p class="m-0" style="font-size: 0.85rem; color: #fff; font-weight: 500;">&copy; @DateTime.Now.Year Easify Solutions. All Rights Reserved.</p>
                <div class="social-icons d-flex gap-4">
                    <a href="#" style="color: #fff;"><i class="fab fa-facebook-f"></i></a>
                    <a href="#" style="color: #fff;"><i class="fab fa-x-twitter"></i></a>
                    <a href="#" style="color: #fff;"><i class="fab fa-linkedin-in"></i></a>
                    <a href="#" style="color: #fff;"><i class="fab fa-instagram"></i></a>
                </div>
            </div>
        </div>
    </footer>

    <!-- Core Scripts -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/aos/2.3.4/aos.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>AOS.init({ duration: 1000, once: true });</script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
