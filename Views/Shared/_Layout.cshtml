    <!-- AI Content Modal -->
    <div class="modal fade" id="aiContentModal" tabindex="-1">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content border-0 rounded-16 shadow-lg overflow-hidden">
                <div class="modal-header text-white p-4" style="background: #7c3aed;">
                    <h5 class="modal-title fw-800">AI Text Generation</h5>
                    <button type="button" class="btn-close btn-close-white shadow-none" data-bs-dismiss="modal"></button>
                </div>
                <form id="aiGenerationForm">
                    <div class="modal-body p-5">
                        <div class="row g-4">
                            <div class="col-md-6">
                                <label class="form-label fw-700 text-muted small text-uppercase">LANGUAGE *</label>
                                <select name="Language" class="form-select border-light-subtle p-3 bg-light-subtle" required>
                                    <option value="English">English</option>
                                    <option value="Spanish">Spanish</option>
                                    <option value="French">French</option>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-700 text-muted small text-uppercase">TEMPLATE *</label>
                                <select name="Template" class="form-select border-light-subtle p-3 bg-light-subtle" required>
                                    <option value="">Select Template</option>
                                    <option value="ExamQuest">Exam Questions</option>
                                    <option value="StudyMaterial">Study Notes</option>
                                    <option value="Notice">Notice Template</option>
                                </select>
                            </div>
                            <div class="col-12">
                                <label class="form-label fw-700 text-muted small text-uppercase">KEYWORD *</label>
                                <input type="text" name="Keyword" class="form-control border-light-subtle p-3 bg-light-subtle" placeholder="Keyword" required>
                                <div class="small text-muted mt-1 fw-600">You can add multiple keywords use comma(,) to separate keyword</div>
                            </div>
                            <div class="col-12 text-end">
                                <button type="button" class="btn btn-link text-decoration-none text-muted fw-800 p-0" id="showAdvancedToggle">
                                    Show Advanced Options <i class="fas fa-chevron-down ms-1" style="background: #7c3aed; color: white; border-radius: 4px; padding: 2px;"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer border-0 p-5 pt-0 d-flex justify-content-center">
                        <button type="submit" class="btn btn-primary fw-900 px-5 py-3 rounded-12 shadow-sm d-flex align-items-center gap-2" style="background: #7c3aed;">
                            <i class="fas fa-robot"></i> GENERATE
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="main-content">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm rounded-12 mb-4 mx-3" role="alert">
                <i class="fas fa-check-circle me-2"></i> @TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm rounded-12 mb-4 mx-3" role="alert">
                <i class="fas fa-exclamation-circle me-2"></i> @TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @RenderBody()
    </div>

    <style>
        :root {
            --sidebar-width: 280px;
            --topbar-height: 50px;
        }

        .sidebar,
        .sidebar-premium,
        .sidebar.sidebar-premium { 
            width: var(--sidebar-width); 
            height: 100vh; 
            height: 100dvh; 
            position: fixed; 
            left: 0; 
            top: 0;
            bottom: 0;
            z-index: 1000; 
            overflow-y: auto;
            overflow-x: hidden;
            background: var(--sidebar-bg, #12403E) !important; 
            box-shadow: 4px 0 24px rgba(0, 0, 0, 0.25);
            scrollbar-width: thin;
            scrollbar-color: rgba(255,255,255,0.15) transparent;
            padding-bottom: 56px;
            border-right: 1px solid rgba(255, 255, 255, 0.18);
            transition: transform 0.35s cubic-bezier(0.4, 0, 0.2, 1);
        }



        /* ===== Sidebar Fully Hidden State ===== */
        .sidebar.sidebar-hidden {
            transform: translateX(-100%);
            box-shadow: none;
        }

        /* When sidebar hidden, topbar + content go full width */
        body.sidebar-hidden-body .topbar {
            left: 0 !important;
        }
        body.sidebar-hidden-body .main-content {
            margin-left: 0 !important;
            width: 100% !important;
        }

        /* Sidebar footer collapse button - fixed at bottom of sidebar */
        .sidebar-footer-collapse {
            position: fixed;
            bottom: 0;
            left: 0;
            width: var(--sidebar-width);
            background: rgba(0,0,0,0.25);
            backdrop-filter: blur(6px);
            border-top: 1px solid rgba(255,255,255,0.12);
            z-index: 1001;
            transition: transform 0.35s cubic-bezier(0.4, 0, 0.2, 1);
        }
        /* Footer hides when sidebar is hidden */
        body.sidebar-hidden-body .sidebar-footer-collapse {
            transform: translateX(-100%);
        }
        .sidebar-hide-btn {
            width: 100%;
            background: transparent;
            border: none;
            color: rgba(255,255,255,0.7);
            padding: 12px 20px;
            display: flex;
            align-items: center;
            gap: 10px;
            cursor: pointer;
            font-size: 0.82rem;
            font-weight: 600;
            letter-spacing: 0.3px;
            transition: all 0.2s ease;
        }
        .sidebar-hide-btn:hover {
            background: rgba(124,58,237,0.25);
            color: #fff;
        }
        .sidebar-hide-btn i {
            font-size: 1rem;
            transition: transform 0.3s ease;
        }
        .sidebar-hide-btn:hover i {
            transform: translateX(-3px);
        }

        /* Floating show-sidebar tab */
        .sidebar-show-tab {
            position: fixed;
            left: 0;
            top: 50%;
            transform: translateY(-50%) translateX(-100%);
            width: 28px;
            height: 64px;
            background: var(--sidebar-bg, #12403E);
            color: rgba(255,255,255,0.9);
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            z-index: 1050;
            border-radius: 0 10px 10px 0;
            box-shadow: 4px 0 16px rgba(0,0,0,0.25);
            font-size: 0.85rem;
            transition: all 0.35s cubic-bezier(0.4, 0, 0.2, 1);
            opacity: 0;
            pointer-events: none;
        }
        .sidebar-show-tab.visible {
            transform: translateY(-50%) translateX(0);
            opacity: 1;
            pointer-events: all;
        }
        .sidebar-show-tab:hover {
            background: #7c3aed;
            width: 36px;
            box-shadow: 4px 0 20px rgba(124,58,237,0.45);
        }



        .sub-menu {
            list-style: none;
            padding-left: 0;
            margin: 0;
            position: relative;
        }

        .sub-menu::before {
            content: '';
            position: absolute;
            left: 25px;
            top: 0;
            bottom: 0;
