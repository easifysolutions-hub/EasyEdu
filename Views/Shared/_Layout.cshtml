@using Microsoft.Extensions.Localization
@using EasyEdu.Resources
@inject IStringLocalizer<SharedResource> L
@using Microsoft.AspNetCore.Localization
@{
    var requestCulture = Context.Features.Get<IRequestCultureFeature>();
    var currentCulture = requestCulture?.RequestCulture.UICulture.TwoLetterISOLanguageName ?? "en";
    var langMap = new Dictionary<string, string> { {"en","en"},{"hi","hi"},{"kn","kn"},{"ta","ta"},{"te","te"} };
    var htmlLang = langMap.ContainsKey(currentCulture) ? langMap[currentCulture] : "en";
}
<!DOCTYPE html>
<html lang="@htmlLang">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - EasyEdu Premium</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <!-- Indian Language Fonts for multilingual support -->
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Devanagari:wght@400;600;700&family=Noto+Sans+Kannada:wght@400;600;700&family=Noto+Sans+Tamil:wght@400;600;700&family=Noto+Sans+Telugu:wght@400;600;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">
    <script>
        // Init appearance early to avoid FOUC
        (function() {
            var theme = localStorage.getItem('themeMode') || 'light';
            var sidebarColor = localStorage.getItem('sidebarColor');
            if (theme === 'dark') {
                document.documentElement.setAttribute('data-theme', 'dark');
            }
            if (sidebarColor) {
                document.documentElement.style.setProperty('--sidebar-bg', sidebarColor);
            }
        })();
    </script>
</head>
<body class="animate-fade-in">
    <!-- Global Education Background -->
    <div class="fixed-global-bg">
        <div class="bg-overlay"></div>
        <!-- Animated Education Tools -->
        <div class="edu-background">
            <div class="floating-tool" style="top: 15%; left: 5%; animation-duration: 25s;"><i class="fas fa-graduation-cap"></i></div>
            <div class="floating-tool" style="top: 25%; left: 95%; animation-duration: 30s;"><i class="fas fa-book"></i></div>
            <div class="floating-tool" style="top: 50%; left: 8%; animation-duration: 20s;"><i class="fas fa-pencil-alt"></i></div>
            <div class="floating-tool" style="top: 80%; left: 92%; animation-duration: 35s;"><i class="fas fa-flask"></i></div>
            <div class="floating-tool" style="top: 40%; left: 88%; animation-duration: 28s;"><i class="fas fa-calculator"></i></div>
            <div class="floating-tool" style="top: 70%; left: 15%; animation-duration: 32s;"><i class="fas fa-atom"></i></div>
            <div class="floating-tool" style="top: 10%; left: 80%; animation-duration: 22s;"><i class="fas fa-globe"></i></div>
            <div class="floating-tool" style="top: 20%; left: 50%; animation-duration: 40s;"><i class="fas fa-microscope"></i></div>
        </div>
    </div>

    <style>
        /* --- Fixed Animated Background --- */
        .fixed-global-bg {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: -2;
            background-image: url('https://images.unsplash.com/photo-1523050853064-85a19f042717?q=80&w=2000&auto=format&fit=crop');
            background-size: cover;
            background-position: center;
        }

        .bg-overlay {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: linear-gradient(135deg, rgba(255, 255, 255, 0.95) 0%, rgba(204, 251, 241, 0.9) 100%);
            z-index: -1;
        }

        .edu-background {
            position: absolute;
            width: 100%;
            height: 100%;
            pointer-events: none;
        }

        .floating-tool {
            position: absolute;
            font-size: 4rem;
            color: rgba(139, 92, 246, 0.12); /* Light Purple */
            animation: moveAround 25s infinite linear;
        }

        @@keyframes moveAround {
            0% { transform: translate(0, 0) rotate(0deg); opacity: 0; }
            50% { opacity: 1; }
            100% { transform: translate(100px, -100px) rotate(360deg); opacity: 0; }
        }
    </style>
