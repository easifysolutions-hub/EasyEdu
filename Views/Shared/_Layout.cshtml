        .search-bar-modern input::placeholder {
            color: #94a3b8;
        }

        .topbar-icons {
            display: flex;
            gap: 12px;
        }

        .topbar-icon {
            position: relative;
            width: 38px;
            height: 38px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #f8f9fa;
            border-radius: 10px;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .topbar-icon:hover {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            transform: translateY(-2px);
        }

        .topbar-icon:hover i {
            color: white;
        }

        .topbar-icon i {
            font-size: 1.1rem;
            color: #64748b;
            transition: all 0.3s ease;
        }

        .notification-badge {
            position: absolute;
            top: -4px;
            right: -4px;
            background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);
            color: white;
            font-size: 0.65rem;
            font-weight: 700;
            padding: 2px 6px;
            border-radius: 10px;
            border: 2px solid white;
            animation: pulse-badge 2s infinite;
        }

        @@keyframes pulse-badge {
            0%, 100% { transform: scale(1); }
            50% { transform: scale(1.1); }
        }

        .btn-premium-blue {
            background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%);
            color: white !important;
            border: none;
            transition: all 0.3s ease;
        }
        .btn-premium-blue:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(37, 99, 235, 0.3);
            background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%);
        }
        
        .user-profile-compact {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 6px 12px 6px 6px;
            background: #f8f9fa;
            border-radius: 25px;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .user-profile-compact:hover {
            background: #e9ecef;
            box-shadow: 0 2px 8px rgba(0,0,0,0.08);
        }

        .user-avatar-modern {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            background: linear-gradient(135deg, #8b5cf6 0%, #f472b6 100%);
            color: white;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            font-size: 0.85rem;
            box-shadow: 0 2px 8px rgba(139, 92, 246, 0.3);
        }

        .btn-premium-purple {
            background: linear-gradient(135deg, #7c3aed 0%, #8b5cf6 100%);
            color: white !important;
            border: none;
            transition: all 0.3s ease;
        }
        .btn-premium-purple:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(124, 58, 237, 0.3);
            background: linear-gradient(135deg, #6d28d9 0%, #7c3aed 100%);
        }

        .user-info {
            display: flex;
            flex-direction: column;
            line-height: 1.2;
        }

        .user-name {
            font-size: 0.85rem;
            font-weight: 700;
            color: #1e293b;
        }

        .user-role {
            font-size: 0.7rem;
            font-weight: 600;
            color: #64748b;
        }
        
        .main-content { 
            margin-left: var(--sidebar-width); 
            padding-top: calc(var(--topbar-height) + 5px); 
            padding-left: 15px;
            padding-right: 15px;
            padding-bottom: 30px;
            background: transparent !important;
            min-height: calc(100vh - var(--topbar-height));
            width: calc(100% - var(--sidebar-width));
            transition: margin-left 0.3s cubic-bezier(0.4, 0, 0.2, 1), width 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }

        /* Main content shifts when sidebar is collapsed */
        body.sidebar-collapsed-body .main-content {
            margin-left: var(--sidebar-collapsed-width);
            width: calc(100% - var(--sidebar-collapsed-width));
        }
        body.sidebar-collapsed-body .topbar {
            left: var(--sidebar-collapsed-width);
        }

        .card, .table-responsive {
            background: rgba(255, 255, 255, 0.4);
            backdrop-filter: blur(8px);
            border: 1px solid rgba(255, 255, 255, 0.3) !important;
            border-radius: 20px !important;
            box-shadow: 0 8px 32px 0 rgba(139, 92, 246, 0.05) !important;
        }

        /* Comprehensive Mobile Responsiveness */
        @@media (max-width: 1200px) {
            :root { --sidebar-width: 0px; }
            .sidebar { transform: translateX(-100%); transition: transform 0.3s ease; }
            .sidebar.show { transform: translateX(0); width: 280px; box-shadow: 20px 0 50px rgba(0,0,0,0.1); }
            .topbar { left: 0; width: 100%; padding: 0 15px; }
            .main-content { margin-left: 0; width: 100%; padding: 15px; }
            .social-topbar { display: none !important; }
            .sidebar-minimize-btn { display: none; }
        }

        @@media (max-width: 768px) {
            .topbar { height: 60px !important; padding: 0 15px !important; flex-wrap: nowrap !important; }
            .topbar .d-flex.align-items-center.gap-4 { width: auto !important; margin-top: 0 !important; }
            .search-bar-modern { display: none; }
            .user-info { display: none !important; }
            .toggle-btn { margin-right: 10px !important; width: 35px !important; height: 35px !important; }
            .btn-premium-blue { font-size: 0.65rem !important; padding: 5px 8px !important; }
        }

        @@media (max-width: 480px) {
            .btn-premium-blue span { display: none; }
            .btn-premium-blue::after { content: 'Finance'; }
