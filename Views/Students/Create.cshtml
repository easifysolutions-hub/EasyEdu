@model EasyEdu.Models.ViewModels.StudentAdmissionViewModel
@{
    ViewData["Title"] = "Student Admission";
    Layout = "_Layout";
}

<div class="content-wrapper p-4">
    <div class="card border-0 shadow-lg rounded-16 overflow-hidden">
        <div class="card-header bg-white border-bottom border-light p-4">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h4 class="fw-800 text-dark m-0">Student Admission</h4>
                    <p class="text-muted small mb-0 mt-1">Enroll a new student into the system with comprehensive details.</p>
                </div>
                <div class="status-badge">
                    <span class="badge bg-primary bg-opacity-10 text-primary fw-700 px-3 py-2 rounded-pill">
                        <i class="fas fa-user-plus me-1"></i> New Admission
                    </span>
                </div>
            </div>
        </div>

        <form asp-action="Create" method="post" enctype="multipart/form-data" class="needs-validation">
            <div class="card-body p-0">
                <!-- Tab Navigation -->
                <ul class="nav nav-tabs nav-fill border-0 bg-light-subtle admission-tabs" id="admissionTabs" role="tablist">
                    <li class="nav-item">
                        <a class="nav-link active" id="general-tab" data-bs-toggle="tab" href="#general" role="tab">
                            <i class="fas fa-info-circle me-2"></i>General Info
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" id="parent-tab" data-bs-toggle="tab" href="#parent" role="tab">
                            <i class="fas fa-users me-2"></i>Parents & Guardian
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" id="transport-tab" data-bs-toggle="tab" href="#transport" role="tab">
                            <i class="fas fa-bus me-2"></i>Transport & Dorm
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" id="document-tab" data-bs-toggle="tab" href="#document" role="tab">
                            <i class="fas fa-file-invoice me-2"></i>Bank & ID
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" id="others-tab" data-bs-toggle="tab" href="#others" role="tab">
                            <i class="fas fa-ellipsis-h me-2"></i>Others
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" id="custom-fields-tab" data-bs-toggle="tab" href="#custom_fields_tab_content" role="tab">
                            <i class="fas fa-edit me-2"></i>Custom Fields
                        </a>
                    </li>
                </ul>

                <div class="tab-content p-4 pt-5" id="admissionTabsContent">
                    <!-- General Info Tab -->
                    <div class="tab-pane fade show active" id="general" role="tabpanel">
                        <div class="row g-4">
                            <div class="col-md-3">
                                <div class="admission-photo-upload text-center p-4 border rounded-12 bg-light">
                                    <label class="form-label fw-700 text-muted small text-uppercase d-block mb-3">Student Photo</label>
                                    <div class="avatar-preview mb-3">
                                        <img id="student_photo_preview" src="https://ui-avatars.com/api/?name=S&background=e2e8f0&color=94a3b8&size=200" class="rounded-pill shadow-sm" style="width: 150px; height: 150px; object-fit: cover; border: 4px solid white;" />
                                    </div>
                                    <input type="file" asp-for="StudentPhoto" class="form-control form-control-sm" accept="image/*" onchange="previewImage(this, 'student_photo_preview')">
                                    <div class="form-text small mt-2">Max 2MB. Format: JPG, PNG.</div>
                                </div>
                            </div>
                            <div class="col-md-9">
                                <div class="row g-3">
                                    <div class="col-md-4">
                                        <label class="form-label fw-600">Admission No *</label>
                                        <input asp-for="AdmissionNumber" class="form-control border-light-subtle shadow-none" readonly />
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label fw-600">Roll Number</label>
                                        <input asp-for="RollNumber" class="form-control border-light-subtle shadow-none" placeholder="e.g. 101" />
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label fw-600">Admission Date *</label>
                                        <input asp-for="AdmissionDate" type="date" class="form-control border-light-subtle shadow-none" />
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label fw-600">Class *</label>
                                        <select asp-for="ClassId" id="adm_class" class="form-select border-light-subtle shadow-none" asp-items="ViewBag.Classes" required>
                                            <option value="">Select Class</option>
                                        </select>
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label fw-600">Section *</label>
                                        <select asp-for="SectionId" id="adm_section" class="form-select border-light-subtle shadow-none" required>
                                            <option value="">Select Class First</option>
                                        </select>
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label fw-600">Category</label>
                                        <select asp-for="StudentCategoryId" class="form-select border-light-subtle shadow-none" asp-items="ViewBag.Categories">
                                            <option value="">Select Category</option>
                                        </select>
                                    </div>
                                    <div class="col-md-6 mt-4">
                                        <label class="form-label fw-600">First Name *</label>
                                        <input asp-for="FirstName" class="form-control border-light-subtle shadow-none" required />
                                    </div>
                                    <div class="col-md-6 mt-4">
                                        <label class="form-label fw-600">Last Name *</label>
                                        <input asp-for="LastName" class="form-control border-light-subtle shadow-none" required />
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label fw-600">Date of Birth *</label>
                                        <input asp-for="DateOfBirth" type="date" class="form-control border-light-subtle shadow-none" required />
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label fw-600">Gender *</label>
                                        <select asp-for="Gender" class="form-select border-light-subtle shadow-none" required>
                                            <option value="">Select Gender</option>
                                            <option value="Male">Male</option>
                                            <option value="Female">Female</option>
                                            <option value="Other">Other</option>
                                        </select>
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label fw-600">Blood Group</label>
                                        <select asp-for="BloodGroup" class="form-select border-light-subtle shadow-none">
                                            <option value="">Select</option>
                                            <option value="A+">A+</option>
                                            <option value="A-">A-</option>
                                            <option value="B+">B+</option>
                                            <option value="B-">B-</option>
                                            <option value="O+">O+</option>
                                            <option value="O-">O-</option>
                                            <option value="AB+">AB+</option>
                                            <option value="AB-">AB-</option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Parents Info Tab -->
                    <div class="tab-pane fade" id="parent" role="tabpanel">
                        <div class="row g-4">
                            <!-- Father -->
                            <div class="col-md-6 border-end border-light">
                                <h6 class="fw-800 text-primary border-bottom pb-2 mb-4">Father's Information</h6>
                                <div class="row g-3">
                                    <div class="col-md-8">
                                        <div class="mb-3">
                                            <label class="form-label fw-600">Father's Name</label>
                                            <input asp-for="FatherName" class="form-control border-light-subtle shadow-none" />
                                        </div>
                                        <div class="mb-3">
                                            <label class="form-label fw-600">Occupation</label>
                                            <input asp-for="FatherOccupation" class="form-control border-light-subtle shadow-none" />
                                        </div>
                                        <div class="mb-3">
                                            <label class="form-label fw-600">Phone</label>
                                            <input asp-for="FatherPhone" class="form-control border-light-subtle shadow-none" />
                                        </div>
                                    </div>
                                    <div class="col-md-4 text-center">
                                        <div class="avatar-preview mb-2">
                                            <img id="father_photo_preview" src="https://ui-avatars.com/api/?name=F&background=f1f5f9&color=64748b" class="rounded shadow-sm" style="width: 100px; height: 100px; object-fit: cover;" />
                                        </div>
                                        <input type="file" asp-for="FatherPhotoFile" class="form-control form-control-sm" onchange="previewImage(this, 'father_photo_preview')">
                                    </div>
                                </div>
                            </div>
                            <!-- Mother -->
                            <div class="col-md-6">
                                <h6 class="fw-800 text-pink-500 border-bottom pb-2 mb-4" style="color: #ed64a6;">Mother's Information</h6>
                                <div class="row g-3">
                                    <div class="col-md-8">
                                        <div class="mb-3">
                                            <label class="form-label fw-600">Mother's Name</label>
                                            <input asp-for="MotherName" class="form-control border-light-subtle shadow-none" />
                                        </div>
                                        <div class="mb-3">
                                            <label class="form-label fw-600">Occupation</label>
                                            <input asp-for="MotherOccupation" class="form-control border-light-subtle shadow-none" />
                                        </div>
                                        <div class="mb-3">
                                            <label class="form-label fw-600">Phone</label>
                                            <input asp-for="MotherPhone" class="form-control border-light-subtle shadow-none" />
                                        </div>
                                    </div>
                                    <div class="col-md-4 text-center">
                                        <div class="avatar-preview mb-2">
                                            <img id="mother_photo_preview" src="https://ui-avatars.com/api/?name=M&background=f1f5f9&color=64748b" class="rounded shadow-sm" style="width: 100px; height: 100px; object-fit: cover;" />
                                        </div>
                                        <input type="file" asp-for="MotherPhotoFile" class="form-control form-control-sm" onchange="previewImage(this, 'mother_photo_preview')">
                                    </div>
                                </div>
                            </div>
                            <!-- Guardian -->
                            <div class="col-12 mt-4 pt-4 border-top border-light">
                                <div class="d-flex align-items-center mb-4">
                                     <h6 class="fw-800 text-dark me-4 mb-0">Guardian's Information</h6>
                                     <div class="d-flex gap-3">
                                         <div class="form-check">
                                             <input class="form-check-input" type="radio" name="GuardianIs" id="g_father" value="Father" checked onchange="toggleGuardian(this.value)">
                                             <label class="form-check-label fw-600 small" for="g_father">Father</label>
                                         </div>
                                         <div class="form-check">
                                             <input class="form-check-input" type="radio" name="GuardianIs" id="g_mother" value="Mother" onchange="toggleGuardian(this.value)">
                                             <label class="form-check-label fw-600 small" for="g_mother">Mother</label>
                                         </div>
                                         <div class="form-check">
                                             <input class="form-check-input" type="radio" name="GuardianIs" id="g_other" value="Other" onchange="toggleGuardian(this.value)">
                                             <label class="form-check-label fw-600 small" for="g_other">Other</label>
                                         </div>
                                     </div>
                                </div>
                                <div id="guardian_details" class="row g-3">
                                    <div class="col-md-3">
                                        <label class="form-label fw-600">Guardian Name *</label>
                                        <input asp-for="GuardianName" id="gv_name" class="form-control border-light-subtle shadow-none" required />
                                    </div>
                                    <div class="col-md-3">
                                        <label class="form-label fw-600">Relation</label>
                                        <input asp-for="GuardianRelation" id="gv_relation" class="form-control border-light-subtle shadow-none" />
                                    </div>
                                    <div class="col-md-3">
                                        <label class="form-label fw-600">Guardian Phone *</label>
                                        <input asp-for="GuardianPhone" id="gv_phone" class="form-control border-light-subtle shadow-none" required />
                                    </div>
                                    <div class="col-md-3">
                                        <label class="form-label fw-600">Guardian Email</label>
                                        <input asp-for="GuardianEmail" id="gv_email" class="form-control border-light-subtle shadow-none" />
                                    </div>
                                    <div class="col-md-12">
                                        <label class="form-label fw-600">Guardian Address</label>
                                        <textarea asp-for="GuardianAddress" rows="2" class="form-control border-light-subtle shadow-none" placeholder="Enter complete address..."></textarea>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Transport/Dorm Tab -->
                    <div class="tab-pane fade" id="transport" role="tabpanel">
                        <div class="row g-4 d-flex align-items-stretch">
                            <div class="col-md-6">
                                <div class="card bg-light border-0 rounded-12 h-100">
                                    <div class="card-body p-4">
                                        <h6 class="fw-800 mb-3"><i class="fas fa-bus-alt text-warning me-2"></i> Transport Details</h6>
                                        <div class="mb-3">
                                            <label class="form-label fw-600">Route</label>
                                            <select asp-for="RouteId" class="form-select border-0 shadow-none" asp-items="ViewBag.Routes">
                                                <option value="">Select Route</option>
                                            </select>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="card bg-light border-0 rounded-12 h-100">
                                    <div class="card-body p-4">
                                        <h6 class="fw-800 mb-3"><i class="fas fa-hotel text-info me-2"></i> Dormitory Details</h6>
                                        <div class="mb-3">
                                            <label class="form-label fw-600">Dormitory</label>
                                            <select asp-for="DormitoryId" class="form-select border-0 shadow-none">
                                                <option value="">Select Dormitory</option>
                                            </select>
                                        </div>
                                        <div class="mb-3">
                                            <label class="form-label fw-600">Room Number</label>
                                            <select asp-for="RoomId" class="form-select border-0 shadow-none">
                                                <option value="">Select Room</option>
                                            </select>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Document Tab -->
                    <div class="tab-pane fade" id="document" role="tabpanel">
                        <div class="row g-4">
                            <div class="col-md-6">
                                <h6 class="fw-800 mb-3 border-bottom pb-2">National ID & Documents</h6>
                                <div class="mb-3">
                                    <label class="form-label fw-600">National ID Number</label>
                                    <input asp-for="NationalIdNumber" class="form-control border-light-subtle shadow-none" />
                                </div>
                                <div class="mb-3">
                                    <label class="form-label fw-600">Birth Certificate Number</label>
                                    <input asp-for="BirthCertificateNumber" class="form-control border-light-subtle shadow-none" />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <h6 class="fw-800 mb-3 border-bottom pb-2">Bank Details</h6>
                                <div class="mb-3">
                                    <label class="form-label fw-600">Bank Name</label>
                                    <input asp-for="BankName" class="form-control border-light-subtle shadow-none" />
                                </div>
                                <div class="row g-3">
                                    <div class="col-md-6">
                                        <label class="form-label fw-600">Account Number</label>
                                        <input asp-for="BankAccountNumber" class="form-control border-light-subtle shadow-none" />
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label fw-600">IFSC Code / Branch Code</label>
                                        <input asp-for="BankIfscCode" class="form-control border-light-subtle shadow-none" />
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Others Tab -->
                    <div class="tab-pane fade" id="others" role="tabpanel">
                        <div class="row g-4">
                            <div class="col-md-6">
                                <label class="form-label fw-600">Previous School Details</label>
                                <textarea asp-for="PreviousSchoolDetails" rows="4" class="form-control border-light-subtle shadow-none" placeholder="School Name, Class, Year, Marks..."></textarea>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-600">Additional Notes</label>
                                <textarea asp-for="AdditionalNotes" rows="4" class="form-control border-light-subtle shadow-none" placeholder="Any other remarks..."></textarea>
                            </div>
                        </div>
                    </div>

                    <!-- Custom Fields Tab -->
                    <div class="tab-pane fade" id="custom_fields_tab_content" role="tabpanel">
                        <div class="row g-4">
                            @{
                                var customFields = ViewBag.CustomFields as List<EasyEdu.Models.CustomField> ?? new List<EasyEdu.Models.CustomField>();
                            }
                            @if (!customFields.Any())
                            {
                                <div class="col-12 text-center py-5">
                                    <div class="opacity-10 mb-2"><i class="fas fa-edit fa-3x"></i></div>
                                    <p class="text-muted fw-600">No custom data points defined for this entity.</p>
                                    <a href="@Url.Action("Index", "CustomFields")" class="btn btn-sm btn-light-soft fw-800">DRIVE CUSTOMIZATION</a>
                                </div>
                            }
                            @foreach (var field in customFields)
                            {
                                <div class="col-md-6">
                                    <label class="form-label fw-600 text-uppercase @(field.IsRequired ? "text-danger" : "")">
                                        @field.FieldName @(field.IsRequired ? "*" : "")
                                    </label>
                                    
                                    @if (field.FieldType == "Select")
                                    {
                                        <select name="CustomField_@field.Id" class="form-select border-light-subtle shadow-none" @(field.IsRequired ? "required" : "")>
                                            <option value="">Select @field.FieldName</option>
                                            @if (!string.IsNullOrEmpty(field.Options))
                                            {
                                                @foreach (var option in field.Options.Split(','))
                                                {
                                                    <option value="@option.Trim()">@option.Trim()</option>
                                                }
                                            }
                                        </select>
                                    }
                                    else if (field.FieldType == "Date")
                                    {
                                        <input type="date" name="CustomField_@field.Id" class="form-control border-light-subtle shadow-none" @(field.IsRequired ? "required" : "") />
                                    }
                                    else if (field.FieldType == "Number")
                                    {
                                        <input type="number" name="CustomField_@field.Id" class="form-control border-light-subtle shadow-none" @(field.IsRequired ? "required" : "") />
                                    }
                                    else
                                    {
                                        <input type="text" name="CustomField_@field.Id" class="form-control border-light-subtle shadow-none" @(field.IsRequired ? "required" : "") />
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <div class="card-footer bg-light border-top border-light p-4 d-flex justify-content-between align-items-center">
                <div class="text-muted small">
                    <i class="fas fa-info-circle me-1 text-primary"></i> Fields marked with * are mandatory across all tabs.
                </div>
                <div class="d-flex gap-3">
                    <button type="reset" class="btn btn-light fw-700 px-4">Reset Form</button>
                    <button type="submit" class="btn btn-primary fw-800 px-5 shadow-sm">
                        <i class="fas fa-user-check me-2"></i> Save Admission
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>

<style>
    .rounded-16 { border-radius: 16px !important; }
    .admission-tabs .nav-link {
        padding: 1.25rem;
        color: #64748b;
        font-weight: 700;
        border: none;
        border-bottom: 3px solid transparent;
        transition: all 0.3s ease;
        font-size: 0.9rem;
    }
    .admission-tabs .nav-link.active {
        color: #7c3aed;
        background: white !important;
        border-bottom: 3px solid #7c3aed;
    }
    .admission-tabs .nav-link:hover:not(.active) {
        color: #1e293b;
        background: #f1f5f9;
        border-bottom: 3px solid #e2e8f0;
    }
    .form-control:focus, .form-select:focus {
        border-color: #7c3aed !important;
        background: #fafafa;
    }
    .avatar-preview {
        background: #fff;
        display: inline-block;
        border: 1px solid #e2e8f0;
        padding: 4px;
        border-radius: 50%;
    }
</style>

@section Scripts {
    <script>
        $(document).ready(function() {
            console.log("Student Admission Script Loaded");

            // Image Preview
            window.previewImage = function(input, previewId) {
                if (input.files && input.files[0]) {
                    var reader = new FileReader();
                    reader.onload = function (e) {
                        $('#' + previewId).attr('src', e.target.result);
                    }
                    reader.readAsDataURL(input.files[0]);
                }
            };

            // Guardian Switcher
            window.toggleGuardian = function(val) {
                if (val === 'Father') {
                    $('#gv_name').val($('#FatherName').val());
                    $('#gv_phone').val($('#FatherPhone').val());
                    $('#gv_relation').val('Father');
                    $('#GuardianOccupation').val($('#FatherOccupation').val()); 
                } else if (val === 'Mother') {
                    $('#gv_name').val($('#MotherName').val());
                    $('#gv_phone').val($('#MotherPhone').val());
                    $('#gv_relation').val('Mother');
                    $('#GuardianOccupation').val($('#MotherOccupation').val());
                } else {
                    $('#gv_name, #gv_phone, #gv_relation, #GuardianOccupation').val('');
                }
            };

            // Section Dropdown Logic
            $('#adm_class').on('change', function() {
                var classId = $(this).val();
                console.log("Class Changed to: " + classId);
                
                var $sec = $('#adm_section');
                
                if (classId) {
                    $sec.prop('disabled', true).html('<option>Loading sections...</option>');
                    
                    $.get('/Students/GetSections?classId=' + classId)
                        .done(function(data) {
                            console.log("Sections loaded:", data);
                            $sec.empty().append('<option value="">Select Section</option>');
                            
                            if (data.length === 0) {
                                $sec.append('<option disabled>No Sections Found</option>');
                                Swal.fire({
                                    icon: 'warning',
                                    title: 'No Sections',
                                    text: 'No active sections found for this class. Please assign sections in the Class Master.',
                                });
                            } else {
                                $.each(data, function(i, item) {
                                    $sec.append($('<option>', { 
                                        value: item.id,
                                        text : item.name 
                                    }));
                                });
                            }
                        })
                        .fail(function(jqXHR, textStatus, errorThrown) {
                            console.error("AJAX Error:", textStatus, errorThrown);
                            $sec.html('<option>Error loading sections</option>');
                        })
                        .always(function() {
                            $sec.prop('disabled', false);
                        });
                } else {
                    $sec.html('<option value="">Select Class First</option>');
                }
            });

            // Trigger change if value exists (e.g. after validation error)
            if ($('#adm_class').val()) {
                $('#adm_class').trigger('change');
            }
        });
    </script>
}
