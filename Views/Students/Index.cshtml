@model IEnumerable<EasyEdu.Models.Student>
@{
    ViewData["Title"] = "Student List";
    Layout = "_Layout";
}

<div class="content-wrapper p-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-800 text-dark m-0">Student List</h4>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 small text-uppercase fw-700">
                    <li class="breadcrumb-item"><a href="/" class="text-decoration-none text-primary">Dashboard</a></li>
                    <li class="breadcrumb-item"><a href="#" class="text-decoration-none text-muted">Student Info</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Student List</li>
                </ol>
            </nav>
        </div>
        <a asp-action="Create" class="btn btn-primary fw-800 shadow-sm px-4">
            <i class="fas fa-plus me-2"></i> Add Student
        </a>
    </div>

    <!-- Select Criteria -->
    <div class="card border-0 shadow-sm rounded-12 mb-4 overflow-hidden">
        <div class="card-header bg-white border-bottom border-light py-3">
             <h6 class="fw-800 text-dark m-0"><i class="fas fa-filter text-primary me-2"></i> Select Criteria</h6>
        </div>
        <div class="card-body p-4 bg-light-subtle">
            <form asp-action="Index" method="get" class="row g-3">
                <div class="col-md-3">
                    <label class="form-label fw-700 text-muted small text-uppercase">Class</label>
                    <select name="classId" id="filter_class" class="form-select border-0 shadow-sm" asp-items="ViewBag.Classes">
                        <option value="">Select Class</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label fw-700 text-muted small text-uppercase">Section</label>
                    <select name="sectionId" id="filter_section" class="form-select border-0 shadow-sm" asp-items="ViewBag.Sections">
                        <option value="">Select Section</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-700 text-muted small text-uppercase">Search By Name</label>
                    <div class="input-group shadow-sm rounded-8 overflow-hidden">
                        <span class="input-group-text border-0 bg-white"><i class="fas fa-user text-muted small"></i></span>
                        <input type="text" name="searchString" class="form-control border-0" placeholder="Student Name..." value="@ViewContext.HttpContext.Request.Query["searchString"]">
                    </div>
                </div>
                <div class="col-md-2">
                    <label class="form-label fw-700 text-muted small text-uppercase">Search By Roll</label>
                    <input type="text" name="rollNo" class="form-control border-0 shadow-sm" placeholder="Roll No..." value="@ViewContext.HttpContext.Request.Query["rollNo"]">
                </div>
                <div class="col-md-2 d-flex align-items-end">
                    <button type="submit" class="btn btn-primary w-100 fw-800 shadow-sm p-2">
                        <i class="fas fa-search me-1"></i> Search
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Student List Table -->
    <div class="card border-0 shadow-sm rounded-12 overflow-hidden">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light-subtle text-muted small text-uppercase">
                        <tr>
                            <th class="px-4 py-3 fw-800">Admission No</th>
                            <th class="py-3 fw-800">Name</th>
                            <th class="py-3 fw-800">Father Name</th>
                            <th class="py-3 fw-800">Date Of Birth</th>
                            <th class="py-3 fw-800">Class (Sec)</th>
                            <th class="py-3 fw-800">Gender</th>
                            <th class="py-3 fw-800">Category</th>
                            <th class="py-3 fw-800">Phone</th>
                            <th class="text-end px-4 py-3 fw-800">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td class="px-4 fw-700 text-primary small">#@item.AdmissionNumber</td>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <div class="rounded-circle bg-primary bg-opacity-10 text-primary fw-800 me-2 d-flex align-items-center justify-content-center" style="width: 32px; height: 32px; font-size: 0.75rem;">
                                                @if (!string.IsNullOrEmpty(item.ProfilePicture))
                                                {
                                                    <img src="@item.ProfilePicture" class="rounded-circle w-100 h-100" style="object-fit: cover;" />
                                                }
                                                else
                                                {
                                                    @(item.FirstName.Substring(0, 1) + item.LastName.Substring(0, 1))
                                                }
                                            </div>
                                            <span class="fw-800 text-dark">@item.FirstName @item.LastName</span>
                                        </div>
                                    </td>
                                    <td class="fw-600 text-muted small">@item.FatherName</td>
                                    <td class="fw-600 text-muted small">@item.DateOfBirth.ToString("dd MMM, yyyy")</td>
                                    <td>
                                        <span class="badge bg-light text-primary border fw-800 px-3 py-1">
                                            @(item.Class?.Name ?? "N/A")(@(item.Section?.Name ?? "N/A"))
                                        </span>
                                    </td>
                                    <td class="fw-700 text-muted small text-uppercase">@item.Gender</td>
                                    <td>
                                        <span class="text-primary fw-700 small">@(item.StudentCategory?.Name ?? "Normal")</span>
                                    </td>
                                    <td>
                                        <a href="tel:@item.Phone" class="text-decoration-none text-muted fw-600 small"><i class="fas fa-phone-alt me-1 text-primary-light"></i> @item.Phone</a>
                                    </td>
                                    <td class="text-end px-4">
                                        <div class="dropdown">
                                            <button class="btn btn-sm btn-light border-0 dropdown-toggle px-3 py-1 fw-700 shadow-none text-muted" type="button" data-bs-toggle="dropdown">
                                                Select
                                            </button>
                                            <ul class="dropdown-menu dropdown-menu-end border-0 shadow-lg p-2 rounded-12">
                                                <li><a class="dropdown-item py-2 px-3 fw-600 rounded-8" href="@Url.Action("Details", new { id = item.Id })"><i class="fas fa-eye text-primary me-2"></i> View Profile</a></li>
                                                <li><a class="dropdown-item py-2 px-3 fw-600 rounded-8" href="@Url.Action("Edit", new { id = item.Id })"><i class="fas fa-edit text-success me-2"></i> Edit Details</a></li>
                                                <li><hr class="dropdown-divider"></li>
                                                <li><a class="dropdown-item py-2 px-3 fw-600 rounded-8 text-danger" href="#"><i class="fas fa-user-slash me-2"></i> Disable Account</a></li>
                                            </ul>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="9" class="text-center py-5">
                                    <div class="py-5">
                                        <i class="fas fa-graduation-cap fa-4x text-light mb-3"></i>
                                        <h5 class="text-muted fw-800">No Student Records Found</h5>
                                        <p class="text-muted small">Try adjusting your filters or search criteria.</p>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        <div class="card-footer bg-white border-0 py-3 px-4 d-flex justify-content-between align-items-center">
            <span class="text-muted small fw-700">Displaying @Model.Count() Scholastic Records</span>
            <div class="pagination-area">
                <!-- Pagination can be added here -->
            </div>
        </div>
    </div>
</div>

<style>
    .rounded-12 { border-radius: 12px !important; }
    .rounded-8 { border-radius: 8px !important; }
    .bg-light-subtle { background-color: #f8fafc !important; }
    .text-primary-light { color: #8b5cf6 !important; }
    .dropdown-item:hover {
        background-color: #f1f5f9;
        color: #7c3aed !important;
    }
    .btn-light { background: #f1f5f9; }
    .btn-light:hover { background: #e2e8f0; }
</style>

@section Scripts {
    <script>
        document.getElementById('filter_class').addEventListener('change', function() {
            var classId = this.value;
            var ddlSection = document.getElementById('filter_section');
            ddlSection.innerHTML = '<option value="">Loading...</option>';
            
            if(classId) {
                fetch('/Students/GetSections?classId=' + classId)
                    .then(response => response.json())
                    .then(data => {
                        ddlSection.innerHTML = '<option value="">Select Section</option>';
                        data.forEach(item => {
                            var option = document.createElement('option');
                            option.value = item.id;
                            option.textContent = item.name;
                            ddlSection.appendChild(option);
                        });
                    });
            } else {
                ddlSection.innerHTML = '<option value="">Select Section</option>';
            }
        });
    </script>
}
