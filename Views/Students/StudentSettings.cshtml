@model EasyEdu.Models.StudentSettings
@{
    ViewData["Title"] = "Student Settings";
    Layout = "_Layout";
}

<div class="content-wrapper p-4 animate-fade-in">
    <h3 class="page-title mb-4">Student Module Settings</h3>

    <div class="row g-4">
        <div class="col-xl-6">
            <div class="premium-card">
                <div class="card-header bg-white border-0 p-4">
                    <h5 class="fw-800 text-dark m-0">General Configuration</h5>
                </div>
                <div class="card-body p-4 pt-0">
                    <form asp-action="UpdateSettings" method="post">
                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="CompanyId" />

                        <div class="mb-4">
                            <label class="form-check-label d-flex align-items-center justify-content-between p-3 rounded-12 border bg-light-subtle cursor-pointer">
                                <div>
                                    <div class="fw-800 text-dark">Auto Admission Number</div>
                                    <div class="small text-muted">Generate unique ID automatically</div>
                                </div>
                                <div class="form-check form-switch m-0">
                                    <input class="form-check-input" type="checkbox" asp-for="RegistrationNumberAutoGenerate">
                                </div>
                            </label>
                        </div>

                        <div class="row mb-4">
                            <div class="col-md-6">
                                <label class="form-label small fw-700 text-uppercase">ID Prefix</label>
                                <input type="text" asp-for="RegistrationNumberPrefix" class="form-control-premium w-100">
                            </div>
                            <div class="col-md-6 d-flex align-items-end">
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" asp-for="RollNoAutoGenerate">
                                    <label class="form-check-label small fw-700 text-uppercase">Auto Roll No</label>
                                </div>
                            </div>
                        </div>

                        <hr class="my-4">

                        <h6 class="fw-800 text-dark small text-uppercase mb-3">Feature Toggles</h6>
                        <div class="mb-3">
                            <div class="form-check form-switch mb-2">
                                <input class="form-check-input" type="checkbox" asp-for="AdmissionDateMandatory">
                                <label class="form-check-label fw-600">Admission Date Mandatory</label>
                            </div>
                            <div class="form-check form-switch mb-2">
                                <input class="form-check-input" type="checkbox" asp-for="ShowSiblingInfo">
                                <label class="form-check-label fw-600">Allow Sibling Assignment</label>
                            </div>
                            <div class="form-check form-switch mb-2">
                                <input class="form-check-input" type="checkbox" asp-for="MultipleClassStudent">
                                <label class="form-check-label fw-600">Enable Multi-Class Enrollment</label>
                            </div>
                            <div class="form-check form-switch mb-2">
                                <input class="form-check-input" type="checkbox" asp-for="EnableBiometricAttendance">
                                <label class="form-check-label fw-600">Biometric Attendance Sync</label>
                            </div>
                            <div class="form-check form-switch mb-2">
                                <input class="form-check-input" type="checkbox" asp-for="SubjectWiseAttendance">
                                <label class="form-check-label fw-600">Subject Wise Attendance</label>
                            </div>
                        </div>

                        <h6 class="fw-800 text-dark small text-uppercase mb-3 mt-4">Notifications</h6>
                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <div class="p-2 border rounded">
                                    <div class="form-check form-switch">
                                        <input class="form-check-input" type="checkbox" asp-for="EnableSmsNotification">
                                        <label class="form-check-label fw-600">SMS Alerts</label>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="p-2 border rounded">
                                    <div class="form-check form-switch">
                                        <input class="form-check-input" type="checkbox" asp-for="EnableEmailNotification">
                                        <label class="form-check-label fw-600">Email Alerts</label>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <h6 class="fw-800 text-dark small text-uppercase mb-3">SMS Sending Times</h6>
                        <div class="row mb-5">
                            <div class="col-md-6">
                                <label class="form-label small">Morning (Absent)</label>
                                <input type="time" asp-for="MorningSmsTime" class="form-control-premium w-100">
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small">Evening (Summary)</label>
                                <input type="time" asp-for="EveningSmsTime" class="form-control-premium w-100">
                            </div>
                        </div>

                        <button type="submit" class="btn btn-premium-primary w-100 shadow">SAVE SETTINGS</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
