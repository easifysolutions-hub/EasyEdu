@model IEnumerable<EasyEdu.Models.Student>
@{
    ViewData["Title"] = "Student Export";
    Layout = "_Layout";
}

<div class="content-wrapper p-4 animate-fade-in">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="page-title mb-1">Student Export</h3>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0">
                    <li class="breadcrumb-item"><a href="@Url.Action("Index", "Students")" class="text-decoration-none">Students</a></li>
                    <li class="breadcrumb-item active">Export</li>
                </ol>
            </nav>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-premium-success btn-sm rounded-8" onclick="exportTable('xlsx')">
                <i class="fas fa-file-excel me-2"></i>EXCEL
            </button>
            <button class="btn btn-premium-primary btn-sm rounded-8" onclick="exportTable('csv')">
                <i class="fas fa-file-csv me-2"></i>CSV
            </button>
        </div>
    </div>

    <!-- Filter Section -->
    <div class="card border-0 shadow-sm rounded-12 mb-4 overflow-hidden">
        <div class="card-header bg-white border-bottom border-light py-3">
             <h6 class="fw-800 text-dark m-0"><i class="fas fa-filter text-primary me-2"></i> Select Criteria</h6>
        </div>
        <div class="card-body p-4 bg-light-subtle">
            <form asp-action="StudentExport" method="get" class="row g-3">
                <div class="col-md-5">
                    <label class="form-label fw-700 text-muted small text-uppercase">Class</label>
                    <select name="classId" id="filter_class" class="form-select border-0 shadow-sm p-2" asp-items="ViewBag.Classes">
                        <option value="">Select Class</option>
                    </select>
                </div>
                <div class="col-md-5">
                    <label class="form-label fw-700 text-muted small text-uppercase">Section</label>
                    <select name="sectionId" id="filter_section" class="form-select border-0 shadow-sm p-2" asp-items="ViewBag.Sections">
                        <option value="">Select Section</option>
                    </select>
                </div>
                <div class="col-md-2 d-flex align-items-end">
                    <button type="submit" class="btn btn-premium-primary w-100 fw-800 shadow-sm p-2">
                        <i class="fas fa-search me-1"></i> Filter
                    </button>
                </div>
            </form>
        </div>
    </div>

    <div class="premium-card">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table premium-table mb-0" id="exportTable">
                    <thead>
                        <tr>
                            <th>Adm No</th>
                            <th>Roll</th>
                            <th>Name</th>
                            <th>Class (Section)</th>
                            <th>Father Name</th>
                            <th>Date of Birth</th>
                            <th>Gender</th>
                            <th>Mobile</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            @foreach (var s in Model)
                            {
                                <tr>
                                    <td class="fw-800 text-primary">@s.AdmissionNumber</td>
                                    <td class="fw-700">@s.RollNumber</td>
                                    <td class="fw-700">@s.FirstName @s.LastName</td>
                                    <td>@(s.Class?.Name) (@(s.Section?.Name))</td>
                                    <td>@s.FatherName</td>
                                    <td>@s.DateOfBirth.ToString("dd MMM yyyy")</td>
                                    <td>@s.Gender</td>
                                    <td>@s.Phone</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8" class="text-center py-5">
                                    <div class="py-5 text-muted">
                                        <i class="fas fa-users-slash fa-4x mb-3 text-light"></i>
                                        <h5 class="fw-800">No Student Records Found</h5>
                                        <p class="small">Try adjusting your filters or add active students to this class/section.</p>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        document.getElementById('filter_class').addEventListener('change', function() {
            var classId = this.value;
            var ddlSection = document.getElementById('filter_section');
            ddlSection.innerHTML = '<option value="">Loading...</option>';
            
            if(classId) {
                fetch('/Students/GetSections?classId=' + classId)
                    .then(response => response.json())
                    .then(data => {
                        ddlSection.innerHTML = '<option value="">Select Section</option>';
                        data.forEach(item => {
                            var option = document.createElement('option');
                            option.value = item.id;
                            option.textContent = item.name;
                            ddlSection.appendChild(option);
                        });
                    });
            } else {
                ddlSection.innerHTML = '<option value="">Select Section</option>';
            }
        });
    });

    function exportTable(type) {
        var classId = document.getElementById('filter_class').value || '';
        var sectionId = document.getElementById('filter_section').value || '';
        window.location.href = '@Url.Action("ExportData", "Students")?format=' + type + '&classId=' + classId + '&sectionId=' + sectionId;
    }
</script>
