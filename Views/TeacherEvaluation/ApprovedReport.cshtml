@model IEnumerable<EasyEdu.Models.TeacherEvaluation>
@{
    ViewData["Title"] = "Approved Evaluations";
    Layout = "_Layout";
}

<div class="page-header d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="page-title animate-slide-in">Performance Archive</h1>
        <p class="text-muted fw-600">Verified institutional faculty appraisals and rankings</p>
    </div>
</div>

<div class="premium-card bg-white shadow-xl border-0 overflow-hidden">
    <div class="table-responsive">
        <table class="table premium-table mb-0">
            <thead>
                <tr>
                    <th class="ps-4">FACULTY_MEMBER</th>
                    <th>COMPLETION_DATE</th>
                    <th>PERFORMANCE_INDEX</th>
                    <th>REMARKS</th>
                    <th class="text-end pe-4">STATUS</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var e in Model)
                {
                    <tr>
                        <td class="ps-4">
                            <div class="d-flex align-items-center">
                                <div class="avatar-sm bg-success-soft text-success rounded-circle me-3 d-flex align-items-center justify-content-center fw-900" style="width: 40px; height: 40px;">
                                    @e.Teacher.FirstName[0]
                                </div>
                                <div>
                                    <div class="fw-800 text-dark">@e.Teacher.FullName</div>
                                    <div class="small text-muted fw-600">@e.Teacher.EmployeeNumber</div>
                                </div>
                            </div>
                        </td>
                        <td class="fw-700 text-muted">@e.EvaluationDate.ToString("MMM dd, yyyy")</td>
                        <td>
                            <div class="d-flex align-items-center">
                                <span class="fw-900 text-success me-2">@e.TotalRating.ToString("F1")</span>
                                <div class="progress w-100px" style="height: 6px; width: 100px;">
                                    <div class="progress-bar bg-success" style="width: @(e.TotalRating * 20)%"></div>
                                </div>
                            </div>
                        </td>
                        <td class="small fw-600 text-muted">@e.Remarks</td>
                        <td class="text-end pe-4">
                            <span class="badge badge-success-premium"><i class="fas fa-certificate me-1"></i> VERIFIED</span>
                            <button class="btn btn-sm btn-light-soft ms-2"><i class="fas fa-print"></i></button>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="5" class="text-center py-5 text-muted fw-600">No archived performance reports available.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<style>
    .bg-success-soft { background: rgba(25, 135, 84, 0.1); }
</style>
