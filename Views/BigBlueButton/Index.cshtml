@model EasyEdu.Controllers.BBBDashboardViewModel
@{
    ViewData["Title"] = "BBB Collaborative Hub";
    Layout = "_Layout";
}

<div class="content-wrapper p-4 animate-fade-in text-dark">
    <div class="d-flex justify-content-between align-items-center mb-5">
        <div>
            <h2 class="fw-900 text-dark mb-1">Collaborative Architect (BBB)</h2>
            <p class="text-muted small fw-600">Unified command center for BigBlueButton virtual spaces & institutional gatherings</p>
        </div>
        <div class="d-flex gap-3">
             <a href="@Url.Action("VirtualClass")" class="btn btn-cobalt px-4 py-2 rounded-12 shadow-sm fw-900">
                <i class="fas fa-plus-circle me-2"></i>CREATE SPACE
            </a>
            <a href="@Url.Action("Settings")" class="btn btn-light-soft px-4 py-2 rounded-12 fw-700">
                <i class="fas fa-cog me-2"></i>SERVER CONFIG
            </a>
        </div>
    </div>

    <!-- Stats Matrix -->
    <div class="row g-4 mb-5">
        <div class="col-md-3">
            <div class="stat-card p-4 rounded-24 bg-white shadow-sm border-0 border-start border-4 border-primary">
                <div class="d-flex align-items-center mb-3">
                    <div class="icon-box bg-light text-primary me-3">
                        <i class="fas fa-chalkboard-teacher fa-lg"></i>
                    </div>
                    <div>
                        <p class="text-uppercase smallest fw-900 text-muted m-0">Virtual Spaces</p>
                        <h3 class="fw-900 m-0 text-dark">@ViewBag.ClassCount</h3>
                    </div>
                </div>
                <div class="progress" style="height: 6px;">
                    <div class="progress-bar bg-primary" style="width: 75%"></div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stat-card p-4 rounded-24 bg-white shadow-sm border-0 border-start border-4 border-info">
                <div class="d-flex align-items-center mb-3">
                    <div class="icon-box bg-light text-info me-3">
                        <i class="fas fa-handshake fa-lg"></i>
                    </div>
                    <div>
                        <p class="text-uppercase smallest fw-900 text-muted m-0">Summits</p>
                        <h3 class="fw-900 m-0 text-dark">@ViewBag.MeetingCount</h3>
                    </div>
                </div>
                 <div class="progress" style="height: 6px;">
                    <div class="progress-bar bg-info" style="width: 50%"></div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
             <div class="stat-card p-4 rounded-24 bg-white shadow-sm border-0 border-start border-4 border-warning">
                <div class="d-flex align-items-center mb-3">
                    <div class="icon-box bg-light text-warning me-3">
                        <i class="fas fa-record-vinyl fa-lg"></i>
                    </div>
                    <div>
                        <p class="text-uppercase smallest fw-900 text-muted m-0">Recordings</p>
                        <h3 class="fw-900 m-0 text-dark">@ViewBag.RecordCount</h3>
                    </div>
                </div>
                <div class="progress" style="height: 6px;">
                    <div class="progress-bar bg-warning" style="width: 25%"></div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stat-card p-4 rounded-24 bg-gradient-cobalt text-white shadow-lg border-0">
                <p class="text-uppercase smallest fw-900 opacity-75 mb-4">BBB Infrastructure</p>
                <div class="d-flex justify-content-between align-items-end">
                    <h3 class="fw-900 m-0">SYNCED</h3>
                    <i class="fas fa-server fa-2x opacity-50"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <!-- Upcoming Classes -->
        <div class="col-xl-8">
            <div class="premium-card p-0 overflow-hidden border-0 shadow-lg" style="border-radius: 24px;">
                <div class="card-header bg-white border-bottom p-4 d-flex justify-content-between align-items-center">
                    <h5 class="fw-900 text-dark m-0"><i class="fas fa-graduation-cap me-2 text-primary opacity-50"></i>Academic Queue</h5>
                    <a href="@Url.Action("VirtualClass")" class="smallest fw-900 text-uppercase ls-1 text-primary">All Sessions</a>
                </div>
                <div class="card-body p-0">
                    <table class="table premium-table mb-0 align-middle">
                        <tbody class="bg-white">
                            @foreach (var cls in Model.RecentClasses)
                            {
                                <tr>
                                    <td class="ps-4">
                                        <div class="fw-900 text-dark">@cls.Topic</div>
                                        <div class="smallest text-muted fw-700 uppercase">SUBJECT: @cls.Subject?.Name</div>
                                    </td>
                                    <td>
                                        <div class="small fw-800 text-dark">@cls.Date.ToString("dd MMM")</div>
                                        <div class="smallest text-muted fw-700">@cls.StartTime</div>
                                    </td>
                                    <td>
                                        <span class="badge @(cls.Status == "Live" ? "bg-info" : "bg-light text-dark") px-3 rounded-pill fw-900 shadow-sm border small">@cls.Status.ToUpper()</span>
                                    </td>
                                    <td class="pe-4 text-end">
                                        <button class="btn btn-sm btn-cobalt rounded-pill px-3 fw-900">ENTER SPACE</button>
                                    </td>
                                </tr>
                            }
                            @if(!Model.RecentClasses.Any()){
                                <tr><td colspan="4" class="text-center py-5 text-muted fw-700 opacity-50 italic">Zero active class queues detected.</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="col-xl-4">
             <div class="premium-card p-5 border-0 shadow-lg bg-light-soft text-center h-100" style="border-radius: 24px;">
                <h6 class="fw-900 text-dark mb-4 ls-1 uppercase opacity-50 italic">Quick Commands</h6>
                <div class="d-grid gap-3">
                    <a href="@Url.Action("VirtualMeeting")" class="btn btn-white shadow-sm border-0 py-3 rounded-16 fw-900 text-dark">
                        <i class="fas fa-users-cog me-2 text-info"></i>STAFF SUMMIT
                    </a>
                    <a href="@Url.Action("ClassRecordList")" class="btn btn-white shadow-sm border-0 py-3 rounded-16 fw-900 text-dark">
                        <i class="fas fa-play-circle me-2 text-warning"></i>ARCHIVE ACCESS
                    </a>
                    <a href="@Url.Action("ClassReports")" class="btn btn-white shadow-sm border-0 py-3 rounded-16 fw-900 text-dark">
                        <i class="fas fa-chart-line me-2 text-primary"></i>USAGE ANALYTICS
                    </a>
                </div>
             </div>
        </div>
    </div>
</div>

<style>
    .rounded-24 { border-radius: 24px; }
    .rounded-16 { border-radius: 16px; }
    .ls-1 { letter-spacing: 1px; }
    .icon-box { width: 45px; height: 45px; display: flex; align-items: center; justify-content: center; border-radius: 14px; }
    .bg-gradient-cobalt { background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%); }
    .btn-cobalt { background: #1e40af; color: white; border: none; }
    .bg-light-soft { background: #f8fafc; }
</style>
