@model IEnumerable<EasyEdu.Models.BBBVirtualClass>
@{
    ViewData["Title"] = "BBB Virtual Classroom";
    Layout = "_Layout";
}

<div class="content-wrapper p-4 animate-fade-in text-dark">
    <div class="d-flex justify-content-between align-items-center mb-5">
        <div>
            <h2 class="fw-900 text-dark mb-1">Academic Space Architect</h2>
            <p class="text-muted small fw-600">Design and automate collaborative learning via BigBlueButton infrastructure</p>
        </div>
        <button class="btn btn-cobalt px-4 py-2 rounded-12 shadow-sm fw-900" data-bs-toggle="modal" data-bs-target="#createClassModal">
            <i class="fas fa-plus-circle me-2"></i>INITIALIZE SPACE
        </button>
    </div>

    <div class="premium-card p-0 overflow-hidden border-0 shadow-lg" style="border-radius: 24px;">
        <table class="table premium-table mb-0 align-middle">
            <thead class="bg-premium-dark text-white">
                <tr>
                    <th class="ps-5 py-4 fw-900 small text-uppercase">SPACE IDENTIFIER</th>
                    <th class="py-4 fw-900 small text-uppercase">ACADEMIC LOCATION</th>
                    <th class="py-4 fw-900 small text-uppercase">TEMPORAL SLOT</th>
                    <th class="py-4 fw-900 small text-uppercase">SYNCHRONIZATION</th>
                    <th class="pe-5 py-4 text-end fw-900 small text-uppercase">ACTIONS</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var cls in Model)
                {
                    <tr>
                        <td class="ps-5 py-4">
                            <span class="fw-900 text-dark h6 mb-1 d-block">@cls.Topic</span>
                            <span class="smallest text-muted fw-700">BBB ID: @cls.MeetingId | Mod: @cls.ModeratorPassword</span>
                        </td>
                        <td class="py-4">
                            <div class="fw-800 text-primary small">@cls.Subject?.Name</div>
                            <div class="smallest text-muted fw-700">@cls.Class?.Name - @cls.Section?.Name</div>
                        </td>
                         <td class="py-4">
                            <div class="fw-900 text-dark">@cls.Date.ToString("dd MMM yyyy")</div>
                            <div class="smallest text-muted fw-700">@cls.StartTime | @cls.DurationMinutes MINS</div>
                        </td>
                        <td class="py-4">
                            <span class="badge @(cls.Status == "Live" ? "bg-info" : "bg-light text-dark") px-3 rounded-pill fw-900 shadow-sm border small">@cls.Status.ToUpper()</span>
                        </td>
                        <td class="pe-5 text-end py-4">
                             <div class="d-flex justify-content-end gap-2">
                                <button class="btn btn-sm btn-cobalt rounded-8 px-3 fw-900 shadow-sm">INITIATE SPACE</button>
                                @if(cls.Status == "Pending"){
                                    <button class="btn btn-icon btn-light-soft rounded-circle shadow-sm"><i class="fas fa-edit text-primary"></i></button>
                                    <button class="btn btn-icon btn-light-soft rounded-circle shadow-sm"><i class="fas fa-trash text-danger"></i></button>
                                }
                            </div>
                        </td>
                    </tr>
                }
                @if(!Model.Any()){
                    <tr><td colspan="5" class="text-center py-5 text-muted fw-700 italic opacity-50">Zero academic spaces detected in repository.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Modal -->
<div class="modal fade animate-slide-up" id="createClassModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow-lg rounded-24">
            <form asp-action="SaveVirtualClass" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header border-0 bg-premium-dark text-white p-4">
                    <h5 class="fw-900 m-0"><i class="fas fa-chalkboard-teacher me-2"></i>ESTABLISH COLLABORATIVE SPACE</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-5">
                    <div class="mb-4">
                        <label class="form-label small fw-800 text-uppercase opacity-50">Space Identification / Topic*</label>
                        <input name="Topic" required class="form-control form-control-premium" placeholder="e.g. Thermodynamics - Live Experiment">
                    </div>
                    
                    <div class="row g-4 mb-4">
                        <div class="col-md-4">
                            <label class="form-label small fw-800 text-uppercase opacity-50">Target Class</label>
                            <select name="ClassId" class="form-select form-control-premium" required>
                                <option value="">Select Academic Class</option>
                                @foreach (var c in (List<EasyEdu.Models.Class>)ViewBag.Classes) { <option value="@c.Id">@c.Name</option> }
                            </select>
                        </div>
                        <div class="col-md-4">
                             <label class="form-label small fw-800 text-uppercase opacity-50">Curriculum Subject</label>
                             <select name="SubjectId" class="form-select form-control-premium" required>
                                <option value="">Select Subject</option>
                                @foreach (var sub in (List<EasyEdu.Models.Subject>)ViewBag.Subjects) { <option value="@sub.Id">@sub.Name</option> }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-800 text-uppercase opacity-50">Record Session</label>
                            <select name="Record" class="form-select form-control-premium">
                                <option value="true">Enable Auto-Record</option>
                                <option value="false">Live Broadcast Only</option>
                            </select>
                        </div>
                    </div>

                    <div class="row g-4">
                        <div class="col-md-6">
                            <label class="form-label small fw-800 text-uppercase opacity-50">Execution Date</label>
                            <input name="Date" type="date" required value="@DateTime.Now.ToString("yyyy-MM-dd")" class="form-control form-control-premium">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-800 text-uppercase opacity-50">Temporal Start Time</label>
                            <input name="StartTime" type="time" required class="form-control form-control-premium">
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0 p-4 pt-0">
                    <button type="submit" class="btn btn-cobalt w-100 py-3 rounded-12 shadow-lg fw-900 h6 mb-0">
                        <i class="fas fa-check-circle me-2"></i>INITIALIZE SPACE DATA
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<style>
    .bg-premium-dark { background: #0f172a; }
    .rounded-24 { border-radius: 24px; }
    .btn-cobalt { background: #1e40af; color: white; border: none; }
</style>
