@model EasyEdu.Models.BBBSetting
@{
    ViewData["Title"] = "BBB Infrastructure Nexus";
    Layout = "_Layout";
}

<div class="content-wrapper p-4 animate-fade-in text-dark">
    <div class="d-flex justify-content-between align-items-center mb-5">
        <div>
            <h2 class="fw-900 text-dark mb-1">Collaborative Infrastructure Architect</h2>
            <p class="text-muted small fw-600">Authenticate and synchronize institutional BigBlueButton server credentials</p>
        </div>
        <div class="d-flex gap-2">
            <a href="@Url.Action("Index")" class="btn btn-light-soft px-4 py-2 rounded-12 shadow-sm fw-700">
                <i class="fas fa-arrow-left me-2"></i>DASHBOARD
            </a>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success border-0 shadow-sm rounded-16 mb-4 animate-slide-up">
            <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
        </div>
    }

    <div class="row g-4 justify-content-center">
        <div class="col-xl-8">
            <form asp-action="SaveSettings" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="CompanyId" />

                <div class="premium-card p-5 mb-4 border-0 shadow-lg" style="border-radius: 24px;">
                    <div class="d-flex align-items-center mb-5 border-bottom pb-4 justify-content-between">
                         <div class="d-flex align-items-center">
                            <div class="bg-primary bg-opacity-10 p-3 rounded-circle me-3">
                                <i class="fas fa-server text-primary fa-lg"></i>
                            </div>
                            <div>
                                <h4 class="fw-900 text-dark mb-0">BBB API Gateway Sync</h4>
                                <p class="smallest text-muted fw-700 uppercase opacity-50 italic">Synchronize with institutional collaborative node</p>
                            </div>
                         </div>
                         <div class="form-check form-switch p-0 d-flex align-items-center">
                            <label class="small fw-900 text-uppercase opacity-75 m-0 me-3">Infrastructure Service</label>
                            <input class="form-check-input ms-0" type="checkbox" asp-for="IsEnabled" style="width: 45px; height: 22px;">
                        </div>
                    </div>

                    <div class="mb-5">
                        <label class="form-label small fw-800 text-uppercase opacity-50">BigBlueButton Server Base URL*</label>
                        <input asp-for="BaseUrl" required class="form-control form-control-premium" placeholder="https://bbb.institutional-nexus.com/bigbluebutton/">
                        <div class="smallest text-muted fw-700 mt-2 italic px-1">Ensure trailing slash '/' is included in the endpoint architecture.</div>
                    </div>

                    <div class="mb-5">
                        <label class="form-label small fw-800 text-uppercase opacity-50">Infrastructure Shared Secret (SALT)*</label>
                        <input asp-for="SecretKey" required class="form-control form-control-premium" type="password" placeholder="••••••••••••••••••••••••••••">
                        <div class="smallest text-muted fw-700 mt-2 italic px-1">This key grants root access to collaborative spaces; keep it secure.</div>
                    </div>
                </div>

                <div class="premium-card p-4 bg-premium-dark d-flex justify-content-between align-items-center shadow-lg" style="border-radius: 20px;">
                    <div class="d-flex align-items-center">
                        <i class="fas fa-shield-alt text-info me-3 fa-lg shadow-sm"></i>
                        <p class="text-white opacity-50 m-0 small fw-700">Configurations are encrypted within the institutional vault.</p>
                    </div>
                    <button type="submit" class="btn btn-cobalt px-5 py-3 rounded-12 shadow-lg fw-900 h6 mb-0 text-white">
                        <i class="fas fa-sync-alt me-2 text-info"></i>SYNCHRONIZE INFRASTRUCTURE
                    </button>
                </div>
            </form>
        </div>

        <div class="col-xl-4">
             <div class="premium-card p-5 border-0 shadow-lg bg-light-soft text-center h-100" style="border-radius: 24px;">
                 <h5 class="fw-900 text-dark mb-4 ls-1 uppercase italic opacity-50">Integration Workflow</h5>
                 <div class="vertical-steps text-start">
                     <div class="step-item d-flex gap-3 mb-4">
                         <div class="step-dot bg-primary">1</div>
                         <div class="step-content small fw-700 text-dark">Locate your SALT/Secret via <code>bbb-conf --secret</code></div>
                     </div>
                      <div class="step-item d-flex gap-3 mb-4">
                         <div class="step-dot bg-primary">2</div>
                         <div class="step-content small fw-700 text-dark">Initialize endpoint URL and Security Salt in this nexus.</div>
                     </div>
                      <div class="step-item d-flex gap-3">
                         <div class="step-dot bg-primary">3</div>
                         <div class="step-content small fw-700 text-dark">Verify bi-directional handshakes via Dashboard.</div>
                     </div>
                 </div>
                 <hr class="my-5 opacity-10">
                 <p class="smallest text-muted fw-700 uppercase ls-1">Security Audit: OPTIMAL</p>
             </div>
        </div>
    </div>
</div>

<style>
    .bg-premium-dark { background: #0f172a; }
    .bg-light-soft { background: #f8fafc; }
    .rounded-24 { border-radius: 24px; }
    .rounded-16 { border-radius: 16px; }
    .btn-cobalt { background: linear-gradient(135deg, #1e40af 0%, #1e3a8a 100%); border: none; }
    .step-dot { width: 25px; height: 25px; border-radius: 50%; color: white; display: flex; align-items: center; justify-content: center; flex-shrink: 0; font-size: 11px; font-weight: 900; }
    .ls-1 { letter-spacing: 1px; }
</style>
