@{
    ViewData["Title"] = "LMS Intelligence Hub";
    Layout = "_Layout";
}

<div class="content-wrapper p-4 animate-fade-in text-dark">
    <div class="d-flex justify-content-between align-items-center mb-5">
        <div>
            <h2 class="fw-900 text-dark mb-1">LMS Intelligence Hub</h2>
            <p class="text-muted small fw-600">Coordinate digital curriculum deployment, student progression, and institutional revenue</p>
        </div>
        <div class="d-flex gap-3">
             <a href="@Url.Action("AddCourse")" class="btn btn-premium-purple px-4 py-2 rounded-12 shadow-sm fw-900">
                <i class="fas fa-plus me-2"></i>DEPLOY NEW COURSE
            </a>
            <a href="@Url.Action("Settings")" class="btn btn-light-soft px-4 py-2 rounded-12 fw-700">
                <i class="fas fa-cogs me-2"></i>INFRASTRUCTURE
            </a>
        </div>
    </div>

    <!-- Stats Matrix -->
    <div class="row g-4 mb-5">
        <div class="col-md-4">
            <div class="premium-card p-5 border-0 shadow-lg bg-primary bg-opacity-10 text-center" style="border-radius: 24px;">
                <div class="bg-primary p-3 rounded-circle d-inline-block mb-3 shadow-sm"><i class="fas fa-graduation-cap text-white fa-2x"></i></div>
                <h6 class="smallest text-primary fw-900 text-uppercase mb-2">Total Published Courses</h6>
                <h1 class="fw-900 text-dark m-0">@ViewBag.CourseCount</h1>
                <p class="smallest text-muted fw-700 m-0 mt-2 italic">Active curriculum nodes</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="premium-card p-5 border-0 shadow-lg bg-success bg-opacity-10 text-center" style="border-radius: 24px;">
                <div class="bg-success p-3 rounded-circle d-inline-block mb-3 shadow-sm"><i class="fas fa-users text-white fa-2x"></i></div>
                <h6 class="smallest text-success fw-900 text-uppercase mb-2">Global Enrollments</h6>
                <h1 class="fw-900 text-dark m-0">@ViewBag.EnrollmentCount</h1>
                <p class="smallest text-muted fw-700 m-0 mt-2 italic">Student engagement reach</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="premium-card p-5 border-0 shadow-lg bg-info bg-opacity-10 text-center" style="border-radius: 24px;">
                <div class="bg-info p-3 rounded-circle d-inline-block mb-3 shadow-sm"><i class="fas fa-wallet text-white fa-2x"></i></div>
                <h6 class="smallest text-info fw-900 text-uppercase mb-2">LMS Ecosystem Revenue</h6>
                <h1 class="fw-900 text-dark m-0">$@ViewBag.TotalRevenue.ToString("N2")</h1>
                <p class="smallest text-muted fw-700 m-0 mt-2 italic">Institutional fiscal growth</p>
            </div>
        </div>
    </div>

    <!-- Navigation Hub -->
    <div class="row g-4">
        <div class="col-md-6 col-lg-3">
            <a href="@Url.Action("AllCourses")" class="nav-hub-card">
                <i class="fas fa-book-open mb-3 fa-2x"></i>
                <h6 class="fw-900">Curriculum Registry</h6>
            </a>
        </div>
        <div class="col-md-6 col-lg-3">
            <a href="@Url.Action("CategoryList")" class="nav-hub-card">
                <i class="fas fa-tags mb-3 fa-2x"></i>
                <h6 class="fw-900">Domain Classification</h6>
            </a>
        </div>
        <div class="col-md-6 col-lg-3">
            <a href="@Url.Action("EnrollmentHistory")" class="nav-hub-card">
                <i class="fas fa-history mb-3 fa-2x"></i>
                <h6 class="fw-900">Progression Log</h6>
            </a>
        </div>
        <div class="col-md-6 col-lg-3">
            <a href="@Url.Action("PurchaseLog")" class="nav-hub-card">
                <i class="fas fa-file-invoice-dollar mb-3 fa-2x"></i>
                <h6 class="fw-900">E-Commerce Intel</h6>
            </a>
        </div>
    </div>
</div>

<style>
    .nav-hub-card {
        display: block;
        padding: 40px;
        background: white;
        border-radius: 20px;
        text-align: center;
        text-decoration: none;
        color: #1e293b;
        transition: all 0.3s ease;
        border: 1px solid rgba(0,0,0,0.05);
        box-shadow: 0 10px 15px -3px rgba(0,0,0,0.1);
    }
    .nav-hub-card:hover {
        transform: translateY(-10px);
        background: #8b5cf6;
        color: white;
    }
    .btn-premium-purple { background: #8b5cf6; color: white; border: none; }
</style>
