@{
    ViewData["Title"] = "Native Live Streaming";
    Layout = "_Layout";
}
<div class="page-header px-4 mb-4 animate-slide-in">
    <h1 class="page-title"><i class="fas fa-tower-broadcast me-2 text-premium-purple"></i> In-App Live</h1>
    <p class="text-muted fw-600">RTMP optimized native streaming engine</p>
</div>
<div class="container-fluid px-4">
    <div class="premium-card bg-white shadow-xl border-0 rounded-24 p-5 text-center">
        <i class="fas fa-satellite-dish fa-4x text-premium-purple opacity-25 mb-4"></i>
        <h3 class="fw-900">Broadcast Terminal Ready</h3>
        <p class="text-muted">Stream directly into student portals without external apps.</p>
        <button class="btn btn-premium-purple rounded-pill px-5 py-3 mt-4 fw-800 shadow-lg">GO LIVE NOW</button>
    </div>
</div>
<style>.btn-premium-purple { background: linear-gradient(135deg, #6366f1 0%, #a855f7 100%); color: white; border: none; }</style>
