@using System.Security.Claims
@{
    ViewData["Title"] = "Student Dashboard";
    Layout = "_Layout";
}

<div class="content-wrapper p-4 animate-up">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="page-title mb-1">Welcome Back, @(User.FindFirst("FullName")?.Value ?? User.Identity?.Name)!</h3>
            <p class="text-muted small fw-600">Your academic journey at a glance.</p>
        </div>
        <div class="d-flex gap-2">
            <span class="badge bg-primary-soft text-primary px-3 py-2 rounded-pill fw-800">CLASS: 10-A</span>
            <span class="badge bg-success-soft text-success px-3 py-2 rounded-pill fw-800">STATUS: ACTIVE</span>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-xl-3 col-md-6">
            <div class="premium-card p-4 text-center">
                <div class="card-icon-box mx-auto mb-3" style="background: rgba(139, 92, 246, 0.1); color: #8b5cf6;">
                    <i class="fas fa-calendar-check"></i>
                </div>
                <h3 class="fw-800 m-0">94%</h3>
                <p class="text-muted small fw-700 text-uppercase mb-0">Attendance</p>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="premium-card p-4 text-center">
                <div class="card-icon-box mx-auto mb-3" style="background: rgba(244, 114, 182, 0.1); color: #f472b6;">
                    <i class="fas fa-book"></i>
                </div>
                <h3 class="fw-800 m-0">8</h3>
                <p class="text-muted small fw-700 text-uppercase mb-0">Subjects</p>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="premium-card p-4 text-center">
                <div class="card-icon-box mx-auto mb-3" style="background: rgba(34, 197, 94, 0.1); color: #22c55e;">
                    <i class="fas fa-star"></i>
                </div>
                <h3 class="fw-800 m-0">3.8</h3>
                <p class="text-muted small fw-700 text-uppercase mb-0">Current GPA</p>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="premium-card p-4 text-center">
                <div class="card-icon-box mx-auto mb-3" style="background: rgba(59, 130, 246, 0.1); color: #3b82f6;">
                    <i class="fas fa-tasks"></i>
                </div>
                <h3 class="fw-800 m-0">4</h3>
                <p class="text-muted small fw-700 text-uppercase mb-0">Pending Tasks</p>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-xl-8">
            <div class="premium-card mb-4">
                <div class="p-4 border-bottom border-light d-flex justify-content-between align-items-center">
                    <h5 class="fw-800 m-0">Today's Schedule</h5>
                    <button class="btn btn-sm btn-light-soft rounded-pill px-3 fw-700">View Full Routine</button>
                </div>
                <div class="p-0">
                    <div class="table-responsive">
                        <table class="table premium-table mb-0">
                            <thead>
                                <tr>
                                    <th class="px-4">TIME</th>
                                    <th>SUBJECT</th>
                                    <th>ROOM</th>
                                    <th>TEACHER</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td class="px-4 fw-800">09:00 AM</td>
                                    <td>Mathematics (Advanced)</td>
                                    <td>Room 302</td>
                                    <td>Dr. Julian Smith</td>
                                </tr>
                                <tr>
                                    <td class="px-4 fw-800">10:30 AM</td>
                                    <td>Physics</td>
                                    <td>Lab 02</td>
                                    <td>Prof. Sarah Wayne</td>
                                </tr>
                                <tr>
                                    <td class="px-4 fw-800">12:00 PM</td>
                                    <td>Literature</td>
                                    <td>Room 105</td>
                                    <td>Mr. Robert Frost</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="premium-card">
                <div class="p-4 border-bottom border-light">
                    <h5 class="fw-800 m-0">Recent Assignments</h5>
                </div>
                <div class="p-4">
                    <div class="d-flex align-items-center gap-3 mb-4 p-3 rounded-16 bg-light-soft hover-up transition-all">
                        <div class="card-icon-box" style="width: 45px; height: 45px; font-size: 1rem;"><i class="fas fa-file-alt"></i></div>
                        <div class="flex-grow-1">
                            <h6 class="fw-800 m-0">Quantum Mechanics Basics</h6>
                            <p class="text-muted small mb-0">DUE: Jan 30, 2026</p>
                        </div>
                        <button class="btn btn-sm btn-premium-purple px-3 rounded-pill">Submit</button>
                    </div>
                    <div class="d-flex align-items-center gap-3 p-3 rounded-16 bg-light-soft hover-up transition-all">
                        <div class="card-icon-box" style="width: 45px; height: 45px; font-size: 1rem;"><i class="fas fa-pen-nib"></i></div>
                        <div class="flex-grow-1">
                            <h6 class="fw-800 m-0">Renaissance Literature Essay</h6>
                            <p class="text-muted small mb-0">DUE: Feb 05, 2026</p>
                        </div>
                        <button class="btn btn-sm btn-premium-purple px-3 rounded-pill">Submit</button>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-4">
            <div class="premium-card mb-4">
                <div class="p-4 border-bottom border-light">
                    <h5 class="fw-800 m-0">Examination Progress</h5>
                </div>
                <div class="p-4">
                    <div class="mb-4">
                        <div class="d-flex justify-content-between mb-2">
                            <span class="small fw-700">Mid-Term Success</span>
                            <span class="small fw-800 text-primary">88%</span>
                        </div>
                        <div class="progress rounded-pill shadow-none" style="height: 8px; background: rgba(139, 148, 136, 0.1);">
                            <div class="progress-bar rounded-pill" style="width: 88%; background: linear-gradient(90deg, #8b5cf6, #f472b6);"></div>
                        </div>
                    </div>
                    <div>
                        <div class="d-flex justify-content-between mb-2">
                            <span class="small fw-700">Practical Labs</span>
                            <span class="small fw-800 text-success">92%</span>
                        </div>
                        <div class="progress rounded-pill shadow-none" style="height: 8px; background: rgba(139, 148, 136, 0.1);">
                            <div class="progress-bar rounded-pill" style="width: 92%; background: linear-gradient(90deg, #22c55e, #10b981);"></div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="premium-card">
                <div class="p-4 border-bottom border-light">
                    <h5 class="fw-800 m-0">Notice Board</h5>
                </div>
                <div class="p-4">
                    <div class="notice-item mb-4 pb-4 border-bottom border-light">
                        <div class="badge bg-warning-soft text-warning mb-2 px-3 rounded-pill">IMPORTANT</div>
                        <h6 class="fw-800">Annual Sports Meet 2026</h6>
                        <p class="small text-muted mb-0">Registration starts from Feb 1st in the main sports gallery.</p>
                    </div>
                    <div class="notice-item">
                        <div class="badge bg-info-soft text-info mb-2 px-3 rounded-pill">ACADEMIC</div>
                        <h6 class="fw-800">Winter Break Extension</h6>
                        <p class="small text-muted mb-0">School will now reopen on Jan 27th due to weather conditions.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
