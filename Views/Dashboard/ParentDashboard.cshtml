@using System.Security.Claims
@{
    ViewData["Title"] = "Parent Dashboard";
    Layout = "_Layout";
}

<div class="content-wrapper p-4 animate-up">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="page-title mb-1">Parent Portal: @(User.FindFirst("FullName")?.Value ?? User.Identity?.Name)</h3>
            <p class="text-muted small fw-600">Secure oversight of your children's educational progress.</p>
        </div>
        <button class="btn btn-premium-purple rounded-pill px-4 fw-800">CONNECT TO TEACHER</button>
    </div>

    <!-- Children Overview Section -->
    <div class="row g-4 mb-4">
        <div class="col-md-6">
            <div class="premium-card p-4 h-100">
                <div class="d-flex align-items-center gap-4">
                    <div class="user-avatar-modern" style="width: 80px; height: 80px; font-size: 2rem; background: linear-gradient(135deg, #8b5cf6, #3b82f6);">JS</div>
                    <div class="flex-grow-1">
                        <h4 class="fw-800 mb-1">John Doe Jr.</h4>
                        <p class="text-muted fw-700 mb-2">Class 10-A | Roll: 24</p>
                        <div class="d-flex gap-2">
                           <span class="badge bg-success-soft text-success px-3 rounded-pill fw-800">96% ATTENDANCE</span>
                           <span class="badge bg-primary-soft text-primary px-3 rounded-pill fw-800">A+ GRADE</span>
                        </div>
                    </div>
                </div>
                <div class="mt-4 pt-4 border-top">
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="small fw-700 text-muted">FEES STATUS:</span>
                        <span class="text-success fw-800">PAID</span>
                    </div>
                    <button class="btn btn-light-soft w-100 mt-3 rounded-pill fw-800">VIEW ACADEMIC RECORD</button>
                </div>
            </div>
        </div>
        <div class="col-md-6">
             <div class="premium-card p-4 h-100" style="background: rgba(255, 255, 255, 0.4); opacity: 0.8; border: 2px dashed rgba(139, 92, 246, 0.2);">
                <div class="h-100 d-flex flex-column align-items-center justify-content-center py-4">
                    <div class="card-icon-box mb-3"><i class="fas fa-plus"></i></div>
                    <h5 class="fw-800 text-muted">Register Another Student</h5>
                    <p class="small text-muted text-center px-4">Link your other children using their official Admission ID.</p>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-xl-4">
            <div class="premium-card mb-4">
                <div class="p-4 border-bottom border-light">
                    <h5 class="fw-800 m-0">Recent Exam Results</h5>
                </div>
                <div class="p-4">
                    <div class="d-flex justify-content-between mb-3 align-items-center">
                        <div>
                            <h6 class="fw-800 mb-0">Mathematics</h6>
                            <span class="smaller text-muted">Annual Assessment</span>
                        </div>
                        <span class="fw-800 text-primary">92/100</span>
                    </div>
                    <div class="d-flex justify-content-between mb-3 align-items-center">
                        <div>
                            <h6 class="fw-800 mb-0">English Literature</h6>
                            <span class="smaller text-muted">Mid-Term Exam</span>
                        </div>
                        <span class="fw-800 text-primary">85/100</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="fw-800 mb-0">Physics Lab</h6>
                            <span class="smaller text-muted">Practical Exam</span>
                        </div>
                        <span class="fw-800 text-success">48/50</span>
                    </div>
                </div>
            </div>
            
            <div class="premium-card">
                 <div class="p-4 border-bottom border-light">
                    <h5 class="fw-800 m-0">Payments Summary</h5>
                </div>
                <div class="p-4 text-center">
                    <div class="mb-4">
                        <span class="smaller text-muted fw-700 text-uppercase d-block mb-1">TOTAL OUTSTANDING</span>
                        <h2 class="fw-800 text-dark">$0.00</h2>
                    </div>
                    <div class="row g-2">
                        <div class="col-6">
                            <button class="btn btn-light-soft w-100 rounded-pill small fw-800">HISTORY</button>
                        </div>
                        <div class="col-6">
                            <button class="btn btn-premium-purple w-100 rounded-pill small fw-800">PAY NOW</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-8">
            <div class="premium-card h-100">
                <div class="p-4 border-bottom border-light d-flex justify-content-between align-items-center">
                    <h5 class="fw-800 m-0">Institutional Notifications</h5>
                    <span class="badge bg-danger px-3 rounded-pill fw-800">3 NEW</span>
                </div>
                <div class="p-4">
                    <div class="d-flex gap-3 mb-4">
                        <div class="card-icon-box bg-purple-soft text-purple" style="width: 45px; height: 45px; font-size: 1rem;"><i class="fas fa-bus"></i></div>
                        <div>
                            <h6 class="fw-800 mb-1">Transport Alert: Route 04</h6>
                            <p class="text-muted small mb-0">Bus will be 15 minutes late today due to city marathon. ETA: 03:45 PM.</p>
                            <span class="smaller text-muted">10 mins ago</span>
                        </div>
                    </div>
                     <div class="d-flex gap-3 mb-4">
                        <div class="card-icon-box bg-blue-soft text-blue" style="width: 45px; height: 45px; font-size: 1rem;"><i class="fas fa-file-invoice"></i></div>
                        <div>
                            <h6 class="fw-800 mb-1">Monthly Newsletter Dispatched</h6>
                            <p class="text-muted small mb-0">The January edition of EasyEdu Parents' Chronicle is now available in your email.</p>
                            <span class="smaller text-muted">2 hours ago</span>
                        </div>
                    </div>
                    <div class="d-flex gap-3">
                        <div class="card-icon-box bg-warning-soft text-warning" style="width: 45px; height: 45px; font-size: 1rem;"><i class="fas fa-exclamation-triangle"></i></div>
                        <div>
                            <h6 class="fw-800 mb-1">Parent-Teacher Meeting Invitation</h6>
                            <p class="text-muted small mb-0">Scheduled for Feb 2nd at 09:00 AM. Location: Seminar Hall A.</p>
                            <span class="smaller text-muted">Yesterday</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
