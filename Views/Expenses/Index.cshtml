@model IEnumerable<EasyEdu.Models.Expense>
@{
    ViewData["Title"] = "Expense Ledger";
}

<div class="page-header d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="page-title animate-slide-in">Institutional Expenses</h1>
        <p class="text-muted fw-600">Centralized log for all operational and maintenance expenditures</p>
    </div>
    <a asp-action="Create" class="btn-premium btn-premium-primary animate-fade-in shadow-lg">
        <i class="fas fa-receipt"></i> Record Expense
    </a>
</div>

<div class="row g-4 mb-5">
    <div class="col-xl-4 col-md-6">
        <div class="premium-card p-4 bg-white border-start border-5 border-danger">
            <h6 class="text-muted fw-700 text-uppercase small">Monthly Spend</h6>
            <h2 class="fw-800 m-0 text-danger">$@Model.Where(e => e.Date.Month == DateTime.Now.Month).Sum(e => e.Amount).ToString("N2")</h2>
            <div class="small fw-600 text-muted mt-2">Current billing cycle</div>
        </div>
    </div>
    <div class="col-xl-4 col-md-6">
        <div class="premium-card p-4 bg-white border-start border-5 border-primary">
            <h6 class="text-muted fw-700 text-uppercase small">Total Expenditure</h6>
            <h2 class="fw-800 m-0 text-primary">$@Model.Sum(e => e.Amount).ToString("N2")</h2>
            <div class="small fw-600 text-muted mt-2">Aggregated system accounts</div>
        </div>
    </div>
</div>

<div class="premium-card bg-white shadow-md animate-fade-in">
    <div class="card-header border-0 bg-transparent py-4 px-4">
        <h5 class="fw-800 m-0">Consolidated Expense Log</h5>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table premium-table mb-0">
                <thead>
                    <tr>
                        <th class="px-5">DATE</th>
                        <th>CATEGORY</th>
                        <th>DESCRIPTION</th>
                        <th>METHOD</th>
                        <th>AMOUNT</th>
                        <th class="text-end px-5">CONTROL</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="px-5 fw-600">@item.Date.ToString("MMM dd, yyyy")</td>
                            <td>
                                <span class="badge-premium badge-info-premium">@item.Category</span>
                            </td>
                            <td>
                                <div class="fw-800 text-dark">@item.Title</div>
                                <div class="small text-muted">@item.Description</div>
                            </td>
                            <td>
                                <i class="fas fa-wallet me-2 text-muted opacity-50"></i>
                                <span class="fw-600">@item.PaymentMethod</span>
                            </td>
                            <td class="fw-800 text-danger">
                                -$@item.Amount.ToString("N2")
                            </td>
                            <td class="text-end px-5">
                                <form asp-action="Delete" asp-route-id="@item.Id" method="post" style="display:inline;" onsubmit="return confirm('Are you sure you want to delete this expense?')">
                                    <button type="submit" class="btn btn-sm btn-light-soft rounded-circle px-2 text-danger"><i class="fas fa-trash"></i></button>
                                </form>
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="5" class="text-center py-5">
                                <i class="fas fa-folder-open fa-3x text-gray-200 mb-3"></i>
                                <h5 class="text-muted">No expenses recorded</h5>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
